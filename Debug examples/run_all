#!/bin/bash

if [ ! -e ../../quantyDebug ]
then
    mkdir ../../quantyDebug
fi

if [ ! -e ../../quantyDebug/History ]
then
    mkdir ../../quantyDebug/History
fi

dir=`date +%Y.%m.%d`
if [ -e ../../quantyDebug/History/$dir ]
then
  echo "File $dir exists"
  echo "script terminated"
  exit 1
fi
mkdir ../../quantyDebug/History/$dir

rm -f ../../quantyDebug/History/current
ln -s ../../quantyDebug/History/$dir ../../quantyDebug/History/current 

echo "Copying all exmples to ../../quantyDebug/History/current"
cp -r Examples ../../quantyDebug/History/current
echo "Copying all references to ../../quantyDebug/History/current"
cp -r Reference ../../quantyDebug/History/current
echo "Copying all tutorials to ../../quantyDebug/History/current"
cp -r Tutorials ../../quantyDebug/History/current
cp create_Examples ../../quantyDebug
cp create_Reference ../../quantyDebug
cp create_Tutorials ../../quantyDebug
cp compare ../../quantyDebug

cd ../../quantyDebug/
./create_Examples
./create_Reference
./create_Tutorials
./compare

if [ $? -ne 0 ]
then
  echo "comparison failed"
  echo "in order to update link to latest finished set of calculations"
  echo "update manuel \" ln -s $dir History/include \" "
  exit 1
fi

ln -s $dir History/include
