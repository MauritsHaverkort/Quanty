-- This script runs FPLO to create an LDA calculation of NiO and subsequently downfold the solution
-- to a basis of Ni-d and O-p orbitals

-- The name of the program and version
FPLO  = "fplo14.00-49-x86_64"
FEdit = "fedit14.00-49-x86_64"

-- create the directory where the calculation should be sored
os.execute("if [ ! -d \"LDApMLFT\" ]; then mkdir LDApMLFT; fi")
os.execute("cd LDApMLFT; if [ ! -d \"FPLO\" ]; then mkdir FPLO; fi")

-- we use the -p option of FPLO to run it in a scripting mode
-- here the script to setup the calculation
FEditMenuOptions = [[
# go to symmetry menu
@+@
# title
@c@NiO
# enter spacegroup select box - 225
@s@
@225@
@x@
# structure type - crystal
@t@
@c@
@x@
# lenth units - angstroem
@u@
@a@
@x@
# lattice constants;
@l@ 4.178  4.178  4.178
# set axis angles
@a@ 90. 90. 90.
# setup Wyckoff positions
@n@2
# Now, give list of ALL !!! Wyckoff positions.
@1@ Ni @ 0. 0. 0.
@2@ O @ 0.5 0.5 0.5
#
# NOW CALL UPDATE, NEVER FORGET THIS!!!
#
@+@
# leave symmetry menu
@x@
# back in main menu
# This was the symmetry setup, and now we follow our advise to create
# the default =.in input by using the REBUILD-action.
# (The space before the 'e' opens the alternative menu bar.)
@ e@
# now we have the default input, and are still in the main menu

# Set the number of k-points
@k@ 10 10 10
# Set the xc-potential version
# first enter select box
@v@
# select via search
!Perdew Wang 92!
# leave select box, go back to main menu
@x@

# Set the relativistic mode:
@r@
# Select by search, please note that the parentheses indicating the hotkey
# are not considered in search mode.
# (Have a look at the select box interactively.)
!scalar relativistic!
# leave select box
@x@

# Set options:
@-@
# save the basis orbitals to disk
!PLOT_BASIS!+
#leave menu
@x@

# last action must be
@q@
]]

-- The first run to selfconsistency.
-- Copy the string above to an input file
file = io.open("LDApMLFT/FPLO/=.pipe", "w")
file:write(FEditMenuOptions)
file:close()
-- run FEdit
os.execute("cd LDApMLFT/FPLO; "..FEdit.." -p "..FPLO.." -pipe <=.pipe 2>+log 1> out.fedit")
-- run FPLO
os.execute("cd LDApMLFT/FPLO; "..FPLO.." 2>>+log 1 | tee out.scflow")

-- Next we increase the number of k-points and numerical accuracy
FEditMenuOptionsMorekPoints = [[
# Set the number of k-points
@k@ 40 40 40
# Set the accuracy of density
@a@ 1.e-9
# Set the accuracy of Etot
@a@ 1.e-11

# last action must be
@q@
]]

-- write the above string to a file
file = io.open("LDApMLFT/FPLO/=.pipekmesh", "w")
file:write(FEditMenuOptionsMorekPoints)
file:close()
-- run FEdit
os.execute("cd LDApMLFT/FPLO; "..FEdit.." -p "..FPLO.." -pipe <=.pipekmesh 2>+log 1> out.feditkmesh")
-- run FPLO
os.execute("cd LDApMLFT/FPLO; "..FPLO.." 2>>+log 1 | tee out.scf")

-- calculate bands
FEditMenuOptionsBand = [[
@ b@
  @b@+
@x@
@q@";
]]

-- copy the string to a file
file = io.open("LDApMLFT/FPLO/=.pipeband", "w")
file:write(FEditMenuOptionsBand)
file:close()
-- run FEDIT
os.execute("cd LDApMLFT/FPLO; "..FEdit.." -p "..FPLO.." -pipe <=.pipeband 2>+log 1> out.feditband")
-- run FPLO
os.execute("cd LDApMLFT/FPLO; "..FPLO.." 2>>+log 1 | tee out.band")

-- define the =.wandef file to calculate the Wannier functions
WanDef=[[doit

---- real space grid for pictures of WFs ---------------------

WF_grid_basis conv
WF_grid_directions
2 0 0
0 2 0
0 0 2
WF_grid_subdivision  1 1 1

-------------------------------------------------
ham_cutoff 18
-- the thresholds need to be 0, otherwise the result is symmetry braking
-- the z^2 orbital has different values for the same hopping from the x^2-y^2 orbital
-- cutting them by value leads to a different behaviour of the z^2 from the x^2-y^2 orbital
-- and by hybridization the pz will be different from the px/py or the dxy from the dxz/dyz
WF_ham_threshold 0
WF_coeff_threshold 0
WF_write_coeff_stats on
ham_write_t_stats on

----- ham export grid --------

k_grid_basis prim
k_grid_directions
1 0 0
0 1 0
0 0 1
k_grid_subdivision  1 1 1
k_grid_incl_periodic_points off

-------- NiO --------------

wandef
on
  name Ni 3dxy
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 1
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 3d-2
    fac    1
wandef
on
  name Ni 3dyz
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 1
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 3d-1
    fac    1
wandef
on
  name Ni 3dz2
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 1
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 3d+0
    fac    1
wandef
on
  name Ni 3dxz
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 1
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 3d+1
    fac    1
wandef
on
  name Ni 3dx2-y2
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 1
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 3d+2
    fac    1

wandef
on
  name O 2py
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 2
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 2p-1
    fac    1
wandef
on
  name O 2pz
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 2
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 2p+0
    fac    1
wandef
on
  name O 2px
  emin -9
  emax   +1.5
  de 0.0
  contrib
    site 2
    difvec 0 0 0
    xaxis 1 0 0
    zaxis 0 0 1
    orb 2p+1
    fac    1
]]

-- write to file
file = io.open("LDApMLFT/FPLO/=.wandef", "w")
file:write(WanDef)
file:close()
-- run FPLO
os.execute("cd LDApMLFT/FPLO; "..FPLO.." 2>>+log 1 | tee out.wandef")
-- rerun FPLO, needed for Wannier functions. 
os.execute("cd LDApMLFT/FPLO; "..FPLO.." 2>>+log 1 | tee out.wan")
