Verbosity(0)

-- read the output of FPLO
-- note that these functions are work in progress, i.e. the exact format might change, the basic idea not
print("Read FPLO output\n")
FPLOOut = FileReadDresdenFPLO("LDApMLFT/FPLO/out.wan")

-- from the DFT output we can create a tight binding Hamiltonian

print("Create Tight binding Hamiltonian\n")
TB = TightBindingDefFromDresdenFPLO(FPLOOut)

print(TB)

print(TB.Units)
print(TB.Cell)
print(TB.Atoms)

Hamiltonian, ClusterTB, IndexName = CreateClusterHamiltonian(TB, {"open", { {"Ni",{0,0,0}}, {"O",{3.9476379,0,0}}, {"O",{-3.9476379,0,0}}, {"O",{0,3.9476379,0}}, {"O",{0,-3.9476379,0}}, {"O",{0,0,3.9476379}}, {"O",{0,0,-3.9476379}}}},  {{"AddSpin",false}})

print("blabla")

print(ClusterTB)

print("blabla2")

print(Hamiltonian)
