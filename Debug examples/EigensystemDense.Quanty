Verbosity(0xFFFF)

local H = {}

N = 800 --size of H. On my computer, >357 crashes.

--parameters defining a tridiagonal matrix which we will represent in dense form as a lua table
V = 2.0
Vb = 1.0
Eb = 4.0

print("Diagonalizing dense tridiagonal matrix of dimension ", N, " x ", N, ".\n\n")
local printH = false
local printE = false

--initialize H to zeros
for i=1,N do H[i] = {}; for j=1,N do H[i][j] = 0.0; end end

--set diagonal and off diagonal elements
H[1][2] = V;  H[2][1] = V

for i=2,N do
  H[i][i] = Eb
  if(i < N) then
    H[i][i+1] = Vb
    H[i+1][i] = Vb
  end
end

--print the matrix
if(printH) then
  for i=1,N do
    for j=1,N do
      io.write(string.format("% 5.3f ",H[i][j]))
    end
    io.write("\n")
  end
end

--do the diagonalization, and time it
local starttime = os.clock()
val,vec = Eigensystem(H)

print("Time for eigensystem: ", 1000*os.clock() - starttime, " milliseconds.")

--print the eigenvalues and vectors
if(printE) then
  print("\n")
  print(val)
  print("\n")

  for i=1,N do
    for j=1,N do
      io.write(string.format("% 5.3f ",vec[i][j]))
    end
    io.write("\n")
  end
end
