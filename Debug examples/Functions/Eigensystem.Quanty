Verbosity(0x0)


-- The function Eigensystem calculates a set of eigen vectors and eigen values for a given matrix or operator
-- The function has several options related to the accuracy needed and methods used

-----------------------------------------------------------
-----------------------------------------------------------
-- test different dense methods on a small 3 by 3 matrix --
-----------------------------------------------------------
-----------------------------------------------------------

-----------------------------------------------------------
  -- test with real numbers
-----------------------------------------------------------
  -- matrix to diagonalize
  A = {{ 1 , 1 , 0 },
       { 1 , 2 , 1 },
       { 0 , 1 , 5 }}
  -- eigensystem according to Mathematica
  valMathematica =  {0.31866935639502262452433761211,  2.35792636751849974970397959719, 5.3234042760864776257716827907}
  funMathematica = {{0.82050111444738313996858969236, -0.55903255238503675521539216190, 0.119417446650283937603699498928},
                    {0.56721932561260656439883881996,  0.77024207841541995975186334504,-0.291529376375475856555699876429},
                    {0.070994069063423073163271775955, 0.30693606176558202824762574539, 0.94907855109345545102883853038}}
  -- create a wave-function acording to the eigenstates of mathematica
  WaveFunMathematica = {}
  for i=1,3 do
    WaveFunMathematica[i] = NewWavefunction(3,0,{{"100",funMathematica[i][1]},{"010",funMathematica[i][2]},{"001",funMathematica[i][3]}})
  end
  -- create an operator for one electron with 3 orbitals that has the same form as A once put on a basis
  Hamiltonian = NewOperator("Number",3,{0,0,1,1,1,2,2},{0,1,0,1,2,1,2},{1,1,1,2,1,1,5})

  -- use Quanty to calculate the eigensystem of the matrix
  print("Eigensystem of matrices")
  val, fun = Eigensystem(A)

  -- test if Quanty gets the same answer as Mathematica
  converged = true
  for i=1,3 do
    if(abs(val[i]-valMathematica[i]) / (abs(val[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
  end
  for i=1,3 do
    dot = 0
    for j=1,3 do
      dot = dot + fun[i][j] * funMathematica[i][j]
    end
    if ((abs(dot)-1)>1E-15) then converged=false end
  end
  if(converged) then
    print("worked ok")
  else
    print("NOT CONVERGED")
  end

  -- use Quanty to calculate the eigen system using wave-functions and operators, starting from random states
  print("Eigensystem of operator starting from random states with restrictions")
  StartRestrictions = {3, 0,  {"111",1,1}}
  Npsi=3
  psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi)
  valOpp = {}
  for i=1,3 do
    valOpp[i] = psiList[i] * Hamiltonian * psiList[i]
  end
  -- test if Quanty gets the same answer as Mathematica
  converged = true
  for i=1,3 do
    if(abs(valOpp[i]-valMathematica[i]) / (abs(valOpp[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
  end
  for i=1,3 do
    dot = psiList[i] * WaveFunMathematica[i]
    if ((abs(dot)-1)>1E-15) then converged=false end
  end
  if(converged) then
    print("worked ok")
  else
    print("NOT CONVERGED")
  end
  
  -- use Quanty to calculate the eigen system using wave-functions and operators, starting from a given set of states
  print("Eigensystem of operator starting from given states")
  psiList = {NewWavefunction(3,0,{{"100",1}}),NewWavefunction(3,0,{{"010",1}}),NewWavefunction(3,0,{{"001",1}})}
  Eigensystem(Hamiltonian, psiList)
  valOpp = {}
  for i=1,3 do
    valOpp[i] = psiList[i] * Hamiltonian * psiList[i]
  end
  -- test if Quanty gets the same answer as Mathematica
  converged = true
  for i=1,3 do
    if(abs(valOpp[i]-valMathematica[i]) / (abs(valOpp[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
  end
  for i=1,3 do
    dot = psiList[i] * WaveFunMathematica[i]
    if ((abs(dot)-1)>1E-15) then converged=false end
  end
  if(converged) then
    print("worked ok")
  else
    print("NOT CONVERGED")
  end

-----------------------------------------------------------
-----------------------------------------------------------
-- test different dense methods on a small 3 by 3 matrix --
-----------------------------------------------------------
-----------------------------------------------------------

-----------------------------------------------------------
  -- test with complex numbers
-----------------------------------------------------------
  -- matrix to diagonalize
  A = {{ 1   , 1+I , 3*I },
       { 1-I , 2   , 1   },
       {-3*I , 1   , 5   }}
  -- eigensystem according to Mathematica
  valMathematica =  {-0.957509016513455874580948715947, 1.93270928155360584570749449359, 7.02479973495985002887345422236}
  funMathematica = {{0.848746334166595978803610284444,                                        -0.3042479274598142156935398646058+ 0.1510389638058049332585723380046*I, 0.0510696545513364274783225088671+ 0.402047236866078372297394505147 *I},
                    {0.2321576044814645871816662641286+  0.00509311096740913239874082449471*I, 0.897729033025279384252337292938,                                      -0.2976595470513314739784930950171+ 0.2270644935140554547829254396339*I},
                    {0.02949840760917409557366913416583+ 0.474169179818120951954618894565  *I, 0.2662172211730120010883264567962+ 0.0884952228275222867210074024975*I, 0.834020634964603430948668779872                                      }}
  -- create a wave-function acording to the eigenstates of mathematica
  WaveFunMathematica = {}
  for i=1,3 do
    WaveFunMathematica[i] = NewWavefunction(3,0,{{"100",funMathematica[i][1]},{"010",funMathematica[i][2]},{"001",funMathematica[i][3]}})
  end
  -- create an operator for one electron with 3 orbitals that has the same form as A once put on a basis
  Hamiltonian = NewOperator("Number",3,{0,0,0,1,1,1,2,2,2},{0,1,2,0,1,2,0,1,2},{1,1+I,3*I,1-I,2,1,-3*I,1,5})

  -- use Quanty to calculate the eigensystem of the matrix
  print("Eigensystem of matrices")
  val, fun = Eigensystem(A)

-- test if Quanty gets the same answer as Mathematica
converged = true
for i=1,3 do
  if(abs(val[i]-valMathematica[i]) / (abs(val[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
end
for i=1,3 do
  dot = 0
  for j=1,3 do
    dot = dot + fun[i][j] * funMathematica[i][j]
  end
  if ((abs(dot)-1)>1E-15) then converged=false end
end
if(converged) then
  print("worked ok")
  else
  print("NOT CONVERGED")
end

-- use Quanty to calculate the eigen system using wave-functions and operators, starting from random states
print("Eigensystem of operator starting from random states with restrictions")
StartRestrictions = {3, 0,  {"111",1,1}}
Npsi=3
psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi)
valOpp = {}
for i=1,3 do
  valOpp[i] = psiList[i] * Hamiltonian * psiList[i]
end
-- test if Quanty gets the same answer as Mathematica
converged = true
for i=1,3 do
  if(abs(valOpp[i]-valMathematica[i]) / (abs(valOpp[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
end
for i=1,3 do
  dot = psiList[i] * WaveFunMathematica[i]
  if ((abs(dot)-1)>1E-15) then converged=false end
end
if(converged) then
  print("worked ok")
  else
  print("NOT CONVERGED")
end

-- use Quanty to calculate the eigen system using wave-functions and operators, starting from a given set of states
print("Eigensystem of operator starting from given states")
psiList = {NewWavefunction(3,0,{{"100",1}}),NewWavefunction(3,0,{{"010",1}}),NewWavefunction(3,0,{{"001",1}})}
Eigensystem(Hamiltonian, psiList)
valOpp = {}
for i=1,3 do
  valOpp[i] = psiList[i] * Hamiltonian * psiList[i]
end
-- test if Quanty gets the same answer as Mathematica
converged = true
for i=1,3 do
  if(abs(valOpp[i]-valMathematica[i]) / (abs(valOpp[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
end
for i=1,3 do
  dot = psiList[i] * WaveFunMathematica[i]
  if ((abs(dot)-1)>1E-15) then converged=false end
end
if(converged) then
  print("worked ok")
  else
  print("NOT CONVERGED")
end

-----------------------------------------------------------
-----------------------------------------------------------
-- test different dense methods on a small 3 by 3 matrix --
-----------------------------------------------------------
-----------------------------------------------------------

-----------------------------------------------------------
-- test with real non hermitian matrix
-----------------------------------------------------------

-- matrix to diagonalize
A = {{ 1 , 2 , 3 },
     { 4 , 5 , 6 },
     { 7 , 8 , 9 }}

val, funL, funR = Eigensystem(A)

print(Chop(val))
print(funL)
print(funR)

Ident = Chop(Dot(MatrixConjugate(funL),MatrixTranspose(funR)))
print(Ident)
Ident = Chop(Dot(MatrixConjugate(funL),Dot(A,MatrixTranspose(funR))),1E-14)
print(Ident)

print(Chop(MatrixTranspose(Dot(A,MatrixTranspose(funR)))))
print(Chop(Dot(Ident,funR)))

print(Chop(Dot(MatrixConjugate(funL),A)))
print(Chop(Dot(Ident,MatrixConjugate(funL))))

A = {{-0.94369691580976538558285751063767, -0.26655885018001686513181826252401,-0.47973275663639217355658602228578,-0.93888883409875102211551184941750 },
     { 0.035232984981573930667958670533319, 0.94844600046085771183405188685326,-0.42559954681343403612834277801162, 0.073352687837053094227198770518446},
     {-0.87360139850468418673374235916250,  0.56941458136408800000138909352172,-0.17711207958743156049799647261450,-0.51551844705731977949707561794563 },
     { 0.98405787363586084305471226145323, -0.51403962504939073711626053785326,-0.38948047908548839438717888206834, 0.14524927383294995136386323417781 }}


val, funL, funR = Eigensystem(A)

print(Chop(val))
print(funL)
print(funR)

Ident = Chop(Dot(MatrixConjugate(funL),MatrixTranspose(funR)))
print(Ident)
Ident = Chop(Dot(MatrixConjugate(funL),Dot(A,MatrixTranspose(funR))),1E-14)
print(Ident)

print(Chop(MatrixTranspose(Dot(A,MatrixTranspose(funR)))))
print(Chop(Dot(Ident,funR)))

print(Chop(Dot(MatrixConjugate(funL),A)))
print(Chop(Dot(Ident,MatrixConjugate(funL))))


-----------------------------------------------------------
-- test with complex non hermitian matrix
-----------------------------------------------------------


-- matrix to diagonalize
A = {{ I , 2 , 3 },
     { 4 , 5 , 6 },
     { 7 , 8 , 9 }}

val, funL, funR = Eigensystem(A)

print(Chop(val))
print(funL)
print(funR)

Ident = Chop(Dot(MatrixConjugate(funL),MatrixTranspose(funR)))
print(Ident)
Ident = Chop(Dot(MatrixConjugate(funL),Dot(A,MatrixTranspose(funR))),1E-14)
print(Ident)

print(Chop(MatrixTranspose(Dot(A,MatrixTranspose(funR)))))
print(Chop(Dot(Ident,funR)))

print(Chop(Dot(MatrixConjugate(funL),A)))
print(Chop(Dot(Ident,MatrixConjugate(funL))))


os.exit()


------------------------------------------------------------
-- test for a large hilbert space the lowest eigen-states --
------------------------------------------------------------

Hamiltonian1 = 0
val1 = {1,2}
fun1 = {}

-- Hamiltonian2 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian2 = Hamiltonian1 / EnergyUnits.J.value
val2 = {}
fun2 = Copy(fun1)

-- Hamiltonian3 is Hamiltonian1 shifted to the ground-state energy
Hamiltonian3 = Hamiltonian1-val1[1]
val3 = {}
fun3 = Copy(fun1)


