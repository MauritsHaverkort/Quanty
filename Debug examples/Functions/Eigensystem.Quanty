print("Large systems with Lanczos")

::atom::
------------------------------------------------------------
--                        real atom                       --
------------------------------------------------------------

print("===========================================")
print("Atom with a single f-shell with 6 electrons")
print("===========================================")

Basis_dn = {0,2,4,6,8,10,12}
Basis_up = {1,3,5,7,9,11,13}

Hamiltonian1 = NewOperator("U",14,Basis_up,Basis_dn,{0,10,6.25,4}) + 0.1 * NewOperator("ldots",14,Basis_up,Basis_dn)
StartRestrictions = {14,0,{"11111111111111",6,6}}

TimeStart("Eigensystem 10 states")
fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10)
TimeEnd("Eigensystem 10 states")
TimeStart("Eigensystem 1 states")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Eigensystem 1 states")
valgrd = fun1s*Hamiltonian1*fun1s
for i=1,10 do
  print(fun1[i]*Hamiltonian1*fun1[i], fun1[i]*Hamiltonian1*fun1[i]-valgrd, fun1[i]*Hamiltonian1*Hamiltonian1*fun1[i] - (fun1[i]*Hamiltonian1*fun1[i])^2)
end
print(fun1s*Hamiltonian1*fun1s, fun1s*Hamiltonian1*fun1s-valgrd, fun1s*Hamiltonian1*Hamiltonian1*fun1s - (fun1s*Hamiltonian1*fun1s)^2)

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
Hamiltonian2 = Hamiltonian1-fun1s*Hamiltonian1*fun1s

TimeStart("Eigensystem 10 states shifted")
fun1  = Eigensystem(Hamiltonian2,StartRestrictions,10)
TimeEnd("Eigensystem 10 states shifted")
TimeStart("Eigensystem 1 states shifted")
fun1s = Eigensystem(Hamiltonian2,StartRestrictions,1)
TimeEnd("Eigensystem 1 states shifted")
valgrd = fun1s*Hamiltonian2*fun1s
for i=1,10 do
  print(fun1[i]*Hamiltonian2*fun1[i], fun1[i]*Hamiltonian2*fun1[i]-valgrd, fun1[i]*Hamiltonian2*Hamiltonian2*fun1[i] - (fun1[i]*Hamiltonian2*fun1[i])^2)
end
print(fun1s*Hamiltonian2*fun1s, fun1s*Hamiltonian2*fun1s-valgrd, fun1s*Hamiltonian2*Hamiltonian2*fun1s - (fun1s*Hamiltonian2*fun1s)^2)

print("\n\n\n\n\n=======================\n    scaled\n========================\n\n\n\n")

-- Hamiltonian3 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian3 = Hamiltonian1 / EnergyUnits.J.value
TimeStart("Eigensystem 10 states scaled")
fun1  = Eigensystem(Hamiltonian3,StartRestrictions,10)
TimeEnd("Eigensystem 10 states scaled")
TimeStart("Eigensystem 1 states scaled")
fun1s = Eigensystem(Hamiltonian3,StartRestrictions,1)
TimeEnd("Eigensystem 1 states scaled")
valgrd = fun1s*Hamiltonian3*fun1s
for i=1,10 do
  print(fun1[i]*Hamiltonian3*fun1[i], fun1[i]*Hamiltonian3*fun1[i]-valgrd, fun1[i]*Hamiltonian3*Hamiltonian1*fun1[i] - (fun1[i]*Hamiltonian3*fun1[i])^2)
end
print(fun1s*Hamiltonian3*fun1s, fun1s*Hamiltonian3*fun1s-valgrd, fun1s*Hamiltonian3*Hamiltonian3*fun1s - (fun1s*Hamiltonian3*fun1s)^2)

TimePrint()

------------------------------------------------------------
--                      compex atom                       --
------------------------------------------------------------

Basis_dn = {0,2,4,6,8,10,12}
Basis_up = {1,3,5,7,9,11,13}

Hamiltonian1 = NewOperator("U",14,Basis_up,Basis_dn,{0,10,6.25,4}) + 0.1 * NewOperator("ldots",14,Basis_up,Basis_dn) + 0.000001 * NewOperator("Ly",14,Basis_up,Basis_dn) + 0.000002 * NewOperator("Sy",14,Basis_up,Basis_dn)
StartRestrictions = {14,0,{"11111111111111",6,6}}

TimeStart("Eigensystem 10 states complex")
fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10)
TimeEnd("Eigensystem 10 states complex")
TimeStart("Eigensystem 1 states complex")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Eigensystem 1 states complex")
valgrd = fun1s*Hamiltonian1*fun1s
for i=1,10 do
  print(fun1[i]*Hamiltonian1*fun1[i], fun1[i]*Hamiltonian1*fun1[i]-valgrd, fun1[i]*Hamiltonian1*Hamiltonian1*fun1[i] - (fun1[i]*Hamiltonian1*fun1[i])^2)
end
print(fun1s*Hamiltonian1*fun1s, fun1s*Hamiltonian1*fun1s-valgrd, fun1s*Hamiltonian1*Hamiltonian1*fun1s - (fun1s*Hamiltonian1*fun1s)^2)

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
Hamiltonian2 = Hamiltonian1-fun1s*Hamiltonian1*fun1s

TimeStart("Eigensystem 10 states shifted complex")
fun1  = Eigensystem(Hamiltonian2,StartRestrictions,10)
TimeEnd("Eigensystem 10 states shifted complex")
TimeStart("Eigensystem 1 states shifted complex")
fun1s = Eigensystem(Hamiltonian2,StartRestrictions,1)
TimeEnd("Eigensystem 1 states shifted complex")
valgrd = fun1s*Hamiltonian2*fun1s
for i=1,10 do
  print(fun1[i]*Hamiltonian2*fun1[i], fun1[i]*Hamiltonian2*fun1[i]-valgrd, fun1[i]*Hamiltonian2*Hamiltonian2*fun1[i] - (fun1[i]*Hamiltonian2*fun1[i])^2)
end
print(fun1s*Hamiltonian2*fun1s, fun1s*Hamiltonian2*fun1s-valgrd, fun1s*Hamiltonian2*Hamiltonian2*fun1s - (fun1s*Hamiltonian2*fun1s)^2)

print("\n\n\n\n\n=======================\n    scaled\n========================\n\n\n\n")

-- Hamiltonian3 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian3 = Hamiltonian1 / EnergyUnits.J.value
TimeStart("Eigensystem 10 states scaled complex")
fun1  = Eigensystem(Hamiltonian3,StartRestrictions,10)
TimeEnd("Eigensystem 10 states scaled complex")
TimeStart("Eigensystem 1 states scaled complex")
fun1s = Eigensystem(Hamiltonian3,StartRestrictions,1)
TimeEnd("Eigensystem 1 states scaled complex")
valgrd = fun1s*Hamiltonian3*fun1s
for i=1,10 do
  print(fun1[i]*Hamiltonian3*fun1[i], fun1[i]*Hamiltonian3*fun1[i]-valgrd, fun1[i]*Hamiltonian3*Hamiltonian1*fun1[i] - (fun1[i]*Hamiltonian3*fun1[i])^2)
end
print(fun1s*Hamiltonian3*fun1s, fun1s*Hamiltonian3*fun1s-valgrd, fun1s*Hamiltonian3*Hamiltonian3*fun1s - (fun1s*Hamiltonian3*fun1s)^2)

TimePrint()

