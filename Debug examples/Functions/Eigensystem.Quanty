-----------------------------------------------------------
  -- test with complex numbers
-----------------------------------------------------------
  -- matrix to diagonalize
  A = {{ 1   , 1+I , 3*I },
       { 1-I , 2   , 1   },
       {-3*I , 1   , 5   }}
  -- eigensystem according to Mathematica
  valMathematica =  {-0.957509016513455874580948715947, 1.93270928155360584570749449359, 7.02479973495985002887345422236}
  funMathematica = {{0.848746334166595978803610284444,                                        -0.3042479274598142156935398646058+ 0.1510389638058049332585723380046*I, 0.0510696545513364274783225088671+ 0.402047236866078372297394505147 *I},
                    {0.2321576044814645871816662641286+  0.00509311096740913239874082449471*I, 0.897729033025279384252337292938,                                      -0.2976595470513314739784930950171+ 0.2270644935140554547829254396339*I},
                    {0.02949840760917409557366913416583+ 0.474169179818120951954618894565  *I, 0.2662172211730120010883264567962+ 0.0884952228275222867210074024975*I, 0.834020634964603430948668779872                                      }}
  -- create a wave-function acording to the eigenstates of mathematica
  WaveFunMathematica = {}
  for i=1,3 do
    WaveFunMathematica[i] = NewWavefunction(3,0,{{"100",funMathematica[i][1]},{"010",funMathematica[i][2]},{"001",funMathematica[i][3]}})
  end
  -- create an operator for one electron with 3 orbitals that has the same form as A once put on a basis
  Hamiltonian = NewOperator("Number",3,{0,0,0,1,1,1,2,2,2},{0,1,2,0,1,2,0,1,2},{1,1+I,3*I,1-I,2,1,-3*I,1,5})

  -- use Quanty to calculate the eigensystem of the matrix
  print("Eigensystem of matrices")
  val, fun = Eigensystem(A)

-- test if Quanty gets the same answer as Mathematica
converged = true
for i=1,3 do
  if(abs(val[i]-valMathematica[i]) / (abs(val[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
end
for i=1,3 do
  dot = 0
  for j=1,3 do
    dot = dot + fun[i][j] * funMathematica[i][j]
  end
  if ((abs(dot)-1)>1E-15) then converged=false end
end
if(converged) then
  print("worked ok")
  else
  print("NOT CONVERGED")
end

-- use Quanty to calculate the eigen system using wave-functions and operators, starting from random states
print("Eigensystem of operator starting from random states with restrictions")
StartRestrictions = {3, 0,  {"111",1,1}}
Npsi=3
psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi)
valOpp = {}
for i=1,3 do
  valOpp[i] = psiList[i] * Hamiltonian * psiList[i]
end
-- test if Quanty gets the same answer as Mathematica
