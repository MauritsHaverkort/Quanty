-- test different dense methods on a small 3 by 3 matrix --
-----------------------------------------------------------
-----------------------------------------------------------

-----------------------------------------------------------
-- test with real non hermitian matrix
-----------------------------------------------------------

print("Diagonalization of a non Hermitian matrix")

-- for dense matrices, given as tables Quanty can handle non hermitian matrices
-- For non hermitian matrices one has a left and a right eigensystem
-- H psi^R_i   = E_i psi^R_i
-- psi^L_i^* H = E_i psi^L_i^*
--
-- and psi^L_i^* . psi^R_j = delta_{i,j}
-- and thus psi^L_i . H . psi^R_j = E_i delta_{i,j}
--

-- matrix to diagonalize
A = {{ 1 , 2 , 3 },
     { 4 , 5 , 6 },
     { 7 , 8 , 0 }}

val, funL, funR = Eigensystem(A)

print("For the matrix\n",A)
print("We have the eigen-values\n",Chop(val))
print("The left eigen-functions\n",Chop(funL))
print("The right eigen-functions\n",Chop(funR))

Ident = Chop(Dot(MatrixConjugate(funL),MatrixTranspose(funR)))
print("funL^* . funR^T gives the identity matrix\n",Ident)
Ident = Chop(Dot(MatrixConjugate(funL),Dot(A,MatrixTranspose(funR))),1E-14)
print("funL^* . H . funR^T gives a diagonal matrix with the eigen energies on the diagonal\n",Ident)

print(Chop(MatrixTranspose(Dot(A,MatrixTranspose(funR)))))
print(Chop(Dot(Ident,funR)))

print(Chop(Dot(MatrixConjugate(funL),A)))
print(Chop(Dot(Ident,MatrixConjugate(funL))))

A = {{-0.94369691580976538558285751063767, -0.26655885018001686513181826252401,-0.47973275663639217355658602228578,-0.93888883409875102211551184941750 },
     { 0.035232984981573930667958670533319, 0.94844600046085771183405188685326,-0.42559954681343403612834277801162, 0.073352687837053094227198770518446},
     {-0.87360139850468418673374235916250,  0.56941458136408800000138909352172,-0.17711207958743156049799647261450,-0.51551844705731977949707561794563 },
     { 0.98405787363586084305471226145323, -0.51403962504939073711626053785326,-0.38948047908548839438717888206834, 0.14524927383294995136386323417781 }}


val, funL, funR = Eigensystem(A)

print(Chop(val))
print(funL)
print(funR)

Ident = Chop(Dot(MatrixConjugate(funL),MatrixTranspose(funR)))
print(Ident)
Ident = Chop(Dot(MatrixConjugate(funL),Dot(A,MatrixTranspose(funR))),1E-14)
print(Ident)

print(Chop(MatrixTranspose(Dot(A,MatrixTranspose(funR)))))
print(Chop(Dot(Ident,funR)))

print(Chop(Dot(MatrixConjugate(funL),A)))
print(Chop(Dot(Ident,MatrixConjugate(funL))))


-----------------------------------------------------------
-- test with complex non hermitian matrix
-----------------------------------------------------------


-- matrix to diagonalize
A = {{ I , 2 , 3 },
     { 4 , 5 , 6 },
     { 7 , 8 , 9 }}

val, funL, funR = Eigensystem(A)

print(Chop(val))
print(funL)
print(funR)

Ident = Chop(Dot(MatrixConjugate(funL),MatrixTranspose(funR)))
print(Ident)
Ident = Chop(Dot(MatrixConjugate(funL),Dot(A,MatrixTranspose(funR))),1E-14)
print(Ident)

print(Chop(MatrixTranspose(Dot(A,MatrixTranspose(funR)))))
print(Chop(Dot(Ident,funR)))

print(Chop(Dot(MatrixConjugate(funL),A)))
print(Chop(Dot(Ident,MatrixConjugate(funL))))

