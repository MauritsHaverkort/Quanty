Verbosity(0xFFFF)

--goto dense
--goto atom
--goto mlft
goto hubbard

-- The function Eigensystem calculates a set of eigen vectors and eigen values for a given matrix or operator
-- The function has several options related to the accuracy needed and methods used

-----------------------------------------------------------
-----------------------------------------------------------
-- test different dense methods on a small 3 by 3 matrix --
-----------------------------------------------------------
-----------------------------------------------------------
::dense::

print("===========================================")
print("==== Dense methods on a 3 by 3 matrix  ====")
print("===========================================")

-----------------------------------------------------------
  -- test with real numbers
-----------------------------------------------------------
  -- matrix to diagonalize
  A = {{ 1 , 1 , 0 },
       { 1 , 2 , 1 },
       { 0 , 1 , 5 }}
  -- eigensystem according to Mathematica
  valMathematica =  {0.31866935639502262452433761211,  2.35792636751849974970397959719, 5.3234042760864776257716827907}
  funMathematica = {{0.82050111444738313996858969236, -0.55903255238503675521539216190, 0.119417446650283937603699498928},
                    {0.56721932561260656439883881996,  0.77024207841541995975186334504,-0.291529376375475856555699876429},
                    {0.070994069063423073163271775955, 0.30693606176558202824762574539, 0.94907855109345545102883853038}}
  -- create a wave-function acording to the eigenstates of mathematica
  WaveFunMathematica = {}
  for i=1,3 do
    WaveFunMathematica[i] = NewWavefunction(3,0,{{"100",funMathematica[i][1]},{"010",funMathematica[i][2]},{"001",funMathematica[i][3]}})
  end
  -- create an operator for one electron with 3 orbitals that has the same form as A once put on a basis
  Hamiltonian = NewOperator("Number",3,{0,0,1,1,1,2,2},{0,1,0,1,2,1,2},{1,1,1,2,1,1,5})

  -- use Quanty to calculate the eigensystem of the matrix
  print("Eigensystem of matrices")
  val, fun = Eigensystem(A)

  -- test if Quanty gets the same answer as Mathematica
  converged = true
  for i=1,3 do
    if(abs(val[i]-valMathematica[i]) / (abs(val[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
  end
  for i=1,3 do
    dot = 0
    for j=1,3 do
      dot = dot + fun[i][j] * funMathematica[i][j]
    end
    if ((abs(dot)-1)>1E-15) then converged=false end
  end
  if(converged) then
    print("worked ok")
  else
    print("NOT CONVERGED")
  end

  -- use Quanty to calculate the eigen system using wave-functions and operators, starting from random states
  print("Eigensystem of operator starting from random states with restrictions")
  StartRestrictions = {3, 0,  {"111",1,1}}
  Npsi=3
  psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi)
  valOpp = {}
  for i=1,3 do
    valOpp[i] = psiList[i] * Hamiltonian * psiList[i]
  end
  -- test if Quanty gets the same answer as Mathematica
  converged = true
  for i=1,3 do
    if(abs(valOpp[i]-valMathematica[i]) / (abs(valOpp[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
  end
  for i=1,3 do
    dot = psiList[i] * WaveFunMathematica[i]
    if ((abs(dot)-1)>1E-15) then converged=false end
  end
  if(converged) then
    print("worked ok")
  else
    print("NOT CONVERGED")
  end
  
  -- use Quanty to calculate the eigen system using wave-functions and operators, starting from a given set of states
  print("Eigensystem of operator starting from given states")
  psiList = {NewWavefunction(3,0,{{"100",1}}),NewWavefunction(3,0,{{"010",1}}),NewWavefunction(3,0,{{"001",1}})}
  Eigensystem(Hamiltonian, psiList)
  valOpp = {}
  for i=1,3 do
    valOpp[i] = psiList[i] * Hamiltonian * psiList[i]
  end
  -- test if Quanty gets the same answer as Mathematica
  converged = true
  for i=1,3 do
    if(abs(valOpp[i]-valMathematica[i]) / (abs(valOpp[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
  end
  for i=1,3 do
    dot = psiList[i] * WaveFunMathematica[i]
    if ((abs(dot)-1)>1E-15) then converged=false end
  end
  if(converged) then
    print("worked ok")
  else
    print("NOT CONVERGED")
  end

