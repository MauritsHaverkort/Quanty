print("This file should not print a thing")

print("erf");
for i=1,#z do
  error = erf(z[i])-Erfz[i]
  tot = erf(z[i])+Erfz[i]
  relerror = error / abs(tot)
  if(abs(relerror)>3E-15) then
    print("Wrong value in",i,"Err",relerror,"val",erf(z[i]),"z",z[i])
  end
end

print("erfc");
for i=1,#z do
  error = erfc(z[i])-Erfcz[i]
  tot = erfc(z[i])+Erfcz[i]
  relerror = error / abs(tot)
  if(abs(relerror)>3E-15) then
    print("Wrong value in",i,"Err",relerror,"val",erfc(z[i]),"z",z[i])
  end
end

print("sin");
for i=1,#z do
  error = sin(z[i])-Sinz[i]
  tot = sin(z[i])+Sinz[i]
  relerror = error / abs(tot)
  if(abs(relerror)>3E-15) then
    print("Wrong value in",i,"Err",relerror,"val",sin(z[i]),"z",z[i])
  end
end

print("cos");
for i=1,#z do
  error = cos(z[i])-Cosz[i]
  tot = cos(z[i])+Cosz[i]
  relerror = error / abs(tot)
  if(abs(relerror)>3E-15) then
    print("Wrong value in",i,"Err",relerror,"val",cos(z[i]),"z",z[i])
  end
end

print("exp");
for i=1,#z do
  error = exp(z[i])-Expz[i]
  tot = exp(z[i])+Expz[i]
  relerror = error / abs(tot)
  if(abs(relerror)>3E-15) then
    print("Wrong value in",i,"Err",relerror,"val",exp(z[i]),"z",z[i])
  end
end

print("log");
for i=1,#z do
  error = log(z[i],E)-Logz[i]
  tot = log(z[i],E)+Logz[i]
  relerror = error / abs(tot)
  if(abs(relerror)>3E-15) then
    print("Wrong value in",i,"Err",relerror,"val",log(z[i],E),Logz[i],"z",z[i])
  end
end
