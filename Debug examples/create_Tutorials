#!/bin/bash

echo "Changing to directory History/current/Tutorials"
cd History/current/Tutorials
  for directory in */
  do
    echo "Changing to directory $directory"
    cd $directory
      if [ "$directory" == "Connection to DFT/" ]
      then
        for directory2 in */
        do
          echo "Changing to directory $directory2"
          cd $directory2
            for file in *.Quanty
            do
              echo `date` "Running $file" 
              fileout="${file/Quanty/out}"
              Quanty $file | tail -n +23 > $fileout
            done
          cd ..
        done
      else
        for file in *.Quanty
        do
          echo `date` "Running $file" 
          fileout="${file/Quanty/out}"
          Quanty $file | tail -n +23 > $fileout
        done
      cd ..
    fi
  done
cd ..