Verbosity(0xffffffff)

NF = 4

t = 1
U = 3

indUp = {0,2}
indDn = {1,3}

T = -t * ( NewOperator("Number",NF,0,2) + NewOperator("Number",NF,2,0) + NewOperator("Number",NF,1,3) + NewOperator("Number",NF,3,1) )
V =  U * ( NewOperator("Number",NF,0,0) * NewOperator("Number",NF,1,1) + NewOperator("Number",NF,2,2) * NewOperator("Number",NF,3,3) )
H = T + V


psi = { NewWavefunction(NF,0,{{"0110",1}}), --Complex.I()
  NewWavefunction(NF,0,{{"1010",1}}),
  NewWavefunction(NF,0,{{"0011",1}}),
  NewWavefunction(NF,0,{{"0101",1}}),
  NewWavefunction(NF,0,{{"1001",1}}),
  NewWavefunction(NF,0,{{"1100",1}}) }

M = Braket(psi,H,psi)

ev, es = Eigensystem(M)
print("Eigenvalues are:",Chop(ev),"\n")

bar = {(psi[1]+psi[2])/sqrt(2),(psi[3]+psi[4])/sqrt(2),psi[5]}

Spec, tri, kryl = CreateSpectra(H, 0*T+1, bar, {{"Emin",0}, {"Emax",3050}, {"NE",3}, {"Gamma",1}, {"NTri",4}, {"E0",0}, {"Tensor",true}, {"epsilon",1E-5},{"denseborder",0},{"KrylovBasis",true}})

print(tri)
print(kryl)

ev, es = Eigensystem(tri)
print("\nBut from BlockTriDiagonalMatrixEigenSystem:",Chop(ev))

flatkryl = Simon.Flatten(kryl)

--print(Chop(Braket(flatkryl,H,flatkryl)))
ev, es = Eigensystem(Braket(flatkryl,H,flatkryl))
print("\nKrylovBasis yields correct Eigenvalues:",Chop(ev),"\n")

bar = {(psi[1]+psi[2])/sqrt(2),(psi[3]+psi[4])/sqrt(2),psi[5]+psi[6]}

Spec, tri, kryl = CreateSpectra(H, 0*T+1, bar, {{"Emin",0}, {"Emax",3050}, {"NE",3}, {"Gamma",1}, {"NTri",4}, {"E0",0}, {"Tensor",true}, {"epsilon",1E-5},{"denseborder",0},{"KrylovBasis",true}})

print(tri)

ev, es = Eigensystem(tri)
print("\nBlockTriDiagonalMatrixEigenSystem after changing starting vectors:",Chop(ev))
