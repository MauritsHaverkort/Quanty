LzFac = 1e6

NFermi = 30
Cr_3d_Dn={ 0 , 2 , 4 , 6 , 8 }
Cr_3d_Up={ 1 , 3 , 5 , 7 , 9 }

dofile("pilesOfInput.Quanty")


function MatrixToOperator(M)
    Op = NewOperator("Number", #M, {0}, {0}, {0})
    for i = 1, #M do
        for j=1, #M do
            Op = Op + NewOperator("Number", #M, {i - 1}, {j - 1}, {M[i][j]})
        end
    end
    Op.Chop(1e-15)
    return Op
end



HDFT = Copy( MatrixToOperator(HDFTFullMat) )

OppSz    = Rotate(NewOperator("Sz",   NFermi,Cr_3d_Up,Cr_3d_Dn),YtoZFull)
OppLz    = Rotate(NewOperator("Lz",   NFermi,Cr_3d_Up,Cr_3d_Dn),YtoZFull)

-- define the Hamiltonian
print("--Define Hamiltonian--\n")
Hamiltonian = HDFT + Bz * (2*OppSz + LzFac*OppLz)
HamiltonianReal = HDFT + Bz * (2*OppSz)

-- print(Bz*OppSz )
-- print(Bz*LzFac*OppLz)
