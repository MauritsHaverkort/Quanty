-- print of some expectation values
Hamiltonian.Name = "E"
OppSz.Name = "S_z_3d"
OppLz.Name = "L_z_3d"
oppList={Hamiltonian, OppSz, OppLz}


function testEigensystem(ham)
list = Eigensystem(ham, StartRestrictions, Npsi,{{"Restrictions", Restrictions}})



    ham.Restrictions= Restrictions
    hamSqrd = ham*ham
--     hamSqrd.Restrictions = Restrictions

    print("Wavefunction norms, and norm of H*psi-E*psi:")
    for key,psi in pairs(list) do
        eigen = ham*psi - Braket(psi,ham,psi)*psi
--         print( key, Braket(psi,psi), Braket(psi,hamSqrd,psi)-Braket(psi,ham,psi)*Braket(psi,ham,psi) )
        print( key, Braket(psi,psi), Braket(eigen,eigen) )
    end

    print("E\tS_z_3d\tL_z_3d")
    Res={}
    for i=1,#list do
        for k=1,#oppList do
            Res[k] = list[i] * oppList[k] * list[i]
        end
        print(Res)
    end

--     print("Eigenstate test: Chop( Ham*psi - E*psi , 0.1)")
--     for key,psi in pairs(list) do
--         print( key, Chop( ham*psi - Braket(psi,ham,psi)*psi, 1e-3 ) )
--     end
end

print(Hamiltonian)

print(Chop(Hamiltonian-ConjugateTranspose(Hamiltonian)))


print("=== Broken Eigensystem ===")
testEigensystem(Hamiltonian)

