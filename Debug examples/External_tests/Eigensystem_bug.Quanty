StartRestrictions = {NFermi, 0}
Restrictions = {NFermi, 0}
StartRestrictions[#StartRestrictions + 1] = {"11111 11111 00000 00000 00000 00000",nd,nd}

StartRestrictions[#StartRestrictions + 1] = {"00000 00000 11111 11111 00000 00000",10,10}
Restrictions[#Restrictions + 1] = {"00000 00000 11111 11111 00000 00000",10-max_excited_es,10}

StartRestrictions[#StartRestrictions + 1] = {"00000 00000 00000 00000 11111 11111",0,0}
Restrictions[#Restrictions + 1] = {"00000 00000 00000 00000 11111 11111",0,1}

