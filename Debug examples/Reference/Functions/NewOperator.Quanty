-- test angular momentum operators
-- single shell l m s sz basis no explicit basis choice

function IsNill(opp)
  if (#opp.N~=0) then
    return false
  end
  if (opp.N[0]==0) then
    return true
  end
  return false
end

function IsEqual(oppA,oppB,message)
  if IsNill(Chop(oppA-oppB,1e-13)) then
    print("OK : ",message)
  else
    print("Wrong : ",message)
    print(Chop(oppA-oppB,1e-13))
    print(debug.traceback())
    os.exit(1)
  end
  return true
end

