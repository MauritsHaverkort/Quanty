Basis_dn = {0,2,4,6,8,10,12}
Basis_up = {1,3,5,7,9,11,13}

Hamiltonian = NewOperator("U",14,Basis_up,Basis_dn,{0,10,6.25,4}) + 0.1 * NewOperator("ldots",14,Basis_up,Basis_dn) + 0.000001 * NewOperator("Ly",14,Basis_up,Basis_dn) + 0.000002 * NewOperator("Sy",14,Basis_up,Basis_dn)
StartRestrictions = {14,0,{"11111111111111",6,6}}

Npsi=50

TimeStart("Eigensystem")
funlist  = Eigensystem(Hamiltonian,StartRestrictions,Npsi)
TimeEnd("Eigensystem")

funlist2 = Copy(funlist)

TimeStart("dot in script loop")
dot1 = {}
for i=1,Npsi do
  dot1[i]={}
  for j=1,Npsi do
    dot1[i][j] = funlist[i] * funlist[j]
  end
end
TimeEnd("dot in script loop")
setmetatable(dot1, MatrixMeta)

TimeStart("dot using Braket with different lists")
dot2 = Braket(funlist,funlist2)
TimeEnd("dot using Braket with different lists")

TimeStart("dot using Braket")
dot3 = Braket(funlist,funlist)
TimeEnd("dot using Braket")

print(Chop(dot2-dot1))
print(Chop(dot3-dot1))

TimePrint()



TimeStart("dot3 in script loop")
dot1 = {}
for i=1,Npsi do
  dot1[i]={}
  for j=1,Npsi do
    dot1[i][j] = funlist[i] * Hamiltonian * funlist[j]
  end
end
TimeEnd("dot3 in script loop")
setmetatable(dot1, MatrixMeta)

TimeStart("dot3 using Braket with different lists")
dot2 = Braket(funlist,Hamiltonian,funlist2)
TimeEnd("dot3 using Braket with different lists")

TimeStart("dot3 using Braket")
dot3 = Braket(funlist,Hamiltonian,funlist)
TimeEnd("dot3 using Braket")

print(Chop(dot2-dot1))
print(Chop(dot3-dot1))

TimePrint()
