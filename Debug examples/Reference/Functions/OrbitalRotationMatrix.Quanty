function PrintRotateMatrix()
    local MM = Matrix.Zero(#orbsOld)
    for i=1,#orbsOld do
        MM[i][i] = i*Matrix.Identity(OrbToMultiplicity(orbsOld[i]))
    end
    local M = Matrix.Flatten(MM)
    print("Example Matrix before Rotation:")
    print(M)
    local MRot = Rotate(M, R)
    print("Example Matrix after Rotation:")
    print(Chop(Matrix.ToTable(MRot)))
end

orbsOld = {"1s","2s","2p"}
orbsNew = {"1s","2s","2p"}
print("\n\n\n")
print("orbsOld:")
print(orbsOld)
print("orbsNew:")
print(orbsNew)
print("OrbitalRotationMatrix:")
R = Matrix.ToUserdata(OrbitalRotationMatrix(orbsOld, orbsNew))
print(R)
PrintRotateMatrix()

