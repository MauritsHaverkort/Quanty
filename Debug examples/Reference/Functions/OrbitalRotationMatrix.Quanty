print("\n\nrotMatRelToNonRel*rotMatNonRelToRel:")
print(Chop(rotMatRelToNonRel*rotMatNonRelToRel))
print("\n\nrotMatNonRelToRel*rotMatRelToNonRel:")
print(Chop(rotMatNonRelToRel*rotMatRelToNonRel))
