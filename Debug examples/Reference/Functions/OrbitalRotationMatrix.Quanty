errorCount = 0

tolerance = 1e-12

function test(mat1,mat2)
    local Ni = #mat1
    local Nj = #(Matrix.ToTable(mat1)[1])
    local zero = 0
    if Ni > Nj then
        zero = Matrix.Zero(Ni,{{"Userdata",true}})
    else
        zero = Matrix.Zero(Nj,{{"Userdata",true}})
    end
    if Matrix.ToUserdata(Chop(mat1 - mat2, tolerance)) ~= Matrix.Sub(zero, 1, Ni, 1, Nj) then
        print("Something went wrong!")
        errorCount = errorCount + 1
    end
end

