print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Complex.Re(Braket(fun1[i],Hamiltonian1,fun1[i]))
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Complex.Re(Braket(Hfun,Hfun))
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
Energy=Complex.Re(Braket(fun1s,Hamiltonian1,fun1s))
Hfun=Hamiltonian1*fun1s
EnergySqr=Complex.Re(Braket(Hfun,Hfun))
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))

TimePrint()

