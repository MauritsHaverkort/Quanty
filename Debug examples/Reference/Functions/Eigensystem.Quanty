print("===========================================")
print("Atom with a single f-shell with 6 electrons")
print("===========================================")
print("                  complex                  ")
print("===========================================\n\n")

Basis_dn = {0,2,4,6,8,10,12}
Basis_up = {1,3,5,7,9,11,13}

Hamiltonian1 = NewOperator("U",14,Basis_up,Basis_dn,{0,10,6.25,4}) + 0.1 * NewOperator("ldots",14,Basis_up,Basis_dn) + 0.000001 * NewOperator("Ly",14,Basis_up,Basis_dn) + 0.000002 * NewOperator("Sy",14,Basis_up,Basis_dn)
StartRestrictions = {14,0,{"11111111111111",6,6}}

TimeStart("Eigensystem 10 states complex")
fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10)
TimeEnd("Eigensystem 10 states complex")
TimeStart("Eigensystem 1 states complex")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Eigensystem 1 states complex")
valgrd = Complex.Re(Braket(fun1s,Hamiltonian1,fun1s))
print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Complex.Re(Braket(fun1[i],Hamiltonian1,fun1[i]))
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Complex.Re(Braket(Hfun,Hfun))
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
Energy=Complex.Re(Braket(fun1s,Hamiltonian1,fun1s))
Hfun=Hamiltonian1*fun1s
EnergySqr=Complex.Re(Braket(Hfun,Hfun))
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
Hamiltonian2 = Hamiltonian1-fun1s*Hamiltonian1*fun1s

TimeStart("Eigensystem 10 states shifted complex")
fun1  = Eigensystem(Hamiltonian2,StartRestrictions,10)
TimeEnd("Eigensystem 10 states shifted complex")
TimeStart("Eigensystem 1 states shifted complex")
fun1s = Eigensystem(Hamiltonian2,StartRestrictions,1)
