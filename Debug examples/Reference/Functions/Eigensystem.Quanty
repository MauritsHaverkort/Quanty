print("============================================")
print("         Hubbard model 10 sites 1D          ")
print("============================================")
print("               real psi start               ")
print("============================================\n\n")

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
  {0,1,0},
{0,0,1}}
Htb.Atoms={{"Cu",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"Cu.s","Cu.s",{0,0, 1},{{1  ,0},{0,1  }}},
  {"Cu.s","Cu.s",{0,0,-1},{{1  ,0},{0,1  }}},
  {"Cu.s","Cu.s",{0,0, 2},{{0.1,0},{0,0.1}}},
{"Cu.s","Cu.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,10}}},U*HlocU)

print(Htb)
print(Hamiltonian1)

funstart10 = { NewWavefunction(20,0,{{"10011001100110011001",1}}),
  NewWavefunction(20,0,{{"01100110011001100110",1}}),
  NewWavefunction(20,0,{{"10010110011001100110",1}}),
  NewWavefunction(20,0,{{"01101001011001100110",1}}),
  NewWavefunction(20,0,{{"01100110100101100110",1}}),
  NewWavefunction(20,0,{{"01100110011010010110",1}}),
  NewWavefunction(20,0,{{"01100110011001101001",1}}),
  NewWavefunction(20,0,{{"01101001100110011001",1}}),
  NewWavefunction(20,0,{{"10010110100110011001",1}}),
  NewWavefunction(20,0,{{"10011001011010011001",1}})}

funstart1  = NewWavefunction(20,0,{{"10011001100110011001",sqrt(0.5)},{"01100110011001100110",sqrt(0.5)}})

print(Htb)

TimeStart("Hubbard psi Eigensystem 10 states")
fun1 = Copy(funstart10)

Eigensystem(Hamiltonian1,fun1)
TimeEnd("Hubbard psi Eigensystem 10 states")
TimeStart("Hubbard psi Eigensystem 1 states")
fun1s = Copy(funstart1)
Eigensystem(Hamiltonian1,fun1s)
TimeEnd("Hubbard psi Eigensystem 1 states")
valgrd = Braket(fun1s,Hamiltonian1,fun1s)
print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian1,fun1[i])
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
Energy=Braket(fun1s,Hamiltonian1,fun1s)
Hfun=Hamiltonian1*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))

TimePrint()

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
Hamiltonian2 = Hamiltonian1-fun1s*Hamiltonian1*fun1s

TimeStart("Hubbard psi Eigensystem 10 states shifted")
fun1 = Copy(funstart10)
Eigensystem(Hamiltonian2,fun1)
TimeEnd("Hubbard psi Eigensystem 10 states shifted")
TimeStart("Hubbard psi Eigensystem 1 states shifted")
fun1s = Copy(funstart1)
Eigensystem(Hamiltonian2,fun1s)
TimeEnd("Hubbard psi Eigensystem 1 states shifted")
valgrd = Braket(fun1s,Hamiltonian2,fun1s)
print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian2,fun1[i])
  Hfun=Hamiltonian2*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
Energy=Braket(fun1s,Hamiltonian2,fun1s)
Hfun=Hamiltonian2*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))

TimePrint()

print("\n\n\n\n\n=======================\n    scaled\n========================\n\n\n\n")

-- Hamiltonian3 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian3 = Hamiltonian1 / EnergyUnits.J.value
TimeStart("Hubbard psi Eigensystem 10 states scaled")
fun1 = Copy(funstart10)
Eigensystem(Hamiltonian3,fun1)
TimeEnd("Hubbard psi Eigensystem 10 states scaled")
TimeStart("Hubbard psi Eigensystem 1 states scaled")
fun1s = Copy(funstart1)
Eigensystem(Hamiltonian3,fun1s)
TimeEnd("Hubbard psi Eigensystem 1 states scaled")
valgrd = Braket(fun1s,Hamiltonian3,fun1s)
print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian3,fun1[i])
  Hfun=Hamiltonian3*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
Energy=Braket(fun1s,Hamiltonian3,fun1s)
Hfun=Hamiltonian3*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))

TimePrint()


------------------------------------------------------------
--         Complex Hubbard model strart from psi          --
------------------------------------------------------------

print("============================================")
print("         Hubbard model 10 sites 1D          ")
print("============================================")
print("             complex psi start              ")
print("============================================\n\n")

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
  {0,1,0},
{0,0,1}}
Htb.Atoms={{"Cu",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"Cu.s","Cu.s",{0,0, 1},{{1  ,0},{0,1  }}},
  {"Cu.s","Cu.s",{0,0,-1},{{1  ,0},{0,1  }}},
  {"Cu.s","Cu.s",{0,0, 2},{{0.1,0},{0,0.1}}},
{"Cu.s","Cu.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,10}}},U*HlocU,{{"k",{0,0,Pi/2}}})

print(Htb)
print(Hamiltonian1)

funstart10 = { NewWavefunction(20,0,{{"10011001100110011001",1}}),
  NewWavefunction(20,0,{{"01100110011001100110",1}}),
  NewWavefunction(20,0,{{"10010110011001100110",1}}),
  NewWavefunction(20,0,{{"01101001011001100110",1}}),
  NewWavefunction(20,0,{{"01100110100101100110",1}}),
  NewWavefunction(20,0,{{"01100110011010010110",1}}),
  NewWavefunction(20,0,{{"01100110011001101001",1}}),
  NewWavefunction(20,0,{{"01101001100110011001",1}}),
  NewWavefunction(20,0,{{"10010110100110011001",1}}),
  NewWavefunction(20,0,{{"10011001011010011001",1}})}

funstart1  = NewWavefunction(20,0,{{"10011001100110011001",sqrt(0.5)},{"01100110011001100110",sqrt(0.5)}})

print(Htb)

TimeStart("Hubbard psi Eigensystem 10 states complex")
fun1 = Copy(funstart10)

Eigensystem(Hamiltonian1,fun1)
TimeEnd("Hubbard psi Eigensystem 10 states complex")
TimeStart("Hubbard psi Eigensystem 1 states complex")
fun1s = Copy(funstart1)
Eigensystem(Hamiltonian1,fun1s)
TimeEnd("Hubbard psi Eigensystem 1 states complex")
