print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Complex.Re(Braket(fun1[i],Hamiltonian2,fun1[i]))
  Hfun=Hamiltonian2*fun1[i]
  EnergySqr=Complex.Re(Braket(Hfun,Hfun))
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
Energy=Complex.Re(Braket(fun1s,Hamiltonian2,fun1s))
Hfun=Hamiltonian2*fun1s
EnergySqr=Complex.Re(Braket(Hfun,Hfun))
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))

TimePrint()

print("\n\n\n\n\n=======================\n    scaled\n========================\n\n\n\n")

-- Hamiltonian3 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian3 = Hamiltonian1 / EnergyUnits.J.value
TimeStart("Hubbard Eigensystem 10 states scaled complex")
fun1  = Eigensystem(Hamiltonian3,StartRestrictions,10)
TimeEnd("Hubbard Eigensystem 10 states scaled complex")
TimeStart("Hubbard Eigensystem 1 states scaled complex")
fun1s = Eigensystem(Hamiltonian3,StartRestrictions,1)
TimeEnd("Hubbard Eigensystem 1 states scaled complex")
