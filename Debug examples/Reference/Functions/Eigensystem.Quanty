  for i=1,3 do
    WaveFunMathematica[i] = NewWavefunction(3,0,{{"100",funMathematica[i][1]},{"010",funMathematica[i][2]},{"001",funMathematica[i][3]}})
  end
  -- create an operator for one electron with 3 orbitals that has the same form as A once put on a basis
  Hamiltonian = NewOperator("Number",3,{0,0,0,1,1,1,2,2,2},{0,1,2,0,1,2,0,1,2},{1,1+I,3*I,1-I,2,1,-3*I,1,5})

  -- use Quanty to calculate the eigensystem of the matrix
  print("Eigensystem of matrices")
  val, fun = Eigensystem(A)

-- test if Quanty gets the same answer as Mathematica
converged = true
for i=1,3 do
  if(abs(val[i]-valMathematica[i]) / (abs(val[i])+abs(valMathematica[i])+1E-100)>1E-15) then converged=false end
end
for i=1,3 do
  dot = 0
  for j=1,3 do
    dot = dot + fun[i][j] * funMathematica[i][j]
  end
  if ((abs(dot)-1)>1E-15) then converged=false end
end
if(converged) then
  print("worked ok")
  else
  print("NOT CONVERGED")
end

