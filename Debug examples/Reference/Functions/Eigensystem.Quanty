print("============================================")
print("        Hubbartd model 10 sites 1D          ")
print("============================================")
print("                  complex                   ")
print("============================================\n\n")

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
          {0,1,0},
          {0,0,1}}
Htb.Atoms={{"O",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"O.s","O.s",{0,0, 1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0,-1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0, 2},{{0.1,0},{0,0.1}}},
             {"O.s","O.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,10}}},U*HlocU,{{"k",{0,0,Pi/2}}})

StartRestrictions = {20,0,{"10101010101010101010",5,5},{"01010101010101010101",5,5}}

TimeStart("Hubbard Eigensystem 10 states complex")
fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10)
TimeEnd("Hubbard Eigensystem 10 states complex")
TimeStart("Hubbard Eigensystem 1 states complex")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Hubbard Eigensystem 1 states complex")
valgrd = Complex.Re(Braket(fun1s,Hamiltonian1,fun1s))
print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Complex.Re(Braket(fun1[i],Hamiltonian1,fun1[i]))
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Complex.Re(Braket(Hfun,Hfun))
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
Energy=Complex.Re(Braket(fun1s,Hamiltonian1,fun1s))
Hfun=Hamiltonian1*fun1s
EnergySqr=Complex.Re(Braket(Hfun,Hfun))
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))

TimePrint()

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
Hamiltonian2 = Hamiltonian1-fun1s*Hamiltonian1*fun1s

