function unitarityTest(mat)
    print("\nUnitarity Test (M*M^dag - 1):")
    setmetatable(mat, MatrixMeta)
    MatMatDag = mat*ConjugateTranspose(mat)
--     print( Chop( MatMatDag - Matrix.Identity(#mat) ) == Matrix.Zero(#mat) )
    print(Chop( MatMatDag - Matrix.Identity(#mat) ))
end

