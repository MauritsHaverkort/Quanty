--Some preparations:
Orbitals = {"1s","2s","2p","3s","3p","3d","4s","4p","4d","4f","5s","5p","5d","5f","5g","6s","6p","6d","6f","6g","6h","7s","7p","7d","7f","7g","8s","8p","8d","8f","9s","9p","9d","10s","10p","11s"}
Groupings = {{"unexcited",{"1s","2s","2p","3s","3p","3d","4s","4p","4d","4f","5s","5p","5d","5f","5g","6s","6p","6d","6f","6g","6h","7s","7p"} }, {"excited", {"7d","7f","7g","8s","8p","8d","8f","9s","9p","9d","10s","10p","11s"} }}
AtomicIndices, NF = Simon.CreateAtomicIndicesDict(Orbitals,Groupings)

NFList = {}
NFList[#NFList+1] = 1
NFList[#NFList+1] = NF
NFList[#NFList+1] = 10000

IndList={}
IndList[#IndList+1] = {}
IndList[#IndList+1] = {0}
IndList[#IndList+1] = {0,1,3,4,5,6,28}
IndList[#IndList+1] = {0,9999}
IndList[#IndList+1] = AtomicIndices["6h"]
IndList[#IndList+1] = AtomicIndices["unexcited"]
IndList[#IndList+1] = AtomicIndices["excited"]

for key1,inds in pairs(IndList) do
    for key2,NF in pairs(NFList) do
        print("\n\n\n")
        print("\nIndices:")
        print(inds)
        print("\nNF =",NF)
        print("\nDeterminantString:")
        print(Simon.DeterminantString(inds,NF))
    end
end
