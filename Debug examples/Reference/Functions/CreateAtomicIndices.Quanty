OrbList={}
OrbList[#OrbList+1] = {"1s"}
OrbList[#OrbList+1] = {"1s","2s","2p"}
OrbList[#OrbList+1] = {"13f","3a"}
OrbList[#OrbList+1] = {"Noodles","Mind the Gap","Barely Used","Stuff","Hug"}
OrbList[#OrbList+1] = {"1s","13g","Test"}
OrbList[#OrbList+1] = {"1s","2s","2p","3s","3p","3d","4s","4p","4d","4f","5s","5p","5d","5f","5g","6s","6p","6d","6f","6g","6h","7s","7p","7d","7f","7g","8s","8p","8d","8f","9s","9p","9d","10s","10p","11s"}


OptList = {}
OptList[#OptList+1] = {}
OptList[#OptList+1] = {{}}
OptList[#OptList+1] = {{"unexcited",{"1s","2s"}}}
OptList[#OptList+1] = {{"very special",{"1s_Dn","2s_Up"}}}
OptList[#OptList+1] = {{"2s",{"1s"}} , {"unexcited",{"1s","2p"}} , {"laser",{"2p","3s"}} }

for key1,orbs in pairs(OrbList) do
    print("\n\n\n")
    print("Testing CreateAtomicIndicesDict:")
    for key2,opts in pairs(OptList) do
        print("\n\n\n")
        print("Orbitals:")
        print(orbs)
        print("Options:")
        print(opts)
        Ind, NF = CreateAtomicIndicesDict(orbs, opts)
        print("NF="..NF)
        print("Ind[ \"all\" ]:")
        print(Ind["all"])
        print("Ind[ \"All\" ]:")
        print(Ind["All"])
        for key3,orb in pairs(orbs) do
            print("Ind[ \""..orb.."\" ]:")
            print(Ind[orb])
            print("Ind[ \""..orb.."_Dn\" ]:")
            print(Ind[orb.."_Dn"])
            print("Ind[ \""..orb.."_Up\" ]:")
            print(Ind[orb.."_Up"])
        end
        for key4,opt in pairs(opts) do
            if  opt[1] ~= nil then
                print("Ind[ \""..opt[1].."\" ]:")
                print(Ind[opt[1]])
            end
        end
    end
    print("\n\n\n")
    print("Testing CreateAtomicIndicesList:")
    print("\n\n\n")
    print("Orbitals:")
    print(orbs)
    Ind, NF = CreateAtomicIndicesList(orbs)
    print(Ind)
end


