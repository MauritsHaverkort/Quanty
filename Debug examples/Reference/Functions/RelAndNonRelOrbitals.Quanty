orbs = {}
orbs[#orbs + 1] = {"1s","2s","2p"}
orbs[#orbs + 1] = {"1s","2s","2p","3s","3p","3d","4s","4p","4d","4f","5s","5p","5d","5f","5g","6s","6p","6d","6f","6g","6h","7s","7p","7d","7f","7g","8s","8p","8d","8f","9s","9p","9d","10s","10p","11s"}
orbs[#orbs + 1] = {"1s1/2","2s1/2","2p1/2","2p3/2"}
orbs[#orbs + 1] = {"13f","2p1 / 2","2p3 2"}

for key,orbitals in pairs(orbs) do
