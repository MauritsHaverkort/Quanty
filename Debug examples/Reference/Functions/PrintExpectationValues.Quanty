orbs = {"1s","2s","2p"}
Ind, NF = CreateAtomicIndicesDict(orbs)

psiList = {}
for key1,orb1 in pairs(orbs) do
    for key2, orb2 in pairs(orbs) do
        if key1 == key2 then
            det1 = DeterminantString(Ind[orb1],NF)
            psiList[#psiList + 1] = NewWavefunction(NF, 0, {{det1,1}})
        elseif key1 < key2 then
            det1 = DeterminantString(Ind[orb1],NF)
            det2 = DeterminantString(Ind[orb2],NF)
            psiList[#psiList + 1] = NewWavefunction(NF, 0, {{det1,math.sqrt(1/2)}, {det2,math.sqrt(1/2)}})
        end
    end
end

-- for key,psi in pairs(psiList) do
--     print("Wavefunction:")
--     print(psi)
-- end



Hamil = NewOperator("Number",NF,Ind["1s"],Ind["1s"],{0.1,0.2})
Hamil = Hamil + NewOperator("Number",NF,Ind["2s"],Ind["2s"],{0.3,0.4})
Hamil = Hamil + NewOperator("Number",NF,Ind["2p"],Ind["2p"],{0.5,0.6,0.7,0.8,0.9,1.0})
Hamil = Hamil + NewOperator("U",NF,Ind["1s_Up"],Ind["1s_Dn"],Ind["2p_Up"],Ind["2p_Dn"],{0.6},{0.7})
Hamil = Hamil + NewOperator("U",NF,Ind["2s_Up"],Ind["2s_Dn"],Ind["2p_Up"],Ind["2p_Dn"],{0.8},{0.9})
Hamil = Hamil + NewOperator("U",NF,Ind["2p_Up"],Ind["2p_Dn"],{0.5,sqrt(2)})
Hamil = Hamil/2
Hamil = Hamil + ConjugateTranspose(Hamil)
Hamil.Name = "H"
-- print("Hamiltonian:")
-- print(Hamil)


opList = {}
opList[#opList + 1] = NewOperator("Number",NF,Ind["1s"],Ind["1s"],{1,1})
opList[#opList].Name = "N_1s"
opList[#opList + 1] = NewOperator("Number",NF,Ind["2s"],Ind["2s"],{1,1})
opList[#opList].Name = "N_2s"
opList[#opList + 1] = NewOperator("Number",NF,Ind["2p"],Ind["2p"],{1,1,1,1,1,1})
opList[#opList].Name = "N_2p"
opList[#opList + 1] = NewOperator("U",NF,Ind["2p_Up"],Ind["2p_Dn"],{1,0})
opList[#opList].Name = "F0_2p"
opList[#opList + 1] = NewOperator("U",NF,Ind["2p_Up"],Ind["2p_Dn"],{0,1})
opList[#opList].Name = "F2_2p"
opList[#opList + 1] = NewOperator("U",NF,Ind["2p_Up"],Ind["2p_Dn"],{0,1})
opList[#opList].Name = "Operator with a long name"




StartRestrictions = {NF,0}
StartRestrictions[3] = {DeterminantString(Ind["1s"],NF),2,2}
StartRestrictions[4] = {DeterminantString(Ind["2s"],NF),2,2}

Restrictions = {NF,0}
Restrictions[3] = {DeterminantString(Ind["2p"],NF),0,1}
-- print("StartRestrictions")
-- print(StartRestrictions)
-- print("Restrictions")
-- print(Restrictions)

NPsi = 15
psiEigenlist = Eigensystem(Hamil,StartRestrictions,NPsi)
psiEigenlistRestr = Eigensystem(Hamil,StartRestrictions,NPsi,{{"Restrictions",Restrictions}})
-- for i = 1, #psiEigenlist do
--     print(psiEigenlist[i]*Hamil*psiEigenlist[i])
-- end


print("\n\n\nPrintExpectationValues(psiList,opList):")
PrintExpectationValues(psiList,opList)
print("\n\n\nPrintExpectationValues(psiList[1],opList[1]):")
PrintExpectationValues(psiList[1],opList[1])
print("\n\n\nPrintExpectationValues(psiEigenlist,Hamil,opList):")
PrintExpectationValues(psiEigenlist,Hamil,opList)
print("\n\n\nPrintExpectationValues(psiEigenlist,Hamil,opList):")
PrintExpectationValues(psiEigenlist,Hamil,opList)
print("\n\n\nPrintExpectationValues(psiEigenlistRestr,opList,{{\"printHeaderEvery\",10},{\"zero\",1E-2}}):")
PrintExpectationValues(psiEigenlistRestr,opList,{{"printHeaderEvery",10},{"zero",1E-2}})
print("\n\n\nPrintExpectationValues(psiEigenlistRestr,Hamil,opList,{{\"printHeaderEvery\",10},{\"printSigma\",true},{\"zero\",1E-2}}):")
PrintExpectationValues(psiEigenlistRestr,Hamil,opList,{{"printHeaderEvery",10},{"printSigma",true},{"zero",1E-2}})
print("PrintExpectationValues(psiEigenlistRestr,Hamil,opList,{{\"colWidth\",10}}):")
PrintExpectationValues(psiEigenlistRestr,Hamil,opList,{{"colWidth",10}})
