NF = 4

OpList={}
OpList[#OpList+1] = Chop(NewOperator("Number",NF,{0},{0},{0}) + 17 + 5*I )
-- OpList[#OpList+1] = NewOperator("Number",NF,{1},{1},{0.1})
OpList[#OpList+1] = NewOperator("Number",NF,{1},{1},{0.1}) + 2
-- OpList[#OpList+1] = NewOperator("U",NF,{0},{1},{5})
-- OpList[#OpList+1] = NewOperator("U",NF,{0},{1},{5}) + 3
OpList[#OpList+1] = NewOperator("Number",NF,{1},{1},{0.1+I}) + NewOperator("U",NF,{0},{1},{5}) + 3
OpList[#OpList+1] = NewOperator("Number",NF,{1},{1},{0.00001 + I}) + NewOperator("Number",NF,{2},{2},{1}) + NewOperator("U",NF,{0},{1},{0},{1},{2},{3},{2},{3},{3}) + NewOperator("U",NF,{0},{1},{5})

IndList={}
IndList[#IndList+1] = {}
IndList[#IndList+1] = {0}
IndList[#IndList+1] = {1,2}
IndList[#IndList+1] = {0,2,4}
IndList[#IndList+1] = {0,9999}
IndList[#IndList+1] = {0, {1,2}}
IndList[#IndList+1] = {0,1,2,3}

modes = {"include", "exclude", "conserve"}

for key1,op in pairs(OpList) do
    for key2,inds in pairs(IndList) do
        for key3, mode in pairs(modes) do
            print("\n\n\n\n\n")
            local opTmp = Copy(op)
            print("Full Operator:")
            print(op)
            print("\nIndices:")
            print(inds)
            print("Mode: "..mode)
            print("\nPartialOperator")
            print( PartialOperator(op, inds, mode) )
            print("Test that the input has not changed (should be zero):")
            print( Chop(opTmp - op) )
        end
    end
end
