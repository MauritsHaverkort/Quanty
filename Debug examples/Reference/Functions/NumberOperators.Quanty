OrbList={}
OrbList[#OrbList+1] = {"1s"}
OrbList[#OrbList+1] = {"1s","2s","2p"}
OrbList[#OrbList+1] = {"13f","3a"}
OrbList[#OrbList+1] = {"Noodles","Mind the Gap","Barely Used","Stuff","Hug"}
OrbList[#OrbList+1] = {"1s","13g","Test"}
OrbList[#OrbList+1] = {"1s","2s","2p","3s","3p","3d","4s","4p","4d","4f","5s","5p","5d","5f","5g","6s","6p","6d","6f","6g","6h","7s","7p","7d","7f","7g","8s","8p","8d","8f","9s","9p","9d","10s","10p","11s"}


groupings = {}
groupings[#groupings+1] = {}
groupings[#groupings+1] = {{}}
groupings[#groupings+1] = {{"unexcited",{"1s","2s"}}}
groupings[#groupings+1] = {{"very special",{"1s_Dn","2s_Up"}}}
groupings[#groupings+1] = {{"2s",{"1s"}} , {"unexcited",{"1s","2p"}} , {"laser",{"2p","3s"}} }

for key1,orbs in pairs(OrbList) do
    print("\n\n\n")
    for key2,groups in pairs(groupings) do
        print("\n\n\n")
        print("Orbitals:")
        print(orbs)
        print("Options:")
        print(groups)
        Num = NumberOperators(orbs, groups)
        print("Num[ \"all\" ]:")
        print(Num["all"])
        print("Num[ \"All\" ]:")
        print(Num["All"])
        for key3,orb in pairs(orbs) do
            print("Num[ \""..orb.."\" ]:")
            print(Num[orb])
            print("Num[ \""..orb.."_Dn\" ]:")
            print(Num[orb.."_Dn"])
            print("Num[ \""..orb.."_Up\" ]:")
            print(Num[orb.."_Up"])
        end
        for key4,group in pairs(groups) do
            if  group[1] ~= nil then
                print("Num[ \""..group[1].."\" ]:")
                print(Num[group[1]])
            end
        end
    end
end


