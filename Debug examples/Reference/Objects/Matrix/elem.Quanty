errorCount = 0

function errorHappened()
    print("Oh no, something went wrong!")
    errorCount = errorCount + 1
end

function test1(iM)
    dimU = MU[iM].dim
    if dimU[1] ~= #M[iM] or dimU[2] ~= #M[iM][1] then
        errorHappened()
    end
end

function test2(iM,i,j)
    local it = i
    local jt = j
    if it < 0 then it = dim[1] + 1 + it end
    if jt < 0 then jt = dim[2] + 1 + jt end
    
    if MU[iM].elem(i,j) ~= M[iM][it][jt] then
        errorHappened()
    end
end
  
M = {}
M[#M + 1] = {{1,2,3},{4,5,6}}
M[#M + 1] = {{1,2,0.3},{4,-0.5,6},{I, 17*I, 23- 1.3*I}}

MU = {} 
for i=1,#M do
    MU[i] = Matrix.ToUserdata( M[i] )
    test1(i)
end

for iM = 1,#M do
    dim = MU[iM].dim
    for i = -dim[1],dim[1] do
        for j = -dim[2],dim[2] do
            if i ~= 0 and j ~= 0 then
                test2(iM,i,j)
            end
        end
    end
end

if errorCount == 0 then
    print("Everything went according to plan.")
end

os.exit(errorCount)
