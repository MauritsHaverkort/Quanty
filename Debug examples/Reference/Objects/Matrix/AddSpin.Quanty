errorCount = 0

Mats = {}
Mats[#Mats + 1] = Matrix.ToUserdata( {{1,2,3},{4,5,6},{7,8,9}} )
Mats[#Mats + 1] = Matrix.ToUserdata( {{1,2,3},{4,5,6}} )
Mats[#Mats + 1] = Matrix.ToUserdata( {{1,2,3*I},{4,5,6+I}} )

Res = {}
Res[#Res + 1] = Matrix.ToUserdata(  { { 1 , 0 , 2 , 0 , 3 , 0 } , 
  { 0 , 1 , 0 , 2 , 0 , 3 } , 
  { 4 , 0 , 5 , 0 , 6 , 0 } , 
  { 0 , 4 , 0 , 5 , 0 , 6 } , 
  { 7 , 0 , 8 , 0 , 9 , 0 } , 
  { 0 , 7 , 0 , 8 , 0 , 9 } } )
Res[#Res + 1] = Matrix.ToUserdata(  { { 1 , 0 , 2 , 0 , 3 , 0 } , 
  { 0 , 1 , 0 , 2 , 0 , 3 } , 
  { 4 , 0 , 5 , 0 , 6 , 0 } , 
  { 0 , 4 , 0 , 5 , 0 , 6 } } )
Res[#Res + 1] = Matrix.ToUserdata( { { 1 , 0 , 2 , 0 ,  3*I , 0 } , 
  { 0 , 1 , 0 , 2 , 0 , 3*I } , 
  { 4 , 0 , 5 , 0 , 6 + I , 0 } , 
  { 0 , 4 , 0 , 5 , 0 , 6 + I } } )



for key,mat in pairs(Mats) do
    local matSpin = Matrix.AddSpin(mat)
    print("\nMatrix:")
    print(mat)
    print("\nMatrix with added Spin:")
    print( matSpin )
    if matSpin ~= Res[key] then
        print("Something went wrong!")
        errorCount = errorCount + 1
    end
end

os.exit(errorCount)
