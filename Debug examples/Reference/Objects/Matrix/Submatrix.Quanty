errorCount = 0

MReal = {}
MComplex = {}
for i = 1,20 do
    MReal[i] = {}
    MComplex[i] = {}
    for j = 1,20 do
        MReal[i][j] = i + 12/j
        MComplex[i][j] = (i + 12/j)*I
    end
end

print("Real Matrix:")
print(MReal)
print("Complex Matrix:")
print(MComplex)

starts = {1, 5}
sizes = {1,3,10}
for key1,rowStart in pairs(starts) do
    for key2,rows in pairs(sizes) do
        for key3,colStart in pairs(starts) do
            for key4, cols in pairs(sizes) do
                print("\n\n\nRowStart = "..rowStart)
                print("RowStart + Rows - 1 = "..(rowStart + rows - 1))
                print("Rows = "..rows)
                print("ColStart = "..colStart)
                print("ColStart + Cols - 1 = "..(colStart + cols - 1))
                print("Cols = "..cols)
                
                print("Real submatrix (2 arguments):")
                print(Matrix.Sub(MReal, rows))
                print("Complex submatrix (2 arguments):")
                print(Matrix.Sub(MComplex, rows))
                
                print("Real submatrix (3 arguments):")
                print(Matrix.Sub(MReal, rows, cols))
                print("Complex submatrix (3 arguments):")
                print(Matrix.Sub(MComplex, rows, cols))
                
                print("Real submatrix (5 arguments):")
                print(Matrix.Sub(MReal, rowStart, rows, colStart, cols))
                print("Complex submatrix (5 arguments):")
                print(Matrix.Sub(MComplex, rowStart, rows, colStart, cols))
                
                print("Real submatrix (5 arguments, variant 2):")
                print(Matrix.Sub(MReal, {rowStart, rowStart + rows - 1}, {colStart, colStart + cols - 1}))
                print("Complex submatrix (5 arguments, variant 2):")
                print(Matrix.Sub(MComplex, {rowStart, rowStart + rows - 1}, {colStart, colStart + cols - 1}))
            end
        end
    end
end

M = Matrix.ToUserdata( {{11,12,13,14,15,16,17},
                        {21,22,23,24,25,26,27},
                        {31,32,33,34,35,36,37},
                        {41,42,43,44,45,46,47},
                        {51,52,53,54,55,56,57}} )

Msub = Matrix.ToUserdata( Matrix.Sub(M,3) )
result = Matrix.ToUserdata( { { 11 , 12 , 13 } , 
                            { 21 , 22 , 23 } , 
                            { 31 , 32 , 33 } } )
if Msub ~= result then
    print("Something went wrong!")
    errorCount = errorCount +1
end

Msub = Matrix.ToUserdata( Matrix.Sub(M,2,4) )
result = Matrix.ToUserdata( { { 11 , 12 , 13 , 14 } , 
                            { 21 , 22 , 23 , 24 } } )
if Msub ~= result then
    print("Something went wrong!")
    errorCount = errorCount +1
end
 
Msub = Matrix.ToUserdata( Matrix.Sub(M,1,2,3,4) )
result = Matrix.ToUserdata( { { 13 , 14 , 15 , 16 } , 
                            { 23 , 24 , 25 , 26 } } )
if Msub ~= result then
    print("Something went wrong!")
    errorCount = errorCount +1
end
 
Msub = Matrix.ToUserdata( Matrix.Sub(M,{1,2},{3,4}) )
result = Matrix.ToUserdata( { {  13    ,  14    } ,
                            {  23    ,  24    } } )
if Msub ~= result then
    print("Something went wrong!")
    errorCount = errorCount +1
end

os.exit(errorCount)
