ErrorCount=0

Nf=6
Nb=0

psi1  = NewWavefunction(Nf,Nb,{{"100010",sqrt(9/10)},{"110000",  sqrt(1/10)}})
psi2  = NewWavefunction(Nf,Nb,{{"100010",sqrt(9/10)},{"110000",I*sqrt(1/10)}})

if( (psi1.PrefactorDet(1)==sqrt(9/10)) == false )
then
  print("psi1.PrefactorDet(1)==sqrt(9/10) returned ",psi1.PrefactorDet(1)==sqrt(9/10))
  ErrorCount = ErrorCount + 1
end

if( (psi1.PrefactorDet(2)==sqrt(1/10)) == false )
then
  print("psi1.PrefactorDet(2)==sqrt(1/10) returned ",psi1.PrefactorDet(2)==sqrt(1/10))
  ErrorCount = ErrorCount + 1
end

if( (Chop(psi2.PrefactorDet(1))==sqrt(9/10)) == false )
then
  print("Chop(psi2.PrefactorDet(1))==sqrt(9/10) returned ",Chop(psi2.PrefactorDet(1))==sqrt(9/10))
  ErrorCount = ErrorCount + 1
end

if( (psi2.PrefactorDet(2)==I*sqrt(1/10)) == false )
then
  print("psi1.PrefactorDet(2)==sqrt(1/10) returned ",psi1.PrefactorDet(2)==sqrt(1/10))
  ErrorCount = ErrorCount + 1
end

os.exit(ErrorCount)

