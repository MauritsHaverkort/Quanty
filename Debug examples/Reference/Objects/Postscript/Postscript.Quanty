PS1 = PostScript.Open(200,150)

PS1 = PostScript.Text(PS1,"Hello World1",50,50)
PS1 = PostScript.Text(PS1,"Hello World2",50,100,15)
PS1 = PostScript.Text(PS1,"Hello World3",50,50,6,"r")


PS1 = PostScript.Line(PS1,{10,50,100,150},{1,2,3,4})
PS1 = PostScript.Line(PS1,{10,50,100,150},{10,20,30,40},{128,255,0})
PS1 = PostScript.Line(PS1,{10,50,100,150},{110,20,30,40},{128,0,128},3)


PS1 = PostScript.Polygon(PS1,{50,60,80,70},{100,0,0,150},{128,0,0},3)

function inttoBW(x)
  return 50*x, 0, 255-50*x
end

PS1 = PostScript.Bitmap(PS1, 10,10,20,30, {{1,2,3},{4,5,6},{0,0,5}}, inttoBW)


PS1 = PostScript.Close(PS1)

print(PS1)
