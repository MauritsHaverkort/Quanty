dofile("definitions.Quanty")

GOmega = Spectra.MultiplyByEnergy(G)

G.Print({{"file","Spectra.dat"}})
GOmega.Print({{"file","Spectra.MultiplyByEnergy.dat"}})

gnuplotScript = gnuplotHead .. [[
set output "Spectra.MultiplyByEnergy.ps"

plot "Spectra.dat"  using 1:(-$3  ) title 'T1' with lines ls  1,\
     "Spectra.MultiplyByEnergy.dat"  using 1:(-$3) title 'T1 * Energy' with lines ls  2
]]

file = io.open("Spectra.MultiplyByEnergy.gnuplot", "w")
file:write(gnuplotScript)
file:close()

os.execute("gnuplot Spectra.MultiplyByEnergy.gnuplot ; ps2pdf Spectra.MultiplyByEnergy.ps ; ps2eps Spectra.MultiplyByEnergy.ps ; mv Spectra.MultiplyByEnergy.eps temp.eps ; eps2eps temp.eps Spectra.MultiplyByEnergy.eps ; rm temp.eps")


