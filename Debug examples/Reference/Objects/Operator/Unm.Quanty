ErrorCount=0

Nf=6
Nb=0

O1 = NewOperator(Nf, Nb, {{1,-1,1}, {0,-0,2},{-1,1,3}})
O2 = NewOperator(Nf, Nb, {{1,-1,-1}, {0,-0,-2},{-1,1,-3}})
O3 = NewOperator(Nf, Nb, {{1,-1,2*I}, {0,-0,4*I},{-1,1,6*I}})
O4 = NewOperator(Nf, Nb, {{1,-1,-2*I}, {0,-0,-4*I},{-1,1,-6*I}})

if( (O1==-O2) == false )
then
  print("O1==-O2 returned ",O1==-O2)
  ErrorCount = ErrorCount + 1
end

if( (O3==-O4) == false )
then
  print("O3==-O4 returned ",O3==-O4)
  ErrorCount = ErrorCount + 1
end

os.exit(ErrorCount)


