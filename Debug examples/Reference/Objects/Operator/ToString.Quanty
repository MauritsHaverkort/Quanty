ErrorCount=0

Nf=6
Nb=0

O1 = NewOperator(Nf, Nb, {{1,-1,1}, {0,-0,2},{-1,1,3}})
O2 = NewOperator(Nf, Nb, {{1,-1,-2*I}, {0,-0,-4*I},{-1,1,-6*I}})

str1=[[

Operator: Operator
QComplex         =          0 (Real==0 or Complex==1 or Mixed==2)
MaxLength        =          2 (largest number of product of lader operators)
NFermionic modes =          6 (Number of fermionic modes (site, spin, orbital, ...) in the one particle basis)
NBosonic modes   =          0 (Number of bosonic modes (phonon modes, ...) in the one particle basis)

Operator of Length   0
QComplex      =          0 (Real==0 or Complex==1)
N             =          1 (number of operators of length   0)
|  3.00000000000000E+00

Operator of Length   2
QComplex      =          0 (Real==0 or Complex==1)
N             =          2 (number of operators of length   2)
C  1 A  1 | -2.00000000000000E+00
C  0 A  0 |  2.00000000000000E+00

]]

str2=[[

Operator: Operator
QComplex         =          1 (Real==0 or Complex==1 or Mixed==2)
MaxLength        =          2 (largest number of product of lader operators)
NFermionic modes =          6 (Number of fermionic modes (site, spin, orbital, ...) in the one particle basis)
NBosonic modes   =          0 (Number of bosonic modes (phonon modes, ...) in the one particle basis)

Operator of Length   0
QComplex      =          1 (Real==0 or Complex==1)
N             =          1 (number of operators of length   0)
| -0.00000000000000E+00 -6.00000000000000E+00

Operator of Length   2
QComplex      =          1 (Real==0 or Complex==1)
N             =          2 (number of operators of length   2)
C  1 A  1 |  0.00000000000000E+00  4.00000000000000E+00
C  0 A  0 | -0.00000000000000E+00 -4.00000000000000E+00

]]


if( (tostring(O1)==str1) == false )
then
  print("tostring(O1)==str1 returned ",tostring(O1)==str1)
  ErrorCount = ErrorCount + 1
end

if( (tostring(O2)==str2) == false )
then
  print("tostring(O2)==str2 returned ",tostring(O2)==str2)
  ErrorCount = ErrorCount + 1
end

os.exit(ErrorCount)


