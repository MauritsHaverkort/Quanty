ErrorCount=0

Nf=6
Nb=0

O1 = NewOperator(Nf, Nb, {{1,-1,1},{0,-0,0.1},{-2,2,0.01}})
O2 = NewOperator(Nf, Nb, {{1,-1,I},{0,-0,0.1},{-2,2,0.01*I}})

if( ((O1.N[0]==1) and (O1.N[1] ==0) and (O1.N[2]==3) ) == false )
then
  print("O1.N==3 returned ",O1.N==3)
  ErrorCount = ErrorCount + 1
end

if( ((O2.N[0]==1) and (O2.N[1] ==0) and (O2.N[2]==3) ) == false )
then
  print("O2.N==3 returned ",O2.N==3)
  ErrorCount = ErrorCount + 1
end

os.exit(ErrorCount)
