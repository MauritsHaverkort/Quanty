ErrorCount=0

Nf=6
Nb=0
OppSplus = NewOperator("Splus",Nf,{1,3,5},{0,2,4})


print("OppSplus.Restrictions =",OppSplus.Restrictions)

OppSplus.Restrictions={Nf,Nb,{"010101",0,1}}

print("OppSplus.Restrictions =",OppSplus.Restrictions)

psitest = NewWavefunction(Nf,Nb,{{"101010",1}})
psitest.Name = "|L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)
psitest = OppSplus*psitest
psitest.Name = "S+ |L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)
psitest = OppSplus*psitest
psitest.Name = "S+ S+ |L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)
psitest = OppSplus*psitest
psitest.Name = "S+ S+ S+ |L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)

OppSplus.Restrictions = nil

print("OppSplus.Restrictions =",OppSplus.Restrictions)

psitest = NewWavefunction(Nf,Nb,{{"101010",1}})
psitest.Name = "|L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)
psitest = OppSplus*psitest
psitest.Name = "S+ |L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)
psitest = OppSplus*psitest
psitest.Name = "S+ S+ |L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)
psitest = OppSplus*psitest
psitest.Name = "S+ S+ S+ |L=0 S=3/2 Lz=0 Sz/3/2>"
print(psitest)

os.exit(ErrorCount)
