  UTriDense  = ChangeType(UTri,"Dense")
  TTriDense  = ChangeType(TTri,"Dense")

  TriDense = Matrix.Flatten({{A1,                     B1,                      0},
                             {ConjugateTranspose(B1), A2,                     B2},
                             {0,                      ConjugateTranspose(B2), A3}})

  if( Chop(MTriDense-TriDense,zero) ~= 0*Matrix.Identity(9) )
  then
    print("MTriDense is wrong")
    ErrorCount = ErrorCount + 1
  end
  if( Chop(UTriDense-TriDense,zero) ~= 0*Matrix.Identity(9) )
  then
    print("UTriDense is wrong")
    ErrorCount = ErrorCount + 1
  end
  if( Chop(TTriDense-TriDense,zero) ~= 0*Matrix.Identity(9) )
  then
    print("TTriDense is wrong")
    ErrorCount = ErrorCount + 1
  end


  print("Anderson")

  MAndDense  = ChangeType(MAnd,"Dense")
  UAndDense  = ChangeType(UAnd,"Dense")
  TAndDense  = ChangeType(TAnd,"Dense")

  AndDense = Matrix.Flatten({{A1,                     B1,  B2},
                             {ConjugateTranspose(B1), A2,   0},
                             {ConjugateTranspose(B2),  0,  A3}})

