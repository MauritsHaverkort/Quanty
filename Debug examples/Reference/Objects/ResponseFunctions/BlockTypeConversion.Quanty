ErrorCount=0

function Check(resfun,type,zero)
  if ( ( Chop(resfun(1,1)-MathAll[type][1],zero) ~= O ) or ( Chop(resfun(2,2)-MathAll[type][2],zero) ~= O ) or ( Chop(resfun(4,1)-MathAll[type][3],zero) ~= O ) )
  then
    print("Evaluation did not get the right value difference is :")
    print("In point omega = 1 Gamma = 1")
    print(Chop(resfun(1,1)-MathAll[type][1],zero))
    print("In point omega = 2 Gamma = 2")
    print(Chop(resfun(2,2)-MathAll[type][2],zero))
    print("In point omega = 4 Gamma = 1")
    print(Chop(resfun(4,1)-MathAll[type][3],zero))
    ErrorCount = ErrorCount + 1
  end
end

function TestAll()
  print("============")
  print("List of poles")
  print("============")
  MListOfPoles = { {A0,a1,a2,a3}, {B1,B2,B3}, mu=0, type="ListOfPoles"}
  setmetatable(MListOfPoles, ResponseFunctionMeta)
  print("========= transform it to a userdata for speed        ==========")
  UListOfPoles = ToUserdata(MListOfPoles)
  print("========= transform it back to a table for convininence ==========")
  TListOfPoles = ToTable(UListOfPoles)

  print("============")
  print("Tri diagonal matrix")
  print("============")
  MTri         = { {A0,A1,A2,A3}, {B0,B1,B2}, mu=0, type="Tri"}
  setmetatable(MTri, ResponseFunctionMeta)
  print("========= transform it to a userdata for speed        ==========")
  UTri         = ToUserdata(MTri)
  print("========= transform it back to a table for convininence ==========")
  TTri         = ToTable(UTri)

  print("============")
  print("And erson matrix")
  print("============")
  MAnd         = { {A0,A1,A2,A3}, {B0,B1,B2}, mu=0, type="And"}
  setmetatable(MAnd, ResponseFunctionMeta)
  print("========= transform it to a userdata for speed        ==========")
  UAnd         = ToUserdata(MAnd)
  print("========= transform it back to a table for convininence ==========")
  TAnd         = ToTable(UAnd)

  print("============")
  print("Natural impurity matrix")
  print("============")
  MNat         = { {A0,B0}, val={ {A0,Am1,Am2,Am3}, {B0,B1,B2}, mu=0, type="Tri"}, con={ {A0,A1,A2,A3}, {B0,B1,B2}, mu=0, type="Tri"}, mu=0, type="Nat"}
  setmetatable(MNat, ResponseFunctionMeta)
  print("========= transform it to a userdata for speed        ==========")
  UNat         = ToUserdata(MNat)
  print("========= transform it back to a table for convininence ==========")
  TNat         = ToTable(UNat)

  print("");
  print("===========================")
  print("Transform to dense matrices")
  print("===========================")

  zero=1e-15


  print("List of poles")

  MLPDense = ChangeType(MListOfPoles,"Dense")
  ULPDense = ChangeType(UListOfPoles,"Dense")
  TLPDense = ChangeType(TListOfPoles,"Dense")

  -- THIS NEEDS TO BE CHANGED
  LPDense = MLPDense

  if( Chop(MLPDense-LPDense,zero) ~= 0*Matrix.Identity(9) )
  then
    print("MLPDense is wrong")
    ErrorCount = ErrorCount + 1
  end
  if( Chop(ULPDense-LPDense,zero) ~= 0*Matrix.Identity(9) )
  then
    print("ULPDense is wrong")
    ErrorCount = ErrorCount + 1
  end
