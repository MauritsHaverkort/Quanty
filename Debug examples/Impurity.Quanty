function TakeEverySecond(M)
  local Mret={}
  for i=1,#M,2 do
    Mret[#Mret+1]={}
    for j=1,#M,2 do
      Mret[(i+1)/2][(j+1)/2]=M[i][j]
    end
  end
  return Mret
end

Verbosity(0x0)

-- There is a difference between an odd number of bath sites, in which case the total system is a singlet and an even number of bath sites where the total cluster is a doublet
NSiteBath = 11
U = 2
OppU = NewOperator(2*(NSiteBath+1),0,{{0,-0,1,-1,U}})

HTB = NewTightBinding()
HTB.Name="1D chain"
HTB.Cell={{1,0,0},{0,1,0},{0,0,1}}
HTB.Atoms={{"Cu",{0,0,0},{{"d",{"x^2-y^2"}}}}}
HTB.Hopping={{"Cu.d","Cu.d",{ 1,0,0},{{1}}},
             {"Cu.d","Cu.d",{-1,0,0},{{1}}}}

print(HTB)

H=Chop(CreateClusterHamiltonian(HTB,{"periodic",{{NSiteBath+1,0,0},{0,1,0},{0,0,1}}},{{"AddSpin",true}})
  + NewOperator(2*(NSiteBath+1),0,{{0,-(2*NSiteBath),  -1},
                                   {1,-(2*NSiteBath+1),-1},
                                   {(2*NSiteBath),-0,  -1},
                                   {(2*NSiteBath+1),-1,-1}})
  + OppU)

print(H)

Rho={}
for i=1,2*(NSiteBath+1) do
  Rho[i]={}
  for j=1,2*(NSiteBath+1) do
    if i==j then
      Rho[i][j]=0.5
    else
      Rho[i][j]=0
    end
  end
end

print(Rho)

Teff=0.0000000001
RhoMF, En, OppMF = MeanFieldGroundState(H,Rho,Teff)

print(RhoMF)
print(En)
print(OppMF)

valRho, funRho = Eigensystem(RhoMF)

print("========")
print("========")
print(Chop(valRho))
print("======== funRho")
print(Chop(funRho))


RhoImp = Copy(RhoMF)
for i=3,2*(NSiteBath+1) do
  RhoImp[i][1]=0
  RhoImp[i][2]=0
  RhoImp[1][i]=0
  RhoImp[2][i]=0
end
RhoImp[1][1]=RhoImp[1][1]-1
RhoImp[2][2]=RhoImp[2][2]-1

print("========")
print("======== RhoMF")
print(Chop(RhoMF))
print("======== RhoImp")
print(RhoImp)

valRhoImp, funRhoImp = Eigensystem(RhoImp)
valRhoImp = Chop(valRhoImp)

print("========")
print("======== valRhoImp")
print(valRhoImp)
print("======== funRhoImp")
print(funRhoImp)

-- reorder funRhoImp and determine number of open shells
funRhoImpOrdered={}
ReorderIndex={}
NImp=0
NvalBath=0
NconBath=0
Rhomin = 0.1
Rhomax = 0.9
for i=1,2*(NSiteBath+1) do
  if valRhoImp[i] < -1E-16 then
    ReorderIndex[#ReorderIndex+1]=i
    funRhoImpOrdered[#funRhoImpOrdered+1]=Copy(funRhoImp[i])
    NImp = NImp + 1
  end
end
for i=1,2*(NSiteBath+1) do
  if (valRhoImp[i] >= Rhomin) and (valRhoImp[i] <= Rhomax) then
    ReorderIndex[#ReorderIndex+1]=i
    funRhoImpOrdered[#funRhoImpOrdered+1]=Copy(funRhoImp[i])
    NImp = NImp + 1
  end
end
for i=1,2*(NSiteBath+1) do
  if (valRhoImp[i] >= -1E-16) and (valRhoImp[i] < Rhomin) then
    ReorderIndex[#ReorderIndex+1]=i
    funRhoImpOrdered[#funRhoImpOrdered+1]=Copy(funRhoImp[i])
    NvalBath = NvalBath + 1
  end
end
for i=1,2*(NSiteBath+1) do
  if valRhoImp[i] >= Rhomax then
    ReorderIndex[#ReorderIndex+1]=i
    funRhoImpOrdered[#funRhoImpOrdered+1]=Copy(funRhoImp[i])
    NconBath = NconBath + 1
  end
end
print("======== funRhoImpOrdered")
print(NImp, NvalBath, NconBath)
print(ReorderIndex)
print(funRhoImpOrdered)



print("======== IdentityMatrix = funRhoImpOrdered . runRhoImpOrdered ^T")
print(Dot(funRhoImpOrdered,MatrixTranspose(funRhoImpOrdered)))

-- create matrix from mean-field operator
print("======== OppMFMat")
OppMFMat = OperatorToMatrix(OppMF);
print(OppMFMat)

-- rotate matrix to a basis where the density matrix is 0 and 1 for the bath and mixed for the extended impurity
print("======== OppMFMatRot")
OppMFMatRot = Dot(funRhoImpOrdered,Dot(OppMFMat,MatrixTranspose(funRhoImpOrdered)))
print(OppMFMatRot)

-- Block tri diagonalize the extended impurity with Block size of the original impurity
OppMFMatRotImp = {}
for i=1,NImp do
  OppMFMatRotImp[i]={}
  for j=1,NImp do
    OppMFMatRotImp[i][j]=OppMFMatRot[i][j]
  end
end
OppMFMatRotImpTri, TOppMFMatRotImpTri = BlockBandDiagonalize(OppMFMatRotImp,2)

TImp = {}
for i=1,2*(NSiteBath+1) do
  TImp[i]={}
  for j=1,2*(NSiteBath+1) do
    if i==j then
      TImp[i][j]=1
      else
      TImp[i][j]=0
    end
  end
end
for i=1,NImp do
  for j=1,NImp do
    TImp[i][j]=TOppMFMatRotImpTri[i][j]
  end
end
OppMFMatRotFull = Dot(TImp,Dot(OppMFMatRot,MatrixTranspose(TImp)))
print("========== OppMFMatRotFull")
print(OppMFMatRotFull)

-- Block tri diagonalize the valence bath orbitals with respect to the extended impurity
OppMFMatRotImpVal = {}
for i=1,NImp+NvalBath do
  OppMFMatRotImpVal[i]={}
  for j=1,NImp+NvalBath do
    OppMFMatRotImpVal[i][j]=OppMFMatRotFull[i][j]
  end
end
OppMFMatRotImpValTri, TOppMFMatRotImpValTri = BlockBandDiagonalize(OppMFMatRotImpVal,NImp)

print(TOppMFMatRotImpValTri)

TImpVal = {}
for i=1,2*(NSiteBath+1) do
  TImpVal[i]={}
  for j=1,2*(NSiteBath+1) do
    if i==j then
      TImpVal[i][j]=1
      else
      TImpVal[i][j]=0
    end
  end
end
for i=1,NImp+NvalBath do
  for j=1,NImp+NvalBath do
    print(i,j)
    TImpVal[i][j]=TOppMFMatRotImpValTri[i][j]
  end
end

-- Block tri diagonalize the conduction bath orbitals with respect to the extended impurity
OppMFMatRotImpCon = {}
for i=1,NImp+NconBath do
  ii = i
  if i>NImp then
    ii = i + NvalBath
  end
  OppMFMatRotImpCon[i]={}
  for j=1,NImp+NconBath do
    jj = j
    if j>NImp then
      jj = j + NvalBath
    end
    OppMFMatRotImpCon[i][j]=OppMFMatRotFull[ii][jj]
  end
end
OppMFMatRotImpConTri, TOppMFMatRotImpConTri = BlockBandDiagonalize(OppMFMatRotImpCon,NImp)

TImpCon = {}
for i=1,2*(NSiteBath+1) do
  TImpCon[i]={}
  for j=1,2*(NSiteBath+1) do
    if i==j then
      TImpCon[i][j]=1
      else
      TImpCon[i][j]=0
    end
  end
end
for i=1,NImp+NconBath do
  ii = i
  if i>NImp then
    ii = i + NvalBath
  end
  for j=1,NImp+NconBath do
    jj = j
    if j>NImp then
      jj = j + NvalBath
    end
    TImpCon[ii][jj]=TOppMFMatRotImpConTri[i][j]
  end
end

print(TImp)
print(TImpVal)
print(TImpCon)
print(Dot(TImp,Dot(TImpVal,TImpCon)))


Ttot = Chop(Dot(Dot(Dot(TImp,TImpVal),TImpCon),funRhoImpOrdered))
print("=======Ttot")
print(Ttot)
print("=======Ttot.Ttot^T")
print(Dot(Ttot,MatrixTranspose(Ttot)))
print("=======Ttot.OppMFMat.Ttot^T")
print(Dot(Ttot,Dot(OppMFMat,MatrixTranspose(Ttot))))
print("=======Ttot.RhoMF.Ttot^T")
print(Dot(Ttot,Dot(RhoMF,MatrixTranspose(Ttot))))

print("\n\n\n\n\n")

print("=======Ttot")
print(Ttot)
print("=======Ttot.Ttot^T")
print(Chop(Dot(Ttot,MatrixTranspose(Ttot))))
print("=======Ttot.OppMFMat.Ttot^T")
print(Chop(Dot(Ttot,Dot(OppMFMat,MatrixTranspose(Ttot)))))
print("=======Ttot.RhoMF.Ttot^T")
print(Chop(Dot(Ttot,Dot(RhoMF,MatrixTranspose(Ttot)))))


print("\n\n\n\n\n")

HNatImpOrb = Chop(Rotate(H,Ttot))

print(HNatImpOrb)





OrbitalStringVal = ""
OrbitalStringCon = ""
OrbitalStringImp = ""
for i=1,NImp do
  OrbitalStringVal = OrbitalStringVal.."0"
  OrbitalStringCon = OrbitalStringCon.."0"
  OrbitalStringImp = OrbitalStringImp.."1"
end
for i=1,NconBath do
  OrbitalStringVal = OrbitalStringVal.."0"
  OrbitalStringCon = OrbitalStringCon.."1"
  OrbitalStringImp = OrbitalStringImp.."0"
end
for i=1,NvalBath do
  OrbitalStringVal = OrbitalStringVal.."1"
  OrbitalStringCon = OrbitalStringCon.."0"
  OrbitalStringImp = OrbitalStringImp.."0"
end

NoBathHoles  = {2*(NSiteBath+1),0,{OrbitalStringVal,NvalBath,NvalBath},{OrbitalStringCon,0,0},{OrbitalStringImp,NImp/2,NImp/2}}
OneBathHole  = {2*(NSiteBath+1),0,{OrbitalStringVal,NvalBath-1,NvalBath},{OrbitalStringCon,0,1}}
TwoBathHoles = {2*(NSiteBath+1),0,{OrbitalStringVal,NvalBath-2,NvalBath},{OrbitalStringCon,0,2}}
ThreeBathHoles = {2*(NSiteBath+1),0,{OrbitalStringVal,NvalBath-3,NvalBath},{OrbitalStringCon,0,3}}
FourBathHoles = {2*(NSiteBath+1),0,{OrbitalStringVal,NvalBath-4,NvalBath},{OrbitalStringCon,0,4}}

print(NoBathHoles)
print(OneBathHole)
print(TwoBathHoles)
print(FourBathHoles)


print("Restricted to no Bath fluctuations")
psi = Eigensystem(HNatImpOrb, NoBathHoles, 1,{{"Restrictions",NoBathHoles}})
print("Energy = ",psi*HNatImpOrb*psi," Number of determinants ",psi.N)
rho0 = DensityMatrix(psi)

print("Restricted to one Bath fluctuations")
psi = Eigensystem(HNatImpOrb, NoBathHoles, 1,{{"Restrictions",OneBathHole}})
print("Energy = ",psi*HNatImpOrb*psi," Number of determinants ",psi.N)
rho1 = DensityMatrix(psi)

print("Restricted to two Bath fluctuations")
psi = Eigensystem(HNatImpOrb, NoBathHoles, 1,{{"Restrictions",TwoBathHoles}})
print("Energy = ",psi*HNatImpOrb*psi," Number of determinants ",psi.N)
rho2 = DensityMatrix(psi)

print("Restricted to two Four fluctuations")
psi = Eigensystem(HNatImpOrb, NoBathHoles, 1,{{"Restrictions",FourBathHoles}})
print("Energy = ",psi*HNatImpOrb*psi," Number of determinants ",psi.N)

print("No restrictions")
psi = Eigensystem(HNatImpOrb, NoBathHoles, 1)
print("Energy = ",psi*HNatImpOrb*psi," Number of determinants ",psi.N)
rhoAll = DensityMatrix(psi)

print("No restrictions high accuracy")
psi = Eigensystem(HNatImpOrb, NoBathHoles, 1,{{"zero",1E-14},{"epsilon",1E-15}})
print("Energy = ",psi*HNatImpOrb*psi," Number of determinants ",psi.N)
rhoAllHighRes = DensityMatrix(psi)

print(TakeEverySecond(rho0))
print(TakeEverySecond(rho1))
print(TakeEverySecond(rho2))
print(TakeEverySecond(rhoAll))
print(TakeEverySecond(rhoAllHighRes))




