-- input parameters
Ecore = -10
Eval  = 0
Ebathmin = -2
Ebathmax = 8
Nbath = 201
ttot = 1

-- derived parameters
ti = ttot / sqrt(Nbath)
NF = 2+Nbath

-- definition of operators
Hloc = NewOperator(NF,0,{{0,-0,Ecore},{1,-1,Eval}})
Hbath=0
for i=1,Nbath do
  Hbath = Hbath + NewOperator(NF,0,{{1,-(i+1),ti}, {(i+1),-1,ti}, {(i+1),-(i+1), Ebathmin + (Ebathmax - Ebathmin) * (i-1) / (Nbath-1)}})
end
HT = NewOperator(NF,0,{{0,-1,1},{1,-0,1}})
Ncore = NewOperator(NF,0,{{0,-0,1}})
Nimp  = NewOperator(NF,0,{{1,-1,1}})


-- creation of groundstate
str="10"
for i=1,Nbath do
  str = str.."0"
end
psi0 = NewWavefunction(NF,0,{{str,1}})

-- creation of spectra in frequency domain

Gloc = CreateSpectra(Hloc,       HT, psi0, {{"Emin",0},{"Emax",20},{"NE",2000},{"Gamma",0.1}})
Gcon = CreateSpectra(Hloc+Hbath, HT, psi0, {{"Emin",0},{"Emax",20},{"NE",2000},{"Gamma",0.1}})

Gloc.Print({{"file","Gloc.dat"}})
Gcon.Print({{"file","Gcon.dat"}})

gnuplotInput = [[
set autoscale
set xtic auto
set ytic auto
set style line  1 lt 1 lw 1 lc rgb "#000000"
set style line  2 lt 1 lw 1 lc rgb "#FF0000"

set xlabel "E (eV)" font "Times,12"
set ylabel "Intensity (arb. units)" font "Times,12"

set out 'Gimp.ps'
set size 1.0, 1.0
set terminal postscript portrait enhanced color  "Times" 12


plot "Gloc.dat"  u 1:(-$3 ) title 'Gloc' with lines ls  1,\
     "Gcon.dat"  u 1:(-$3 ) title 'Gcon' with lines ls  2

]]

file = io.open("Gimp.gnuplot", "w")
file:write(gnuplotInput)
file:close()

-- and finally call gnuplot to execute the script
os.execute("gnuplot Gimp.gnuplot")
os.execute(" ps2pdf Gimp.ps ")


-----------------------------------------------------------------------------------------------------------------
--------------------------------------        time evolution         --------------------------------------------
-----------------------------------------------------------------------------------------------------------------

-- input parameters
w = 10
tmax = 20
dt = 0.05
E0 = 1
-- E = E0 sin(w t)
-- H = Hloc + E HT (+Hbath)


psit = Copy(psi0)
Gtloc = {}
for t=0,tmax,dt do
  Hdt = dt * (Hloc + E0 * sin(w*t) * HT)
  psit = (psit + Hdt*
                     (-I*psit + Hdt*
                                    (-(psit/2) + Hdt*
                                                    (psit*I/6 + Hdt*
                                                                    (psit/24 + Hdt*
                                                                                   (-(psit*I/120) + Hdt*
                                                                                                        (-(psit/720) + Hdt*
                                                                                                                           (psit*I/5040 + Hdt*
                                                                                                                                              (psit/40320 + Hdt*
                                                                                                                                                                (-(psit*I/362880) - Hdt*psit/3628800))))))))))
  Gtloc[#Gtloc+1] = {E0 * sin(w*t), psit * psit, psit * Ncore * psit, psit * Nimp * psit}
end


psit = Copy(psi0)
Gtcon = {}
for t=0,tmax,dt do
  print(t)
  Hdt = dt * (Hloc + Hbath + E0 * sin(w*t) * HT)
  psit = (psit + Hdt*
          (-I*psit + Hdt*
           (-(psit/2) + Hdt*
            (psit*I/6 + Hdt*
             (psit/24 + Hdt*
              (-(psit*I/120) + Hdt*
               (-(psit/720) + Hdt*
                (psit*I/5040 + Hdt*
                 (psit/40320 + Hdt*
                  (-(psit*I/362880) - Hdt*psit/3628800))))))))))
  Gtcon[#Gtcon+1] = {E0 * sin(w*t), psit * psit, psit * Ncore * psit, psit * Nimp * psit}
end


file = assert(io.open("Gt.dat", "w"))
i=1
for t=0,tmax,dt do
  file:write(string.format("%12.6E %12.6E %12.6E %12.6E %12.6E %12.6E %12.6E %12.6E\n",t, Gtloc[i][1], Gtloc[i][2], Gtloc[i][3], Gtloc[i][4], Gtcon[i][2], Gtcon[i][3], Gtcon[i][4]))
  i=i+1
end
file:close()

gnuplotInput = [[
set autoscale
set xtic auto
set ytic auto
set style line  1 lt 1 lw 1 lc rgb "#000000"
set style line  2 lt 1 lw 1 lc rgb "#FF0000"


set out 'Gtimp.ps'
set size 1.0, 1.0
set terminal postscript portrait enhanced color  "Times" 12


set xlabel "t (eV^-1)" font "Times,12"
set ylabel "E" font "Times,12"
plot "Gt.dat"  u 1:2 title 'Efield' with lines ls  1


set xlabel "t (eV^-1)" font "Times,12"
set ylabel "norm of total wave function" font "Times,12"
plot "Gt.dat"  u 1:3 title 'norm psi loc' with lines ls  1,\
      "Gt.dat"  u 1:6 title 'norm psi con' with lines ls  2

set xlabel "t (eV^-1)" font "Times,12"
set ylabel "occupation" font "Times,12"
plot "Gt.dat"  u 1:($4+$5) title 'inpurity occupation' with lines ls  1,\
     "Gt.dat"  u 1:($7+$8) title 'inpurity occupation' with lines ls  2


set xlabel "t (eV^-1)" font "Times,12"
set ylabel "occupation" font "Times,12"
plot "Gt.dat"  u 1:4 title 'inpurity core occupation' with lines ls  1,\
     "Gt.dat"  u 1:7 title 'inpurity core occupation' with lines ls  2


set xlabel "t (eV^-1)" font "Times,12"
set ylabel "occupation" font "Times,12"
plot "Gt.dat"  u 1:5 title 'inpurity valence occupation' with lines ls  1,\
     "Gt.dat"  u 1:8 title 'inpurity valence occupation' with lines ls  2
]]

file = io.open("Gtimp.gnuplot", "w")
file:write(gnuplotInput)
file:close()

-- and finally call gnuplot to execute the script
os.execute("gnuplot Gtimp.gnuplot")
os.execute(" ps2pdf Gtimp.ps ")
