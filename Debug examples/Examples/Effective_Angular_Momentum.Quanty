-- covalent d1
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------

NF = 20
NB = 0
indexdn_d = {0,2,4,6,8}
indexup_d = {1,3,5,7,9}
indexdn_L = {10,12,14,16,18}
indexup_L = {11,13,15,17,19}

-- operators acting on the d shell
Akm = PotentialExpandedOnClm("Oh",2,{0.6,-0.4});
OppCFd      = NewOperator("CF",    NF, indexup_d, indexdn_d, Akm)
Akm = PotentialExpandedOnClm("Oh",2,{1,0});
OppNegd     = NewOperator("CF",    NF, indexup_d, indexdn_d, Akm);
Akm = PotentialExpandedOnClm("Oh",2,{0,1});
OppNt2gd    = NewOperator("CF",    NF, indexup_d, indexdn_d, Akm);
Oppldotsd   = NewOperator("ldots", NF, indexup_d, indexdn_d)
OppLxd      = NewOperator("Lx",    NF,indexup_d,indexdn_d)
OppLyd      = NewOperator("Ly",    NF,indexup_d,indexdn_d)
OppLzd      = NewOperator("Lz",    NF,indexup_d,indexdn_d)
OppLsqrd    = NewOperator("Lsqr",  NF,indexup_d,indexdn_d)
OppSxd      = NewOperator("Sx",    NF,indexup_d,indexdn_d)
OppSyd      = NewOperator("Sy",    NF,indexup_d,indexdn_d)
OppSzd      = NewOperator("Sz",    NF,indexup_d,indexdn_d)
OppSsqrd    = NewOperator("Ssqr",  NF,indexup_d,indexdn_d)
OppJxd      = NewOperator("Jx",    NF,indexup_d,indexdn_d)
OppJyd      = NewOperator("Jy",    NF,indexup_d,indexdn_d)
OppJzd      = NewOperator("Jz",    NF,indexup_d,indexdn_d)
OppJsqrd    = NewOperator("Jsqr",  NF,indexup_d,indexdn_d)
OppLeffd    = EffectiveOrbitalAngularMomentum(NF,indexup_d,indexdn_d)
OppLeffSqrd = OppLeffd[1] * OppLeffd[1] + OppLeffd[2] * OppLeffd[2] + OppLeffd[3] * OppLeffd[3]
OppJeffd    = {OppLeffd[1] + OppSxd, OppLeffd[2] + OppSyd, OppLeffd[3] + OppSzd}

-- operators acting on the ligand shell
Akm = PotentialExpandedOnClm("Oh",2,{0.6,-0.4});
OppCFL      = NewOperator("CF",    NF, indexup_L, indexdn_L, Akm)
Akm = PotentialExpandedOnClm("Oh",2,{1,0});
OppNegL     = NewOperator("CF",    NF, indexup_L, indexdn_L, Akm);
Akm = PotentialExpandedOnClm("Oh",2,{0,1});
OppNt2gL    = NewOperator("CF",    NF, indexup_L, indexdn_L, Akm);
OppldotsL   = NewOperator("ldots", NF, indexup_L, indexdn_L)
OppLxL      = NewOperator("Lx",    NF,indexup_L,indexdn_L)
OppLyL      = NewOperator("Ly",    NF,indexup_L,indexdn_L)
OppLzL      = NewOperator("Lz",    NF,indexup_L,indexdn_L)
OppLsqrL    = NewOperator("Lsqr",  NF,indexup_L,indexdn_L)
OppSxL      = NewOperator("Sx",    NF,indexup_L,indexdn_L)
OppSyL      = NewOperator("Sy",    NF,indexup_L,indexdn_L)
OppSzL      = NewOperator("Sz",    NF,indexup_L,indexdn_L)
OppSsqrL    = NewOperator("Ssqr",  NF,indexup_L,indexdn_L)
OppJxL      = NewOperator("Jx",    NF,indexup_L,indexdn_L)
OppJyL      = NewOperator("Jy",    NF,indexup_L,indexdn_L)
OppJzL      = NewOperator("Jz",    NF,indexup_L,indexdn_L)
OppJsqrL    = NewOperator("Jsqr",  NF,indexup_L,indexdn_L)
OppLeffL    = EffectiveOrbitalAngularMomentum(NF,indexup_L,indexdn_L)
OppLeffSqrL = OppLeffL[1] * OppLeffL[1] + OppLeffL[2] * OppLeffL[2] + OppLeffL[3] * OppLeffL[3]
OppJeffL    = {OppLeffL[1] + OppSxL, OppLeffL[2] + OppSyL, OppLeffL[3] + OppSzL}

-- Nubmer operators

OppNUp_3d = NewOperator("Number", NF, indexup_d,indexup_d,{1,1,1,1,1})
OppNDn_3d = NewOperator("Number", NF, indexdn_d,indexdn_d,{1,1,1,1,1})
OppN_3d = OppNUp_3d + OppNDn_3d
OppNUp_Ld = NewOperator("Number", NF, indexup_L,indexup_L,{1,1,1,1,1})
OppNDn_Ld = NewOperator("Number", NF, indexdn_L,indexdn_L,{1,1,1,1,1})
OppN_Ld = OppNUp_Ld + OppNDn_Ld

-- Operators acting on the total cluster
OppLx = OppLxd + OppLxL
OppLy = OppLyd + OppLyL
OppLz = OppLzd + OppLzL
OppLsqr = OppLx * OppLx + OppLy * OppLy + OppLz * OppLz
OppSx = OppSxd + OppSxL
OppSy = OppSyd + OppSyL
OppSz = OppSzd + OppSzL
OppSsqr = OppSx * OppSx + OppSy * OppSy + OppSz * OppSz
OppJx = OppJxd + OppJxL
OppJy = OppJyd + OppJyL
OppJz = OppJzd + OppJzL
OppJsqr = OppJx * OppJx + OppJy * OppJy + OppJz * OppJz
OppLeff = {OppLeffd[1] + OppLeffL[1], OppLeffd[2] + OppLeffL[2], OppLeffd[3] + OppLeffL[3] }
OppJeff = {OppJeffd[1] + OppJeffL[1], OppJeffd[2] + OppJeffL[2], OppJeffd[3] + OppJeffL[3] }
OppLeffSqr = OppLeff[1] * OppLeff[1] + OppLeff[2] * OppLeff[2] + OppLeff[3] * OppLeff[3]
OppJeffSqr = OppJeff[1] * OppJeff[1] + OppJeff[2] * OppJeff[2] + OppJeff[3] * OppJeff[3]

-- hopping
Akm = PotentialExpandedOnClm("Oh", 2, {1,0})
OppVeg  = NewOperator("CF", NF, indexup_d,indexdn_d, indexup_L,indexdn_L,Akm) +  NewOperator("CF", NF, indexup_L,indexdn_L, indexup_d,indexdn_d,Akm)
Akm = PotentialExpandedOnClm("Oh", 2, {0,1})
OppVt2g = NewOperator("CF", NF, indexup_d,indexdn_d, indexup_L,indexdn_L,Akm) +  NewOperator("CF", NF, indexup_L,indexdn_L, indexup_d,indexdn_d,Akm)


Hamiltonian = 0.5 * OppCFd + 1.0 * OppVt2g + 3.0 * OppVeg - 3.0 * OppN_Ld + 0.1*Oppldots + 0.0000001 * OppJz

StartRestrictions = {NF, NB, {"1111111111 1111111111",1,1}};
Npsi = 20;
psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi);

-- In order to get some information on these eigenstates it is good to plot expectation values
-- We first define a list of all the operators we would like to calculate the expectation value of
oppList={Hamiltonian, OppSsqr, OppLsqr, OppJsqr, Oppldots, OppNegd, OppNt2gd, OppNegL, OppNt2gL, OppLeffSqr, OppJeffSqr, OppLz, OppSz, OppJz, OppJeff[3]};

-- next we loop over all operators and all states and print the expectation value
print(" <E>    <S^2>  <L^2>  <J^2>  <l.s>  <Negd> <Nt2gd><NegL> <Nt2gL><~L^2> <~J^2> <Lz>   <Sz>   <Jz>   <~Jz>");
for i = 1,#psiList do
  for j = 1,#oppList do
    expectationvalue = Chop(psiList[i]*oppList[j]*psiList[i])
    io.write(string.format("%6.3f ",expectationvalue))
  end
  io.write("\n")
end

-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-- covalent with coulomb
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------


OppF0 =NewOperator("U", NF, indexup_d, indexdn_d, {1,0,0})
OppF2 =NewOperator("U", NF, indexup_d, indexdn_d, {0,1,0})
OppF4 =NewOperator("U", NF, indexup_d, indexdn_d, {0,0,1})

nd = 5

U       =  3
Delta   =  3
F2dd = 5.0;
F4dd = 2.0;

ed      = (10*Delta-nd*(19+nd)*U/2)/(10+nd)
eL      = nd*((1+nd)*U/2-Delta)/(10+nd)
F0dd    = U+(F2dd+F4dd)*2/63

Hamiltonian =  F0dd*OppF0 + F2dd*OppF2 + F4dd*OppF4 + ed * OppN_3d + eL * OppN_Ld +
               0.5 * OppCFd + 1.0 * OppVt2g + 3.0 * OppVeg + 0.1*Oppldots + 0.0000001 * OppJz

StartRestrictions = {NF, NB, {"1111111111 0000000000",nd,nd}, {"0000000000 1111111111",10,10}}
Npsi = 7;
psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi);

-- In order to get some information on these eigenstates it is good to plot expectation values
-- We first define a list of all the operators we would like to calculate the expectation value of
oppList={Hamiltonian, OppSsqr, OppLsqr, OppJsqr, Oppldots, OppNegd, OppNt2gd, OppNegL, OppNt2gL, OppLeffSqr, OppJeffSqr, OppLz, OppSz, OppJz, OppJeff[3]};

-- next we loop over all operators and all states and print the expectation value
print(" <E>    <S^2>  <L^2>  <J^2>  <l.s>  <Negd> <Nt2gd><NegL> <Nt2gL><~L^2> <~J^2> <Lz>   <Sz>   <Jz>   <~Jz>");
for i = 1,#psiList do
  for j = 1,#oppList do
    expectationvalue = Chop(psiList[i]*oppList[j]*psiList[i])
    io.write(string.format("%6.3f ",expectationvalue))
  end
  io.write("\n")
end
