Verbosity(0xFF)

-- This input file calculates the effective angular momentumn (L_eff and J_eff) of an open t_{2g} shell
-- We do this for 4 examples
--  (1) ionic d1
--  (2) ionic d5 (with Coulomb interaction)
--  (3) covalent d1
--  (4) covalent d5 L10
-- - As spin-orbit coupling allows for excitations between the t2g and eg shell, one finds that the effective angular momentum
-- of the t2g shell orbitals only becomes exactly 1 when 10Dq >> spin-orbit coupling
-- - As the effective angular momentum does not commute with Coulomb repulsion, one finds that for the cases with more then one
-- electron there is a deviation from the expected expectation value of L_eff = 1 for an open t_{2g} shell.
-- - As covalence mixes the d and L orbitals one needs to calculate the operators of the total cluster to find good quantum numbers


-- Define a function that creates the operator L_{eff} action on IndexUp and IndexDn
function EffectiveOrbitalAngularMomentum(NF, IndexUp, IndexDn)
  
  local rotmatKd   = {}
  local rotmatKt2g = {}
  for i=1,NF do
    rotmatKd[i]   = {}
    rotmatKt2g[i] = {}
    for j=1,NF do
      rotmatKd[i][j]   = 0
      rotmatKt2g[i][j] = 0
    end
  end
  local t = sqrt(1/2)
  local u = I*sqrt(1/2)
  
  rotmatKd[1+IndexUp[1]][1+IndexUp[1]] = t
  rotmatKd[1+IndexUp[1]][1+IndexUp[5]] = t
  rotmatKd[1+IndexUp[2]][1+IndexUp[3]] = 1
  rotmatKd[1+IndexUp[3]][1+IndexUp[2]] = u
  rotmatKd[1+IndexUp[3]][1+IndexUp[4]] = u
  rotmatKd[1+IndexUp[4]][1+IndexUp[2]] = t
  rotmatKd[1+IndexUp[4]][1+IndexUp[4]] =-t
  rotmatKd[1+IndexUp[5]][1+IndexUp[1]] = u
  rotmatKd[1+IndexUp[5]][1+IndexUp[5]] =-u
  
  rotmatKd[1+IndexDn[1]][1+IndexDn[1]] = t
  rotmatKd[1+IndexDn[1]][1+IndexDn[5]] = t
  rotmatKd[1+IndexDn[2]][1+IndexDn[3]] = 1
  rotmatKd[1+IndexDn[3]][1+IndexDn[2]] = u
  rotmatKd[1+IndexDn[3]][1+IndexDn[4]] = u
  rotmatKd[1+IndexDn[4]][1+IndexDn[2]] = t
  rotmatKd[1+IndexDn[4]][1+IndexDn[4]] =-t
  rotmatKd[1+IndexDn[5]][1+IndexDn[1]] = u
  rotmatKd[1+IndexDn[5]][1+IndexDn[5]] =-u
  
  rotmatKt2g[1+IndexUp[3]][1+IndexUp[2]] = u
  rotmatKt2g[1+IndexUp[3]][1+IndexUp[4]] = u
  rotmatKt2g[1+IndexUp[4]][1+IndexUp[2]] = t
  rotmatKt2g[1+IndexUp[4]][1+IndexUp[4]] =-t
  rotmatKt2g[1+IndexUp[5]][1+IndexUp[1]] = u
  rotmatKt2g[1+IndexUp[5]][1+IndexUp[5]] =-u
  
  rotmatKt2g[1+IndexDn[3]][1+IndexDn[2]] = u
  rotmatKt2g[1+IndexDn[3]][1+IndexDn[4]] = u
  rotmatKt2g[1+IndexDn[4]][1+IndexDn[2]] = t
  rotmatKt2g[1+IndexDn[4]][1+IndexDn[4]] =-t
  rotmatKt2g[1+IndexDn[5]][1+IndexDn[1]] = u
  rotmatKt2g[1+IndexDn[5]][1+IndexDn[5]] =-u
  
  return {-Chop(Rotate(Chop(Rotate(NewOperator("Lx",   NF, IndexUp, IndexDn),rotmatKt2g)),ConjugateTranspose(rotmatKd))),
          -Chop(Rotate(Chop(Rotate(NewOperator("Ly",   NF, IndexUp, IndexDn),rotmatKt2g)),ConjugateTranspose(rotmatKd))),
          -Chop(Rotate(Chop(Rotate(NewOperator("Lz",   NF, IndexUp, IndexDn),rotmatKt2g)),ConjugateTranspose(rotmatKd))) }
  
end


-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-- ionic d1
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------

-- define orbital basis
NF = 10
NB = 0
indexdn = {0,2,4,6,8}
indexup = {1,3,5,7,9}

-- define operators acting on the d-shell
Akm = PotentialExpandedOnClm("Oh",2,{0.6,-0.4});
OppCF      = NewOperator("CF",    NF, indexup, indexdn, Akm)
Akm = PotentialExpandedOnClm("Oh",2,{1,0});
OppNeg     = NewOperator("CF",    NF, indexup, indexdn, Akm);
Akm = PotentialExpandedOnClm("Oh",2,{0,1});
OppNt2g    = NewOperator("CF",    NF, indexup, indexdn, Akm);
Oppldots   = NewOperator("ldots", NF, indexup, indexdn)
OppLx      = NewOperator("Lx",    NF,indexup,indexdn)
OppLy      = NewOperator("Ly",    NF,indexup,indexdn)
OppLz      = NewOperator("Lz",    NF,indexup,indexdn)
OppLsqr    = NewOperator("Lsqr",  NF,indexup,indexdn)
OppSx      = NewOperator("Sx",    NF,indexup,indexdn)
OppSy      = NewOperator("Sy",    NF,indexup,indexdn)
OppSz      = NewOperator("Sz",    NF,indexup,indexdn)
OppSsqr    = NewOperator("Ssqr",  NF,indexup,indexdn)
OppJx      = NewOperator("Jx",    NF,indexup,indexdn)
OppJy      = NewOperator("Jy",    NF,indexup,indexdn)
OppJz      = NewOperator("Jz",    NF,indexup,indexdn)
OppJsqr    = NewOperator("Jsqr",  NF,indexup,indexdn)
OppLeff    = EffectiveOrbitalAngularMomentum(NF,indexup,indexdn)
OppLeffSqr = OppLeff[1] * OppLeff[1] + OppLeff[2] * OppLeff[2] + OppLeff[3] * OppLeff[3]
OppJeff    = {OppLeff[1] + OppSx, OppLeff[2] + OppSy, OppLeff[3] + OppSz}
OppJeffSqr = OppJeff[1] * OppJeff[1] + OppJeff[2] * OppJeff[2] + OppJeff[3] * OppJeff[3]

-- test the commutation relations between the effective angular momentum operators [Lx,Ly] = i Lz 
-- or [Lx,Ly]/i - Lz = 0
print("Test commutation relations")
print(Chop((OppLeff[2]*OppLeff[3]-OppLeff[3]*OppLeff[2])/I-OppLeff[1]))
print(Chop((OppLeff[3]*OppLeff[1]-OppLeff[1]*OppLeff[3])/I-OppLeff[2]))
print(Chop((OppLeff[1]*OppLeff[2]-OppLeff[2]*OppLeff[1])/I-OppLeff[3]))

-- create the Hamiltonian
-- We work here in units of 10Dq
-- We shift the Hamiltonian by 0.4 to make the energy of the t2g orbitals 0, of the eg orbitals 1
-- We add spin-orbit coupling to get the effective angular momentum in the t2g shell
-- one can test that if the spin-orbit coupling becomes to large the mixing between t2g and eg becomes important
-- We add as small "field" in the z direction in order to allign the moments
-- one can change OppJz by OppJx or OppJy to see how things work out in different directions. 
-- also works for combinations of these operators, althought the magnetic point-group in that case is lower
Hamiltonian = OppCF + 0.4 + 0.01*Oppldots + 0.0000000001 * OppJz

-- calculate all 10 eigen-states with one electron
StartRestrictions = {NF, NB, {"1111111111",1,1}};
Npsi = 10;
psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi);

-- In order to get some information on these eigenstates it is good to plot expectation values
-- We first define a list of all the operators we would like to calculate the expectation value of
oppList={Hamiltonian, OppSsqr, OppLsqr, OppJsqr, Oppldots, OppNeg, OppNt2g, OppLeffSqr, OppJeffSqr, OppLx, OppSx, OppJx, OppJeff[1], OppLy, OppSy, OppJy, OppJeff[2], OppLz, OppSz, OppJz, OppJeff[3]};

-- next we loop over all operators and all states and print the expectation value
print(" <E>    <S^2>  <L^2>  <J^2>  <l.s>  <Neg>  <Nt2g> <~L^2> <~J^2> <Lx>   <Sx>   <Jx>   <~Jx>  <Ly>   <Sy>   <Jy>   <~Jy>  <Lz>   <Sz>   <Jz>   <~Jz>");
for i = 1,#psiList do
  for j = 1,#oppList do
    expectationvalue = Chop(psiList[i]*oppList[j]*psiList[i])
    io.write(string.format("%6.3f ",expectationvalue))
  end
  io.write("\n")
end

-- create energy level diagram as a function of spin-orbit coupling strength
Verbosity(0x0)
H0 = OppCF + 0.4 + 0.00000001 * Oppldots + 0.0000000001 * OppJz
H1 = Oppldots
-- get starting wave functions
StartRestrictions = {NF, NB, {"1111111111",1,1}};
Npsi = 10;
psiList = Eigensystem(H0, StartRestrictions, Npsi);
-- We will write the eigen energies to the file EnergyLevelDiagram, which we open for writing
-- The variable file now points to the file "EnergyLevelDiagram"
file = assert(io.open("EnergyLevelDiagram", "w"))
io.write("zeta = ")
for i=0, 200 do
  zeta = 0.005*i
  io.write(string.format("%5.3f ",zeta))
  io.flush()
  file:write(string.format("%14.7E ",zeta))
  Hamiltonian=H0 + zeta * H1
  Eigensystem(Hamiltonian, psiList)
  for key,psi in pairs(psiList) do
    energy = psi * Hamiltonian * psi
    file:write(string.format("%14.7E ",energy))
    jeff = (sqrt(1 + 4 * psi * OppJeffSqr * psi)-1)/2
    file:write(string.format("%14.7E ",jeff))
  end
  file:write("\n")
end
io.write("\n")
file:close()

-- A gnuplot script that would make this plot can be found below
gnuplotInput = [[
set autoscale
set xtic auto
set ytic auto

set xlabel "zeta in units of 10Dq" font "Times,12"
set ylabel "Energy (eV)" font "Times,12"

set out 'EnergyLevelDiagram.ps'
set size 1.0, 0.625
set terminal postscript portrait enhanced color  "Times" 12

# set this to the range of your variable which you want to color-encode
# or leave it out
set cbrange [0.5:1.5]

# define the palette to your liking
set palette defined ( 0.5 "#FF0000", 0.75 "#00FF00", 1.25 "#00FF00", 1.5 "#0000FF" )

# in this example, column 3 is mapped to the colors of the palette
plot for [i=0:9] "EnergyLevelDiagram" using 1:2*i+2:2*i+3 with lines lc palette z notitle
]]

-- write the gnuplot script to a file
file = io.open("EnergyLevelDiagram.gnuplot", "w")
file:write(gnuplotInput)
file:close()

-- call gnuplot to execute the script
os.execute("/opt/local/bin/gnuplot EnergyLevelDiagram.gnuplot")
-- change the postscript file to pdf
os.execute("/opt/local/bin/ps2pdf EnergyLevelDiagram.ps")


Verbosity(0xFF)

