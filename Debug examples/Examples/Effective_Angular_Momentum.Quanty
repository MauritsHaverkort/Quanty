-- ionic with coulomb
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
-----------------------------------------------------------------------------------
   -- Needs definitions of operatros from ionic to be evaluated

OppF0 =NewOperator("U", NF, indexup, indexdn, {1,0,0})
OppF2 =NewOperator("U", NF, indexup, indexdn, {0,1,0})
OppF4 =NewOperator("U", NF, indexup, indexdn, {0,0,1})

print("test commutator of Leff and U")
print("Number of non-zero elements of length l for commuator with F0")
print(Chop(OppF0 * OppLeffSqr - OppLeffSqr * OppF0).N)
print("Number of non-zero elements of length l for commuator with F2")
print(Chop(OppF2 * OppLeffSqr - OppLeffSqr * OppF2).N)
print("Number of non-zero elements of length l for commuator with F4")
print(Chop(OppF4 * OppLeffSqr - OppLeffSqr * OppF4).N)



Hamiltonian = 3*OppCF + 5*OppF2 + 2*OppF4 + 0.1*Oppldots + 0.0000001 * OppJz + 3.079

StartRestrictions = {NF, NB, {"1111111111",5,5}};
Npsi = 7;
psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi);

-- In order to get some information on these eigenstates it is good to plot expectation values
-- We first define a list of all the operators we would like to calculate the expectation value of
oppList={Hamiltonian, OppSsqr, OppLsqr, OppJsqr, Oppldots, OppNeg, OppNt2g, OppLeffSqr, OppJeffSqr, OppLz, OppSz, OppJz, OppJeff[3]};

-- next we loop over all operators and all states and print the expectation value
print(" <E>     <S^2>   <L^2>   <J^2>   <l.s>   <Neg>   <Nt2g>  <~L^2>  <~J^2>  <Lz>    <Sz>    <Jz>    <~Jz>");
for i = 1,#psiList do
  for j = 1,#oppList do
    expectationvalue = Chop(psiList[i]*oppList[j]*psiList[i])
    io.write(string.format("%7.4f ",expectationvalue))
  end
  io.write("\n")
end

