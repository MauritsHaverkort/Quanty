print("========= defined Green's function as a list of poles ==========")
a = {1,0,1,2,4}
b = {0.25,0.2,0.4,0.25}
M = {a,b, mu=0, type="ListOfPoles"}
setmetatable(M, ResponseFunctionMeta)
print(M)
print("========= transform it to a userdata for speed        ==========")
U = ToUserdata(M)
print(U)
print("========= transform it back to a table for convininence ==========")
T = ToTable(U)
print(T)
print("========= Evaluate M ==========")
print(M(1,1))
print("========= Evaluate U ==========")
print(U(1,1))
print("========= Evaluate T ==========")
print(T(1,1))
print("========= Free response functions ==========")
M=nil
U=nil
T=nil
collectgarbage()
print("\n\n\n")

