print("========= defined Green's function as Natural Orbital impurity matrix ==========")
aval = {1,0,1,2,4}
bval = {0.25,0.2,0.4,0.25}
acon = {11,10,11,12,14}
bcon = {1.25,1.2,1.4,1.25}
Mval = {aval,bval, mu=0, type="Tri"}
Mcon = {acon,bcon, mu=0, type="Tri"}
a0=1
b0=1.2
M = {{a0,b0},val=Mval, con=Mcon, mu=0, type="Nat"}
setmetatable(M, ResponseFunctionMeta)
print(M)
print("========= transform it to a userdata for speed        ==========")
U = ToUserdata(M)
print(U)
print("========= transform it back to a table for convininence ==========")
T = ToTable(U)
print(T)
print("========= Evaluate M ==========")
print(M(1,1))
print("========= Evaluate U ==========")
print(U(1,1))
print("========= Evaluate T ==========")
print(T(1,1))
print("========= Free response functions ==========")
M=nil
U=nil
T=nil
collectgarbage()
print("\n\n\n")



function matrixmultiply(A,B)
    C={}
    for i=1,#A do
        C[i]={}
        for j=1,#B[1] do
            C[i][j]=0
            for k=1,#B do
                C[i][j]=C[i][j]+A[i][k]*B[k][j]
            end
        end
    end
    return C
end

A0 = {{0,2,3},{2,5,6},{3,6,9}};
A1 = {{1,2,3},{2,5,6},{3,6,9}};
A2 = {{2,2,3},{2,5,6},{3,6,9}};
A3 = {{3,2,3},{2,5,6},{3,6,9}};
a1 = -1
a2 = 0
a3 = 1
B0 = matrixmultiply({{0,0,3},{0,5,6},{3,6,9}},{{0,0,3},{0,5,6},{3,6,9}});
B1 = matrixmultiply({{1,0,3},{0,5,6},{3,6,9}},{{1,0,3},{0,5,6},{3,6,9}});
B2 = matrixmultiply({{2,0,3},{0,5,6},{3,6,9}},{{2,0,3},{0,5,6},{3,6,9}});
B3 = matrixmultiply({{3,0,3},{0,5,6},{3,6,9}},{{3,0,3},{0,5,6},{3,6,9}});

MListOfPoles = { {A0,a1,a2,a3}, {B1,B2,B3}, mu=0, type="ListOfPoles"}
setmetatable(MListOfPoles, ResponseFunctionMeta)
MTri         = { {A0,A1,A2,A3}, {B0,B1,B2}, mu=0, type="Tri"}
setmetatable(MTri, ResponseFunctionMeta)

print("List of poles")
print(MListOfPoles)
Mval = MListOfPoles(1,2)
print(Mval)

print("Tri")
print(MTri)
Mval = MTri(1,2)
print(Mval)

ATri = ChangeType(MListOfPoles,"Tri")
print(ATri)
print(ATri(1,2))

TB = ToTightBinding(ATri)
print(TB)

AAnd = ChangeType(MListOfPoles,"And")
print(AAnd)
print(AAnd(1,2))

TB = ToTightBinding(AAnd)
print(TB)
