indexfdn = {18,20,22,24,26,28,30}
indexfup = {19,21,23,25,27,29,31}

OppUsF0 = NewOperator("U",NF,indexsdn,indexsup,{1})
OppUpF0 = NewOperator("U",NF,indexpdn,indexpup,{1,0})
OppUpF2 = NewOperator("U",NF,indexpdn,indexpup,{0,1})
OppUdF0 = NewOperator("U",NF,indexddn,indexdup,{1,0,0})
OppUdF2 = NewOperator("U",NF,indexddn,indexdup,{0,1,0})
OppUdF4 = NewOperator("U",NF,indexddn,indexdup,{0,0,1})
