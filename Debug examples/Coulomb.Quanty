OppUdfF2 = NewOperator("U",NF,indexddn,indexdup,indexfdn,indexfup,{0,1,0},{0,0,0})
OppUdfF4 = NewOperator("U",NF,indexddn,indexdup,indexfdn,indexfup,{0,0,1},{0,0,0})
OppUdfG1 = NewOperator("U",NF,indexddn,indexdup,indexfdn,indexfup,{0,0,0},{1,0,0})
OppUdfG3 = NewOperator("U",NF,indexddn,indexdup,indexfdn,indexfup,{0,0,0},{0,1,0})
OppUdfG5 = NewOperator("U",NF,indexddn,indexdup,indexfdn,indexfup,{0,0,0},{0,0,1})

OppUsF0_sec = NewOperator("U",NF, indexsdn,indexsup, indexsdn,indexsup, indexsdn,indexsup, indexsdn,indexsup, {1})
OppUpF0_sec = NewOperator("U",NF, indexpdn,indexpup, indexpdn,indexpup, indexpdn,indexpup, indexpdn,indexpup, {1,0})
OppUpF2_sec = NewOperator("U",NF, indexpdn,indexpup, indexpdn,indexpup, indexpdn,indexpup, indexpdn,indexpup, {0,1})
OppUdF0_sec = NewOperator("U",NF, indexddn,indexdup, indexddn,indexdup, indexddn,indexdup, indexddn,indexdup, {1,0,0})
OppUdF2_sec = NewOperator("U",NF, indexddn,indexdup, indexddn,indexdup, indexddn,indexdup, indexddn,indexdup, {0,1,0})
OppUdF4_sec = NewOperator("U",NF, indexddn,indexdup, indexddn,indexdup, indexddn,indexdup, indexddn,indexdup, {0,0,1})
OppUfF0_sec = NewOperator("U",NF, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, {1,0,0,0})
OppUfF2_sec = NewOperator("U",NF, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, {0,1,0,0})
OppUfF4_sec = NewOperator("U",NF, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, {0,0,1,0})
OppUfF6_sec = NewOperator("U",NF, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, indexfdn,indexfup, {0,0,0,1})

print(Chop(OppUsF0-OppUsF0_sec))
print(Chop(OppUpF0-OppUpF0_sec))
print(Chop(OppUpF2-OppUpF2_sec))
print(Chop(OppUdF0-OppUdF0_sec))
print(Chop(OppUdF2-OppUdF2_sec))
print(Chop(OppUdF4-OppUdF4_sec))
