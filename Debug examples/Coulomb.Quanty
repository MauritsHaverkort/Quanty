OppUfF2 = NewOperator("U",NF,indexfdn,indexfup,{0,1,0,0})
OppUfF4 = NewOperator("U",NF,indexfdn,indexfup,{0,0,1,0})
OppUfF6 = NewOperator("U",NF,indexfdn,indexfup,{0,0,0,1})

OppUspF0 = NewOperator("U",NF,indexsdn,indexsup,indexpdn,indexpup,{1},{0})
OppUspG1 = NewOperator("U",NF,indexsdn,indexsup,indexpdn,indexpup,{0},{1})
OppUsdF0 = NewOperator("U",NF,indexsdn,indexsup,indexddn,indexdup,{1},{0})
OppUsdG2 = NewOperator("U",NF,indexsdn,indexsup,indexddn,indexdup,{0},{1})
OppUsfF0 = NewOperator("U",NF,indexsdn,indexsup,indexfdn,indexfup,{1},{0})
OppUsfG3 = NewOperator("U",NF,indexsdn,indexsup,indexfdn,indexfup,{0},{1})
OppUpdF0 = NewOperator("U",NF,indexpdn,indexpup,indexddn,indexdup,{1,0},{0,0})
OppUpdF2 = NewOperator("U",NF,indexpdn,indexpup,indexddn,indexdup,{0,1},{0,0})
OppUpdG1 = NewOperator("U",NF,indexpdn,indexpup,indexddn,indexdup,{0,0},{1,0})
OppUpdG3 = NewOperator("U",NF,indexpdn,indexpup,indexddn,indexdup,{0,0},{0,1})
OppUpfF0 = NewOperator("U",NF,indexpdn,indexpup,indexfdn,indexfup,{1,0},{0,0})
OppUpfF2 = NewOperator("U",NF,indexpdn,indexpup,indexfdn,indexfup,{0,1},{0,0})
