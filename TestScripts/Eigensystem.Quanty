	{ -3.8992563127001 , 3.7483409848205 , 18.266435178766 , 28.878222377537 , 0.48538958802089 , 0.75219158343461 , 0.031746977679172 , -0.49897365871444 , -0.45700617385254 , 1.6083105892866 , 3.5418833936717 , 3.883965073008 , 5.9658409440337 , 5.1501939829582 } ,
	{ -3.8985172532273 , 3.748315462356 , 18.269626915292 , 27.979676816895 , -1.0801797041269 , -1.3692678612449 , 0.069905218206182 , -0.49904223427392 , -0.45695339334815 , 1.6079760552149 , 3.5421760661633 , 3.8840142162539 , 5.965833662368 , 5.1501521213782 } ,
	{ -3.8985147587368 , 3.7483154511119 , 18.269621611273 , 27.979702667926 , -0.31064788553071 , -0.42580438377972 , 0.069902200202387 , -0.49904216937454 , -0.45695342992034 , 1.6079756886815 , 3.5421764787472 , 3.8840141621995 , 5.965833670372 , 5.1501521674287 } ,
	{ -3.898512664575 , 3.7483154716722 , 18.269617873627 , 27.979648926453 , 0.31063503541897 , 0.42579152582681 , 0.069905043195628 , -0.49904212749972 , -0.45695345160099 , 1.6079752219231 , 3.5421769800627 , 3.8840141202283 , 5.9658336777859 , 5.1501522019857 } ,
	{ -3.8985101464949 , 3.7483154614035 , 18.269612367705 , 27.979702937152 , 1.0940997862618 , 1.3885699048008 , 0.069900815826096 , -0.49904205921804 , -0.45695349040686 , 1.6079748568479 , 3.542177392464 , 3.8840140637613 , 5.9658336869267 , 5.1501522493119 }  }
 
-- and our Hamiltonian is the sum over several operators

Hamiltonian =  F0dd*OppF0_3d + F2dd*OppF2_3d + F4dd*OppF4_3d + zeta_3d*Oppldots_3d + B*(2*OppSy_3d + OppLy_3d)
+ tenDq*OpptenDq_3d + tenDqL*OpptenDq_Ld + Veg * OppVeg + Vt2g * OppVt2g
+ ed * OppN_3d + eL * OppN_Ld

-- we now can create the lowest Npsi eigenstates:
Npsi=6
-- in order to make sure we have a filling of 8 electrons we need to define some restrictions
StartRestrictions = {NF, NB, {"1111111111 0000000000",nd,nd}, {"0000000000 1111111111",10,10}}

TimeStart("Eigensystem mlft complex")
--psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi,{{"Restrictions",Restrictions},{"epsilon",1E-15},{"zero",1E-13}})
psiList = Eigensystem(Hamiltonian, StartRestrictions, Npsi,{{"Restrictions",Restrictions}})
TimeEnd("Eigensystem mlft complex")
oppList={Hamiltonian, OppSsqr, OppLsqr, OppJsqr, OppSy_3d, OppLy_3d, Oppldots_3d, OppF2_3d, OppF4_3d, OppNeg_3d, OppNt2g_3d, OppNeg_Ld, OppNt2g_Ld, OppN_3d}

-- print of some expectation values
expectationvalue={}
print("  #    <E>      <S^2>    <L^2>    <J^2>    <S_z^3d> <L_z^3d> <l.s>    <F[2]>   <F[4]>   <Neg^3d> <Nt2g^3d><Neg^Ld> <Nt2g^Ld><N^3d>");
for i = 1,#psiList do
expectationvalue[i]={}
	io.write(string.format("%3i ",i))
	for j = 1,#oppList do
		expectationvalue[i][j] = Chop(Complex.Re(Braket(psiList[i],oppList[j],psiList[i])))
		io.write(string.format("%8.3f ",1E8*(expectationvalue[i][j]- valuesExpected[i][j])))
		if Chop(expectationvalue[i][j] - valuesExpected[i][j], 2E-6)~=0 then error("Expectation value not equal to the expected value\n,1") end
	end
	io.write("\n")
end


print(expectationvalue)
TimePrint()









::hubbard::
------------------------------------------------------------
--                  real Hubbard model                    --
------------------------------------------------------------

print("============================================")
print("         Hubbard model 8 sites 1D           ")
print("============================================")
print("                    real                    ")
print("============================================\n\n")

-- Energy eigenvalues from Quanty
expectedEn = { -5.0089945483798 , -4.7231531376672 , -4.4313578927377 , -4.0692744354563 , -4.0692744352503 , -3.8663093361573 , -3.8663093259782 , -3.6089305392783 , -3.6089305059467 , -3.5591887636111 }

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
          {0,1,0},
          {0,0,1}}
Htb.Atoms={{"O",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"O.s","O.s",{0,0, 1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0,-1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0, 2},{{0.1,0},{0,0.1}}},
             {"O.s","O.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,8}}},U*HlocU)

StartRestrictions = {16,0,{"1010101010101010",4,4},{"0101010101010101",4,4}}

TimeStart("Hubbard Eigensystem 10 states")
fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10)
TimeEnd("Hubbard Eigensystem 10 states")
TimeStart("Hubbard Eigensystem 1 states")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Hubbard Eigensystem 1 states")
valgrd = Braket(fun1s,Hamiltonian1,fun1s)
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian1,fun1[i])
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[i]))
  if Chop(Energy - expectedEn[i], 1E-4)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Braket(fun1s,Hamiltonian1,fun1s)
Hfun=Hamiltonian1*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[1]))
if Chop(Energy - expectedEn[1], 1E-4)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

TimePrint()

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
E1s = fun1s*Hamiltonian1*fun1s
Hamiltonian2 = Hamiltonian1-E1s

TimeStart("Hubbard Eigensystem 10 states shifted")
fun1  = Eigensystem(Hamiltonian2,StartRestrictions,10)
TimeEnd("Hubbard Eigensystem 10 states shifted")
TimeStart("Hubbard Eigensystem 1 states shifted")
fun1s = Eigensystem(Hamiltonian2,StartRestrictions,1)
TimeEnd("Hubbard Eigensystem 1 states shifted")
valgrd = Braket(fun1s,Hamiltonian2,fun1s)
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian2,fun1[i])
  Hfun=Hamiltonian2*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - (expectedEn[i]-E1s)))
  if Chop(Energy - (expectedEn[i]-E1s), 1E-4)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Braket(fun1s,Hamiltonian2,fun1s)
Hfun=Hamiltonian2*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - (expectedEn[1]-E1s)))
if Chop(Energy - (expectedEn[1]-E1s), 1E-4)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

TimePrint()

print("\n\n\n\n\n=======================\n    scaled\n========================\n\n\n\n")

-- Hamiltonian3 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian3 = Hamiltonian1 / EnergyUnits.J.value
TimeStart("Hubbard Eigensystem 10 states scaled")
fun1  = Eigensystem(Hamiltonian3,StartRestrictions,10)
TimeEnd("Hubbard Eigensystem 10 states scaled")
TimeStart("Hubbard Eigensystem 1 states scaled")
fun1s = Eigensystem(Hamiltonian3,StartRestrictions,1)
TimeEnd("Hubbard Eigensystem 1 states scaled")
