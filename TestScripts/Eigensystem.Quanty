print("============================================")
print("         Hubbard model 8 sites 1D           ")
print("============================================")
print("                    real                    ")
print("============================================\n\n")

-- Energy eigenvalues from Quanty
expectedEn = { -5.0089945483798 , -4.7231531381315 , -4.4313578928744 , -4.0692744355582 , -4.0692744355581 , -3.8663093361573 , -3.8663093361572 , -3.6089305392784 , -3.6089305392783 , -3.5591887636111 }

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
          {0,1,0},
          {0,0,1}}
Htb.Atoms={{"O",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"O.s","O.s",{0,0, 1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0,-1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0, 2},{{0.1,0},{0,0.1}}},
             {"O.s","O.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,8}}},U*HlocU)

StartRestrictions = {16,0,{"1010101010101010",4,4},{"0101010101010101",4,4}}

print("\nTest DenseBorder ...")

fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10, {{"DenseBorder", 5000}, 
                                                        {"NKrylovStart", 150}, {"NKrylovMax", 500}, {"NKrylovStep", 10}, {"NKrylovMin", 50}, 
                                                        {"NBitsKey", 16}, {"Epsilon", 1.49012E-8}, {"Zero", 1.49012E-6}, {"ExpandBasis", true}})

print("      Energy          Variance        Energy-Exact")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian1,fun1[i])
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, EnergySqr - (Energy)^2, Energy - expectedEn[i]))
  if Chop(Energy - expectedEn[i], threshold)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()


-- The three sections below compare ten eigenvalues of a nearly degenerate spectrum
-- against a reference to 1E-5.  Zero is the convergence criterion: the search stops
-- once every state has a variance below totESqr*Zero/Npsi.  A small variance does not
-- imply a small energy error for a near degenerate multiplet, and at the standard
-- Zero = 1.49012E-6 the energies came out only 6 to 76 times inside that tolerance,
-- scattering with the random starting block, so the comparisons failed every so often.
-- At Zero = 1E-8 the margin is 4000 times or better, for about 8 seconds more over the
-- three sections.  1E-10 would be another three decades but costs a factor of twenty in
-- time.  The options under test here are NKrylovStart, NKrylovMax and NKrylovStep, not
-- Zero, so tightening it does not weaken what these sections check.
print("\nTest NKrylovStart ...")

fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10, {{"DenseBorder", 1}, 
                                                        {"NKrylovStart", 150}, {"NKrylovMax", 500}, {"NKrylovStep", 10}, {"NKrylovMin", 50}, 
                                                        {"NBitsKey", 16}, {"Epsilon", 1.49012E-8}, {"Zero", 1E-8}, {"ExpandBasis", true}})
fun1s  = Eigensystem(Hamiltonian1,StartRestrictions,1, {{"DenseBorder", 1}, 
                                                        {"NKrylovStart", 150}, {"NKrylovMax", 500}, {"NKrylovStep", 10}, {"NKrylovMin", 50}, 
                                                        {"NBitsKey", 16}, {"Epsilon", 1.49012E-8}, {"Zero", 1E-8}, {"ExpandBasis", true}})
valgrd = Braket(fun1s,Hamiltonian1,fun1s)

print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian1,fun1[i])
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[i]))
  if Chop(Energy - expectedEn[i], 1E-5)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Braket(fun1s,Hamiltonian1,fun1s)
Hfun=Hamiltonian1*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[1]))
if Chop(Energy - expectedEn[1], 1E-5)~=0 then error("The eigenvalue not equal to the expected value\n",1) end


