-- The function Eigensystem calculates a set of eigen vectors and eigen values for a given matrix or operator
-- The function has several options related to the accuracy needed and methods used

--[[
Reminders:
1 - Dense method using wavefunction.
2 - pick one of the models to do options.
3 - Ask Maurits to check the thresholds in Chop!
]]

-----------------------------------------------------------
-----------------------------------------------------------
-- test different dense methods on a small 3 by 3 matrix --
-----------------------------------------------------------
-----------------------------------------------------------


print("===========================================")
print("==== Dense methods on a 3 by 3 matrix  ====")
print("===========================================")

-----------------------------------------------------------
  -- test with real numbers
-----------------------------------------------------------
  -- matrix to diagonalize
  A = {{ 1 , 1 , 0 },
       { 1 , 2 , 1 },
       { 0 , 1 , 5 }}
  setmetatable(A, MatrixMeta)
  -- eigensystem according to Mathematica
  valMathematica =  {0.31866935639502262452433761211,  2.35792636751849974970397959719, 5.3234042760864776257716827907}
  funMathematica = {{0.82050111444738313996858969236, -0.55903255238503675521539216190, 0.119417446650283937603699498928},
                    {0.56721932561260656439883881996,  0.77024207841541995975186334504,-0.291529376375475856555699876429},
                    {0.070994069063423073163271775955, 0.30693606176558202824762574539, 0.94907855109345545102883853038}}
  setmetatable(funMathematica, MatrixMeta)

print("Eigensystem on real symetric dense matrix")

val, fun = Eigensystem(A)
identity = fun * Matrix.Transpose(funMathematica)
-- remove phase
identity = identity * identity
zero = Chop(identity - Matrix.Identity(3))

if(zero~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

zero=0
for i=1,3 do
  zero = zero + abs(val[i] - valMathematica[i])
end
zero = Chop(zero)
if(zero~=0) then
  error("eigenvalues not equivalent to expected value\n",1)
end

-----------------------------------------------------------
  -- test with complex numbers
-----------------------------------------------------------
  -- matrix to diagonalize
  A = {{ 1   , 1+I , 3*I },
       { 1-I , 2   , 1   },
       {-3*I , 1   , 5   }}
  -- eigensystem according to Mathematica
  valMathematica =  {-0.957509016513455874580948715947, 1.93270928155360584570749449359, 7.02479973495985002887345422236}
  funMathematica = {{0.848746334166595978803610284444,                                        -0.3042479274598142156935398646058+ 0.1510389638058049332585723380046*I, 0.0510696545513364274783225088671+ 0.402047236866078372297394505147 *I},
                    {0.2321576044814645871816662641286+  0.00509311096740913239874082449471*I, 0.897729033025279384252337292938,                                      -0.2976595470513314739784930950171+ 0.2270644935140554547829254396339*I},
                    {0.02949840760917409557366913416583+ 0.474169179818120951954618894565  *I, 0.2662172211730120010883264567962+ 0.0884952228275222867210074024975*I, 0.834020634964603430948668779872                                      }}

print("Eigensystem on complex hermitian dense matrix")

val, fun = Eigensystem(A)

-- test if Quanty gets the same answer as Mathematica
identity = Matrix.Conjugate(fun) * Matrix.Transpose(funMathematica)
-- remove phase
identity = Matrix.Conjugate(identity) * identity
zero = Chop(identity - Matrix.Identity(3))

if(zero~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

zero=0
for i=1,3 do
  zero = zero + abs(val[i] - valMathematica[i])
end
zero = Chop(zero)
if(zero~=0) then
  error("eigenvalues not equivalent to expected value\n",1)
end


-----------------------------------------------------------
-- test with real non hermitian matrix
-----------------------------------------------------------

-- for dense matrices, given as tables Quanty can handle non hermitian matrices
-- For non hermitian matrices one has a left and a right eigensystem
-- H psi^R_i   = E_i psi^R_i
-- psi^L_i^* H = E_i psi^L_i^*
--
-- and psi^L_i^* . psi^R_j = delta_{i,j}
-- and thus psi^L_i . H . psi^R_j = E_i delta_{i,j}

threshold = 1E-12

-- matrix to diagonalize
A = {{ 1 , 2 , 3 },
     { 4 , 5 , 6 },
     { 7 , 8 , 0 }}
setmetatable(A, MatrixMeta)

-- eigenvalues according to python
valPython = {-5.734509942225074, -0.3883838424073199, 12.1228937846324}

print("Eigensystem on real non-hermitian dense matrix")

val, funL, funR = Eigensystem(A)

zero=0
for i=1,3 do
  zero = zero + abs(val[i] - valPython[i])
end
zero = Chop(zero, threshold)
if(zero~=0) then
  error("eigenvalues not equivalent to expected value\n",1)
end

-- funL^* . funR^T gives the identity matrix
identity = Chop(Matrix.Conjugate(funL)*Matrix.Transpose(funR),threshold)
zero = Chop(identity - Matrix.Identity(3))

if(zero~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

-- funL^* . H . funR^T gives a diagonal matrix with the eigen energies on the diagonal
valExpected = Chop(Matrix.Conjugate(funL)*(A*Matrix.Transpose(funR)),threshold)
valExpected = {valExpected[1][1], valExpected[2][2], valExpected[3][3]}

zero=0
for i=1,3 do
  zero = zero + abs(valExpected[i] - valPython[i])
end
zero = Chop(zero, threshold)
if(zero~=0) then
  error("eigenvalues not equivalent to expected value\n",1)
end

-- (A * funR^T)^T - Diagonal(val) * funR
zero = Chop(Matrix.Transpose(A*Matrix.Transpose(funR))-Matrix.Diagonal(val)*funR,threshold)
if(Matrix.ToUserdata(zero)~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

-- funL^* * A     - Diagonal(val) * funL
zero = Chop(Matrix.Conjugate(funL)*A-Matrix.Diagonal(val)*Matrix.Conjugate(funL),threshold)
if(Matrix.ToUserdata(zero)~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end
-----------------------------------------------------------

-----------------------------------------------------------
-- test with complex non hermitian matrix
-----------------------------------------------------------

-- matrix to diagonalize
A = {{ I , 2 , 3 },
     { 4 , 5 , 6 },
     { 7 , 8 , 9 }}
setmetatable(A, MatrixMeta)

-- eigenvalues according to python
valPython = {-1.88575998514644+0.853201479934894*I, -0.119547088095287+0.0459304731689488*I, 16.0053070732417+0.100868046896157*I}

print("Eigensystem on complex non-hermitian dense matrix")

val, funL, funR = Eigensystem(A)

zero=0
for i=1,3 do
  zero = zero + abs(val[i] - valPython[i])
end
zero = Chop(zero, threshold)
if(zero~=0) then
  error("eigenvalues not equivalent to expected value\n",1)
end

-- funL^* . funR^T gives the identity matrix
identity = Chop(Matrix.Conjugate(funL)*Matrix.Transpose(funR),threshold)
zero = Chop(identity - Matrix.Identity(3))

if(zero~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

-- funL^* . H . funR^T gives a diagonal matrix with the eigen energies on the diagonal
valExpected = Chop(Matrix.Conjugate(funL)*(A*Matrix.Transpose(funR)),threshold)
valExpected = {valExpected[1][1], valExpected[2][2], valExpected[3][3]}

zero=0
for i=1,3 do
  zero = zero + abs(valExpected[i] - valPython[i])
end
zero = Chop(zero, threshold)
if(zero~=0) then
  error("eigenvalues not equivalent to expected value\n",1)
end

-- (A * funR^T)^T - Diagonal(val) * funR
zero = Chop(Matrix.Transpose(A*Matrix.Transpose(funR))-Matrix.Diagonal(val)*funR,threshold)
if(Matrix.ToUserdata(zero)~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

-- funL^* * A     - Diagonal(val) * funL
zero = Chop(Matrix.Conjugate(funL)*A-Matrix.Diagonal(val)*Matrix.Conjugate(funL),threshold)
if(Matrix.ToUserdata(zero)~=Matrix.Zero(3)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

