val, fun = Eigensystem(MTri)

-- test if Quanty gets the same answer as Mathematica
identity = Matrix.Conjugate(fun) * Matrix.Transpose(funMathematica)
-- remove phase
identity = Matrix.Conjugate(identity) * identity
zero = Chop(identity - Matrix.Identity(#val), threshold)

if(zero~=Matrix.Zero(#val)) then
  error("eigenfunctions not equivalent to expected value\n",1)
end

zero=0
for i=1,3 do
  zero = zero + abs(val[i] - valMathematica[i])
end
zero = Chop(zero, threshold)
if(zero~=0) then
  error("eigenvalues not equivalent to expected value\n",1)
end

------------------------------------------------------------
-- test for a large hilbert space the lowest eigen-states --
------------------------------------------------------------

print("Large systems with Lanczos\n")

::atom::
------------------------------------------------------------
--                        real atom                       --
------------------------------------------------------------

print("===========================================")
print("Atom with a single f-shell with 6 electrons")
print("===========================================")
print("                    real                   ")
print("===========================================\n\n")

Basis_dn = {0,2,4,6,8,10,12}
Basis_up = {1,3,5,7,9,11,13}

Hamiltonian1 = NewOperator("U",14,Basis_up,Basis_dn,{0,10,6.25,4}) + 0.1 * NewOperator("ldots",14,Basis_up,Basis_dn)
StartRestrictions = {14,0,{"11111111111111",6,6}}

-- Energy eigenvalues from Mathematica
expectedEn = {-12.11458547046453,-12.08935739575368,-12.08935739575368,-12.08935739575368,-12.04302371821059,-12.04302371821059,-12.04302371821059,-12.04302371821058,-12.04302371821058,-11.98075902249375}

TimeStart("Eigensystem 10 states")
fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10)
TimeEnd("Eigensystem 10 states")
TimeStart("Eigensystem 1 states")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Eigensystem 1 states")
valgrd = Braket(fun1s,Hamiltonian1,fun1s)
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian1,fun1[i])
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[i]))
  if Chop(Energy - expectedEn[i], 1E-5)~=0 then print(Energy - expectedEn[i]); error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Braket(fun1s,Hamiltonian1,fun1s)
Hfun=Hamiltonian1*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
if Chop(Energy - expectedEn[1], 1E-6)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
E1s = fun1s*Hamiltonian1*fun1s
Hamiltonian2 = Hamiltonian1-E1s

TimeStart("Eigensystem 10 states shifted")
fun1  = Eigensystem(Hamiltonian2,StartRestrictions,10)
TimeEnd("Eigensystem 10 states shifted")
TimeStart("Eigensystem 1 states shifted")
fun1s = Eigensystem(Hamiltonian2,StartRestrictions,1)
TimeEnd("Eigensystem 1 states shifted")
valgrd = Braket(fun1s,Hamiltonian2,fun1s)
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian2,fun1[i])
  Hfun=Hamiltonian2*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - (expectedEn[i] - E1s)))
  if Chop(Energy - (expectedEn[i] - E1s), 1E-5)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Braket(fun1s,Hamiltonian2,fun1s)
Hfun=Hamiltonian2*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - (expectedEn[1] - E1s)))
if Chop(Energy - (expectedEn[1] - E1s), 1E-5)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

print("\n\n\n\n\n=======================\n    scaled\n========================\n\n\n\n")

-- Hamiltonian3 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian3 = Hamiltonian1 / EnergyUnits.J.value
TimeStart("Eigensystem 10 states scaled")
fun1  = Eigensystem(Hamiltonian3,StartRestrictions,10)
TimeEnd("Eigensystem 10 states scaled")
TimeStart("Eigensystem 1 states scaled")
fun1s = Eigensystem(Hamiltonian3,StartRestrictions,1)
TimeEnd("Eigensystem 1 states scaled")
valgrd = Braket(fun1s,Hamiltonian3,fun1s)
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian3,fun1[i])
  Hfun=Hamiltonian3*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[i]/EnergyUnits.J.value))
  if Chop(Energy - expectedEn[i]/EnergyUnits.J.value, 1E-17)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Braket(fun1s,Hamiltonian3,fun1s)
Hfun=Hamiltonian3*fun1s
EnergySqr=Braket(Hfun,Hfun)
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
if Chop(Energy - expectedEn[1]/EnergyUnits.J.value, 1E-17)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

TimePrint()


------------------------------------------------------------
--                      complex atom                      --
------------------------------------------------------------

print("===========================================")
print("Atom with a single f-shell with 6 electrons")
print("===========================================")
print("                  complex                  ")
print("===========================================\n\n")

Basis_dn = {0,2,4,6,8,10,12}
Basis_up = {1,3,5,7,9,11,13}

Hamiltonian1 = NewOperator("U",14,Basis_up,Basis_dn,{0,10,6.25,4}) + 0.1 * NewOperator("ldots",14,Basis_up,Basis_dn) + 0.000001 * NewOperator("Ly",14,Basis_up,Basis_dn) + 0.000002 * NewOperator("Sy",14,Basis_up,Basis_dn)
StartRestrictions = {14,0,{"11111111111111",6,6}}

-- Energy eigenvalues from Mathematica
expectedEn = {-12.11458548596329,-12.0893723915261,-12.0893573866057,-12.08934240950505,-12.0430536956854,-12.04303870467152,-12.0430237159282,-12.04300872945544,-12.04299374525323,-11.98080397324668}

TimeStart("Eigensystem 10 states complex")
fun1  = Eigensystem(Hamiltonian1,StartRestrictions,10)
TimeEnd("Eigensystem 10 states complex")
TimeStart("Eigensystem 1 states complex")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Eigensystem 1 states complex")
valgrd = Complex.Re(Braket(fun1s,Hamiltonian1,fun1s))
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Complex.Re(Braket(fun1[i],Hamiltonian1,fun1[i]))
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Complex.Re(Braket(Hfun,Hfun))
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[i]))
  if Chop(Energy - expectedEn[i], 1E-4)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Complex.Re(Braket(fun1s,Hamiltonian1,fun1s))
Hfun=Hamiltonian1*fun1s
EnergySqr=Complex.Re(Braket(Hfun,Hfun))
io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[1]))
if Chop(Energy - expectedEn[1], 1E-6)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

print("\n\n\n\n\n=======================\n    shifted\n========================\n\n\n\n")

-- Hamiltonian2 is Hamiltonian1 shifted to the ground-state energy
E1s = fun1s*Hamiltonian1*fun1s
Hamiltonian2 = Hamiltonian1-E1s

TimeStart("Eigensystem 10 states shifted complex")
fun1  = Eigensystem(Hamiltonian2,StartRestrictions,10)
TimeEnd("Eigensystem 10 states shifted complex")
TimeStart("Eigensystem 1 states shifted complex")
fun1s = Eigensystem(Hamiltonian2,StartRestrictions,1)
TimeEnd("Eigensystem 1 states shifted complex")
valgrd = Complex.Re(Braket(fun1s,Hamiltonian2,fun1s))
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Complex.Re(Braket(fun1[i],Hamiltonian2,fun1[i]))
  Hfun=Hamiltonian2*fun1[i]
  EnergySqr=Complex.Re(Braket(Hfun,Hfun))
  io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - (expectedEn[i] - E1s)))
  if Chop(Energy - (expectedEn[i] - E1s), 1E-4)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Complex.Re(Braket(fun1s,Hamiltonian2,fun1s))
Hfun=Hamiltonian2*fun1s
EnergySqr=Complex.Re(Braket(Hfun,Hfun))
io.write(string.format("%16.8e %16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - (expectedEn[1] - E1s)))
if Chop(Energy - (expectedEn[1] - E1s), 1E-6)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

print("\n\n\n\n\n=======================\n    scaled\n========================\n\n\n\n")

-- Hamiltonian3 is Hamiltonian1 but transfered from units of eV to units of J (i.e. devide by energy of 1J in units of eV (6.2415091259E+18)
Hamiltonian3 = Hamiltonian1 / EnergyUnits.J.value
TimeStart("Eigensystem 10 states scaled complex")
fun1  = Eigensystem(Hamiltonian3,StartRestrictions,10)
TimeEnd("Eigensystem 10 states scaled complex")
TimeStart("Eigensystem 1 states scaled complex")
fun1s = Eigensystem(Hamiltonian3,StartRestrictions,1)
TimeEnd("Eigensystem 1 states scaled complex")
valgrd = Complex.Re(Braket(fun1s,Hamiltonian3,fun1s))
print("      Energy           Energy-E0        Variance        Energy-Exact")
for i=1,10 do
  Energy=Complex.Re(Braket(fun1[i],Hamiltonian3,fun1[i]))
  Hfun=Hamiltonian3*fun1[i]
  EnergySqr=Complex.Re(Braket(Hfun,Hfun))
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[i]/EnergyUnits.J.value))
  if Chop(Energy - expectedEn[i]/EnergyUnits.J.value, 1E-17)~=0 then error("The eigenvalue not equal to the expected value\n",1) end
end
print()
Energy=Complex.Re(Braket(fun1s,Hamiltonian3,fun1s))
Hfun=Hamiltonian3*fun1s
EnergySqr=Complex.Re(Braket(Hfun,Hfun))
io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2, Energy - expectedEn[1]/EnergyUnits.J.value))
if Chop(Energy - expectedEn[1]/EnergyUnits.J.value, 1E-17)~=0 then error("The eigenvalue not equal to the expected value\n",1) end

TimePrint()

