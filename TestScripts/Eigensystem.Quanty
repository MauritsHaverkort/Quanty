print("============================================")
print("         Hubbard model 8 sites 1D           ")
print("============================================")
print("               real psi start               ")
print("============================================\n\n")

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
  {0,1,0},
{0,0,1}}
Htb.Atoms={{"Cu",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"Cu.s","Cu.s",{0,0, 1},{{1  ,0},{0,1  }}},
  {"Cu.s","Cu.s",{0,0,-1},{{1  ,0},{0,1  }}},
  {"Cu.s","Cu.s",{0,0, 2},{{0.1,0},{0,0.1}}},
{"Cu.s","Cu.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,8}}},U*HlocU)

funstart10 = { NewWavefunction(16,0,{{"1001100110011001",1}}),
  NewWavefunction(16,0,{{"0110011001100110",1}}),
  NewWavefunction(16,0,{{"1001011001100110",1}}),
  NewWavefunction(16,0,{{"0110100101100110",1}}),
  NewWavefunction(16,0,{{"0110011010010110",1}}),
  NewWavefunction(16,0,{{"0110011001101001",1}}),
  NewWavefunction(16,0,{{"0110011001100110",1}}),
  NewWavefunction(16,0,{{"0110100110011001",1}}),
  NewWavefunction(16,0,{{"1001011010011001",1}}),
  NewWavefunction(16,0,{{"1001100101101001",1}})}

funstart1  = NewWavefunction(16,0,{{"1001100110011001",sqrt(0.5)},{"0110011001100110",sqrt(0.5)}})

TimeStart("Hubbard psi Eigensystem 10 states")
fun1 = Copy(funstart10)

Eigensystem(Hamiltonian1,fun1)
TimeEnd("Hubbard psi Eigensystem 10 states")
TimeStart("Hubbard psi Eigensystem 1 states")
fun1s = Copy(funstart1)
Eigensystem(Hamiltonian1,fun1s)
TimeEnd("Hubbard psi Eigensystem 1 states")
valgrd = Braket(fun1s,Hamiltonian1,fun1s)
print("      Energy           Energy-E0        Variance")
for i=1,10 do
  Energy=Braket(fun1[i],Hamiltonian1,fun1[i])
  Hfun=Hamiltonian1*fun1[i]
  EnergySqr=Braket(Hfun,Hfun)
  io.write(string.format("%16.8e %16.8e %16.8e\n",Energy, Energy-valgrd, EnergySqr - (Energy)^2))
end
print()
