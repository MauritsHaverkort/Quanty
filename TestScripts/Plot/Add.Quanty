-- Determine working directory (same as the directory of the input script)
directory = debug.getinfo(1, "S").source:sub(2):match("(.*/)")

print("-------------------------------------------------------")
print("--                   Graphics.Add                    --")
print("-------------------------------------------------------")



print("Add line")

-- create an empty graphics object
pl = Graphics.New()

pl2 = Graphics.Add(pl  , {{0,0},{0.5,0.5}})
pl3 = Graphics.Add(pl2 , {{0.1,0.3},{0.2,0.3},{0.2,0.4}},{{"Close",true}})
pl4 = Graphics.Add(pl3 , {{0.2,0.1},{0.5,0.2}},{{"Line Width",0.05}})
pl5 = Graphics.Add(pl4 , {{0.6,0.8},{0.2,0.8},{0.3,0.2}},{{"Close",true},
									                                        {"Fill Color",0xFF0000},
									                                        {"Fill Transparancy",0x7F}})
pl6 = Graphics.Add(pl5 , {{0.0,0.3},{0.9,0.2}},{{"Line Width",0.05},
									                              {"Color",0x0000FF},
									                              {"Transparancy",0x5F}})

SVGpl = Graphics.ToSVG(pl6,{{"RelativeSize",true}})
file = io.open(directory.."OutputPlots/Add_line_function.svg",'w')
file:write(SVGpl)
file:close()

