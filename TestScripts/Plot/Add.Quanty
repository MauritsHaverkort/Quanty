print("Add bitmap: values are clipped to 0 to 255")

-- negative values are 0 (black, or opaque), not 255; above 255 is 255
Clip = Graphics.ToTable(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, {{-5, 0, 128, 300}, {{-1,300,7}, {1,2,3,264}, {-3}, {400}}}})).BitMap[1].Pixels
if Clip ~= "00000000000000000080808000FFFFFF0000FF07FF0102030000000000FFFFFF>" then
	print(Clip)
	error("Graphics.Add clipping of bitmap values failed\n", 1)
end

print("Add bitmap: transparent colour")

function BitMapPixels(pl) return Graphics.ToTable(pl).BitMap[1].Pixels end
Pixels = {{{255,0,0}, {0,0,255}}, {0, {255,0,0,55}}}
-- the red pixels become transparent, whatever their own transparency; the others stay as they are
T = BitMapPixels(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, Pixels, {255,0,0}}))
if T ~= "FFFF0000000000FF00000000FFFF0000>" then error("Graphics.Add transparent colour failed: "..T.."\n", 1) end
-- with a transparency in the transparent colour the red pixels get that transparency
T = BitMapPixels(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, Pixels, {255,0,0,127}}))
if T ~= "7FFF0000000000FF000000007FFF0000>" then error("Graphics.Add transparent colour with alpha failed: "..T.."\n", 1) end
-- a grey transparent colour
T = BitMapPixels(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, Pixels, 0}))
if T ~= "00FF0000000000FFFF00000037FF0000>" then error("Graphics.Add grey transparent colour failed: "..T.."\n", 1) end

print("Add bitmap: colour function and matrices")

-- row 1 of the matrix is the top row of the bitmap, as for a table of pixels
F1 = function(re, im) return re, 0, 1-re end
Real = {{0, 0.2, 0.4}, {0.6, 0.8, 1}}
G = Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, F1, Real})
T = Graphics.ToTable(G).BitMap[1]
if T.Pixels ~= "000000FF003300CC006600990099006600CC003300FF0000>" or T.NpointsX ~= 3 or T.NpointsY ~= 2 then
	error("Graphics.Add colour function failed: "..T.Pixels.."\n", 1)
end
-- a Matrix object gives the same, and these bitmaps are drawn with hard pixels
if BitMapPixels(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, F1, Matrix.New(Real)})) ~= T.Pixels or not T.Pixelated
   or not string.find(Graphics.ToSVG(G), "image-rendering:pixelated", 1, true) then
	error("Graphics.Add colour function with a Matrix object failed\n", 1)
end
-- a complex matrix hands on the imaginary part, values outside 0 to 1 are clipped
T = BitMapPixels(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, function(re, im) return re, im, 0 end, {{0.2+0.4*I, -1+2*I}}}))
if T ~= "003366000000FF00>" then error("Graphics.Add colour function with a complex matrix failed: "..T.."\n", 1) end
-- several matrices: the function gets Re and Im of each
T = BitMapPixels(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, function(r1, i1, r2, i2, r3, i3) return r1, r2+i2, r3 end,
                                               {{1, 0}}, {{0.2*I, 0.4}}, Matrix.New({{0, 0.6}})}))
if T ~= "00FF330000006699>" then error("Graphics.Add colour function with three matrices failed: "..T.."\n", 1) end
-- the option Pixelated overrides the default of either form
if Graphics.ToTable(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, F1, Real}, {{"Pixelated",false}})).BitMap[1].Pixelated
   or not Graphics.ToTable(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, Pixels}, {{"Pixelated",true}})).BitMap[1].Pixelated
   or Graphics.ToTable(Graphics.Add(Graphics.New(), {"BitMap", {0,0}, {1,1}, Pixels})).BitMap[1].Pixelated then
	error("Graphics.Add option Pixelated failed\n", 1)
end
-- errors: the message of the colour function itself, wrong return values, no matrix,
-- matrices of different size, an empty matrix, and a fourth element that is neither
ok, msg = pcall(Graphics.Add, Graphics.New(), {"BitMap", {0,0}, {1,1}, function(re, im) error("my own bitmap error") end, Real})
if ok or not string.find(msg, "my own bitmap error", 1, true) then error("Graphics.Add lost the error of the colour function: "..tostring(msg).."\n", 1) end
ok, msg = pcall(Graphics.Add, Graphics.New(), {"BitMap", {0,0}, {1,1}, function(re, im) return re end, Real})
if ok or not string.find(msg, "Graphics.Add: the ColorFunction should return three numbers", 1, true) then error("Graphics.Add accepted a colour function returning one number\n", 1) end
for k, w in ipairs({ {F1}, {F1, Real, {{1,2}}}, {F1, {}}, {3, Real} }) do
	local b = {"BitMap", {0,0}, {1,1}}
	for _, x in ipairs(w) do b[#b+1] = x end
	if pcall(Graphics.Add, Graphics.New(), b) then error("Graphics.Add accepted a wrong bitmap in case "..k.."\n", 1) end
end

print("Add: option Layer")
-- the option Layer: 0 is the graphics itself, n its layer n, -1 the last layer; a list
-- {n1, n2, ...} goes down into layer n2 of layer n1. A + B + C has the layers B and C.
function Strings(T) local s = {} for _, t in ipairs(T.Text or {}) do s[#s+1] = t.String end return table.concat(s, " ") end
G = Graphics.New() + Graphics.New() + Graphics.New()
G.Add("own", 0.1, 0.1)
G.Add("one", 0.1, 0.1, {{"Layer",1}})
G.Add("last", 0.1, 0.1, {{"Layer",-1}})
G.Add("zero", 0.1, 0.1, {{"Layer",0}})
G.Add("minustwo", 0.1, 0.1, {{"Layer",{-2}}})
T = Graphics.ToTable(G)
if G.NLayer ~= 3 or Strings(T) ~= "own zero" or Strings(T.Layer[1]) ~= "one minustwo" or Strings(T.Layer[2]) ~= "last" then
	error("Graphics.Add option Layer failed: "..Strings(T).." | "..Strings(T.Layer[1]).." | "..Strings(T.Layer[2] or {}).."\n", 1)
end
-- a path into a layer of a layer, for a line, a Graphics object and a text; the functional form
-- Graphics.Add leaves its input unchanged
Page = Graphics.New()
Page.Add(G)
Page.Add({{0,0}, {1,1}}, {{"Layer",{1,2}}})
Page.Add(Graphics.New(), {{"Layer",{1,-1}}})
Page2 = Graphics.Add(Page, "deep", 0.5, 0.5, {{"Layer",{1,2,1}}})
T, T2 = Graphics.ToTable(Page), Graphics.ToTable(Page2)
if #T.Layer ~= 1 or #T.Layer[1].Layer[2].Line ~= 1 or #T.Layer[1].Layer[2].Layer ~= 1 or T.Layer[1].Layer[1].Line
   or T.Layer[1].Layer[2].Layer[1].Text or Strings(T2.Layer[1].Layer[2].Layer[1]) ~= "deep" then
	error("Graphics.Add option Layer with a path failed\n", 1)
end
-- a layer of a Graphics object without layers: 0 and -1 are the object itself
G = Graphics.New()
G.Add("a", 0, 0, {{"Layer",-1}})
if Strings(Graphics.ToTable(G)) ~= "a" then error("Graphics.Add option Layer -1 without layers failed\n", 1) end
-- the panels of a grid plot are its layers 1 to Nrow*Ncolumn
S = Spectra.FromTable({{{0,0},{1,1}}, {{0,1},{1,0}}})
Grid = Graphics.Plot(S, {{"Nrow",1}, {"Ncolumn",2}, {"plotIm",false}})
Grid.Add("panel 2", 0.5, 0.5, {{"Layer",2}})
if Grid.NLayer ~= 3 or Strings(Graphics.ToTable(Grid).Layer[2]) ~= "panel 2" then error("Graphics.Add option Layer in a grid plot failed\n", 1) end
-- an empty list goes down no level: the graphics itself
G = Graphics.New() + Graphics.New()
G.Add("empty", 0, 0, {{"Layer",{}}})
if Strings(Graphics.ToTable(G)) ~= "empty" then error("Graphics.Add option Layer {} failed\n", 1) end
-- errors: a layer that does not exist (at the first or a later level, or far out of range), no
-- whole number, a complex number and not a number
G = Graphics.New() + Graphics.New()
ok, msg = pcall(G.Add, "x", 0, 0, {{"Layer",2}})
if ok or not string.find(msg, "there is no layer 2, the layers are 0 (the graphics itself) to 1, or -1 (the last one) to -2", 1, true) then
	error("Graphics.Add option Layer: wrong error for a missing layer: "..tostring(msg).."\n", 1)
end
for k, l in ipairs({-3, {1, 1}, {0, 2}, 1E30, -1E30, 0.5, I, {0, 1+I}, "a", {1, "a"}}) do
	if pcall(G.Add, "x", 0, 0, {{"Layer",l}}) then error("Graphics.Add accepted a wrong Layer in case "..k.."\n", 1) end
end
