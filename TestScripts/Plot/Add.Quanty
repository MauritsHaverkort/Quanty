BlackWith = {}
for i=0,15 do
	BlackWith[i]={}
	for j=0,15 do
		BlackWith[i][j]=i*j
	end
end
RGB={}
for i=0,15 do
	RGB[i]={}
	for j=0,15 do
		RGB[i][j]={i*16+i,j*16+j,0}
	end
end



-- create an empty graphics object
pl = Graphics.New()

pl2 = Graphics.Add(pl  , {"BitMap", {0.0,0.0}, {0.2,0.2}, BlackWith})
