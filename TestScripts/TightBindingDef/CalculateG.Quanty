-- Determine working directory (same as the directory of the input script)
directory = debug.getinfo(1, "S").source:sub(2):match("(.*/)")

----------------------------
--- Functions
----------------------------
-- create unifrom energy mesh in window [Emin,Emax]
function CreateUniformEGrid(Emin, Emax, NE)
	local EGrid = {}
	local dE = (Emax-Emin)/NE
	for i = 0, NE do
		EGrid[i+1] = Emin + i*dE
	end
	return EGrid
end

-- generate non-uniform energy mesh: a list of n_rand random variables in range [a, b] based on normal probability distribution with center mu and standard derviation sigma
function RandomVariate_NormalPDF(mu, sigma, a, b, n_rand)
  local function f(m,s,y)
  	return Exp(-(y-m)^2/(2*s^2))/(Sqrt(2*Pi)*s)
  end
  local fmax = f(mu,sigma,mu)
  local rand_list = Matrix.Random({a,b},{n_rand,100000})
  local out = {}
  for i = 1, n_rand do
	for j = 1, 100000 do
		local x = rand_list[i][j]
		if math.random() * fmax <= f(mu,sigma,x) then
			out[i] = Copy(x)
			break
		end
	end
	if out[i] == nil then
		error("rejection sampling did not converge -- check fmax bounds f")
	end
  end
  table.sort(out)
  return out
end

----------------------------
--- End of Functions
----------------------------

-- this test creates plots for several local response functions of a few different tight binding Hamiltonians
-- We furthermore add a local (k independent) self energy
   -- we compare the local response function calculated by integrating over k with a self energy to the
	 -- calculations done using only response functions.

