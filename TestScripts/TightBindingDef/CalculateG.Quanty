-- check first moment of the response functions: compare the G on uniform grid with G on non-uniform grid in the impuritry block

G_u_mat  = ResponseFunction.ToMatrix(G0)
G_nu_mat = ResponseFunction.ToMatrix(G0_nu)

if not Chop(Matrix.Sub(G_u_mat,2,2)-Matrix.Sub(G_nu_mat,2,2)) == Matrix.New({{0,0},{0,0}}) then
	error("Error: Impurity block not the same between G defeined on a uniform grid and G on non-uniform grid!\n",1)
end

G_u_mat  = ResponseFunction.ToMatrix(G)
G_nu_mat = ResponseFunction.ToMatrix(G_nu)

if not Chop(Matrix.Sub(G_u_mat,2,2)-Matrix.Sub(G_nu_mat,2,2)) == Matrix.New({{0,0},{0,0}}) then
