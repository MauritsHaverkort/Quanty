HTB.Atoms = { {"A", {  0,0,0},       {{"s", {"up","dn"}}}} }
HTB.Hopping =  {{"A.s","A.s",{ 1, 0,0},{{-1, 0},{0 ,-1}}},
	              {"A.s","A.s",{-1, 0,0},{{-1, 0},{0 ,-1}}},
								{"A.s","A.s",{ 0, 0,0},{{0 , 0.2},{0.2 ,1}}}
								}
print(HTB)

Sigma = ResponseFunction.New({ {{{0,1},{1,0.5}},-1,3}, { {{1,0.5},{0.5,1}}, {{1,-0.5},{-0.5,2}} }, mu=0, type="ListOfPoles", name="Sigma 1"})

