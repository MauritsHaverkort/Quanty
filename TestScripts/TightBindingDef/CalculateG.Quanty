SigmaList[1][2] = ResponseFunction.New({ {{{0}},-0.4,-0.3,-0.2,-0.1,0,0.1,0.2,0.3,0.4}, {{{0.25}},{{0.25}},{{0.25}},{{0.25}},{{0.25}}, {{0.25}},{{0.25}},{{0.25}},{{0.25}}}, mu=0, type="ListOfPoles", name="Sigma 2"})

