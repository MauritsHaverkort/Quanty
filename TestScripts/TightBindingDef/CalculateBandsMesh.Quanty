print("--------------------------------------------------------")
print("-- TightBinding CalculateBands Method Mesh            --")
print("--------------------------------------------------------")

-- The default route diagonalizes H(k) plus the self energy embedded as a bath state per
-- pole, which costs the cube of the number of poles.  Method "Mesh" evaluates the resolvent
-- off the real axis instead and takes its residues on an energy grid, at a cost that does
-- not grow with the number of poles.  Every exact pole is split over the two grid points
-- around it, so the two agree once the spectra are broadened well above the grid spacing.

-- a two atom, three orbital model so that the characters and the gauge are exercised
H = TightBinding.New()
H.Name  = "two atoms, three orbitals"
H.Units = {"2Pi", "Angstrom", "Absolute"}
H.Cell  = {{1,0,0},{0,1,0},{0,0,1}}
H.Atoms = {{"A", {0.0,0,0}, {{"s", {"0"}}, {"p", {"z"}}}},
           {"B", {0.4,0,0}, {{"s", {"0"}}}}}
-- the connecting vectors are absolute: the distance between the two atoms plus whole unit
-- cells, and every hopping needs its hermitian conjugate written out
H.Hopping = {{"A.s","A.s",{ 0.0,0,0},{{ 0.30}}},
             {"A.p","A.p",{ 0.0,0,0},{{-0.40}}},
             {"B.s","B.s",{ 0.0,0,0},{{ 0.10}}},
             {"A.s","B.s",{ 0.4,0,0},{{ 0.50}}}, {"B.s","A.s",{-0.4,0,0},{{ 0.50}}},
             {"A.p","B.s",{ 0.4,0,0},{{ 0.20}}}, {"B.s","A.p",{-0.4,0,0},{{ 0.20}}},
             {"A.s","A.s",{ 1.0,0,0},{{-0.20}}}, {"A.s","A.s",{-1.0,0,0},{{-0.20}}},
             {"A.p","A.p",{ 1.0,0,0},{{ 0.15}}}, {"A.p","A.p",{-1.0,0,0},{{ 0.15}}},
             {"A.s","B.s",{-0.6,0,0},{{ 0.25}}}, {"B.s","A.s",{ 0.6,0,0},{{ 0.25}}}}

Path = {{"G",{0,0,0}}, 30, {"X",{Pi,0,0}}}
NkPath = 32

-- a self energy on the three orbitals, poles spread over the band
function SigmaOfNPoles(NP)
  local a, b = {Matrix.Zero(3)}, {}
  for i = 1, NP do
    a[i+1] = -2 + 4*(i-1)/(NP-1)
    local d = 0.6/NP
    b[i] = Matrix.New({{d,0,0},{0,2*d,0},{0,0,0}})    -- nothing on B, a shell that is not correlated
  end
  return ResponseFunction.New({a, b, mu = 0, type = "ListOfPoles"})
end

-- the characters: the three orbitals.  With a self energy there are 0, 1 or 3 of them
PAs = Matrix.ToUserdata(Matrix.New({{1,0,0},{0,0,0},{0,0,0}}))
PAp = Matrix.ToUserdata(Matrix.New({{0,0,0},{0,1,0},{0,0,0}}))
PBs = Matrix.ToUserdata(Matrix.New({{0,0,0},{0,0,0},{0,0,1}}))

Emin, Emax, NE = -8, 8, 3200        -- spacing 0.005
GammaG = 0.1                        -- twenty times the spacing

function Compare(name, S, WithCharacters)
  local BE, BEa, BEb, BEc, BM, BMa, BMb, BMc
  if WithCharacters then
    BE, BEa, BEb, BEc = TightBinding.CalculateBands(H, Path, S, PAs, PAp, PBs)
    BM, BMa, BMb, BMc = TightBinding.CalculateBands(H, Path, S, PAs, PAp, PBs,
                     {{"Method","Mesh"},{"Emin",Emin},{"Emax",Emax},{"NE",NE}})
  else
    BE = TightBinding.CalculateBands(H, Path, S)
    BM = TightBinding.CalculateBands(H, Path, S,
                     {{"Method","Mesh"},{"Emin",Emin},{"Emax",Emax},{"NE",NE}})
  end
  local worst, peak, worstsum = 0, 0, 0
  for ik = 1, #BE do
    local se, sm = 0, 0
    local TE, TM = ResponseFunction.ToTable(BE[ik]), ResponseFunction.ToTable(BM[ik])
    for i = 1, #TE[2] do se = se + TE[2][i] end
    for i = 1, #TM[2] do sm = sm + TM[2][i] end
    worstsum = Max(worstsum, Abs(se-sm), Abs(se-3))     -- three orbitals, weight three
    for i = 0, 120 do
      local w = Emin + (Emax-Emin)*i/120
      local sets = WithCharacters and {{BE,BM},{BEa,BMa},{BEb,BMb},{BEc,BMc}} or {{BE,BM}}
      for _, p in ipairs(sets) do
        local a = -Complex.Im(p[1][ik](w, GammaG))/Pi
        local b = -Complex.Im(p[2][ik](w, GammaG))/Pi
        peak = Max(peak, Abs(a)); worst = Max(worst, Abs(a-b))
      end
    end
  end
  print(string.format("%-34s worst |dA|/peak %.2e   sum rule %.2e", name, worst/peak, worstsum))
  if(worst/peak > 2E-2) then
    error("CalculateBands Method Mesh does not reproduce the route that diagonalizes: "..(worst/peak),1)
  end
  if(worstsum > 1E-5) then
    error("CalculateBands Method Mesh loses weight: "..worstsum,1)
  end
end

Compare("20 poles",                  SigmaOfNPoles(20),  false)
Compare("20 poles, three characters",SigmaOfNPoles(20),  true)
Compare("100 poles",                 SigmaOfNPoles(100), false)

-- The cost of the mesh does not grow with the number of poles, the cost of diagonalizing
-- grows as its cube, so a self energy of eight hundred poles is only run through the mesh.
-- What can be checked without the other route is the weight, three orbitals carry three.
BBig = TightBinding.CalculateBands(H, Path, SigmaOfNPoles(800),
         {{"Method","Mesh"},{"Emin",Emin},{"Emax",Emax},{"NE",NE}})
WBig = 0
for ik = 1, #BBig do
  local T, sm = ResponseFunction.ToTable(BBig[ik]), 0
  for i = 1, #T[2] do sm = sm + T[2][i] end
  WBig = Max(WBig, Abs(sm-3))
end
print(string.format("%-34s                          sum rule %.2e", "800 poles, the mesh alone", WBig))
if(WBig > 1E-5) then error("CalculateBands Method Mesh loses weight for a self energy of 800 poles: "..WBig,1) end

-- a self energy of every type reaches the same route
STri = ResponseFunction.ChangeType(SigmaOfNPoles(60), "Tri")
Compare("the same as a chain",       STri, false)

-- an energy grid given point by point
Grid = {}
for i = 0, NE do Grid[i+1] = Emin + (Emax-Emin)*i/NE end
BG = TightBinding.CalculateBands(H, Path, SigmaOfNPoles(20), {{"Method","Mesh"},{"EnergyGrid",Grid}})
BN = TightBinding.CalculateBands(H, Path, SigmaOfNPoles(20), {{"Method","Mesh"},{"Emin",Emin},{"Emax",Emax},{"NE",NE}})
if((Chop(BG[1]-BN[1]) == Chop(BG[1]-BG[1])) ~= true) then
  error("CalculateBands: EnergyGrid and Emin/Emax/NE spanning the same grid disagree",1)
end
print("EnergyGrid agrees with Emin, Emax and NE")

-- what it refuses
S20 = SigmaOfNPoles(20)
Refuse = {{"a method that does not exist",      function() return TightBinding.CalculateBands(H, Path, S20, {{"Method","Squeeze"}}) end},
          {"Mesh without an energy grid",       function() return TightBinding.CalculateBands(H, Path, S20, {{"Method","Mesh"}}) end},
          {"EnergyGrid together with Emin",     function() return TightBinding.CalculateBands(H, Path, S20, {{"Method","Mesh"},{"EnergyGrid",Grid},{"Emin",Emin}}) end},
          {"a grid without a self energy",      function() return TightBinding.CalculateBands(H, Path, {{"Method","Mesh"},{"Emin",Emin},{"Emax",Emax},{"NE",NE}}) end},
          {"Emax below Emin",                   function() return TightBinding.CalculateBands(H, Path, S20, {{"Method","Mesh"},{"Emin",1},{"Emax",-1},{"NE",NE}}) end}}
for _, R in ipairs(Refuse) do
  if(pcall(R[2]) ~= false) then
    error("CalculateBands took "..R[1]..", it should refuse it",1)
  end
end
print("what Method Mesh refuses")

collectgarbage()
print("--------------------------------------------------------")
print("-- End                                                --")
print("--------------------------------------------------------")
