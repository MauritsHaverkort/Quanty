								{"A.s","B.p",{0.1,0.2,-1.7},{{0.0680414, 0.136083, -0.47629}}},
								{"B.p","A.s",{-0.1,-0.2,1.7},{{0.0680414}, {0.136083}, {-0.47629}}},
								
								
								}


HTB3 = NewTightBinding()
HTB3.Name = "cubic lattice"
HTB3.Cell = {{1,1,0},
						 {0,1,0},
						 {0,0,2}}
HTB3.Atoms =  { {"A", {0,0,0},       {{"s", {"0"}}}},
