print("--------------------------------------------------------------------")
print("-- DOS and Bands - unit cell dependence sp differnt sites orbital --")
print("--------------------------------------------------------------------")

HTB1 = NewTightBinding()
HTB1.Name = "cubic lattice"
HTB1.Cell = {{1,0,0},
						 {0,1,0},
						 {0,0,1}}
HTB1.Atoms =  { {"A", {0,0,0},       {{"s", {"0"}}}},
                {"B", {0.1,0.2,0.3}, {{"p", {"x","y","z"}}}}}
HTB1.Hopping = {{"A.s","A.s",{1,0,0},{{1}}},
								{"A.s","A.s",{0,1,0},{{1}}},
								{"A.s","A.s",{0,0,1},{{1}}},
								
								{"B.p","B.p",{1,0,0},{{1,0,0},{0,0.2,0},{0,0,0.2}}},
								{"B.p","B.p",{0,1,0},{{0.2,0,0},{0,1,0},{0,0,0.2}}},
								{"B.p","B.p",{0,0,1},{{0.2,0,0},{0,0.2,0},{0,0,1}}},
								
								{"A.s","B.p",{0.1,0.2,0.3},{{0.267261, 0.534522, 0.801784}}},
								{"B.p","A.s",{-0.1,-0.2,-0.3},{{0.267261}, {0.534522}, {0.801784}}},
								
								{"A.s","B.p",{0.1,0.2,-0.7},{{0.0680414, 0.136083, -0.47629}}},
								{"B.p","A.s",{-0.1,-0.2,0.7},{{0.0680414}, {0.136083}, {-0.47629}}},
								
								
								}


HTB2 = NewTightBinding()
HTB2.Name = "cubic lattice"
