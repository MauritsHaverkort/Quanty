	              {"A.p","A.p",{0,1,0},{{0.2,0,0},{0,1,0},{0,0,0.2}}},
	              {"A.p","A.p",{0,0,1},{{0.2,0,0},{0,0.2,0},{0,0,1}}}
                }


G1 = CalculateG(HTB1, {{"NK",{80,80,80}},{"Emin",-5},{"Emax",5},{"NE",1000}})
G2 = CalculateG(HTB2, {{"NK",{80,80,80}},{"Emin",-5},{"Emax",5},{"NE",1000}})
G3 = CalculateG(HTB3, {{"NK",{80,80,80}},{"Emin",-5},{"Emax",5},{"NE",1000}})
