rotateMat = Orthonormalize(rotateMat, {{"Method","GramSchmidt"}, {"Order","Row"}})

print("\nTesting periodic TB object")

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
          {0,1,0},
          {0,0,1}}
Htb.Atoms={{"O",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"O.s","O.s",{0,0, 1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0,-1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0, 2},{{0.1,0},{0,0.1}}},
