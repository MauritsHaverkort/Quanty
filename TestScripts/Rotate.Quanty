print("---------------------------------------------------------------------------")
print("--                  Rotation Operator with n-particale part              --")
print("---------------------------------------------------------------------------")

-- Define some Operator
Nf = 5
Nb = 0
O = NewOperator(Nf, Nb, {{             10},
                         {0,-0,         3},
                         {0,1,2,3,-4,  1+I}})

-- Define some rotation matrix
rotateMat = {{1,0,3,0,-2},
             {1,0,I,0,0},
             {0,1,0,-2,0},
             {Exp(I*Pi/8),0,0,-1,0}}
rotateMat = Orthonormalize(rotateMat, {{"Method","GramSchmidt"}, {"Order","Row"}})

expectedOpp = NewOperator( 4, 0,{
    { 1.000000000000000E+01 },
    {     0, -   0, 2.142857142857143E-01 + I * 0.000000000000000E+00 },
    {     1, -   0, 6.565991539589371E-01 + I * 1.515228816828316E-01 },
    {     3, -   0, 2.533316929662540E-01 - I * 1.049334230055592E-01 },
    {     0, -   1, 6.565991539589371E-01 - I * 1.515228816828316E-01 },
    {     1, -   1, 2.119047619047620E+00 + I * 4.624866754108578E-17 },
    {     3, -   1, 7.020419496252479E-01 - I * 5.006621429007453E-01 },
    {     0, -   3, 2.533316929662540E-01 + I * 1.049334230055592E-01 },
    {     1, -   3, 7.020419496252478E-01 + I * 5.006621429007453E-01 },
    {     3, -   3, 3.508771929824560E-01 + I * 3.433844065205237E-18 },
    {     3,     2,     1,     0, -   0, 1.734219939048240E-01 + I * 3.468439878096480E-01 },
    {     3,     2,     1,     0, -   1, 2.043797798283220E-01 - I * 2.043797798283220E-01 },
    {     3,     2,     1,     0, -   3,-3.800192370792179E-01 - I * 9.735956626746517E-02 }},
   {{"Name","Operator"},{"NBitsKey",{0,6,0,0,6}}})

res = Chop(Rotate(O,rotateMat))
if Chop(res - expectedOpp) ~= 0*res then
    error("Result of rotation not equal to the expected value\n",1)
end


