res = Chop( Rotate(matrixR, rotateMatRS) )
if Matrix.ToUserdata(Chop(res - expectedMat, threshold)) ~= Matrix.Zero(#expectedMat) then
    error("Result of rotation not equal to the expected value\n",1)
end
-- Test in operator form
res = Chop( Rotate(Matrix.ToOperator(matrixR), rotateMatRS) )
if Matrix.ToUserdata(Chop(OperatorToMatrix(res) - expectedMat, threshold)) ~= Matrix.Zero(#expectedMat) then
    error("Result of rotation not equal to the expected value\n",1)
end
