print("------------------------------------------------")
print("--                  Rotate                    --")
print("------------------------------------------------")

-- Rotate can be used for 4 types of objects: wave-functions, operators, TB objects and matrices.
-- The rotation matrix and the object can be complex or real.
-- The rotation matrix could be square or non-square.

-- threshold for comparison with expected result
threshold = 1E-13

print("---------------------------------------------------------------------------")
print("--                  Rotation of Matrix and Square Operator               --")
print("---------------------------------------------------------------------------")


-- some random unitary matrix (real, square)
rotateMatRS = {{-7,1,-2,-2,3,-4,9,2,4,0},{1,8,3,6,3,-5,7,4,-1,9},{-4,-10,8,-4,-3,1,-4,-2,-3,-6},{-5,0,7,1,2,10,1,3,-2,0},{-10,3,-6,-9,3,9,10,7,-3,7},{-10,8,-2,-7,2,8,9,-10,-8,5},{-3,-2,5,-9,10,-6,-5,-3,10,2},{5,-4,5,1,4,-10,9,-7,1,6},{0,1,-8,4,5,9,-4,2,-4,0},{6,8,-6,2,-9,6,-1,-9,7,-4}}
rotateMatRS = Orthonormalize(rotateMatRS, {{"Method","GramSchmidt"}, {"Order","Row"}})
-- some random unitary matrix (real, non-square)
rotateMatRNS = {{-1,-2,5,1,7,-2,3,10,4,-7},{8,-8,3,10,1,-1,10,10,6,0},{2,-4,-10,5,0,-5,2,-8,0,-8},{3,4,-6,3,-3,-6,-3,5,9,5},{3,1,-1,7,-4,-7,-1,0,-8,1},{0,4,3,3,0,3,-3,1,10,5}}
rotateMatRNS = Orthonormalize(rotateMatRNS, {{"Method","GramSchmidt"}, {"Order","Row"}})
-- some random unitary matrix (complex, square)
rotateMatCS = {{-10+2*I,-4*I,-7+9*I,4+9*I,8+7*I,-8+6*I,-4-4*I,2-6*I,2+8*I,-8-2*I},{-7,-3+I,-3+9*I,5-I,10-10*I,-6+4*I,-6-5*I,3-6*I,3+6*I,-3-2*I},{-6*I,-1+9*I,9+2*I,7-2*I,9-3*I,-8+10*I,-5+9*I,-9+4*I,6+8*I,-10-8*I},{4-9*I,7-8*I,1-5*I,-10+3*I,2-I,6-4*I,6+2*I,8-7*I,-6+6*I,-5+6*I},{-3+5*I,-5-10*I,7+10*I,-10-6*I,5-6*I,4-5*I,-6-2*I,-7-2*I,8-9*I,-4-8*I},{5-2*I,-3,-5-8*I,-5+3*I,5+I,-6-10*I,-7-8*I,-8+I,2-10*I,-9+9*I},{-1+9*I,-7+5*I,-1-9*I,-4+5*I,5-8*I,6,-6-I,-3-4*I,-10-3*I,10-3*I},{-5-9*I,-1+9*I,9+7*I,4+3*I,-4+I,1+7*I,10-4*I,-7-5*I,4+2*I,1-I},{4-8*I,-1+I,8+10*I,5-I,-3+9*I,-3-2*I,7+2*I,-10+3*I,8-6*I,-6-9*I},{1-I,-5-3*I,8-10*I,-1+6*I,8-10*I,-7-9*I,-3-8*I,-4*I,-7,-8*I}}
rotateMatCS = Orthonormalize(rotateMatCS, {{"Method","GramSchmidt"}, {"Order","Row"}})
-- some random unitary matrix (complex, non-square)
rotateMatCNS = {{-6*I,-7-6*I,-7-I,6+2*I,9-6*I,-9+3*I,-4-8*I,-1-5*I,-6-9*I,-8-9*I},{8-8*I,8*I,-3-9*I,6+6*I,-10+7*I,-7-9*I,8-2*I,7-5*I,6+6*I,-10+8*I},{7-5*I,-4-2*I,3-4*I,9-4*I,4-7*I,-2-2*I,10+9*I,-2-3*I,-2-I,-3-6*I},{9+4*I,-4-3*I,9+9*I,9-6*I,-3+10*I,6-I,6-3*I,4+5*I,4+7*I,-2+3*I},{8+7*I,-4+3*I,-10-7*I,7+6*I,1-7*I,8-4*I,0,1+8*I,9+I,-9-9*I},{3-8*I,0,-5-3*I,8-2*I,-2+I,-1+10*I,-7,-7+4*I,10-I,9+3*I}}
rotateMatCNS = Orthonormalize(rotateMatCNS, {{"Method","GramSchmidt"}, {"Order","Row"}})

-- Define some random Hermitian matrix (real)
matrixR = {{10,-10,10,0,-7,-5,8,4,-7,10},{0,8,-9,-1,9,8,-9,10,-9,1},{-7,-9,-9,-1,-7,-5,-7,-1,-10,0},{10,0,-10,-4,-8,-1,6,10,10,4},{1,0,7,-2,0,-9,5,6,-5,7},{-4,6,-1,2,-8,1,5,9,-5,6},{6,6,-6,1,-1,6,-3,10,10,4},{-8,-8,3,5,1,4,5,1,-4,-4},{4,-2,-9,-1,-6,6,10,-1,10,10},{8,8,-5,5,3,1,-4,1,-6,10}}
setmetatable(matrixR, MatrixMeta)
matrixR = Chop( (matrixR + ConjugateTranspose(matrixR))/2 )
-- Define some random Hermitian matrix (complex)
matrixC = {{1,-3-(5*I)/2,9/2+(7*I)/2,-4-(3*I)/2,-(1/2)-(5*I)/2,3/2+(7*I)/2,-(9/2)+(17*I)/2,7*I,-(13/2)+3*I,9/2+7*I},{-3+(5*I)/2,9,-5+2*I,5/2-2*I,-6-(15*I)/2,-(9/2)+I,3+(3*I)/2,1/2-7*I,3+(5*I)/2,4+(15*I)/2},{9/2-(7*I)/2,-5-2*I,1,-(3/2)+4*I,3/2+I,9/2+2*I,5/2-9*I,-(1/2)+(5*I)/2,1+5*I,5-I/2},{-4+(3*I)/2,5/2+2*I,-(3/2)-4*I,8,-(9/2)+(5*I)/2,5-4*I,-5+5*I,-4-(5*I)/2,6-I/2,-(3/2)-4*I},{-(1/2)+(5*I)/2,-6+(15*I)/2,3/2-I,-(9/2)-(5*I)/2,9,-(3/2)+7*I,8-(9*I)/2,-(5/2)-2*I,1/2-(5*I)/2,-7+(7*I)/2},{3/2-(7*I)/2,-(9/2)-I,9/2-2*I,5+4*I,-(3/2)-7*I,0,9/2-(19*I)/2,-3+I/2,I/2,-3-I/2},{-(9/2)-(17*I)/2,3-(3*I)/2,5/2+9*I,-5-5*I,8+(9*I)/2,9/2+(19*I)/2,7,-1+(5*I)/2,2+(13*I)/2,15/2-(7*I)/2},{-7*I,1/2+7*I,-(1/2)-(5*I)/2,-4+(5*I)/2,-(5/2)+2*I,-3-I/2,-1-(5*I)/2,-1,15/2-2*I,-(9/2)+I/2},{-(13/2)-3*I,3-(5*I)/2,1-5*I,6+I/2,1/2+(5*I)/2,-(I/2),2-(13*I)/2,15/2+2*I,0,-2*I},{9/2-7*I,4-(15*I)/2,5+I/2,-(3/2)+4*I,-7-(7*I)/2,-3+I/2,15/2+(7*I)/2,-(9/2)-I/2,2*I,-6}}
setmetatable(matrixC, MatrixMeta)
matrixC = Chop( (matrixC + ConjugateTranspose(matrixC))/2 )


print("\nTesting rotation with real, square rotation matrix")
