--some vectors operation
function crossProd(a,b)
  local c = {}
  c[1] = a[2]*b[3]-a[3]*b[2]
  c[2] = a[3]*b[1]-a[1]*b[3]
  c[3] = a[1]*b[2]-a[2]*b[1]
  return c
end

function dotProd(a,b)
  local c = 0
  for i=1,#a do
    c = c + a[i]*b[i]
  end
  return c
end

function scalarMult(b,a)
  local c = {}
  for i=1,#a do
    c[i] = a[i]*b
  end
  return c
end

function getReciprocalLatticeVectors(a1,a2,a3,scaling)
  
  local V = dotProd(a1,(crossProd(a2,a3)))
  
  local b1 = scalarMult((scaling/V),crossProd(a2,a3))
  local b2 = scalarMult((scaling/V),crossProd(a3,a1))
  local b3 = scalarMult((scaling/V),crossProd(a1,a2))
  
  return b1,b2,b3
end

--function checking that three vetors are linera independent
function checkLinearIndep(a1,a2,a3)
  local V = dotProd(a1,(crossProd(a2,a3)))
  if V == 0 then
    return false
  else
    return true
  end
end 

--function comparing two tables
function deepCompare(t1, t2)
  if t1 == t2 then return true end
  if type(t1) ~= "table" or type(t2) ~= "table" then return false end
  for k, v in pairs(t1) do
      if not deepCompare(v, t2[k]) then return false end
  end
  for k, v in pairs(t2) do
      if not deepCompare(v, t1[k]) then return false end
  end
  return true
end





--set Hoppings
--random numbers between 0 and 10 
t1 = math.random()*10               
t2 = math.random()*10   


print("=====================")
print("check functionalities")
print("=====================")

-- create the tight binding Hamiltonian
HTB = NewTightBinding()


--Gererate linearly independent vectors for the basis
rVectorsFound=false
while rVectorsFound==false do
  r1={math.random()*10 ,math.random()*10 ,math.random()*10 }
  r2={math.random()*10 ,math.random()*10 ,math.random()*10 }
  r3={math.random()*10 ,math.random()*10 ,math.random()*10 }
  rVectorsFound = checkLinearIndep(r1,r2,r3)
end
rCell={r1,r2,r3}

HTB.Name = "Test Random Vectors"
HTB.Cell = rCell
HTB.Units= {"2Pi","Angstrom","Absolute"}


print("check Units scaling of reciprocal lattice vectors")
g1,g2,g3=getReciprocalLatticeVectors(r1,r2,r3,2*math.pi)  
gCell={g1,g2,g3}

--for 2Pi
for i=1,3 do
  for j=1,3 do
  assert(HTB.ReciprocalCell[i][j]-gCell[i][j]<1e-10,"Wrong computation of the reciprocal lattice vectors")
  end
end

--for NoPi
HTB.Units= {"NoPi","Angstrom","Absolute"}
g1,g2,g3=getReciprocalLatticeVectors(r1,r2,r3,1)  
gCell={g1,g2,g3}

--check that the lattice vectors are correct
for i=1,3 do
  for j=1,3 do
  assert(HTB.ReciprocalCell[i][j]-gCell[i][j]<1e-10,"Wrong computation of the reciprocal lattice vectors")
  end
end

print("check the conversion of units of length")

Ang=10^-10
nm=10^-9
Bohr=5.29177210903*10^-11

UnitsLs={"Angstrom","Bohr","nm"}
for k,v in pairs(UnitsLs) do
  HTB.Units={v}
  print(HTB.Units[2],UnitsLs[k])
  assert(HTB.Units[2]==UnitsLs[k],"Could not set the units of length")
end

HTB.Units={"Angstrom"}
--check that the lattice vectors are correct
HTB.Cell = rCell

