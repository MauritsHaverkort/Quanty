print("Check absolute versus relative coordinats")

HTB2=Clone(HTB)

HTB.Units={"Absolute"}
--All the atoms positions and hoppings translations are set in absolute coordinates.

rA={0,0,0}
rB={0.5*r1[1],0.5*r1[1],0.5*r1[1]}

setAtomsHTB={ {"A", rA,{{"s", {"0"}}}},
{"B", rB,{{"s", {"0"}}}}
    }
HTB.Atoms =  setAtomsHTB
HTB.Hopping = {{"A.s","B.s",rB,{{t1}}},
}

--check if the two tablelib are the same
assert(deepCompare(HTB.Atoms,setAtomsHTB),"setting of atoms position did Not work")


HTB2.Units={"Relative"}
--All the atoms positions and hoppings translations are set in relative coordinates.
--The relative coordinates are set in the basis of the lattice vectors. 
--While the position of the atoms can be set to be real numbers,
--the hopping translations are set in the basis of the lattice vectors and the hopping between A and B inside the same cell has 
--translation (0,0,0). It would be interesting if, for the case where we would cut all hopping with jumps longer than epsilon, 
--if then the hopping between A and B would be cut.

setAtomsHTB2={ {"A", {0,0,0},         {{"s", {"0"}}}},
              {"B", {0.5,0,0},         {{"s", {"0"}}}}
                  }
HTB2.Atoms = setAtomsHTB2 
HTB2.Hopping = {{"A.s","B.s",{0,0,0},{{t1}}},
}

--check if the two tablelib are the same
assert(deepCompare(HTB2.Atoms,setAtomsHTB2),"setting of atoms position did Not work")

