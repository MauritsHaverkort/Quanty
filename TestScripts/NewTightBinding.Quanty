print("Check the setting of the hopping by using the hopping function. Compare the crated H operater with the one expected to be")
-- create the tight binding Hamiltonian
HTB = NewTightBinding()

HTB.Name = "Test periodic"
HTB.Units= {"2Pi","Angstrom","Absolute"}
HTB.Cell = {{1,0,0},
            {0,1,0},
            {0,0,1}}

HTB.Atoms = { {"A", {0,0,0},         {{"s", {"0"}}}}}
HTB.Hopping = {{"A.s","A.s",{1,0,0},{{t1}}},
            }


print("Single site")
HCl, HClTB, Cellpos, Kvec = CreateClusterHamiltonian(HTB, {"periodic", {{1,0,0},{0,1,0},{0,0,1}}}, 
    {{"ReturnTBSuperCell",true},{"ReturnTBCellPositions",true}, {"ReturnTBKVectors",true} })

--oppN Valence band
OppList={}
for i=0,0 do
  OppList[#OppList+1] = {i,-(i),t1}
end
OppHtest = NewOperator(1,0,OppList)

--assert if HClTB is same as OppHtest
assert(HCl==OppHtest,"Error: HClTB is not the same as OppHtest")



Nx=10
print("many sites")
HCl, HClTB, Cellpos, Kvec = CreateClusterHamiltonian(HTB, {"periodic", {{Nx,0,0},{0,1,0},{0,0,1}}}, 
    {{"ReturnTBSuperCell",true},{"ReturnTBCellPositions",true}, {"ReturnTBKVectors",true} })

--oppN Valence band
OppList={}
for i=1,Nx do
  OppList[#OppList+1] = {i%10,-((i+1)%10),t1}
  --OppList[#OppList+1] = {-((i+1)%10),i%10,1}
end

print(OppList)
OppHtest = NewOperator(10,0,OppList)

print(OppHtest)
--assert if HClTB is same as OppHtest
assert(HCl==OppHtest,"Error: HClTB is not the same as OppHtest")

