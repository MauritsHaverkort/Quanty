M1 = {{5, 1, 2, 0},
			{0, 5, 0, 2},
			{2, 0, 5, 1},
			{0, 9, 1, 5}}
setmetatable(M1, MatrixMeta)

M1T= {{5, 0, 2, 0},
			{1, 5, 0, 9},
			{2, 0, 5, 1},
			{0, 2, 1, 5}}
setmetatable(M1T, MatrixMeta)

M2 = Matrix.Transpose(M1)

if not(M1T == M2) then
	error("Error in Matrix ToUserdata\n",1)
end

collectgarbage()
collectgarbage()
collectgarbage()
collectgarbage()
print("Finished Transpose")
