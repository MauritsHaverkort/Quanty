function TestIfMatrixIsZero(M)
	for i=1,#M do
		for j=1,#M[i] do
			if not(M[i][j]==0) then
				error("Matrix non-zero at i,j = "..tostring(i).." , "..tostring(j).." with val "..tostring(M[i][j]).."\n",1)
			end
		end
	end
end


