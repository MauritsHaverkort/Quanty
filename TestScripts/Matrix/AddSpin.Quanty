M1 = {{ 1, 2},
			{ 5, 6}}
setmetatable(M1, MatrixMeta)
M1D = Matrix.New(M1)

M1C = M1 + I*M1
M1CD = Matrix.New(M1C)

M2 = { { 1 , 0 , 2 , 0 } ,
	     { 0 , 1 , 0 , 2 } ,
       { 5 , 0 , 6 , 0 } ,
       { 0 , 5 , 0 , 6 } }
setmetatable(M2, MatrixMeta)
M2D = Matrix.New(M2)

M2C = M2 + I*M2
M2CD = Matrix.New(M2C)

if not(Matrix.AddSpin(M1) == M2) then
	error("Error in Matrix AddSpin\n",1)
end

if not(Matrix.AddSpin(M1C) == M2C) then
	error("Error in Matrix AddSpin\n",1)
end

if not(Matrix.AddSpin(M1D) == M2D) then
	error("Error in Matrix AddSpin\n",1)
end

if not(Matrix.AddSpin(M1CD) == M2CD) then
	error("Error in Matrix AddSpin\n",1)
end

collectgarbage()
collectgarbage()
collectgarbage()
collectgarbage()
print("Finished AddSpin")
