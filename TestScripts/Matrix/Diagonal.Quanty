M1 = {{ 1, 0, 0, 0},
			{ 0, 2, 0, 0},
			{ 0, 0, 3, 0},
			{ 0, 0, 0, 4}}
setmetatable(M1, MatrixMeta)
M1D = Matrix.New(M1)

M1C = M1 + I*M1
M1CD = Matrix.New(M1C)

if not(Matrix.Diagonal({1,2,3,4}) == M1D) then
	error("Error in Matrix Diagonal\n",1)
end

if not(Matrix.Diagonal({1+1*I,2+2*I,3+3*I,4+4*I}) == M1CD) then
	error("Error in Matrix Diagonal\n",1)
end

if not(Matrix.Diagonal({1,2,3,4},{{"Userdata",false}}) == M1) then
	error("Error in Matrix Diagonal\n",1)
end

if not(Matrix.Diagonal({1+1*I,2+2*I,3+3*I,4+4*I},{{"Userdata",false}}) == M1C) then
	error("Error in Matrix Diagonal\n",1)
end

collectgarbage()
collectgarbage()
collectgarbage()
collectgarbage()
print("Finished Diagonal")
