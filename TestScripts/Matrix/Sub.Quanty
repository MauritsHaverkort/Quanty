M = Matrix.Random({-1,1},{5,5})

-- matrix and size of submatrix

Msub = Matrix.Sub(M,2)
Mnew = Matrix.New({{M[1][1],M[1][2]},{M[2][1],M[2][2]}})

if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end

-- matrix and list of indices

Msub = Matrix.Sub(M,{1,3,4})
Mnew = Matrix.New({{M[1][1],M[1][3],M[1][4]},{M[3][1],M[3][3],M[3][4]},{M[4][1],M[4][3],M[4][4]}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end
-- matrix, number of rows and number of columns of submatrix

Msub = Matrix.Sub(M,2,3)
Mnew = Matrix.New({{M[1][1],M[1][2],M[1][3]},{M[2][1],M[2][2],M[2][3]}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end
-- matrix, table with first and last index of row, table with first and last index of column

Msub = Matrix.Sub(M,{2,2},{3,4})
Mnew = Matrix.New({{M[2][3],M[2][4]}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end

-- matrix, first row index, number of rows, first column index, number of columns

Msub = Matrix.Sub(M, 2,2, 3,1)
Mnew = Matrix.New({{M[2][3]},{M[3][3]}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end


M = Matrix.ToTable(M)

Msub = Matrix.Sub(M,2)
Mnew = Matrix.New({{M[1][1],M[1][2]},{M[2][1],M[2][2]}},{{"userdata",false}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end

-- matrix and list of indices

Msub = Matrix.Sub(M,{1,3,4})
Mnew = Matrix.New({{M[1][1],M[1][3],M[1][4]},{M[3][1],M[3][3],M[3][4]},{M[4][1],M[4][3],M[4][4]}},{{"userdata",false}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end
-- matrix, number of rows and number of columns of submatrix

Msub = Matrix.Sub(M,2,3)
Mnew = Matrix.New({{M[1][1],M[1][2],M[1][3]},{M[2][1],M[2][2],M[2][3]}},{{"userdata",false}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end
-- matrix, table with first and last index of row, table with first and last index of column

Msub = Matrix.Sub(M,{2,2},{3,4})
Mnew = Matrix.New({{M[2][3],M[2][4]}},{{"userdata",false}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end

-- matrix, first row index, number of rows, first column index, number of columns

Msub = Matrix.Sub(M, 2,2, 3,1)
Mnew = Matrix.New({{M[2][3]},{M[3][3]}},{{"userdata",false}})
if not(Msub==Mnew) then
	error("Error in Matrix sub\n",1)
end

collectgarbage()
collectgarbage()
collectgarbage()
collectgarbage()
print("Finished Sub")
