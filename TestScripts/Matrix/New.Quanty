M1 = {{5, 1, 2, 0},
			{1, 5, 0, 2},
			{2, 0, 5, 1},
			{0, 2, 1, 5}}
setmetatable(M1, MatrixMeta)
M1D = Matrix.New(M1)
M1U = Matrix.ToUserdata(M1)

if not(M1D==M1U) then
	error("Error in Matrix Expand\n",1)
end

collectgarbage()
collectgarbage()
collectgarbage()
collectgarbage()
print("Finished New")
