print("create a cluster Hamiltonian with some atoms and some orbs")
HCl, HClTB = CreateClusterHamiltonian(TB, {"open", NewCluster}, 
                                          {{"AddSpin", false}, {"ReturnTBSuperCell", false}, {"ReturnTBCellPositions", false}, {"ReturnTBKVectors", false}, {"ReturnTBIndicesDict", false}, {"k", {}}})

if Chop(HCl - RefHCl, threshold)~=0*HCl then print(Chop(HCl - RefHCl, threshold)); error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF -RefNF ~= 0 then error("Number of fermions not correct\n",1) end

print("create a cluster Hamiltonian with some atoms and spin and ReturnTBIndicesDict")
HCl, HClTB, TBIdxDict  = CreateClusterHamiltonian(TB, {"open", NewCluster}, 
                                          {{"AddSpin", true}, {"ReturnTBSuperCell", false}, {"ReturnTBCellPositions", false}, {"ReturnTBKVectors", false}, {"ReturnTBIndicesDict", true}, {"k", {}}})

if Chop(HCl - Matrix.ToOperator(Matrix.AddSpin(OperatorToMatrix(RefHCl))))~=0*HCl then print(Chop(HCl - Matrix.ToOperator(Matrix.AddSpin(OperatorToMatrix(RefHCl))))); error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF - RefNF ~= 0 then error("Number of fermions not correct\n",1) end
if not compareDictionaries(TBIdxDict, RefTBIdxDict) then error("Output dict not equal to the expected value\n",1) end


