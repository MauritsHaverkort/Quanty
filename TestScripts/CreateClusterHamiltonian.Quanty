-- Function to compare two tables
local function compareTables(t1, t2, threshold)
    if #t1 ~= #t2 then
        return false
    end
    if threshold == nil then
        for i = 1, #t1 do
            if (type(t1[i]) == "table") and (type(t2[i]) == "table") then
                if #t1[i] ~= #t2[i] then
                    return false
                end
                for j = 1, #t1[i] do
                    if t1[i][j] ~= t2[i][j] then
                        return false
                    end
                end
            else
                if t1[i] ~= t2[i] then
                    return false
                end
            end
        end
    else
        for i = 1, #t1 do
            if (type(t1[i]) == "table") and (type(t2[i]) == "table") then
                if #t1[i] ~= #t2[i] then
                    return false
                end
                for j = 1, #t1[i] do
                    if Chop(t1[i][j] - t2[i][j], threshold) ~= 0 then
                        return false
                    end
                end
            else
                if Chop(t1[i] - t2[i], threshold) ~= 0 then
                    return false
                end
            end
        end
    end
    
    return true
end

-- Function to compare two dictionaries
local function compareDictionaries(dict1, dict2)
    -- First, check if both dictionaries have the same set of keys
    for key in pairs(dict1) do
        if dict2[key] == nil then
            return false
        end
    end
    
    for key in pairs(dict2) do
        if dict1[key] == nil then
            return false
        end
    end

    -- Now compare the values for each key
    for key, value in pairs(dict1) do
        local value2 = dict2[key]

        if type(value) == "table" and type(value2) == "table" then
            if not compareTables(value, value2) then
                -- print(key)
                -- print(value)
                -- print(value2)
                return false
            end
        else
            if value ~= value2 then
                return false
            end
        end
    end

    return true
end

-- threshold for comparison with the expected result (used only in the case of DFT TB object)
threshold = 1E-13

