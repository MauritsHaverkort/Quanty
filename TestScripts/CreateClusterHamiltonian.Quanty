-- set parameters
dAB = 0.2
tnn = 1.1
-- create the tight binding Hamiltonian
HTB = NewTightBinding()
HTB.Name = "dichalcogenide tight binding"
HTB.Cell = {{sqrt(3),0,0},
            {sqrt(3/4),3/2,0},
            {0,0,1}}
HTB.Atoms = { {"A", {0,0,0},       {{"p", {"0"}}}},
              {"B", {sqrt(3),1,0}, {{"p", {"0"}}}}}
HTB.Hopping = {{"A.p","A.p",{         0,   0,0},{{-dAB/2}}},
               {"B.p","B.p",{         0,   0,0},{{ dAB/2}}},
               {"A.p","B.p",{         0,   1,0},{{ tnn  }}},
               {"B.p","A.p",{         0,  -1,0},{{ tnn  }}},
               {"A.p","B.p",{ sqrt(3/4),-1/2,0},{{ tnn  }}},
               {"B.p","A.p",{-sqrt(3/4), 1/2,0},{{ tnn  }}},
               {"A.p","B.p",{-sqrt(3/4),-1/2,0},{{ tnn  }}},
               {"B.p","A.p",{ sqrt(3/4), 1/2,0},{{ tnn  }}}
              }
print("create a cluster Hamiltonian")
HCl, HClTB = CreateClusterHamiltonian(HTB, {"open", {{"A", {0,0,0}}, {"B", {sqrt(3),1,0}},
                                                     {"B", {0,1,0}},
                                                     {"B", { sqrt(3/4),-1/2,0}}, 
                                                     {"B", {-sqrt(3/4),-1/2,0}}, 
                                                     {"A", {sqrt(3),0,0}},
                                                     {"A", {sqrt(3/4), 3/2,0}},
                                                     {"A", {3*sqrt(3/4), 3/2,0}}}}, 
                                                     {{"AddSpin", false}, {"ReturnTBSuperCell", false}, {"ReturnTBCellPositions", false}, {"ReturnTBKVectors", false}, {"ReturnTBIndicesDict", false}, {"k", {}}})


if Chop(HCl - RefHCl)~=0*HCl then error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF -RefNF ~= 0 then error("Number of fermions not correct\n",1) end

print("create a cluster Hamiltonian with ReturnTBIndicesDict")
HCl, HClTB, TBIdxDict = CreateClusterHamiltonian(HTB, {"open", {{"A", {0,0,0}}, {"B", {sqrt(3),1,0}},
                                                     {"B", {0,1,0}},
                                                     {"B", { sqrt(3/4),-1/2,0}}, 
                                                     {"B", {-sqrt(3/4),-1/2,0}}, 
                                                     {"A", {sqrt(3),0,0}},
                                                     {"A", {sqrt(3/4), 3/2,0}},
                                                     {"A", {3*sqrt(3/4), 3/2,0}}}}, 
                                                     {{"AddSpin", false}, {"ReturnTBSuperCell", false}, {"ReturnTBCellPositions", false}, {"ReturnTBKVectors", false}, {"ReturnTBIndicesDict", true}, {"k", {}}})

if Chop(HCl - RefHCl)~=0*HCl then error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF - RefNF ~= 0 then error("Number of fermions not correct\n",1) end
if not compareDictionaries(TBIdxDict, RefTBIdxDict) then error("Output dict not equal to the expected value\n",1) end

print("create a cluster Hamiltonian with spin and ReturnTBIndicesDict")
HCl, HClTB, TBIdxDict = CreateClusterHamiltonian(HTB, {"open", {{"A", {0,0,0}}, {"B", {sqrt(3),1,0}},
                                                     {"B", {0,1,0}},
                                                     {"B", { sqrt(3/4),-1/2,0}}, 
                                                     {"B", {-sqrt(3/4),-1/2,0}}, 
                                                     {"A", {sqrt(3),0,0}},
                                                     {"A", {sqrt(3/4), 3/2,0}},
                                                     {"A", {3*sqrt(3/4), 3/2,0}}}}, 
                                                     {{"AddSpin", true}, {"ReturnTBSuperCell", false}, {"ReturnTBCellPositions", false}, {"ReturnTBKVectors", false}, {"ReturnTBIndicesDict", true}, {"k", {}}})

if Chop(HCl - Matrix.ToOperator(Matrix.AddSpin(OperatorToMatrix(RefHCl))))~=0*HCl then error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF - RefNF ~= 0 then error("Number of fermions not correct\n",1) end
if not compareDictionaries(TBIdxDict, RefTBIdxDictWithSpin) then error("Output dict not equal to the expected value\n",1) end

