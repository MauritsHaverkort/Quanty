RefOppU = NewOperator( 36, 0,{
{    1,    0,-   1,-   0,-1.000000000000000E+00 },
{    5,    4,-   5,-   4,-1.000000000000000E+00 },
{    9,    8,-   9,-   8,-1.000000000000000E+00 },
{   13,   12,-  13,-  12,-1.000000000000000E+00 },
{   17,   16,-  17,-  16,-1.000000000000000E+00 },
{   21,   20,-  21,-  20,-1.000000000000000E+00 },
{   25,   24,-  25,-  24,-1.000000000000000E+00 },
{   29,   28,-  29,-  28,-1.000000000000000E+00 },
{   33,   32,-  33,-  32,-1.000000000000000E+00 }},
{{"Name","Operator"},{"NBitsKey",{0,12,0,6}}}) 

-- set parameters
dAB = 0.2
tnn = 1.1
-- create the tight binding Hamiltonian
HTB = NewTightBinding()
HTB.Name = "dichalcogenide tight binding"
HTB.Cell = {{sqrt(3),0,0},
            {sqrt(3/4),3/2,0},
            {0,0,1}}
HTB.Atoms = { {"A", {0,0,0},       {{"p", {"0"}}}},
              {"B", {sqrt(3),1,0}, {{"p", {"0"}}}}}
HTB.Hopping = {{"A.p","A.p",{         0,   0,0},{{-dAB/2}}},
               {"B.p","B.p",{         0,   0,0},{{ dAB/2}}},
               {"A.p","B.p",{         0,   1,0},{{ tnn  }}},
               {"B.p","A.p",{         0,  -1,0},{{ tnn  }}},
               {"A.p","B.p",{ sqrt(3/4),-1/2,0},{{ tnn  }}},
               {"B.p","A.p",{-sqrt(3/4), 1/2,0},{{ tnn  }}},
               {"A.p","B.p",{-sqrt(3/4),-1/2,0},{{ tnn  }}},
               {"B.p","A.p",{ sqrt(3/4), 1/2,0},{{ tnn  }}}
              }
print("create a cluster Hamiltonian")
HCl = CreateClusterHamiltonian(HTB, {"periodic", {{3,0,0},{0,3,0},{0,0,1}}}, 
                                                     {{"AddSpin", false}, {"ReturnTBSuperCell", false}, {"ReturnTBCellPositions", false}, {"ReturnTBKVectors", false}, {"ReturnTBIndicesDict", false}, {"k", {0,0,0}}})

if Chop(HCl - RefHCl)~=0*HCl then error("Output operator to equal to the expected value\n",1) end

print("create a cluster Hamiltonian with ReturnTBSuperCell, ReturnTBCellPositions, ReturnTBKVectors, ReturnTBIndicesDict")
HCl, HClTB, TBVecs, TBKVecs, TBIdxDict = CreateClusterHamiltonian(HTB, {"periodic", {{3,0,0},{0,3,0},{0,0,1}}}, 
                                                     {{"AddSpin", false}, {"ReturnTBSuperCell", true}, {"ReturnTBCellPositions", true}, {"ReturnTBKVectors", true}, {"ReturnTBIndicesDict", true}, {"k", {0,0,0}}})


if Chop(HCl - RefHCl)~=0*HCl then error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF -RefNF ~= 0 then error("Number of fermions not correct\n",1) end
if not compareTables(TBVecs, RefTBVecs) then error("TB vectors not equal to the expected value\n",1) end
if not compareTables(TBKVecs, RefTBKVecs, threshold) then error("TB reciprocal vectors not equal to the expected value\n",1) end
if not compareDictionaries(TBIdxDict, RefTBIdxDict) then error("Output dict not equal to the expected value\n",1) end

print("create a cluster Hamiltonian with spin, ReturnTBSuperCell, ReturnTBCellPositions, ReturnTBKVectors, ReturnTBIndicesDict")
HCl, HClTB, TBVecs, TBKVecs, TBIdxDict = CreateClusterHamiltonian(HTB, {"periodic", {{3,0,0},{0,3,0},{0,0,1}}}, 
                                                     {{"AddSpin", true}, {"ReturnTBSuperCell", true}, {"ReturnTBCellPositions", true}, {"ReturnTBKVectors", true}, {"ReturnTBIndicesDict", true}, {"k", {0,0,0}}})


if Chop(HCl - Matrix.ToOperator(Matrix.AddSpin(OperatorToMatrix(RefHCl))))~=0*HCl then error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF -RefNF ~= 0 then error("Number of fermions not correct\n",1) end
if not compareTables(TBVecs, RefTBVecs) then error("TB vectors not equal to the expected value\n",1) end
if not compareTables(TBKVecs, RefTBKVecs, threshold) then error("TB reciprocal vectors not equal to the expected value\n",1) end
if not compareDictionaries(TBIdxDict, RefTBIdxDictWithSpin) then error("Output dict not equal to the expected value\n",1) end

print("create a cluster Hamiltonian with k at {Pi, 0, 0}")
HCl, HClTB, TBVecs, TBKVecs, TBIdxDict = CreateClusterHamiltonian(HTB, {"periodic", {{3,0,0},{0,3,0},{0,0,1}}}, 
                                                     {{"AddSpin", false}, {"ReturnTBSuperCell", true}, {"ReturnTBCellPositions", true}, {"ReturnTBKVectors", true}, {"ReturnTBIndicesDict", true}, {"k", {Pi,0,0}}})

if Chop(HCl - RefHClK)~=0*HCl then error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF -RefNF ~= 0 then error("Number of fermions not correct\n",1) end
if not compareTables(TBVecs, RefTBVecs) then error("TB vectors not equal to the expected value\n",1) end
if not compareTables(TBKVecs, RefTBKVecs, threshold) then error("TB reciprocal vectors not equal to the expected value\n",1) end
if not compareDictionaries(TBIdxDict, RefTBIdxDict) then error("Output dict not equal to the expected value\n",1) end
          
OppU = NewOperator(4, 0, {{1,-1,0,-0,1}})
print("create a cluster Hamiltonian with spin and OppU")
HCl, HClTB, TBVecs, TBKVecs, TBIdxDict = CreateClusterHamiltonian(HTB, {"periodic", {{3,0,0},{0,3,0},{0,0,1}}}, OppU,
                                                     {{"AddSpin", true}, {"ReturnTBSuperCell", true}, {"ReturnTBCellPositions", true}, {"ReturnTBKVectors", true}, {"ReturnTBIndicesDict", true}, {"k", {0,0,0}}})

if Chop(HCl - Matrix.ToOperator(Matrix.AddSpin(OperatorToMatrix(RefHCl)))-RefOppU)~=0*HCl then error("Output operator to equal to the expected value\n",1) end
if HClTB.NAtoms - RefNAtoms ~= 0 then error("Number of atoms not correct\n",1) end
if HClTB.NF -RefNF ~= 0 then error("Number of fermions not correct\n",1) end
if not compareTables(TBVecs, RefTBVecs) then error("TB vectors not equal to the expected value\n",1) end
if not compareTables(TBKVecs, RefTBKVecs, threshold) then error("TB reciprocal vectors not equal to the expected value\n",1) end
if not compareDictionaries(TBIdxDict, RefTBIdxDictWithSpin) then error("Output dict not equal to the expected value\n",1) end

print("--------------------------------------------------------------")
print("--                  Perioid Cluster (from DFT)              --")
print("--------------------------------------------------------------")

