local vectors_list = {vectors_simple_singular,vectors_fullRank,vectors_nonSquare,vectors_random_square,vectors_random_nonSquare,vectors_random_square_complex}
local labels       = {"Singular 1","full Rank 1", "dim < NF","random dim=NF","random dim<NF", "random complex dim=NF"}


local wf_1e = { NewWavefunction(NF1,0,{{"100",1}}),NewWavefunction(NF1,0,{{"010",1},{"001",1}}),NewWavefunction(NF1,0,{{"001",1}}) }

function checkInList(elem,tab)
    for i=1,#tab do
        if elem == tab[i] then return true end
    end
    return false
end

function randomNeWF(NF,Ne,maxDet,complex)
    local det_list = {}
    for iMaxDet=1,maxDet do
        if (math.random()>.5)or(#det_list==0) then
            local pos = {}
            for i=1,Ne do
                local newPos = math.random( 1,NF )-1
                while checkInList(newPos,pos) do
                    newPos = math.random( 1,NF )-1
                end
                pos[i] = newPos 
            end
            local coeff = (math.random()-.5)*math.random(10)
            if complex then coeff = coeff + (math.random()-.5)*math.random( 10 ) * Complex.I() end
            det_list[#det_list+1] = {DeterminantString(NF,pos),coeff}
        end
    end
    local wf = NewWavefunction(NF,0,det_list)
    return wf
end

function randomNeWFList(NF,Ne,maxDet,complex,nList)
    local wf_list = {}
    for i=1,nList do
        wf_list[i] = randomNeWF(NF,Ne,maxDet,complex)
    end
    return wf_list
end

local wf_list = {
    wf_1e,
    randomNeWFList(3,1,20,false,3),
    randomNeWFList(10,2,20,false,10),
    randomNeWFList(10,2,20,true,10),
    randomNeWFList(100,10,1000,false,100),
    randomNeWFList(100,10,1000,true,100)
    }
local wf_labels = {
    "1e",
    "1e random",
    "2e random",
    "2e random complex",
    "10e random",
    "10e random complex"
}




function checkMatrix(M1,M2,tol)

    local M1 = Matrix.ToTable(M1)
    local M2 = Matrix.ToTable(M2)
    if #M1 ~= #M2 then
        return false
    end
    for i=1,#M1 do
        if #M1[i] ~= #M2[i] then return false end
        for j=1,#M1[i] do
            if math.abs(M1[i][j]-M2[i][j])>tol then
							  print(i,j,M1[i][j],M2[i][j],M1[i][j]-M2[i][j],math.abs(M1[i][j]-M2[i][j]))
                return false
            end
        end
    end
    return true
end

function checkListOfWavefunctions(l1,l2,tol)
    local tol2 = tol*tol
    if #l1 ~= #l2 then 
        return false 
    end
    for i=1,#l1 do
        local diff = Chop( l1[i]-l2[i] )
        local diff_norm = diff*diff
        if diff_norm>tol2 then
            return false
        end
    end
    return true
end

function checkBasis(V,tol,isWf)

    if not isWf then 
        V = Matrix.ToTable(V)
    end
    local S = getS(V,1e-15,isWf)

    for i=1,#S do
        for j=1,#S[i] do
            if i==j then
                if ( (math.abs(S[i][i]-1)>tol) and (math.abs(S[i][j]-0)>tol) ) then
									  -- The diagonal must either be 1 or 0. The late is true for singular matrices
									  print("checkBasis fails for S=")
										print(S)
									  print("At element ",i,j,"with shifted value:",S[i][j]-1,math.abs(S[i][j]-1),type(S[i][j]))
                    return false
                end
            else
                if math.abs(S[i][j]-0)>tol then
									print("checkBasis fails for S=")
									print(S)
									print("At element ",i,j,"with shifted value:",S[i][j]-0,math.abs(S[i][j]-1),type(S[i][j]))
									return false
                end
            end
        end
    end

    return true

end

function multiply(v1,v2,isWf)

    if isWf == nil then error("Gigsd",1) end
    if isWf then
        return v1*v2
    else
        local mul = 0
        if #v1~=#v2 then error("Error in multiply: non matching dimensions",1) end
        for k=1,#v1 do
            mul = mul + Conjugate(v1[k])*v2[k]
        end
        return mul
    end
end

function normalize(v,isWf)
    local v = Clone(v)
    if isWf then
        v.Normalize()
    else
        local norm = math.sqrt( Chop(multiply(v,v,isWf),sv) )
        if norm < sv then
            for i=1,#v do v[i] = 0 end
        else
            for i=1,#v do v[i] = v[i]/norm end
        end
    end
    return v
end


function getS(vectors,tol,isWf)

    local S = Matrix.ToUserdata(Matrix.Zero(#vectors))
    for i=1,#S do
        for j=1,#S do
            S[i][j] = multiply(vectors[i],vectors[j],isWf)
        end
    end
    S = (ConjugateTranspose(S)+S)/2
    return Chop(S,tol)
end


function RotateListOfVectors(U,vectors,isWf)
    local isWf = false or isWf
    local newWfList = {}
    if isWf then
        for i=1,#vectors do
            local newWf = Chop(Clone(vectors[i])*0)
            for j=1,#U[i] do
                newWf = newWf + vectors[j]*U[i][j]
            end
            newWfList[i] = Chop( newWf , tol)
        end
    else
        newWfList = Chop( U*vectors , tol)
    end
    return newWfList
end

function lowdinONVectors(vectors,isWf)

    local isWf = false or isWf
    print(isWf)

    local vectors = Copy(vectors)
    local S = getS(vectors,sv,isWf)

    local val,fun = Eigensystem(S)
    fun = Matrix.ToTable(fun)

    local rankS = 0
    for i=1,#val do
        if val[i]>sv then 
            rankS = rankS + 1 
        elseif val[i] < -sv then
            error("Overlap Matrix is not positive semi definite",1)
        else 
            val[i] = 0 
        end
    end

    print("Rank of Overlap Matrix = "..tostring(rankS).." (for "..tostring(#vectors).." vectors)")

    if rankS<#vectors then
        print("Overlap Matrix is singular -> Löwdin ON is ill defined") 
        return nil
    else 
        print("Overlap Matrix is full rank!") 
    end

    local val_sqrt_inv = {}
    for i=1,#val do
        val_sqrt_inv[i] = 1 / math.sqrt( val[i] )
    end

    local diag_sqrt_inv = Matrix.Diagonal(val_sqrt_inv)
    local S_sqrt_inv = Rotate(diag_sqrt_inv,Transpose(fun))

    return RotateListOfVectors(S_sqrt_inv,vectors,isWf)

end

function GramSchidt(vectors,isWf)

    local sv2 = sv*sv
    local new_vectors = {}
    for i=1,#vectors do
        local new_v = Clone(vectors[i])
        for j=1,#new_vectors do
            local ovlp = multiply(new_vectors[j],new_v,isWf)
            if isWf then
                new_v = new_v-ovlp*new_vectors[j]
            else
                for k=1,#new_v do
                    new_v[k] = new_v[k]-ovlp*new_vectors[j][k]
                end
            end
        end
        local norm2 = multiply(new_v,new_v,isWf)
        if math.abs(norm2)>sv2 then
            new_v = normalize(new_v,isWf)
            new_vectors[#new_vectors+1] = Clone(new_v)
        end
    end
    return new_vectors
end
            
   
    

print("\n")
print("#####################################################")
print("\n")
print("Checking Vectors:\n\n")
for iVec=1,#vectors_list do
    local isWf = false

    local vectors = Matrix.ToTable( vectors_list[iVec] )
    local label = labels[iVec]

    print("\n=================================")
    print("Basis type: "..tostring(label))

    
    local vectors_LON_test = lowdinONVectors(vectors,isWf)
    
    if vectors_LON_test ~= nil then 
    
        ----------------------------------------------------------------------------
        options = {{"Method","Lowdin"},{"SingularValue",sv},{"Order","Row"},{"ReduceDimension",true}}
        print("\n-----------------")
        print("Options:")
        print(options)

        local vectors_LON_Quanty = Orthonormalize(vectors,options)
        if not (checkBasis(vectors_LON_Quanty, tol, isWf) and checkMatrix(vectors_LON_test,vectors_LON_Quanty,tol)) then 
            error("Lowdin ON failed for vectors ("..label..") with options: "..tostring(options),1)
        else
            print("Passed")
        end


        ----------------------------------------------------------------------------
        options = {{"Method","Lowdin"},{"SingularValue",sv},{"Order","Column"}}
        print("\n-----------------")
        print("Options:")
        print(options)

        local vectors_LON_Quanty = Transpose(Orthonormalize(Transpose(vectors),options))
        if not (checkBasis(vectors_LON_Quanty, tol, isWf) and checkMatrix(vectors_LON_test,vectors_LON_Quanty,tol)) then
            error("Lowdin ON failed for vectors ("..label..") with options: "..tostring(options),1)
        else
            print("Passed")
        end

        ----------------------------------------------------------------------------
    end

    --########################################################################
    local vectors_GS_test = GramSchidt(vectors,isWf)

    ----------------------------------------------------------------------------
    options = {{"Method","GramSchmidt"},{"SingularValue",sv},{"Order","Row"},{"ReduceDimension",true}}
    print("\n-----------------")
    print("Options:")
    print(options)

    local vectors_GS_Quanty = Orthonormalize(vectors,options)
    if not (checkBasis(vectors_GS_Quanty, tol, isWf) and checkMatrix(vectors_GS_test,vectors_GS_Quanty,tol)) then 
        error("Gram Schmidt failed for vectors ("..label..") with options: "..tostring(options),1)
    else
        print("Passed")
    end

    ----------------------------------------------------------------------------
    options = {{"Method","GramSchmidt"},{"SingularValue",sv},{"Order","Column"},{"ReduceDimension",true}}
    print("\n-----------------")
    print("Options:")
    print(options)

    local vectors_GS_Quanty = Transpose(Orthonormalize(Transpose(vectors),options))
    if not (checkBasis(vectors_GS_Quanty, tol, isWf) and checkMatrix(vectors_GS_test,vectors_GS_Quanty,tol)) then
        error("Lowdin ON failed for vectors ("..label..") with options: "..tostring(options),1)
    else
        print("Passed")
    end

    ---------------------------------------------------------------------------

    local zero_vec = {}
    for k=1,#vectors[1] do zero_vec[k] = 0 end
    for k=#vectors_GS_test+1,#vectors do
        vectors_GS_test[k] = Clone(zero_vec)
    end
    ----------------------------------------------------------------------------
    options = {{"Method","GramSchmidt"},{"SingularValue",sv},{"Order","Row"},{"ReduceDimension",false}}
    print("\n-----------------")
    print("Options:")
    print(options)

    local vectors_GS_Quanty = Orthonormalize(vectors,options)
    if not (checkBasis(vectors_GS_Quanty, tol, isWf) and checkMatrix(vectors_GS_test,vectors_GS_Quanty,tol)) then
        print(vectors)
				print()
				print(vectors_GS_Quanty)
        print()
        print(vectors_GS_test)
				print("Which of the two tests fails")
				print(checkBasis(vectors_GS_Quanty, tol, isWf), checkMatrix(vectors_GS_test,vectors_GS_Quanty,tol))
        error("Gram Schmidt failed for vectors ("..label..") with options: "..tostring(options),1)
    else
        print("Passed")
    end

    ----------------------------------------------------------------------------
    options = {{"Method","GramSchmidt"},{"SingularValue",sv},{"Order","Column"},{"ReduceDimension",false}}
    print("\n-----------------")
    print("Options:")
    print(options)

    local vectors_GS_Quanty = Transpose(Orthonormalize(Transpose(vectors),options))
    if not (checkBasis(vectors_GS_Quanty, tol, isWf) and checkMatrix(vectors_GS_test,vectors_GS_Quanty,tol)) then
        error("Lowdin ON failed for vectors ("..label..") with options: "..tostring(options),1)
    else
        print("Passed")
    end
    

end

print("\n")
print("#####################################################")
print("\n")
print("Checking Wavefunctions:\n\n")
for iVec=1,#wf_list do

    local isWf = true

    local vectors = wf_list[iVec]
    local label = wf_labels[iVec]

    print("\n=================================")
    print("Basis type: "..tostring(label))

    
    local vectors_LON_test = lowdinONVectors(vectors,isWf)
    
    if vectors_LON_test ~= nil then 
    
        ----------------------------------------------------------------------------
        options = {{"Method","Lowdin"},{"SingularValue",sv},{"ReduceDimension",true}}
        print("\n-----------------")
        print("Options:")
        print(options)

        local vectors_LON_Quanty = Orthonormalize(vectors,options)
        if not (checkBasis(vectors_LON_Quanty, tol, isWf) and checkListOfWavefunctions(vectors_LON_test,vectors_LON_Quanty,tol)) then 
            error("Lowdin ON failed for list of wavefunctions ("..label..") with options: "..tostring(options),1)
        else
            print("Passed")
        end

    end





    --########################################################################
    local vectors_GS_test = GramSchidt(vectors,isWf)

    ----------------------------------------------------------------------------
    options = {{"Method","GramSchmidt"},{"SingularValue",sv},{"Order","Row"},{"ReduceDimension",true}}
    print("\n-----------------")
    print("Options:")
    print(options)

    local vectors_GS_Quanty = Orthonormalize(vectors,options)
    if not (checkBasis(vectors_GS_Quanty, tol, isWf) and checkListOfWavefunctions(vectors_GS_test,vectors_GS_Quanty,tol)) then 
        error("Gram Schmidt failed for vectors ("..label..") with options: "..tostring(options),1)
    else
        print("Passed")
    end

    ---------------------------------------------------------------------------

    local zero_vec = Chop( Clone(vectors[1])*0, 1)
    for k=#vectors_GS_test+1,#vectors do
        vectors_GS_test[k] = Clone(zero_vec)
    end
    ----------------------------------------------------------------------------
    options = {{"Method","GramSchmidt"},{"SingularValue",sv},{"Order","Row"},{"ReduceDimension",false}}
    print("\n-----------------")
    print("Options:")
    print(options)

    local vectors_GS_Quanty = Orthonormalize(vectors,options)
    if not (checkBasis(vectors_GS_Quanty, tol, isWf) and checkListOfWavefunctions(vectors_GS_test,vectors_GS_Quanty,tol)) then 
        print(vectors)
				print()
				print(vectors_GS_Quanty)
        print()
        print(vectors_GS_test)
        error("Gram Schmidt failed for vectors ("..label..") with options: "..tostring(options),1)
    else
        print("Passed")
    end

end
