local vectors_random_square = Matrix.Random({-1,1},{100,100})
local vectors_random_square_complex = Matrix.Random({-1,1},{NF1,NF1})+Matrix.Random({-1,1},{NF1,NF1})*I
local vectors_random_nonSquare = Matrix.Random({-1,1},{100,300})
local vectors_random_nonSquare = Matrix.Random({-1,1},{30,10})
local vectors_simple_singular = {{1,0,0},{0,1,0},{1,0,0}}


local vectors_list = {vectors_simple_singular,vectors_fullRank,vectors_nonSquare,vectors_random_square,vectors_random_nonSquare,vectors_random_square_complex}
local labels       = {"Singular 1","full Rank 1", "dim < NF","random dim=NF","random dim<NF", "random complex dim=NF"}

function checkMatrix(M1,M2,tol)

    local M1 = Matrix.ToTable(M1)
    local M2 = Matrix.ToTable(M2)
    if #M1 ~= #M2 then
        return false
    end
    for i=1,#M1 do
        if #M1[i] ~= #M2[i] then return false end
        for j=1,#M1[i] do
            if math.abs(M1[i][j]-M2[i][j])>tol then
                return false
            end
        end
    end
    return true
end



function checkBasis(V,tol)

    local V = Matrix.ToTable(V)
    local S = getS(V,1e-15)

    for i=1,#S do
        for j=1,#S[i] do
            if i==j then
                if math.abs(S[i][i]-1)>tol then 
                    return false
                end
            else
                if math.abs(S[i][j]-0)>tol then 
                    return false
                end
            end
        end
    end

    return true

end


function getS(vectors,tol)

    local S = Matrix.ToUserdata(Matrix.Zero(#vectors))
    for i=1,#S do
        for j=1,#S do
            local v1 = Conjugate(vectors[i])
            local v2 = Conjugate(vectors[j])
            local sp = 0
            for k=1,#v1 do
                sp = sp + v1[k]*v2[k]
            end

            S[i][j] = sp
        end
    end
    S = (ConjugateTranspose(S)+S)/2
    return Chop(S,tol)
end

function RotateListOfVectors(vectors,U)
    return Chop( U*vectors , tol)
end


function lowdinONVectors(vectors)

    local vectors = Copy(vectors)
    local S = getS(vectors,sv)

    local val,fun = Eigensystem(S)
    fun = Matrix.ToTable(fun)

    local rankS = 0
    for i=1,#val do
        if math.abs(val[i])>sv then 
            rankS = rankS + 1 
        else 
            val[i] = 0 
        end
    end

    print("Rank of Overlap Matrix = "..tostring(rankS).." (for "..tostring(#vectors).." vectors)")

    if rankS<#vectors then

        print("Overlap Matrix is singular -> Löwdin ON is ill defined") 
   
        --[[
        vectors_S = RotateListOfVectors(vectors,fun)
        local vectors_reduced = {}
        for i=1,#val do
            if val[i]>sv then
                vectors_reduced[#vectors_reduced+1] = vectors_S[i]
            else val[i] = 0 end
        end

        setmetatable(vectors_reduced,MatrixMeta)
        vectors = Clone(vectors_reduced)
        
        S = getS(vectors,sv)
        val,fun = Eigensystem(S)
        fun = Matrix.ToTable(fun)
        ]]
        return nil

    else 
        print("Overlap Matrix is full rank!") 
    end

    local val_sqrt_inv = {}
    for i=1,#val do
        val_sqrt_inv[i] = 1 / math.sqrt( val[i] )
    end

    local diag_sqrt_inv = Matrix.Diagonal(val_sqrt_inv)
    local S_sqrt_inv = Rotate(diag_sqrt_inv,Transpose(fun))
    local vectors_LON_test = S_sqrt_inv*vectors


    return vectors_LON_test

end

for iVec=1,#vectors_list do

    local vectors = vectors_list[iVec]
    local label = labels[iVec]

    print("\n=================================")
    print("Basis type: "..tostring(label))

    
    local vectors_LON_test = lowdinONVectors(vectors)
    
    if vectors_LON_test ~= nil then 
    
        ----------------------------------------------------------------------------
        options = {{"Method","Lowdin"},{"SingularValue",sv},{"Order","Row"},{"ReduceDimension",true}}
        print("\n-----------------")
        print("Options:")
        print(options)

        local vectors_LON_Quanty = Orthonormalize(vectors,options)
        if not (checkBasis(vectors_LON_Quanty, tol) and checkMatrix(vectors_LON_test,vectors_LON_Quanty,tol)) then
            print(checkMatrix(vectors_LON_test,vectors_LON_Quanty,tol))
            
            
            print(vectors_LON_test)
            print("'------------------------'")
            print(vectors_LON_Quanty)


            error("Lowdin ON failed for vectors ("..label..") with options: "..tostring(options),1)
        else
            print("Passed")
        end


        ----------------------------------------------------------------------------
        options = {{"Method","Lowdin"},{"SingularValue",sv},{"Order","Column"}}
        print("\n-----------------")
        print("Options:")
        print(options)

        local vectors_LON_Quanty = Transpose(Orthonormalize(Transpose(vectors),options))
        if not (checkBasis(vectors_LON_Quanty, tol) and checkMatrix(vectors_LON_test,vectors_LON_Quanty,tol)) then
            error("Lowdin ON failed for vectors ("..label..") with options: "..tostring(options),1)
        else
            print("Passed")
        end

        ----------------------------------------------------------------------------

    end

end
