print("-----------------------------------------------------------------")
print("--                  CreateFluorescenceYield                    --")
print("-----------------------------------------------------------------")

-- Function for comparing all elements of two spectral tables
function CmpSpectra(s1, s2, threshold)
	if #s1 ~= #s2 then return false end
	if Chop(s1.Gamma - s2.Gamma, threshold) ~= 0 then return false end
	for i = 1, #s1 do
		if Chop(s1[i][1] - s2[i][1], threshold) ~= 0 then return false end
		if Chop(s1[i][2] - s2[i][2], threshold) ~= 0 then return false end
	end
	return true
end

-- Threshold for comparing with th expected result
threshold = 1E-13

print("--------------------------------------------------------")
print("--                     Lanczos                        --")
print("--------------------------------------------------------")

-- Define some model Hamiltonian: impurity coupled to a 1D chain
NBath = 5
NF = 2 + 2*NBath

-- some parameters
t = 1
U = 3

-- defining 3 Hamiltonian (real, mixed, complex)
H0 = U*NewOperator(NF, 0, {{0, -0, 1, -1, 1}})
for i = 1, NBath do
		H0 = H0 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,         t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),     t}})
end
H1 = U*NewOperator(NF, 0, {{0, -0, 1, -1, 1}})
for i = 1, NBath do
		H1 = H1 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     I*t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), I*t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,        -I*t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),    -I*t}})
end
H2 = 0
for i = 1, NBath do
		H2 = H2 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     I*t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), I*t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,        -I*t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),    -I*t}})
end
H2 = Chop(H2)

-- Defining 2 transition operators
TDn = NewOperator("Cr", NF, 0)
TUp = NewOperator("Cr", NF, 1)

-- Addition transition operator
TBath = NewOperator("Cr", NF, 5)

-- Defining 2 starting states (real and complex)
str1 = "10"
for i = 1, NBath do
		str1 = str1.."00"
end
str2 = "01"
for i = 1, NBath do
		str2 = str2.."00"
end
psi1 = NewWavefunction(NF, 0, {{str1, 1}, {str2, 1}})
psi1.Normalize()
psi2 = NewWavefunction(NF, 0, {{str1, 1}, {str2, -2*I}})
psi2.Normalize()

