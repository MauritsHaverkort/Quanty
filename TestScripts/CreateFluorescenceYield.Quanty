spec = CreateFluorescenceYield(H0, TUp, TDn, psi1, {{"NE", 20}, {"NTri", 200}, {"epsilon", 1.49E-8}, {"Restrictions", restrictions}})
spec = Spectra.ToTable(spec)
if not CmpSpectra(spec[1], specRefH0Psi1, threshold) then
	error("Spectrum not equal to the expected one\n",1)
end

