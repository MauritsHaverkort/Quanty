print("--------------------------------------------------------")
print("--                  Create Spectra                    --")
print("--------------------------------------------------------")


-- Define some model Hamiltonian: impurity coupled to a 1D chain
NBath = 5
NF = 2 + 2*NBath

-- some parameters
t = 1
U = 3

-- defining 3 Hamiltonian (real, mixed, complex)
H0 = U*NewOperator(NF, 0, {{0, -0, 1, -1, 1}})
for i = 1, NBath do
		H0 = H0 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,         t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),     t}})
end
H1 = U*NewOperator(NF, 0, {{0, -0, 1, -1, 1}})
for i = 1, NBath do
		H1 = H1 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     I*t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), I*t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,        -I*t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),    -I*t}})
end
H2 = 0
for i = 1, NBath do
		H2 = H2 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     I*t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), I*t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,        -I*t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),    -I*t}})
end
H2 = Chop(H2)

-- Defining 2 transition operators
TDn = NewOperator("Cr", NF, 0)
TUp = NewOperator("Cr", NF, 1)

-- Defining 2 starting states (real and complex)
str1 = "10"
for i = 1, NBath do
		str1 = str1.."00"
end
str2 = "01"
for i = 1, NBath do
		str2 = str2.."00"
end
psi1 = NewWavefunction(NF, 0, {{str1, 1}, {str2, 1}})
psi1.Normalize()
psi2 = NewWavefunction(NF, 0, {{str1, 1}, {str2, -2*I}})
psi2.Normalize()

-- comparing response funcitons has the same problem as comparing doubles, they are almost never really accurate
-- the currenct comparison G1==G2 
--   yields true if they are equal on a 100*DBL_EPSILON level for all values of omega and gamma.
--       This is hard to achive but not impossible
--   yields false if they are really different
--   is 'ill defined' i.e. can yield both true or false, if they are roughly equal, but not perfect

specRef = Spectra.FromTable({
    {{-4.525266805879130E+00, 4.678858379196852E-04 + I *  0.000000000000000E+00},{-4.062461722851595E+00, 6.333456740445073E-04 + I *  0.000000000000000E+00},{-3.599656639824062E+00, 8.559146336477634E-04 + I *  0.000000000000000E+00},{-3.136851556796527E+00, 1.144904420345214E-03 + I *  0.000000000000000E+00},{-2.674046473768993E+00, 1.504560336514554E-03 + I *  0.000000000000000E+00},{-2.211241390741459E+00, 1.933268259134002E-03 + I *  0.000000000000000E+00},{-1.748436307713925E+00, 2.424503974198638E-03 + I *  0.000000000000000E+00},{-1.285631224686390E+00, 2.968427468417065E-03 + I *  0.000000000000000E+00},{-8.228261416588563E-01, 3.553133591609214E-03 + I *  0.000000000000000E+00},{-3.600210586313221E-01, 4.164682966981754E-03 + I *  0.000000000000000E+00},{ 1.027840243962121E-01, 4.786249445846021E-03 + I *  0.000000000000000E+00},{ 5.655891074237464E-01, 5.396219208704829E-03 + I *  0.000000000000000E+00},{ 1.028394190451281E+00, 5.964980042307574E-03 + I *  0.000000000000000E+00},{ 1.491199273478815E+00, 6.450262902084851E-03 + I *  0.000000000000000E+00},{ 1.954004356506349E+00, 6.790676126328200E-03 + I *  0.000000000000000E+00},{ 2.416809439533883E+00, 6.902398454699803E-03 + I *  0.000000000000000E+00},{ 2.879614522561417E+00, 6.690470789985889E-03 + I *  0.000000000000000E+00},{ 3.342419605588951E+00, 6.093636930790388E-03 + I *  0.000000000000000E+00},{ 3.805224688616486E+00, 5.156340100385605E-03 + I *  0.000000000000000E+00},{ 4.268029771644020E+00, 4.053827699185512E-03 + I *  0.000000000000000E+00},{ 4.730834854671555E+00, 3.003834182106083E-03 + I *  0.000000000000000E+00},["Name"]="Spectrum 0/1",["EminPole"]=-3.599656639824062E+00,["EmaxPole"]= 3.805224688616486E+00,["Gamma"]= 4.628050830275342E+00,["Integral"]= 0.000000000000000E+00}})

spec, G = CreateFluorescenceYield(H0, TUp, TDn, psi1, {{"NE", 20}})
-- spec, G = CreateResonantSpectra(H0, H0, TUp, TDn, psi1, {{"NE1", 2}, {"NE2", 20}})


print(spec)
