print("--------------------------------------")
print("--          ManyHoppings            --")
print("--------------------------------------")
-- A synthetic file (made by a script, not by FPLO): simple cubic, one Ni 3dxy Wannier function
-- with a name longer than 15 characters, and 13^3 = 2197 hoppings to the lattice vectors
-- n1 a1 + n2 a2 + n3 a3, -6 <= n_i <= 6, with t(n) = -1/(1 + n1^2 + 2 n2^2 + 3 n3^2).
-- Up to version 0.9 the reader wrote the name into 16 bytes and hopping 1025 of an orbital
-- pair one past its array, and TightBindingDefFromDresdenFPLO had room for 2048 vectors per
-- shell pair. This file overflowed all three and crashed.

print("Reading the FPLO output file")
FPLOOut = FileReadDresdenFPLO(script_path().."DFT/ManyHoppings/out.wan")
print("Creating the TB object from FPLOOut")
TB = TightBindingDefFromDresdenFPLO(FPLOOut)

H = TB.Hopping
print("number of hoppings: "..#H)
if #H ~= 13^3 then error("Expected 2197 hoppings, found "..#H.."\n", 1) end
a = TB.Cell
seen = {}
maxdiff = 0
for k=1,#H do
  local v = H[k][3]
  local n = {}
  for i=1,3 do
    n[i] = (v[1]*a[i][1] + v[2]*a[i][2] + v[3]*a[i][3]) / (a[i][1]^2 + a[i][2]^2 + a[i][3]^2)
    if math.abs(n[i] - math.floor(n[i]+0.5)) > 1E-6 or math.abs(n[i]) > 6.5 then
      error("Hopping "..k.." has a vector that is not one of the lattice vectors in the file\n", 1)
    end
    n[i] = math.floor(n[i]+0.5)
  end
  local key = n[1]..","..n[2]..","..n[3]
  if seen[key] then error("Lattice vector "..key.." appears twice\n", 1) end
  seen[key] = true
  local t = -1/(1 + n[1]^2 + 2*n[2]^2 + 3*n[3]^2)
  maxdiff = math.max(maxdiff, math.abs(H[k][4][1][1] - t))
end
print(string.format("largest difference of a hopping from t(n): %.1e", maxdiff))
if not (maxdiff < threshold) then error("Hopping values not equal to the expected ones\n", 1) end

TB = nil
collectgarbage("collect")
collectgarbage("collect")
collectgarbage("collect")
collectgarbage("collect")

print("------------------------------------------------------------------")
print("--                  End of FileReadDresdenFPLO                  --")
print("------------------------------------------------------------------")

