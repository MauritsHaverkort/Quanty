function script_path()
    local str = debug.getinfo(2, "S").source:sub(2)
    local out = str:match("(.*/)")
    if out ~= nil then
        return out
    end
    return "./"
end

-- Function to compare two tables
local function compareTables(t1, t2, threshold)
    if #t1 ~= #t2 then
        return false
    end
    if threshold == nil then
        for i = 1, #t1 do
            if (type(t1[i]) == "table") and (type(t2[i]) == "table") then
                if #t1[i] ~= #t2[i] then
                    return false
                end
                for j = 1, #t1[i] do
                    if t1[i][j] ~= t2[i][j] then
                        return false
                    end
                end
            else
                if t1[i] ~= t2[i] then
                    return false
                end
            end
        end
    else
        for i = 1, #t1 do
            if (type(t1[i]) == "table") and (type(t2[i]) == "table") then
                if #t1[i] ~= #t2[i] then
                    return false
                end
                for j = 1, #t1[i] do
                    if Chop(t1[i][j] - t2[i][j], threshold) ~= 0 then
                        return false
                    end
                end
            else
                if Chop(t1[i] - t2[i], threshold) ~= 0 then
                    return false
                end
            end
        end
    end
    
    return true
end

-- compare two cluster (list of atoms, their positions and their spin-orbitals)
function compareClusters(cl1, cl2)
    if #cl1 ~= #cl2 then
        print("Number of atoms not equal!")
        return false
    end

    for i, atom in pairs(cl1) do
        if atom[1] ~= cl2[i][1] then print("Name of Atom "..i.." not equal"); return false end
        if not compareTables(atom[2], cl2[i][2], 1E-14) then print("Position of atoms not equal!"); return false end
        for ishell, shell in pairs(atom[3]) do
            if shell[1] ~= cl2[i][3][ishell][1] then print("Shell of atoms not equal!", shell[1] ,cl2[i][3][ishell][1]); return false end
            for is, str in pairs(shell[2]) do
                if str ~= cl2[i][3][ishell][2][is] then print("spin-orbs of atoms not equal!"); return false end
            end
        end
    end
    return true
end

threshold = 1E-13

print("-----------------------------------------------------------")
print("--                  FileReadDresdenFPLO                  --")
print("-----------------------------------------------------------")

print("--------------------------------------")
print("--                  NiO             --")
print("--------------------------------------")

RefCell = { { 0 , 3.9476378751116 , 3.9476378751116 } , 
{ 3.9476378751116 , 0 , 3.9476378751116 } , 
{ 3.9476378751116 , 3.9476378751116 , 0 } }
RefReciprocalCell = { { -0.79581581517301 , 0.79581581517301 , 0.79581581517301 } , 
{ 0.79581581517301 , -0.79581581517301 , 0.79581581517301 } , 
{ 0.79581581517301 , 0.79581581517301 , -0.79581581517301 } }
RefNAtoms = 2
RefAtoms = { { "Ni" , 
{ 0 , 0 , 0 } , 
{ { "3d" , 
{ "d_{xy}" , "d_{yz}" , "d_{3z^2-r^2}" , "d_{xz}" , "d_{x^2-y^2}" } } } } , 
{ "O" , 
{ -3.947637875111609 , -3.947637875111609 , -3.947637875111609 } , 
{ { "2p" , 
{ "p_y" , "p_z" , "p_x" } } } } }

print("Reading the FPLO output file")
FPLOOut = FileReadDresdenFPLO(script_path().."DFT/NiO/out.wan")
print("Creating the TB object from FPLOOut")
TB = TightBindingDefFromDresdenFPLO(FPLOOut)

print("TB.Cell:")
print(TB.Cell)
if not compareTables(TB.Cell, RefCell, threshold) then error("Result not equal to the expected one\n", 1) end
print("TB.ReciprocalCell:")
print(TB.ReciprocalCell)
if not compareTables(TB.ReciprocalCell, RefReciprocalCell, threshold) then error("Result not equal to the expected one\n", 1) end
print("TB.NAtoms:")
print(TB.NAtoms)
if TB.NAtoms ~= RefNAtoms then error("Result not equal to the expected one\n", 1) end
print("TB.Atoms:")
print(TB.Atoms)
if not compareClusters(TB.Atoms, RefAtoms, threshold) then error("Result not equal to the expected one\n", 1) end

TB = nil
collectgarbage("collect")
collectgarbage("collect")
collectgarbage("collect")
collectgarbage("collect")

