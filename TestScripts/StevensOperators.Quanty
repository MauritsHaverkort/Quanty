  {11, 2, 2.2600265489831338e8, 5.642222940161957e7, 1.51473605886491e8},
  {11, 10, 1.9747029536018923e6, -2.9916115654971214e6, 1.4740255281371486e7},
  {11, 11, -7.5933612893373528e6, -1.4801226104685163e8, 6.9137925675565361e7},
  {12, -12, 5.9312979579132031e7, -1.1197838447721723e8, 2.395008e8},
  {12, -11, 1.0202216878263682e6, -5.3302164565845136e7, 3.4568962837782681e7},
  {12, -2, -8.6514656694888855e7, -4.2933664405714652e9, 7.185024e8},
  {12, -1, 4.5112101225376601e9, -9.9893433872361352e9, 4.2683921001184134e9},
  {12, 0, -2.6069429184654169e11, 6.1236197416299537e10, 1.106493696e11},
  {12, 1, -2.7930876391251128e10, -2.8498295370506461e8, 4.2683921001184134e9},
  {12, 2, 1.8047407831263291e9, 5.4133108782476613e8, 7.185024e8},
  {12, 11, 8.1780114610233672e7, 1.5909451742064611e7, 3.4568962837782681e7},
  {12, 12, -2.5191334128281874e8, 2.0127400297065353e8, 2.395008e8},
}

-- 1  the five normalisations against the Mathematica package, J = 7/2
Jx, Jy, Jz = Jmat(7/2)
Functions = {StevensC, StevensY, StevensD, StevensZ, StevensO}
Names = {"StevensC", "StevensY", "StevensD", "StevensZ", "StevensO"}
MaxDev = 0
for _, r in ipairs(RefPackage) do
  local k, m = r[1], r[2]
  for t = 1, 5 do
    local fr, fi, sum = Fingerprint(Functions[t](k, m, Jx, Jy, Jz))
    local dev = math.sqrt((fr - r[1+2*t])^2 + (fi - r[2+2*t])^2) / math.max(1, sum)
    if dev > MaxDev then MaxDev = dev end
    Check(Names[t].."("..k..","..m..") for J = 7/2, relative deviation "..dev, dev < 1e-13)
  end
end
print("1  J = 7/2, k <= 6, five normalisations: largest relative deviation from the Mathematica package "..string.format("%.1e", MaxDev))

-- 2  StevensO for 7 <= k <= 12 against the construction of EasySpin and Ryabov, J = 6
Jx, Jy, Jz = Jmat(6)
MaxDev = 0
for _, r in ipairs(RefRyabov) do
  local k, m = r[1], r[2]
  local fr, fi = Fingerprint(StevensO(k, m, Jx, Jy, Jz))
  local dev = math.sqrt((fr - r[3])^2 + (fi - r[4])^2) / r[5]
  if dev > MaxDev then MaxDev = dev end
  Check("StevensO("..k..","..m..") for J = 6, deviation relative to the largest element "..dev, dev < 1e-10)
end
print("2  J = 6, 7 <= k <= 12, StevensO: largest deviation from Ryabov, relative to the largest element "..string.format("%.1e", MaxDev))

-- 3  StevensPrefactor against the table of the Mathematica package, which holds 1/StevensPrefactor
PrefactorOtoD = {
  {1},
  {1, 1},
  {1/2, math.sqrt(3), math.sqrt(3)/2},
  {1/2, math.sqrt(3/2)/2, math.sqrt(15)/2, math.sqrt(5/2)/2},
  {1/8, math.sqrt(5/2)/2, math.sqrt(5)/4, math.sqrt(35/2)/2, math.sqrt(35)/8},
  {1/8, math.sqrt(15)/8, math.sqrt(105)/4, math.sqrt(35/2)/8, 3*math.sqrt(35)/8, 3*math.sqrt(7/2)/8},
  {1/16, math.sqrt(21)/8, math.sqrt(105/2)/16, math.sqrt(105/2)/8, 3*math.sqrt(7)/16, 3*math.sqrt(77/2)/8, math.sqrt(231/2)/16}}
MaxDev = 0
for k = 0, 6 do
  for m = -k, k do
    local dev = math.abs(StevensPrefactor(k, m) * PrefactorOtoD[k+1][math.abs(m)+1] - 1)
    if dev > MaxDev then MaxDev = dev end
    Check("StevensPrefactor("..k..","..m..")", dev < 1e-14)
  end
end
print("3  StevensPrefactor, k <= 6: largest relative deviation from the Mathematica package "..string.format("%.1e", MaxDev))

-- 4  ladder relation and hermiticity on Matrix objects, J = 6
X, Y, Z = Matrix.ToUserdata(Jx), Matrix.ToUserdata(Jy), Matrix.ToUserdata(Jz)
Jmin = X - I*Y
MaxLadder, MaxHerm = 0, 0
for k = 1, 12 do
  for m = -k+1, k do
    local C = StevensC(k, m, X, Y, Z)
    local L = Matrix.ToTable(Jmin*C - C*Jmin - math.sqrt((k+m)*(k-m+1))*StevensC(k, m-1, X, Y, Z))
    local _, _, _, size = Fingerprint(Matrix.ToTable(C))
    local _, _, _, dev = Fingerprint(L)
    if dev/size > MaxLadder then MaxLadder = dev/size end
    Check("[J-, C("..k..","..m..")] for J = 6, relative deviation "..dev/size, dev/size < 1e-11)
  end
  for m = -k, k do
    local O = StevensO(k, m, X, Y, Z)
    local _, _, _, size = Fingerprint(Matrix.ToTable(O))
    local _, _, _, dev = Fingerprint(Matrix.ToTable(O - Matrix.ConjugateTranspose(O)))
    if dev/size > MaxHerm then MaxHerm = dev/size end
    Check("StevensO("..k..","..m..") hermitian for J = 6, relative deviation "..dev/size, dev/size < 1e-13)
  end
end
print("4  J = 6, k <= 12: largest relative deviation of the ladder relation "..string.format("%.1e", MaxLadder)..", of hermiticity "..string.format("%.1e", MaxHerm))

-- 5  operators: J = 3/2 as one fermion in four orbitals
Jx, Jy, Jz = Jmat(3/2)
NF, NB = 4, 0
OppJx, OppJy, OppJz = Matrix.ToOperator(Jx), Matrix.ToOperator(Jy), Matrix.ToOperator(Jz)
psi = {}
for i = 1, NF do
  local s = ""
  for j = 1, NF do if i == j then s = s.."1" else s = s.."0" end end
  psi[i] = NewWavefunction(NF, NB, {{s, 1}})
end
MaxDev = 0
for k = 0, 4 do
  for m = -k, k do
    for t = 1, 5 do
      local M = Functions[t](k, m, Jx, Jy, Jz)
      local O = Functions[t](k, m, OppJx, OppJy, OppJz)
      for i = 1, NF do
        for j = 1, NF do
          local dev = Abs(psi[i] * (O * psi[j]) - M[i][j])
          if dev > MaxDev then MaxDev = dev end
          Check(Names[t].."("..k..","..m..") operator element "..i..","..j.." deviation "..dev, dev < 1e-12)
        end
      end
    end
  end
end
print("5  J = 3/2 as operators, k <= 4: largest deviation of the one particle matrix elements "..string.format("%.1e", MaxDev))

-- 6  the cutoff. With J held by one fermion in 2J+1 orbitals the total angular momentum of every particle
--    sector is at most 1 for J = 1 and at most 2 for J = 3/2, so for k > 2 and k > 4 the operator vanishes
--    on the whole Fock space, and the matrix for k > 2J. Rounding leaves noise, which the default removes.
function NTerms(O)
  local n = 0
  for _, v in pairs(O.N) do n = n + v end
  return n
end
NZero = 0
for _, c in ipairs({{1, 3}, {1, 4}, {3/2, 5}, {3/2, 6}}) do
  local J, k = c[1], c[2]
  local Jx, Jy, Jz = Jmat(J)
  local X, Y, Z = Matrix.ToOperator(Jx), Matrix.ToOperator(Jy), Matrix.ToOperator(Jz)
  for m = -k, k do
    for t = 1, 5 do
      local n = NTerms(Functions[t](k, m, X, Y, Z))
      Check(Names[t].."("..k..","..m..") for J = "..J.." as an operator should have no terms, it has "..n, n == 0)
      local _, _, sum = Fingerprint(Functions[t](k, m, Jx, Jy, Jz))
      Check(Names[t].."("..k..","..m..") for J = "..J.." as a matrix should be zero, the sum of |elements| is "..sum, sum == 0)
      NZero = NZero + 1
    end
  end
end
Jx, Jy, Jz = Jmat(3)
X, Y, Z = Matrix.ToOperator(Jx), Matrix.ToOperator(Jy), Matrix.ToOperator(Jz)
N0 = NTerms(StevensO(6, 0, X, Y, Z, {{"Epsilon", 0}}))
Ndefault = NTerms(StevensO(6, 0, X, Y, Z))
Nlarge = NTerms(StevensO(6, 0, X, Y, Z, {{"Epsilon", 1}}))
Check("Epsilon = 0 should keep at least as many terms as the default, "..N0.." and "..Ndefault, N0 >= Ndefault)
Check("Epsilon = 1 should remove terms, "..Nlarge.." of "..Ndefault, Nlarge < Ndefault)
Check("a negative Epsilon should raise an error", not pcall(StevensO, 2, 0, X, Y, Z, {{"Epsilon", -1}}))
print("6  "..NZero.." vanishing Stevens operators come back empty as operators and as matrices; J = 3, O(6,0): "..N0.." terms at Epsilon = 0, "..Ndefault.." by default")

if Failed > 0 then error(Failed.." checks of the Stevens operators failed") end
print("All checks of the Stevens operators passed")
