-- Test of the Stevens operators StevensO, StevensD, StevensZ, StevensC, StevensY and StevensPrefactor
--
--  1  the five normalisations on matrices for J = 7/2, k <= 6, against the Mathematica package
--     Quanty`StevensOperators`, which builds them by averaging products over all orderings
--  2  StevensO for J = 6 and 7 <= k <= 12 against the construction of EasySpin (stev): J+^k lowered with
--     commutators and scaled with the table of Ryabov, J. Magn. Reson. 140, 141 (1999)
--  3  StevensPrefactor against the table of the Mathematica package for k <= 6
--  4  the ladder relation [J-, C(k,m)] = sqrt((k+m)(k-m+1)) C(k,m-1) and hermiticity, J = 6, k <= 12
--  5  operators: J = 3/2 as one fermion in 4 orbitals; the one particle matrix elements of the Stevens
--     operator built from operators equal the Stevens matrix built from matrices
--  6  the cutoff Epsilon: Stevens operators that vanish come back without terms, as operators and as
--     matrices, and an explicit Epsilon replaces the default
--
-- Matrices are compared by a fingerprint, sum_ij M_ij (cos(i+2j) + I sin(3i-j)), which the reference
-- script in Mathematica computes the same way. Thresholds are relative to the size of the elements.

-- the matrices of Jx, Jy and Jz on the states M = J, J-1, ..., -J
function Jmat(J)
  local d = math.floor(2*J+1.5)
  local Jx, Jy, Jz = {}, {}, {}
  for i = 1, d do
    Jx[i], Jy[i], Jz[i] = {}, {}, {}
    for j = 1, d do Jx[i][j], Jy[i][j], Jz[i][j] = 0, 0, 0 end
  end
  for i = 1, d do
    local M = J - (i-1)
    Jz[i][i] = M
    if i > 1 then
      local v = math.sqrt(J*(J+1) - M*(M+1))
      Jx[i-1][i], Jx[i][i-1] = v/2, v/2
      Jy[i-1][i], Jy[i][i-1] = -I*v/2, I*v/2
    end
  end
  return Jx, Jy, Jz
end

function Re(z) if type(z) == "number" then return z end return Complex.Re(z) end
function Im(z) if type(z) == "number" then return 0 end return Complex.Im(z) end
function Abs(z) return math.sqrt(Re(z)^2 + Im(z)^2) end

-- fingerprint, and the sum and largest of the absolute values of the elements
function Fingerprint(M)
  local fr, fi, sum, max = 0, 0, 0, 0
  for i = 1, #M do
    for j = 1, #M do
      local wr, wi = math.cos(i+2*j), math.sin(3*i-j)
      local mr, mi = Re(M[i][j]), Im(M[i][j])
      fr = fr + mr*wr - mi*wi
      fi = fi + mr*wi + mi*wr
      sum = sum + Abs(M[i][j])
      if Abs(M[i][j]) > max then max = Abs(M[i][j]) end
    end
  end
  return fr, fi, sum, max
end

Failed = 0
function Check(name, ok)
  if not ok then
    print("FAILED: "..name)
    Failed = Failed + 1
  end
end

