RandomMat1 = {{-0.8403616426931201572699966061179180741759525855022275753391890707,-0.3981458700215574795047361840877532237522687221997418322949632367,0.2099850810780362410424978985707261446752706149675675441437139441,0.2537179290232612848230181270451269749667896555647455358815099059,0.1637243228469600386619475990862443415345308205786451598199182156},{-0.3766461926933332210273287315625710307695677999040156658463216621,0.3796886212336381431286860450725432868212281277581327975610973551,0.01925368059959897453730571597990259269825917379907100918458074631,-0.1288986922191435644553647224933628395903190729550641638312005467,-0.8348584427092286973722956982502087548287225410319904913028364938},{-0.05145816238863186108569429048640413815579590129689423112271188297,0.5754663566255020038542969366414414531658477725167636587469794234,-0.1816142916773230668294720315231187920699715446225466835286433525,0.7794074438389114531401420081180051190963626271907097288194310431,0.1604082774135862659485334959970154465363352651754716739427403655},{-0.3435041003894923280517308626962002176832360610583429058359780511,0.5724657940199711757701179451519374159242732523498687603343431220,-0.01307658923093448465373600559473855753722604403096928127352752174,-0.5513337796124650315011290931778050185259194096052297115122312806,0.5001478920929376034281550296830462766091551850050428219117452999},{0.1768811622500483206494944340096689205564516120017685906025534122,0.1960556149660866185497276084967141574978566119714441633202085445,0.9604065875350131114165190374979085168758670985983692432726709257,0.08699103162435639478086753888603602415742646728916914179741390917,0.01808306715198219050422714333235205666196217979613349746770011568}}
RandomMat2 = {{-0.0760581271423255149461505597153092894880643993107849436950150936 + 0.1477648223530594814948984685524663150328148805304613209094934654 *I, 0.4607001947855446380743060091700080008717003139558182286506272830 - 0.1060891362476756376887885728180502659982590452916750503916769758 *I, 0.5685053886963831399198167541653577512419704818749727137106849378 + 0.0927896893581634404741917384439792621151728449287094317117267136 *I, 0.4980244489593369334830132540262717859629422311034959326879070509 - 0.1883373285321243412002583964586184098282207083658679548547795185 *I, -0.3309539778956952302249903484791862717450022210138909717591309470 - 0.1550580674215016541609677003059891236138621516972489182501113511 *I}, {0.4518896503369655025746251976070079116749079603454183700604058820 + 0.5499108231834952615203803746348270758930791277607194123538266006 *I, -0.2880486441942307974992030095513416455924599229025763657531580587 - 0.2402822151196603762852012013980694919750389172509658963034542457 *I, 0.2852201493481695003682080421339410626386876598853379005527255655 + 0.0564564791767486170526374715207488153612416265343364779087418482 *I, -0.1527643605080640778018983192137611760808228523845483757486958975 + 0.2259802672721239979778090110880353353012394684399792584276137434 *I, 0.1575731801922062373688235259765136717599385108764442931701580417 - 0.4109927740850314777801531512743021043256255590953083088715388979 *I}, {-0.6140996148655906287647583298237232492183637522659581195148808427 - 0.0992153964399398800012487639595519531245622463113717302875535420 *I, -0.2929723159241657535337200337671348331713485862703912987447323753 - 0.2177125990881136023713253053988236652990921669553173833509724989 *I, 0.1904140913395115213535698437163220259143628310011455406165442916 - 0.2233662206896797360316014171741502217669488113613237014611818940 *I, -0.1928146643482667568821619714720020130831947416044520735569480620 + 0.3949722108751515370866376980072728986169669550448650186432186974 *I, -0.3830183791178170702530035177491206414326016127830543805972410543 - 0.2318896263576825347018784894778951851466762985873961911191218133 *I}, {0.1670668380328926560480057822793380087280082178372449227162707298 + 0.0600678273797977386710241996853107993727938789940479217867919449 *I, 0.5572933227355481186778313023610161622960150339814104240923966308 + 0.1623093763756542348896346605899488932381379701197470839409383987 *I, 0.2286413578459091444533752643988730987060035554423567038746079669 - 0.2464421669483894495521128278149632238457201970394525300110134399 *I, -0.4173389664939408682556756184278665272165539505200047717627625815 + 0.4912486177778516069395992027274706775356277127801399759928278729 *I, -0.0218019690520589137762068687225050094454946088152865888673745898 + 0.3202770536164183942433530707614393785421795076477457940536314846 *I}, {-0.1113515799351029890252405177999746990854884228161327611729796170 + 0.1867990111196349795593985371505476543136635843297677619717862973 *I, 0.3275596208168649204706122589159902919326736797257139664766012293 + 0.2415487968411294975852867854064074229168260465790599414329932133 *I, -0.3398972689093688800411941541897129593235449729659321666945368554 - 0.5186164947541041924539718820931239141925498424876153491952121809 *I, -0.0421642633529312183345408779002678993643146615567489711781568127 - 0.1778799685293354643238826936490346030714569796695315014658400708 *I, 0.0783296174449703150958999547338138209657184905100291536070060029 - 0.6025097255027071883474243221963274677783481906696979146613986538 *I}}
-- create all possible binary 5-bit representations
StrList = {"0","1"}
for i=1,4 do
	StrListNew={}
	for j=1,#StrList do
		StrListNew[#StrListNew+1] = StrList[j].."0"
		StrListNew[#StrListNew+1] = StrList[j].."1"
	end
	StrList = StrListNew
end

-- create two wave functions
psiStr1 = {}
psiStr2 = {}
for i=1,32 do
	psiStr1[i] = {StrList[i], RandomList1[i]}
	psiStr2[i] = {StrList[i], RandomList2[i]}
end
NF=5
NB=0
psi1 = NewWavefunction(NF,NB,psiStr1)
psi2 = NewWavefunction(NF,NB,psiStr2)
-- calculate the one particle density matrix
rho1 = DensityMatrix(psi1)
rho2 = DensityMatrix(psi2)
-- recalculate the one particle density matrix
rhoS1={}
rhoS2={}
rhoS1b={}
rhoS2b={}
for i=1,5 do
	rhoS1[i]={}
	rhoS2[i]={}
	rhoS1b[i]={}
	rhoS2b[i]={}
	for j=1,5 do
		ONij = NewOperator(5,0,{{(i-1),-(j-1),1}})
		rhoS1[i][j] = psi1*ONij*psi1
		rhoS2[i][j] = psi2*ONij*psi2
		rhoS1b[i][j] = Braket(psi1,ONij,psi1)
		rhoS2b[i][j] = Braket(psi2,ONij,psi2)
	end
end
-- compare the two ways of calculating rho
if not(Chop(rhoS1-rho1) == Matrix.Zero(5,{{"userdata",false}})) then
	print(rhoS1)
	print(rho1)
	print(rhoS1-rho1)
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS2-rho2) == Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS1b-rho1) == Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS2b-rho2) == Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end

-- We now test rotating the density matrix and the wave functions
-- We test that
-- Rotate(rho,M^*) = Table_{i,j} Rotate(psi) * a^{dag}_i a_j * Rotate(psi)
psi1R1 = Rotate(psi1,RandomMat1)
psi1R2 = Rotate(psi1,RandomMat2)
psi2R1 = Rotate(psi2,RandomMat1)
psi2R2 = Rotate(psi2,RandomMat2)

rho1R1 = DensityMatrix(psi1R1)
rho1R2 = DensityMatrix(psi1R2)
rho2R1 = DensityMatrix(psi2R1)
rho2R2 = DensityMatrix(psi2R2)

if not(Chop( rho1R1 - Rotate(rho1,Matrix.Conjugate(RandomMat1))) == Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop( rho1R2 - Rotate(rho1,Matrix.Conjugate(RandomMat2))) == Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop( rho2R1 - Rotate(rho2,Matrix.Conjugate(RandomMat1))) == Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop( rho2R2 - Rotate(rho2,Matrix.Conjugate(RandomMat2))) == Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end

-- recalculate the one particle density matrix rotating both psi and a^dag_i a_j
-- If we rotate the operator and the function the expectation value does not change.
-- i.e. Rotate(psi,M) * Rotate(O,M) * Rotate(psi,M) = psi * O * psi
rhoS1R1={}
rhoS2R1={}
rhoS1R2={}
rhoS2R2={}
for i=1,5 do
	rhoS1R1[i]={}
	rhoS2R1[i]={}
	rhoS1R2[i]={}
	rhoS2R2[i]={}
	for j=1,5 do
		ONijR1 = Rotate(NewOperator(5,0,{{(i-1),-(j-1),1}}),RandomMat1)
		ONijR2 = Rotate(NewOperator(5,0,{{(i-1),-(j-1),1}}),RandomMat2)
		rhoS1R1[i][j] = psi1R1*ONijR1*psi1R1
		rhoS2R1[i][j] = psi2R1*ONijR1*psi2R1
		rhoS1R2[i][j] = psi1R2*ONijR2*psi1R2
		rhoS2R2[i][j] = psi2R2*ONijR2*psi2R2
	end
end

if not(Chop(rhoS1R1 - rho1)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS1R2 - rho1)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS2R1 - rho2)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS2R2 - rho2)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end


-- recalculate the one particle density matrix rotating the operator a^dag_i a_j
-- when rho_{i,j} = <psi | a^{dag}_i a_j | psi >
-- then
-- Rotate(rho,M^T) = <psi | rotate(a^dag_i a_j,M) | psi>

rho1OR1={}
rho1OR2={}
rho2OR1={}
rho2OR2={}
for i=1,5 do
	rho1OR1[i]={}
	rho1OR2[i]={}
	rho2OR1[i]={}
	rho2OR2[i]={}
	for j=1,5 do
		ONijR1 = Rotate(NewOperator(5,0,{{(i-1),-(j-1),1}}),RandomMat1)
		ONijR2 = Rotate(NewOperator(5,0,{{(i-1),-(j-1),1}}),RandomMat2)
		rho1OR1[i][j] = psi1*ONijR1*psi1
		rho2OR1[i][j] = psi2*ONijR1*psi2
		rho1OR2[i][j] = psi1*ONijR2*psi1
		rho2OR2[i][j] = psi2*ONijR2*psi2
	end
end


if not(Chop(rho1OR1-Rotate(rho1,Matrix.Transpose(RandomMat1)))== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rho1OR2-Rotate(rho1,Matrix.Transpose(RandomMat2)))== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rho2OR1-Rotate(rho2,Matrix.Transpose(RandomMat1)))== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rho2OR2-Rotate(rho2,Matrix.Transpose(RandomMat2)))== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end




if not(Chop(rhoS1R1 - rho1)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS1R2 - rho1)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS2R1 - rho2)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end
if not(Chop(rhoS2R2 - rho2)== Matrix.Zero(5,{{"userdata",false}})) then
	error("Error in DensityMatrix",1)
end




--- Define some functions

NF=5
NB=0
psi1 = NewWavefunction(NF,NB,{ {"11100",1}, {"11010",2}, {"10110",4}, {"01110",8}, {"11001",16} })
