-- test the function DensityMatrix
-- rho = DensityMatrix(psi) returns a NF by NF matrix containing the elmeents
-- rho[i][j] = < psi | a^dag_i a_j | psi >

-- The first test generates two random states with NF = 5 and creates the density matrix
-- we test the function DensityMatrix by calculating the expectation value of the operator
-- a^dag_i a_j for i and j raning from 0 to 4

-- We do this for a real and complex function

-- Create a list of 32 random numbers  v . v^ct = 1
RandomList1 = {0.05223796486674906574580868153383630283985213533949648565081992900,-0.08364247254882715992386500854162267692525807194684518529614298824,-0.2741914448360307313555851548456237845515724710914339169279004693,-0.2184426566289019278085441320861012900142118096692977117835616234,-0.1213355978625744547788539907119018998754320278011199759023845471,-0.01454483955300177089081969936355707988967817948522169504457837019,0.07689088920194304876764896772299538519928013717253803242399122489,-0.03082580053805945607895209493761832050889354219812237225628147952,-0.2729568695954576367441627930959319369216793630184177518312784326,-0.1944456003902624012990219755764660017081645215000460027179707845,-0.2550169481308798556719315989207222760497951363324016027709894614,0.2735355767394762748432670251660999904981917574276440792203200123,0.1086426211704323258051678339728825914305935104254225285027392320,-0.1285115664484055672077464683819857642241857184755264355265001355,0.2544768214631291267794343156552320927117169015504570305412173203,0.1097614549822016927967693493085408283451841396165934281215529527,0.1606105227033060271047278738739738026014065283739467280386730904,0.03684435483585329230963610846736607770462244405407617710231390857,-0.06604977537066056171109635360851384819928128190636483266927896489,-0.2489598133568181102346406365862966486156320748491660427656875937,0.3202179530236464148376750788263229790035249064385678219363407760,-0.3693694797889627440549278559859296627686442715955238948456056132,-0.2083345718467097156775235452604992875444619873214778600549686977,0.06003122107286672548041234007876609100355238005041102782324653584,-0.05752349011545262705096066777470452550533200427709694247073302374,0.1100700987923449664496249397459637902526574166348474693957084619,0.1386968121831335977519809528169435071708038600779097975736319385,-0.2096848885160865379087667534242247458896575742763392906293990503,-0.1473774193434131692385444338694643108184897762163047084092556343,0.08267796064212