--[[
 *  math.SphericalBesselJ(n, x, {{"Method", "Recurrence"}}) against 30-digit values of mpmath
 *  (sqrt(pi/2x) J_{n+1/2}(x)), including the middle range x ~ n/2 of large n where the former
 *  two-series implementation (Method "Series") fails. Core/BasicMath/BasicMath_StandardFunctions.cpp:
 *  measured on n = 0 .. 60, x = 1e-4 .. 1e3: recurrence <= 1.3e-13 relative, checked 1e-12
 *  here; the series is checked where it is good (n <= 7: 1e-10).
]]

local ref = {
  {0, 0.5, 9.5885107720840600055e-1},
  {0, 10, -5.440211108893698134e-2},
  {0, 562.3, 8.0152446038866320627e-5},
  {1, 0.001, 3.3333330000000119742e-4},
  {1, 0.3, 9.9102888040641876539e-2},
  {1, 3, 3.4567749976235595488e-1},
  {2, 5.766, -4.204378253305088285e-4},
  {3, 500, -1.7563660738876379973e-3},
  {5, 2, 2.635169770244117349e-3},
  {5, 0.0001, 9.6200096163096186153e-25},
  {7, 18.9, 1.1664506290635025576e-3},
  {10, 7, 6.7289852643458608087e-3},
  {12, 35.5, 5.9918420867632242571e-4},
  {15, 9.5, 5.7951974831447843436e-4},
  {20, 11.88, 4.336425326105882235e-5},
  {30, 17, 4.2420032997357494419e-7},
  {40, 22.1, 4.3523766518548040358e-9},
  {60, 32.33, 5.4416537795046856617e-13},
  {60, 200, 4.8839124247658215298e-3},
}
local failed = false
local function check(ok, text)
  print((ok and "ok    " or "FAILED") .. "  " .. text)
  if not ok then failed = true end
end
for _, r in ipairs(ref) do
  local rec = math.SphericalBesselJ(r[1], r[2])
  local ser = math.SphericalBesselJ(r[1], r[2], {{"Method", "Series"}})
  local e1, e2 = math.abs(rec - r[3])/math.abs(r[3]), math.abs(ser - r[3])/math.abs(r[3])
  check(e1 < 1e-12 and (r[1] > 7 or e2 < 1e-10), string.format("j_%d(%g) = %.15e: Recurrence %.1e, Series %.1e", r[1], r[2], r[3], e1, e2))
end
check(math.SphericalBesselJ(0, 0) == 1 and math.SphericalBesselJ(2, 0) == 0, "j_0(0) = 1, j_2(0) = 0")
local ok = pcall(function() return math.SphericalBesselJ(1, 1, {{"Method", "Taylor"}}) end)
check(not ok, "unknown Method is an error")
if failed then error("SphericalBesselJ: checks failed", 1) end
print("passed")
