spec = CreateResonantSpectra(H0-E0psi2, H0-E0psi2, TBathCr, TBathAn, psi2, {{"DenseBorder", 1}, {"NE1", 5}, {"NE2", 20}, {"Emin1", -1}, {"Emax1", 1}, {"Gamma1", 1}, {"Emin2", -2}, {"Emax2", 2}, {"Gamma2", 1}, {"NTri1", 100}, {"NTri2", 120}, {"epsilon", 1.49E-5}})
spec = Spectra.ToTable(spec)
for s = 1, #spec do
    if not CmpSpectra(spec[s], specRefH0H0BathBathPsi2[s], 1E-4) then
        error("Spectrum not equal to the expected one\n",1)
    end
end

spec = CreateResonantSpectra(H0, H0, {TUpCr, TDnCr}, {TUpAn, TDnAn, TBathAn}, {psi1, psi2}, {{"DenseBorder", 1}, {"NE1", 5}, {"NE2", 20}, {"Emin1", -1}, {"Emax1", 1}, {"Gamma1", 1}, {"Emin2", -2}, {"Emax2", 2}, {"Gamma2", 1}, {"NTri1", 100}, {"NTri2", 120}, {"epsilon", 1.49E-5}})
