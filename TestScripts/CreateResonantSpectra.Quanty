spec = CreateResonantSpectra(H0-E0psi1, H2-E2psi1, TUpCr, TUpAn, psi1, {{"DenseBorder", 10000}, {"NE1", 5}, {"NE2", 20}, {"Emin1", -1}, {"Emax1", 1}, {"Gamma1", 1}, {"Emin2", -2}, {"Emax2", 2}, {"Gamma2", 1}, {"NTri1", 200}, {"NTri2", 200}, {"epsilon", 1.49E-8}})
spec = Spectra.ToTable(spec)
for s = 1, #spec do
	if not CmpSpectra(spec[s], specRefH0H2UpUpPsi1[s], threshold) then
		error("Spectrum not equal to the expected one\n",1)
	end
end

