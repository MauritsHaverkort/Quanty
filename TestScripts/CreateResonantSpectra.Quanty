spec = CreateResonantSpectra(H0, H0, {TUpCr, TDnCr}, {TUpAn, TDnAn, TBathAn}, {psi1, psi2}, {{"DenseBorder", 10000}, {"NE1", 5}, {"NE2", 20}, {"Emin1", -1}, {"Emax1", 1}, {"Gamma1", 1}, {"Emin2", -2}, {"Emax2", 2}, {"Gamma2", 1}, {"NTri1", 200}, {"NTri2", 200}, {"epsilon", 1.49E-8}})
spec = Spectra.ToTable(spec)

specList = {specRefH0H0UpUpPsi1, specRefH0H0UpDnPsi1, specRefH0H0UpBathPsi1, 
			specRefH0H0DnUpPsi1, specRefH0H0DnDnPsi1, specRefH0H0DnBathPsi1,
			specRefH0H0UpUpPsi2, specRefH0H0UpDnPsi2, specRefH0H0UpBathPsi2,
			specRefH0H0DnUpPsi2, specRefH0H0DnDnPsi2, specRefH0H0DnBathPsi2}
for i = 1, 12 do
	for s = 1, 6 do
		if not CmpSpectra(spec[(i-1)*6+s], specList[i][s], threshold) then
			error("Spectrum not equal to the expected one\n",1)
		end
	end
end


