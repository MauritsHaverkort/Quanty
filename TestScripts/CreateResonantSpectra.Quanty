spec = CreateResonantSpectra(H0, H2, {TUpCr, TDnCr}, {TUpAn, TDnAn}, {psi1, psi2}, {{"DenseBorder", 10000}, {"NE1", 5}, {"NE2", 20}, {"Emin1", -1}, {"Emax1", 1}, {"Gamma1", 1}, {"Emin2", -2}, {"Emax2", 2}, {"Gamma2", 1}, {"NTri1", 200}, {"NTri2", 200}, {"epsilon", 1.49E-8}})
spec = Spectra.ToTable(spec)

specList = {specRefH0H2UpUpPsi1, specRefH0H2UpDnPsi1, 
			specRefH0H2DnUpPsi1, specRefH0H2DnDnPsi1,
			specRefH0H2UpUpPsi2, specRefH0H2UpDnPsi2,
			specRefH0H2DnUpPsi2, specRefH0H2DnDnPsi2}
for i = 1, 8 do
	for s = 1, 6 do
		if not CmpSpectra(spec[(i-1)*6+s], specList[i][s], threshold) then
			error("Spectrum not equal to the expected one\n",1)
		end
	end
end

