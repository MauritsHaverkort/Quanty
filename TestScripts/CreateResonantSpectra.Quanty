print("-------------------------------------------------------------------------")
print("--                     Dense with restrictions                         --")
print("-------------------------------------------------------------------------")

-- Define some model Hamiltonian: impurity coupled to a 1D chain
NBath = 6
NF = 2 + 2*NBath

restrictions1 = {NF,0,{"00 0000000000 11",0,0}}
restrictions2 = {NF,0,{"00 0000000000 01",0,0}}

-- some parameters
t = 1
U = 3

-- defining 3 Hamiltonian (real, mixed, complex)
H0 = U*NewOperator(NF, 0, {{0, -0, 1, -1, 1}})
for i = 1, NBath do
		H0 = H0 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,         t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),     t}})
end
H1 = U*NewOperator(NF, 0, {{0, -0, 1, -1, 1}})
for i = 1, NBath do
		H1 = H1 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     I*t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), I*t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,        -I*t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),    -I*t}})
end
H2 = 0
for i = 1, NBath do
		H2 = H2 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     I*t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), I*t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,        -I*t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),    -I*t}})
end
H2 = Chop(H2)

-- Defining 2 transition operators
TDnCr = NewOperator("Cr", NF, 0)
TUpCr = NewOperator("Cr", NF, 1)
TDnAn = NewOperator("An", NF, 0)
TUpAn = NewOperator("An", NF, 1)

-- Addition transition operator
TBathCr = NewOperator("Cr", NF, 5)
TBathAn = NewOperator("An", NF, 5)

-- Defining 2 starting states (real and complex)
str1 = "10"
for i = 1, NBath do
		str1 = str1.."00"
end
str2 = "01"
for i = 1, NBath do
		str2 = str2.."00"
end
psi1 = NewWavefunction(NF, 0, {{str1, 1}, {str2, 1}})
psi1.Normalize()
psi2 = NewWavefunction(NF, 0, {{str1, 1}, {str2, -2*I}})
psi2.Normalize()

E0psi1 = psi1*H0*psi1
E0psi2 = psi2*H0*psi2
E1psi1 = psi1*H1*psi1
E1psi2 = psi2*H1*psi2
E2psi1 = psi1*H2*psi1
E2psi2 = psi2*H2*psi2


-- Define some reference spectra
specRefH0H2UpUpPsi1 = {
