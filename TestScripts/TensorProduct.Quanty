print("-----------------------------------------------------------------------------------")
print("--                  TensorProduct using single wave-functions                    --")
print("-----------------------------------------------------------------------------------")

psi = TensorProduct(psi1, psi1)

if Chop(psi - psi11) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi1, psi2)

if Chop(psi - psi12) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi1, psi3)

if Chop(psi - psi13) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi2, psi1)

if Chop(psi - psi21) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi2, psi2)

if Chop(psi - psi22) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi2, psi3)

if Chop(psi - psi23) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi3, psi1)

if Chop(psi - psi31) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi3, psi2)

if Chop(psi - psi32) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end

psi = TensorProduct(psi3, psi3)

if Chop(psi - psi33) ~= 0*psi then error("TensorProduct using single wave-functions not equal to the expected value\n", 1) end


print("-----------------------------------------------------------------------------------")
print("--                  TensorProduct of single wave-functions with array            --")
print("-----------------------------------------------------------------------------------")

psiBlock = TensorProduct(psi1, psiList)

for i, psiRef in pairs({psi11, psi12, psi13}) do
    if Chop(psiBlock[i] - psiRef) ~= 0*psiRef then error("TensorProduct of single wave-functions with array not equal to the expected value\n", 1) end
end

psiBlock = TensorProduct(psi2, psiList)

for i, psiRef in pairs({psi21, psi22, psi23}) do
    if Chop(psiBlock[i] - psiRef) ~= 0*psiRef then error("TensorProduct of single wave-functions with array not equal to the expected value\n", 1) end
end

psiBlock = TensorProduct(psi3, psiList)

for i, psiRef in pairs({psi31, psi32, psi33}) do
    if Chop(psiBlock[i] - psiRef) ~= 0*psiRef then error("TensorProduct of single wave-functions with array not equal to the expected value\n", 1) end
end

psiBlock = TensorProduct(psiList, psi1)

for i, psiRef in pairs({psi11, psi21, psi31}) do
    if Chop(psiBlock[i] - psiRef) ~= 0*psiRef then error("TensorProduct of single wave-functions with array not equal to the expected value\n", 1) end
end

psiBlock = TensorProduct(psiList, psi2)

for i, psiRef in pairs({psi12, psi22, psi32}) do
    if Chop(psiBlock[i] - psiRef) ~= 0*psiRef then error("TensorProduct of single wave-functions with array not equal to the expected value\n", 1) end
end

psiBlock = TensorProduct(psiList, psi3)

for i, psiRef in pairs({psi13, psi23, psi33}) do
    if Chop(psiBlock[i] - psiRef) ~= 0*psiRef then error("TensorProduct of single wave-functions with array not equal to the expected value\n", 1) end
end

print("-----------------------------------------------------------------------------------")
print("--                  TensorProduct using array of wavefunctions                   --")
print("-----------------------------------------------------------------------------------")

psiBlock = TensorProduct(psiList, psiList)

for i, psiRef in pairs({psi11, psi12, psi13, psi21, psi22, psi23, psi31, psi32, psi33}) do
    if Chop(psiBlock[i] - psiRef) ~= 0*psiRef then error("TensorProduct using array of wavefunctions not equal to the expected value\n", 1) end
end

print("--------------------------------------------------------------")
print("--                  End of TensorProduct                    --")
print("--------------------------------------------------------------")

