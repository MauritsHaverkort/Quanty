-- CreateSpectra with hybridisation functions and more than one excitation in
-- the baths they stand for, i.e. CalculateGforHwithSigmaAsOperatorBathExcitations
-- (option NBathExcitations).
--
-- Every model below is built so that the only truncation left is the number
-- of bath excitations: the channels of each hybridisation function reach every
-- orbital of P, so the intermediate spaces are complete sectors and the
-- Rayleigh-Ritz step is exact.  The answer is then compared with a calculation
-- in which the baths are written out explicitly and restricted to at most p
-- excitations.  The two have to agree to machine precision.
--
-- The valence bath is written with holes, so that "at most p excitations" is
-- a single restriction on the number of particles in the baths.  Quanty has no
-- boson wave functions, so the photons of the second model are written with
-- fermion pairs (see there).
--
-- What is tested: the exchange sign of the crossed processes for fermions
-- (without it every p = 2 comparison below is off by about one), the factor
-- sqrt(2) of two bosons in one mode (the boson model is off by 0.12 without
-- it), a fermionic and a bosonic hybridisation at once, complex couplings, and
-- that the new routine gives what the old one gives at one excitation.

print("--------------------------------------------------------")
print("-- CreateSpectra with more than one bath excitation   --")
print("--------------------------------------------------------")

Verbosity(0)

threshold = 1e-9

-- the largest absolute value of a complex number, by bisection on Chop
function Mag(z)
  local lo, hi = 0, 1
  while Chop(z, hi) ~= 0 do hi = hi * 2 end
  for it = 1, 60 do
    local mid = 0.5 * (lo + hi)
    if Chop(z, mid) ~= 0 then lo = mid else hi = mid end
  end
  return hi
end

function Deviation(sa, sb)
  local ta, tb = Spectra.ToTable(sa), Spectra.ToTable(sb)
  if #ta ~= #tb then error("the two spectra do not have the same number of elements", 1) end
  local d, s = 0, 0
  for i = 1, #ta do
    if #ta[i] ~= #tb[i] then error("the two spectra are not on the same energy grid", 1) end
    for k = 1, #ta[i] do
      local x = Mag(ta[i][k][2] - tb[i][k][2])
      local y = Mag(ta[i][k][2])
      if x > d then d = x end
      if y > s then s = y end
    end
  end
  return d, s
end

function Check(name, sa, sb)
  local d, s = Deviation(sa, sb)
  print(string.format("%-62s largest value %10.6f   deviation %.3e", name, s, d))
  if d > threshold * math.max(s, 1) then
    error("CreateSpectra with bath excitations: " .. name .. " deviates by " .. d, 1)
  end
end

-- the two must differ: a check that the crossed processes are really there
function CheckDifferent(name, sa, sb)
  local d, s = Deviation(sa, sb)
  print(string.format("%-62s largest value %10.6f   deviation %.3e", name, s, d))
  if d < 1e-3 * math.max(s, 1) then
    error("CreateSpectra with bath excitations: " .. name .. " should differ but deviates by only " .. d, 1)
  end
end

function Options(extra)
  local o = { {"Tensor", true}, {"NTri", 200}, {"DenseBorder", 0}, {"E0", 0.0},
              {"Emin", -8}, {"Emax", 10}, {"NE", 600}, {"Gamma", 0.2} }
  for _, v in ipairs(extra) do o[#o + 1] = v end
  return o
end

-- the residue of one pole with one mode per spin, the mode of spin sg coupling
-- to the channels d sg and s sg (channel order d up, d dn, s up, s dn)
function SpinResidue(L)
  local W = {}
  for j = 1, 4 do W[j] = {0, 0, 0, 0} end
  for sg = 0, 1 do
    local l = {0, 0, 0, 0}
    l[1 + sg] = L[1]
    l[3 + sg] = L[2]
    for j = 1, 4 do for jp = 1, 4 do W[j][jp] = W[j][jp] + Conjugate(l[j]) * l[jp] end end
  end
  return W
end

-- P is four spin orbitals: 0 d up, 1 d dn, 2 s up, 3 s dn, with a Hubbard U on
-- both sites.  psi has two electrons in P and nothing in the baths
function PModel(NF, iH)
  local M = {}
  local function Num(i) return NewOperator(NF, 0, {{i, -i, 1}}) end
  M.Num = Num
  local nd = {Num(0), Num(1)}
  local ns = {Num(2), Num(3)}
  local th = 0.45 + 0.15 * iH
  local hop = NewOperator(NF, 0, {{0, -2, th}, {2, -0, Conjugate(th)}, {1, -3, th}, {3, -1, Conjugate(th)}})
  M.HP = -0.4 * (nd[1] + nd[2]) + 0.3 * (ns[1] + ns[2]) + hop + 1.7 * nd[1] * nd[2] + 0.6 * ns[1] * ns[2]
  M.Ntot = nd[1] + nd[2] + ns[1] + ns[2]
  local occ = {"1100", "1001", "0110", "0011"}
  local amp = {0.55, 0.45 + 0.1 * iH, 0.40, 0.35 - 0.15 * iH}
  local dets = {}
  for q = 1, 4 do dets[q] = {occ[q] .. string.rep("0", NF - 4), amp[q]} end
  M.psi = NewWavefunction(NF, 0, dets)
  M.psi = M.psi / sqrt(M.psi * M.psi)
  M.T = { NewOperator(NF, 0, {{0, 1}}), NewOperator(NF, 0, {{1, 1}}) }
  return M
end

-- ---------------------------------------------------------------------------
-- 1  a conduction bath (electrons, V = c) and a valence bath (holes, V = c^dag)
-- ---------------------------------------------------------------------------
function FermionModel(iH)
  local ec = {1.1, 2.3}
  local ev = {0.8, 1.9}                -- hole energies
  local Lc = { {0.35 + 0.1 * iH, 0.22}, {0.18, -0.30 + 0.05 * iH} }
  local Lv = { {0.28, 0.16 - 0.08 * iH}, {-0.21, 0.33} }
  local NF = 4 + 2 * #ec + 2 * #ev
  local M = PModel(NF, iH)
  local Hbath = 0 * M.Ntot
  local Hhyb  = 0 * M.Ntot
  for k = 1, #ec do
    for sg = 0, 1 do
      local b = 4 + 2 * (k - 1) + sg
      Hbath = Hbath + ec[k] * M.Num(b)
      local O = NewOperator(NF, 0, {{b, -(0 + sg), Lc[k][1]}, {b, -(2 + sg), Lc[k][2]}})
      Hhyb = Hhyb + O + ConjugateTranspose(O)
    end
  end
  for k = 1, #ev do
    for sg = 0, 1 do
      local h = 4 + 2 * #ec + 2 * (k - 1) + sg
      Hbath = Hbath + ev[k] * M.Num(h)
      -- a hole in the valence bath and an electron in P: h^dag c_x^dag
      local O = NewOperator(NF, 0, {{h, 0 + sg, Lv[k][1]}, {h, 2 + sg, Lv[k][2]}})
      Hhyb = Hhyb + O + ConjugateTranspose(O)
    end
  end
  M.Hfull = M.HP + Hbath + Hhyb
  M.Mask = string.rep("0", 4) .. string.rep("1", NF - 4)
  local zero = {} for j = 1, 4 do zero[j] = {0, 0, 0, 0} end
  local lc, wc, lv, wv = {zero}, {}, {zero}, {}
  for k = 1, #ec do lc[#lc + 1] = ec[k] ; wc[k] = SpinResidue(Lc[k]) end
  for k = 1, #ev do lv[#lv + 1] = ev[k] ; wv[k] = SpinResidue(Lv[k]) end
  local Scon = ResponseFunction.New({ lc, wc, mu = 0, type = "ListOfPoles", name = "Scon" })
  local Sval = ResponseFunction.New({ lv, wv, mu = 0, type = "ListOfPoles", name = "Sval" })
  local Vcon, Vval = {}, {}
  for x = 0, 3 do
    Vcon[x + 1] = NewOperator("An", NF, x)
    Vval[x + 1] = NewOperator("Cr", NF, x)
  end
  M.Hyb = {{Sval, Vval}, {Scon, Vcon}}
  M.NF = NF
  return M
end

-- ---------------------------------------------------------------------------
-- 2  the conduction bath and photons (V even: the number of electrons, and
--    the decay s -> d of either spin)
--
--    Every photon mode is written with fermion pairs: one quantum is
--    g1^dag h1^dag, the second one adds g2^dag h2^dag.  The pairs are even, so
--    they commute with the electrons, and
--
--      b^dag = g1^dag h1^dag (1 - n_g2) + sqrt(2) g2^dag h2^dag n_g1 (1 - n_g2)
--
--    is a boson truncated at two quanta, which is all p <= 2 reaches.  Without
--    the first (1 - n_g2) its adjoint would take two quanta to a state that
--    holds the second pair alone.  The number of electrons among the channels
--    makes the intermediate spaces complete sectors.
-- ---------------------------------------------------------------------------
function BosonModel(iH)
  local ec = {1.1, 2.3}
  local eb = {1.4, 2.6}
  local Lc = { {0.35 + 0.1 * iH, 0.22}, {0.18, -0.30 + 0.05 * iH} }
  local Lb = { {0.12, 0.30 + 0.1 * iH, 0.25}, {-0.08, 0.20, -0.28 + 0.05 * iH} }
  local NF = 4 + 2 * #ec + 4 * #eb
  local M = PModel(NF, iH)
  local Vb = { M.Ntot, NewOperator(NF, 0, {{0, -2, 1}}), NewOperator(NF, 0, {{1, -3, 1}}) }
  local Hbath = 0 * M.Ntot
  local Hhyb  = 0 * M.Ntot
  for k = 1, #ec do
    for sg = 0, 1 do
      local b = 4 + 2 * (k - 1) + sg
      Hbath = Hbath + ec[k] * M.Num(b)
      local O = NewOperator(NF, 0, {{b, -(0 + sg), Lc[k][1]}, {b, -(2 + sg), Lc[k][2]}})
      Hhyb = Hhyb + O + ConjugateTranspose(O)
    end
  end
  for k = 1, #eb do
    local g1 = 4 + 2 * #ec + 4 * (k - 1)
    local h1, g2, h2 = g1 + 1, g1 + 2, g1 + 3
    local bdag = NewOperator(NF, 0, {{g1, h1, 1}}) * (1 - M.Num(g2))
               + sqrt(2) * NewOperator(NF, 0, {{g2, h2, 1}}) * M.Num(g1) * (1 - M.Num(g2))
    Hbath = Hbath + eb[k] * (M.Num(g1) + M.Num(g2))
    for j = 1, 3 do
      local O = Lb[k][j] * bdag * Vb[j]
      Hhyb = Hhyb + O + ConjugateTranspose(O)
    end
  end
  M.Hfull = M.HP + Hbath + Hhyb
  -- the excitations are the electrons of the bath and the quanta g1, g2
  M.Mask = string.rep("0", 4) .. string.rep("1", 2 * #ec) .. string.rep("1010", #eb)
  local zero4 = {} for j = 1, 4 do zero4[j] = {0, 0, 0, 0} end
  local zero3 = {} for j = 1, 3 do zero3[j] = {0, 0, 0} end
  local lc, wc, lb, wb = {zero4}, {}, {zero3}, {}
  for k = 1, #ec do lc[#lc + 1] = ec[k] ; wc[k] = SpinResidue(Lc[k]) end
  for k = 1, #eb do
    lb[#lb + 1] = eb[k]
    wb[k] = {}
    for j = 1, 3 do
      wb[k][j] = {}
      for jp = 1, 3 do wb[k][j][jp] = Conjugate(Lb[k][j]) * Lb[k][jp] end
    end
  end
  local Scon = ResponseFunction.New({ lc, wc, mu = 0, type = "ListOfPoles", name = "Scon" })
  local Sbos = ResponseFunction.New({ lb, wb, mu = 0, type = "ListOfPoles", name = "Sbos" })
  local Vcon = {}
  for x = 0, 3 do Vcon[x + 1] = NewOperator("An", NF, x) end
  M.Hyb = {{Scon, Vcon}, {Sbos, Vb}}
  M.NF = NF
  return M
end

for _, model in ipairs({ {"fermions", FermionModel}, {"fermions and photons", BosonModel} }) do
  for _, iH in ipairs({0, I}) do
    local M = model[2](iH)
    local tag = model[1] .. ((iH == 0) and ", real" or ", complex")
    local s = {}
    for p = 1, 2 do
      local sref = CreateSpectra(M.Hfull, M.T, M.psi, Options({{"Restrictions", {M.NF, 0, {M.Mask, 0, p}}}}))
      local extra = {{"NTriFull", 200}}
      if p > 1 then extra[#extra + 1] = {"NBathExcitations", p} end
      s[p] = CreateSpectra(M.HP, M.T, M.psi, M.Hyb, Options(extra))
      Check(string.format("%s, p = %d, against explicit baths", tag, p), sref, s[p])
    end
    -- at one excitation NonCrossing sends the calculation through the new routine
    local snew = CreateSpectra(M.HP, M.T, M.psi, M.Hyb, Options({{"NTriFull", 200}, {"NonCrossing", true}}))
    Check(tag .. ", p = 1, new routine against old", s[1], snew)
    local snc = CreateSpectra(M.HP, M.T, M.psi, M.Hyb, Options({{"NTriFull", 200}, {"NBathExcitations", 2}, {"NonCrossing", true}}))
    CheckDifferent(tag .. ", p = 2, non crossing against full", s[2], snc)
  end
end

-- ---------------------------------------------------------------------------
-- 3  an operator that mixes an even and an odd number of fermion operators
--    can not couple to a bath of free particles and has to be refused
-- ---------------------------------------------------------------------------
M = FermionModel(0)
Vmixed = {}
for x = 0, 3 do Vmixed[x + 1] = NewOperator("An", M.NF, x) + NewOperator(M.NF, 0, {{x, -x, 1}}) end
ok = pcall(CreateSpectra, M.HP, M.T, M.psi, {{M.Hyb[2][1], Vmixed}}, Options({{"NBathExcitations", 2}}))
if ok then error("CreateSpectra with bath excitations: an operator of mixed parity was accepted", 1) end
print("an operator of mixed parity is refused")

collectgarbage()
collectgarbage()
collectgarbage()
print("--------------------------------------------------------")
print("-- End                                                --")
print("--------------------------------------------------------")
