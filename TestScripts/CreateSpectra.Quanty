print("--------------------------------------------------------")
print("--                 Lanczos Tensor                     --")
print("--------------------------------------------------------")

spec, G = CreateSpectra(H0, {TDn,TUp}, psi1, {{"DenseBorder", 1}, {"Tensor", true}})
for i, omega in pairs(omegaList) do
		if Chop(G(omega, 0.1)[1][1] - G0Dn1(omega, 0.1), threshold) ~= 0 then
				error("Response function not equal to the expected value\n",1)
		end
		if Chop(G(omega, 0.1)[2][2] - G0Up1(omega, 0.1), threshold) ~= 0 then
				error("Response function not equal to the expected value\n",1)
		end
end
spec, G = CreateSpectra(H0, {TDn,TUp}, psi2, {{"DenseBorder", 1}, {"Tensor", true}})
for i, omega in pairs(omegaList) do
	if Chop(G(omega, 0.1)[1][1] - G0Dn2(omega, 0.1), threshold) ~= 0 then
			 error("Response function not equal to the expected value\n",1)
	 end
	if Chop(G(omega, 0.1)[2][2] - G0Up2(omega, 0.1), threshold) ~= 0 then
			 error("Response function not equal to the expected value\n",1)
	 end
end
