print("--                Lanczos Restricted                  --")
print("--------------------------------------------------------")

spec, G = CreateSpectra(H0, TDn, psi1, {{"DenseBorder", 1}, {"Tensor", false},{"Restrictions",restrictions}})
G = G[1]
if(G~=G0Dn1) then error("Response function not equal to the expected value\n",1) end
for i, omega in pairs(omegaList) do
		if Chop(G(omega, 0.1) - G0Dn1(omega, 0.1), threshold) ~= 0 then
				error("Response function not equal to the expected value\n",1)
		end
end
