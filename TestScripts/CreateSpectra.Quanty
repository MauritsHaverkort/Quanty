G = G[1]
if(G~=G1Dn1) then error("Response function not equal to the expected value\n",1) end
for i, omega in pairs(omegaList) do
		if Chop(G(omega, 0.1) - G1Dn1(omega, 0.1), threshold) ~= 0 then
				error("Response function not equal to the expected value\n",1)
		end
end
