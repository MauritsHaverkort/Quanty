-- some reference frequencies
omegaList = {-1.1, -0.5463, 0.0, 4.75, 100.1}
-- Threshold for comparing the response functions
threshold = 1E-13

collectgarbage()

print("--------------------------------------------------------")
print("--                     Lanczos                        --")
print("--------------------------------------------------------")

spec, G = CreateSpectra(H0, TDn, psi1, {{"DenseBorder", 1}, {"Tensor", false}})
G = G[1]
if(G~=G0Dn1) then error("Response function not equal to the expected value\n",1) end
for i, omega in pairs(omegaList) do
		if Chop(G(omega, 0.1) - G0Dn1(omega, 0.1), threshold) ~= 0 then
				error("Response function not equal to the expected value\n",1)
		end
end
spec, G = CreateSpectra(H0, TDn, psi2, {{"DenseBorder", 1}, {"Tensor", false}})
