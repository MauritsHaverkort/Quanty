	if Chop(G(omega, 0.1)[1][1] - G2Dn2(omega, 0.1), threshold) ~= 0 then
			 error("Response function not equal to the expected value\n",1)
	 end
	if Chop(G(omega, 0.1)[2][2] - G2Up2(omega, 0.1), threshold) ~= 0 then
			 error("Response function not equal to the expected value\n",1)
	 end
end

