	 end
end
spec, G = CreateSpectra(H1, {TDn,TUp}, psi2, {{"DenseBorder", 1}, {"Tensor", true}})
for i, omega in pairs(omegaList) do
	if Chop(G(omega, 0.1)[1][1] - G1Dn2(omega, 0.1), threshold) ~= 0 then
		error("Response function not equal to the expected value\n",1)
	end
	if Chop(G(omega, 0.1)[2][2] - G1Up2(omega, 0.1), threshold) ~= 0 then
		error("Response function not equal to the expected value\n",1)
	end
end
