print("------------------------------------------------")
print("--              NewOperator Basis             --")
print("------------------------------------------------")

-- NewOperator takes an option {"Basis", b} with b one of
--   "Y"    spherical harmonics, the default, alternating dn, up from m=-l to m=l
--   "Z"    tesseral harmonics
--   "K"    cubic harmonics
--   "jjz"  j = l-1/2 (2l states) followed by j = l+1/2 (2l+2 states), jz = -j ... j
-- Every operator is created in the spherical harmonics basis and rotated with the matrix
--   C[i][m] = <new_i|Y_m>
-- that YtoZMatrix, YtoKMatrix and YtojjzMatrix return, so that in the new basis a one particle
-- operator has the matrix A' = C^* A C^T. This script checks that what NewOperator returns for a
-- rotated basis is the same as rotating by hand, that a many body spectrum does not depend on the
-- basis, and that the operators written directly on the jjz basis agree with the rotated ones.

threshold = 1E-11
nfail = 0

function CheckOperator(name, A, B)
  if Chop(A - B, threshold) ~= Chop(0 * A) then
    print("Not equal: " .. name)
    nfail = nfail + 1
  end
end

function RotationMatrix(l, basis)
  if basis == "Z"   then return Matrix.ToUserdata(YtoZMatrix(l))   end
  if basis == "K"   then return Matrix.ToUserdata(YtoKMatrix(l))   end
  if basis == "jjz" then return Matrix.ToUserdata(YtojjzMatrix(l)) end
end

-- the indices of one shell of angular momentum l filling the whole basis
function ShellIndices(l)
  local up, dn, jmin, jplus = {}, {}, {}, {}
  for i = 1, 2*l+1 do dn[i] = 2*(i-1) ; up[i] = 2*(i-1) + 1 end
  for i = 1, 2*l   do jmin[i]  = i - 1 end
  for i = 1, 2*l+2 do jplus[i] = 2*l + i - 1 end
  return up, dn, jmin, jplus
end

OneShellOperators = {"Lx","Ly","Lz","Lplus","Lmin","Lsqr","Sx","Sy","Sz","Splus","Smin","Ssqr",
                     "Jx","Jy","Jz","Jplus","Jmin","Jsqr","Tx","Ty","Tz","Tplus","Tmin","Tsqr",
                     "Qxx","Qyy","Qzz","Qxy","Qxz","Qyz","ldots"}

print("\nOne shell operators, every basis against an explicit rotation")

for _, l in ipairs({1, 2, 3}) do
  local NF = 2*(2*l+1)
  local up, dn, jmin, jplus = ShellIndices(l)
  for _, basis in ipairs({"Z", "K", "jjz"}) do
    local u, d = up, dn
    if basis == "jjz" then u, d = jmin, jplus end
    local U = RotationMatrix(l, basis)
    for _, name in ipairs(OneShellOperators) do
      CheckOperator("l=" .. l .. " basis " .. basis .. " " .. name,
                    NewOperator(name, NF, u, d, {{"Basis", basis}}),
                    Rotate(NewOperator(name, NF, up, dn), U))
    end
    -- the coulomb operator keeps its Slater integrals F[0], F[2], ... in every basis
    local F = {}
    for k = 0, l do F[k+1] = 1 / (k+1) end
    CheckOperator("l=" .. l .. " basis " .. basis .. " Coulomb",
                  NewOperator("U", NF, u, d, F, {{"Basis", basis}}),
                  Rotate(NewOperator("U", NF, up, dn, F), U))
  end
  print("  l = " .. l .. " done")
end

print("\nSquares of the angular momentum operators in every basis")

for _, l in ipairs({1, 2, 3}) do
  local NF = 2*(2*l+1)
  local up, dn, jmin, jplus = ShellIndices(l)
  for _, basis in ipairs({"Y", "Z", "K", "jjz"}) do
    local u, d = up, dn
    if basis == "jjz" then u, d = jmin, jplus end
    for _, X in ipairs({"L", "S", "J"}) do
      local x = NewOperator(X .. "x", NF, u, d, {{"Basis", basis}})
      local y = NewOperator(X .. "y", NF, u, d, {{"Basis", basis}})
      local z = NewOperator(X .. "z", NF, u, d, {{"Basis", basis}})
      CheckOperator("l=" .. l .. " basis " .. basis .. " " .. X .. "sqr",
                    NewOperator(X .. "sqr", NF, u, d, {{"Basis", basis}}), x*x + y*y + z*z)
    end
  end
end

print("\nCrystal field and two shell coulomb operator between a p and a d shell")

NF = 16
p_Dn = {0, 2, 4}          ; p_Up = {1, 3, 5}
d_Dn = {6, 8, 10, 12, 14} ; d_Up = {7, 9, 11, 13, 15}
Akm  = {{1,-1,0.3}, {1,0,0.5}, {1,1,-0.2}, {3,0,0.15}}
for _, basis in ipairs({"Z", "K"}) do
  local U = Matrix.ToUserdata(basis == "Z" and YtoZMatrix({1,2}) or YtoKMatrix({1,2}))
  CheckOperator("basis " .. basis .. " CF 3d <- 2p",
                NewOperator("CF", NF, d_Up, d_Dn, p_Up, p_Dn, Akm, {{"Basis", basis}}),
                Rotate(NewOperator("CF", NF, d_Up, d_Dn, p_Up, p_Dn, Akm), U))
  CheckOperator("basis " .. basis .. " Coulomb 2p 3d",
                NewOperator("U", NF, p_Up, p_Dn, d_Up, d_Dn, {1.0,0.4}, {0.2,0.1}, {{"Basis", basis}}),
                Rotate(NewOperator("U", NF, p_Up, p_Dn, d_Up, d_Dn, {1.0,0.4}, {0.2,0.1}), U))
end

print("\nA many body spectrum may not depend on the one particle basis")

NF    = 10
IDn   = {0, 2, 4, 6, 8} ; IUp = {1, 3, 5, 7, 9}
Ijmin = {0, 1, 2, 3}    ; Ijplus = {4, 5, 6, 7, 8, 9}
reference = nil
for _, basis in ipairs({"Y", "Z", "K", "jjz"}) do
  local u, d = IUp, IDn
  if basis == "jjz" then u, d = Ijmin, Ijplus end
  local H = NewOperator("ldots", NF, u, d, {{"Basis", basis}})
          + 0.1 * NewOperator("Lsqr", NF, u, d, {{"Basis", basis}})
          + NewOperator("U", NF, u, d, {1.0, 0.5, 0.3}, {{"Basis", basis}})
  local psiList = Eigensystem(H, {NF, 0, {"1111111111", 2, 2}}, 45, {{"DenseBorder", 46}})
  local e = {}
  for i = 1, 45 do e[i] = psiList[i] * H * psiList[i] end
  if reference == nil then
    reference = e
  else
    for i = 1, 45 do
      if math.abs(e[i] - reference[i]) > 1E-9 then
        print("Spectrum in basis " .. basis .. " differs at state " .. i)
        nfail = nfail + 1
      end
    end
  end
end

if nfail > 0 then
  error("" .. nfail .. " checks failed\n", 1)
end

print("\n-------------------------------------------------------")
print("--              End of NewOperator Basis             --")
print("-------------------------------------------------------")
