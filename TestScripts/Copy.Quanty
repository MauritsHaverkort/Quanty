tol = 1e-12

function checkMat(M1,M2,tol)
    tol = tol or 1e-15
    for i=1,#M1 do
        for j=1,#M1[i] do
            if math.abs(M1[i][j]-M2[i][j])>tol then return false end
        end
    end
    return true
end

print("=========================================")
print("Table:")

t00 = {{1,2,3},{4,5,6}}
t0 = {{1,2,3},{4,5,6}}
t1 = Copy(t0)
t0[1][2] = 0

if not checkMat(t00,t1) then
    error("Copy of Table did not copy the object",1)
end


print("=========================================")
print("Matrix (Table):")

t00 = {{1,2,3},{4,5,6}}
t0 = {{1,2,3},{4,5,6}}
setmetatable(t0,MatrixMeta)
t1 = Copy(t0)
t0[1][2] = 0


if not checkMat(Matrix.ToTable(t1),t00) then
    error("Copy of Matrix (Table) did not copy the matrix",1)
end

print("=========================================")
print("Matrix (Pointer):")

t00 = {{1,2,3},{4,5,6}}
t0 = NewMatrix({{1,2,3},{4,5,6}})
t1 = Copy(t0)
t0[1][2] = 0


if not checkMat(Matrix.ToTable(t1),t00) then
    error("Copy of Matrix (Pointer) did not copy the matrix",1)
end

print("Test Needed :(")