-------- expected values
omega = 0.1
gamma = 0.1
GA = 10.374533844318035550280744907149611422991838306539613709917191704 - 0.468637049967315952584530456603022329483414391744913594107849170 * I
GB = -1.375251164942556357773361351533519659549035823664840248196412292 - 1.230698975732759098765175551243385187741531720820724357080853024 * I
