GD = -0.058443832117413756987386217730572654149710540306313835149695600 - 0.680768190242625469395412727341028901005244603388377236765120370 * I
MA = 0
MB = 0
MC = 0
MD = 0

------------ test

if((Chop(GA_L(0.1,0.1)-GA)==0)==false) then error("Response function comparison failed\n",1) end
