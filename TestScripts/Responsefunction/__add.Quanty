print("-- Single valued                                      --")

a = {10,   0, 0.5,   1, 1.5}
b = {    0.1, 0.1, 0.2, 0.3}
GA = {a,b,mu=0,type="ListOfPoles", name="A"}
setmetatable(GA, ResponseFunctionMeta)

a = {-10, -1,-0.5, 0}
b = {    0.1, 0.1, 0.1}
GB = {a,b,mu=0,type="ListOfPoles", name="B"}
setmetatable(GB, ResponseFunctionMeta)

a = {0, -1, -0.5, 0,   0.5,   1, 1.5}
b = {   0.1, 0.1, 0.2, 0.1, 0.2, 0.3}
GAB = {a,b,mu=0,type="ListOfPoles", name="A+B"}
setmetatable(GAB, ResponseFunctionMeta)
GAB = ResponseFunction.ToUserdata(GAB)


G = GA+GB
if((G==GAB)~=true) then error("Response function comparison failed\n",1) end


GA_L = ResponseFunction.ChangeType(GA,"LP")
GA_l = ResponseFunction.ToUserdata(GA_L)
GA_T = ResponseFunction.ChangeType(GA,"Tri")
GA_t = ResponseFunction.ToUserdata(GA_T)
GA_A = ResponseFunction.ChangeType(GA,"And")
GA_a = ResponseFunction.ToUserdata(GA_A)
GA_N = ResponseFunction.ChangeType(GA,"Nat")
GA_n = ResponseFunction.ToUserdata(GA_N)
GA_U = ResponseFunction.ChangeType(GA,"Userdata")
GA_u = ResponseFunction.ToUserdata(GA_U)
GA_B = ResponseFunction.ChangeType(GA,"Table")
GA_b = ResponseFunction.ToUserdata(GA_B)

GB_L = ResponseFunction.ChangeType(GB,"LP")
GB_l = ResponseFunction.ToUserdata(GB_L)
GB_T = ResponseFunction.ChangeType(GB,"Tri")
GB_t = ResponseFunction.ToUserdata(GB_T)
GB_A = ResponseFunction.ChangeType(GB,"And")
GB_a = ResponseFunction.ToUserdata(GB_A)
GB_N = ResponseFunction.ChangeType(GB,"Nat")
GB_n = ResponseFunction.ToUserdata(GB_N)
GB_U = ResponseFunction.ChangeType(GB,"Userdata")
GB_u = ResponseFunction.ToUserdata(GB_U)
GB_B = ResponseFunction.ChangeType(GB,"Table")
GB_b = ResponseFunction.ToUserdata(GB_B)

GAList = {GA_L,GA_l,GA_T,GA_t,GA_A,GA_a,GA_N,GA_n,GA_U,GA_u,GA_B,GA_b}
GBList = {GB_L,GB_l,GB_T,GB_t,GB_A,GB_a,GB_N,GB_n,GB_U,GB_u,GB_B,GB_b}
for i=1,#GAList do
	for j=1,#GBList do
		G = GAList[i]+GBList[j]
		if((G==GAB)~=true) then
			print("Error at i=",i,"j=",j)
			print("GA\n",GAList[i])
			print("GB\n",GBList[j])
			print("G\n",ResponseFunction.ToTable(G))
			print("GAB\n",ResponseFunction.ToTable(GAB))
			error("Response function comparison failed\n",1)
		end
	end
end

print("-- Matrix                                             --")

A0 = {{0,0,0},{0,0,0},{0,0,0}}
