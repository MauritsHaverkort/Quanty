B2 = B2s * B2s
B3s = {{3,0,3},{0,5,6},{3,6,9}}
setmetatable(B3s, MatrixMeta)
B3 = B3s * B3s

MA = { {A0,a1,a2,a3}, {B1,B2,B3}, mu=0, type="ListOfPoles", name="A"}
setmetatable(MA, ResponseFunctionMeta)



A0 = {{1,0,0},{0,1,0},{0,0,1}}
setmetatable(A0, MatrixMeta)
a1 = -2
a2 = -1
