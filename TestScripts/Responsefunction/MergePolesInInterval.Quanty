-- Define response functions of different type
-- singel valued tri-diagonal
a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  3,  4,  5,  6}
G1 = ResponseFunction.New({a,b,mu=0,type="Tri", name="G Tri"})

-- single valued anderson
a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  3,  4,  5,  6}
G2 = ResponseFunction.New({a,b,mu=0,type="And", name="G And"})

-- single valued Natural
acon = {0,  10, 11, 12}
bcon = {     2,  3,  4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16,  -17}
bval = {     2,    3,    4}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
a0=3
b0=1
G3 = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=0,type="Nat", name="G Nat"})

-- single valued list of poles
a = {0, 10,  11,  12,  13,  14,  15,  16}
b = {  1/7, 1/7, 1/7, 1/7, 1/7, 1/7, 1/7}
G4 = ResponseFunction.New({a,b,mu=0,type="ListOfPoles", name="G LP"})

-- Matrix valued tri-diagonal
A0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})/3
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})/3
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})/3

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s / 100
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s / 100
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s / 100

G5 = ResponseFunction.New( { {A0,A1,A2,A3}, {B0,B1,B2}, mu=0, type="Tri", name="G Mat Tri"} )

-- Matrix valued anderson

A0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})/3
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})/3
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})/3

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s/100
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s/100
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s/100

G6 = ResponseFunction.New( { {A0,A1,A2,A3}, {B0,B1,B2}, mu=0, type="And", name="G Mat And"} )

-- Matrix valued Natural

A0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})/3
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})/3
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})/3

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s/100
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s/100
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s/100

B0v = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})
B0c = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})

Gv = ResponseFunction.New( { {A0,-A1,-A2,-A3}, {B0v,B1,B2}, mu=0, type="Tri", name="A"} )
Gc = ResponseFunction.New( { {A0, A1, A2, A3}, {B0c,B1,B2}, mu=0, type="Tri", name="A"} )

G7 = ResponseFunction.New( { {A0,B0}, val=Gv, con=Gc, mu=0, type="Nat", name="G Mat Nat"} )

-- Matrix valued list of poles

A0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{0,1,3},{1,5,0},{3,0,0}})
B1 = B1s * B1s/100
B2s = Matrix.New({{2,0,3},{0,0,2},{3,2,0}})
B2 = B2s * B2s/100
B3s = Matrix.New({{3,0,3},{0,5,1},{3,1,0}})
B3 = B3s * B3s/100

G8 = ResponseFunction.New( { {A0,-5,7,10}, {B0,B1,B2}, mu=0, type="ListOfPoles", name="G Mat LP"} )


G1a = ResponseFunction.MergePolesInInterval(G1,2,20)
print(G1a)
G2a = ResponseFunction.MergePolesInInterval(G2,2,20)
print(G2a)
G3a = ResponseFunction.MergePolesInInterval(G3,2,20)
print(G3a)
G4a = ResponseFunction.MergePolesInInterval(G4,2,20)
print(G4a)
G5a = ResponseFunction.MergePolesInInterval(G5,2,20)
print(G5a)
G6a = ResponseFunction.MergePolesInInterval(G6,2,20)
print(G6a)
G7a = ResponseFunction.MergePolesInInterval(G7,2,20)
print(G7a)
G8a = ResponseFunction.MergePolesInInterval(G8,2,20)
print(G8a)
