print("-- Tri                                                --")

Mexp = Matrix.New({ {  11     ,  2      ,  0      ,  0      ,  0      ,  0      } ,
										{  2      ,  12     ,  3      ,  0      ,  0      ,  0      } ,
				            {  0      ,  3      ,  13     ,  4      ,  0      ,  0      } ,
				            {  0      ,  0      ,  4      ,  14     ,  5      ,  0      } ,
				            {  0      ,  0      ,  0      ,  5      ,  15     ,  6      } ,
				            {  0      ,  0      ,  0      ,  0      ,  6      ,  16     } })
a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  3,  4,  5,  6}
G = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
M = ResponseFunction.ToMatrix(G)
if((M==Mexp)~=true) then
	print("Error")
	print("M\n",M)
	print("Mexp\n",Mexp)
	print("G\n",ResponseFunction.ToTable(G))
	error("Response matrix comparison failed\n",1)
end

