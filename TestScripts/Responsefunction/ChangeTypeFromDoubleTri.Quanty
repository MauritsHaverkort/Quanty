print("--------------------------------------------------------")
print("-- Responsefunction ChangeType from DoubleTri          --")
print("--------------------------------------------------------")

-- Read a double tri-diagonal matrix in the order val_N ... val_1, impurity,
-- con_1 ... con_N and it is one ordinary tri-diagonal chain with the impurity in
-- the middle. Deleting the impurity, which is what the Anderson form asks for,
-- leaves two chains that do not touch, so the Anderson bath is the two chain
-- spectra side by side and the impurity reaches eigenvector k of a chain only
-- through that chain's head.
--
-- Hence: the dimension is preserved, the impurity energy is val.a[0]+con.a[0],
-- the bath carries val.b[0]^2+con.b[0]^2 of hybridization weight, and the whole
-- response function is unchanged.

function MaxRelDiff(G1, G2, gamma)
	local worst = 0.0
	for i = 0, 300 do
		local w = -8.0 + 16.0 * i / 300
		local v1, v2 = G1(w, gamma), G2(w, gamma)
		local d = math.sqrt((v1.Re - v2.Re)^2 + (v1.Im - v2.Im)^2)
		local n = math.sqrt(v1.Re^2 + v1.Im^2)
		if (n > 0) and ((d / n) > worst) then worst = d / n end
	end
	return worst
end

function MakeAnderson(nb, eimp, mu)
	local a, b = {0.3, eimp}, {1.4}
	for i = 1, nb do
		local E = -5.0 + 10.0 * (i - 0.5) / nb
		a[#a + 1] = E
		b[#b + 1] = 0.5 * math.sqrt(math.max(0.0, 25.0 - E * E)) / math.sqrt(nb)
	end
	return ResponseFunction.New({a, b, mu = mu, type = "And", name = "bath"})
end

-- everything that has to hold of the Anderson form of a double tri-diagonal one
function CheckAgainst(name, GD)
	local GA = ResponseFunction.ChangeType(GD, "And")
	local td, ta = ResponseFunction.ToTable(GD), ResponseFunction.ToTable(GA)
	local nv, nc = #(td.val[1]) - 1, #(td.con[1]) - 1
	if (#(ta[1]) - 1) ~= (1 + nv + nc) then
		error("ChangeType DoubleTri to And: dimension is not 1+val.N+con.N for " .. name, 1)
	end
	if math.abs(ta[1][2] - (td.val[1][1] + td.con[1][1])) > 1E-12 * (1 + math.abs(ta[1][2])) then
		error("ChangeType DoubleTri to And: the impurity is not val.a[0]+con.a[0] for " .. name, 1)
	end
	local W, Wd = 0.0, 0.0
	for i = 2, #ta[2] do W = W + ta[2][i] * ta[2][i] end
	if #(td.val[2]) > 0 then Wd = Wd + td.val[2][1]^2 end
	if #(td.con[2]) > 0 then Wd = Wd + td.con[2][1]^2 end
	if math.abs(W - Wd) > 1E-12 * (1 + Wd) then
		error("ChangeType DoubleTri to And: the bath weight is not val.b[0]^2+con.b[0]^2 for " .. name, 1)
	end
	for i = 3, #(ta[1]) - 1 do
		if ta[1][i] > ta[1][i + 1] then
			error("ChangeType DoubleTri to And: the bath is not ordered for " .. name, 1)
		end
	end
	local e = math.max(MaxRelDiff(GD, GA, 0.3), MaxRelDiff(GD, GA, 0.02))
	print(string.format("  %-32s val.N=%4d con.N=%4d  dim %5d   max relative error %9.2e",
	      name, nv, nc, #(ta[1]) - 1, e))
	if e > 1E-11 then
		error("ChangeType DoubleTri to And does not reproduce the original function for " .. name, 1)
	end
	return GA
end

print("from a double tri-diagonal matrix built out of an Anderson matrix")
CheckAgainst("kBT finite, eimp nonzero",
             ResponseFunction.ChangeType(MakeAnderson(999, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckAgainst("kBT zero",
             ResponseFunction.ChangeType(MakeAnderson(999, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.0}}))
CheckAgainst("mu off centre",
             ResponseFunction.ChangeType(MakeAnderson(999, 0.0, -1.3), "DoubleTri", {{"EffectivekBT", 0.1}}))
CheckAgainst("valence chain empty",
             ResponseFunction.ChangeType(MakeAnderson(999, 1.7, -6.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckAgainst("conduction chain empty",
             ResponseFunction.ChangeType(MakeAnderson(999, 1.7, 6.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckAgainst("small bath",
             ResponseFunction.ChangeType(MakeAnderson(6, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.3}}))
CheckAgainst("single bath level",
             ResponseFunction.ChangeType(MakeAnderson(1, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.3}}))

-- A double tri-diagonal matrix written by hand rather than converted from an
-- Anderson one, so that both head slots carry energy of their own.
-- n = 0 is a branch that is absent: one site energy, and no hopping into it
function Chain(n, elo, ehi, b, head)
	local a, bb = {head}, {}
	if n > 0 then bb[1] = 0.6 end
	for i = 1, n do
		a[#a + 1] = elo + (ehi - elo) * (i - 0.5) / n
		if i < n then bb[#bb + 1] = b * (1.0 + 0.3 * math.sin(3.0 * i)) end
	end
	return a, bb
end

function MakeD(nv, nc)
	local av, bv = Chain(nv, -5.0, -0.2, 0.30, 0.9)
	local ac, bc = Chain(nc,  0.2,  5.0, 0.28, 0.8)
	local Gval = {av, bv, mu = 0, type = "Tri"}
	setmetatable(Gval, ResponseFunctionMeta)
	local Gcon = {ac, bc, mu = 0, type = "Tri"}
	setmetatable(Gcon, ResponseFunctionMeta)
	return ResponseFunction.New({{0.3, 1.2}, val = Gval, con = Gcon, mu = 0, kBT = 0.05,
	                             type = "DoubleTri", name = "D"})
end

print("from a double tri-diagonal matrix written by hand")
for i, s in ipairs({{5, 5}, {40, 25}, {1, 1}, {1, 7}, {7, 1}, {0, 7}, {7, 0}, {0, 0}}) do
	CheckAgainst("val.N " .. s[1] .. " con.N " .. s[2], MakeD(s[1], s[2]))
end

-- Tri-diagonalizing from the impurity. Interleaved behind the impurity as
--   impurity, val_1, con_1, val_2, con_2, ...
-- every coupling is at distance 1 or 2, so the matrix is a band matrix of half
-- bandwidth 2 and the starting vector is e_1. A band reduction leaves e_1 alone,
-- so what comes out is the Lanczos chain from the impurity, but computed by
-- orthogonal similarity rather than by the three term recurrence.
function CheckTri(name, GD)
	local GT = ResponseFunction.ChangeType(GD, "Tri")
	local td, tt = ResponseFunction.ToTable(GD), ResponseFunction.ToTable(GT)
	local nv, nc = #(td.val[1]) - 1, #(td.con[1]) - 1
	if (#(tt[1]) - 1) ~= (1 + nv + nc) then
		error("ChangeType DoubleTri to Tri: dimension is not 1+val.N+con.N for " .. name, 1)
	end
	if math.abs(tt[1][2] - (td.val[1][1] + td.con[1][1])) > 1E-11 * (1 + math.abs(tt[1][2])) then
		error("ChangeType DoubleTri to Tri: the first site is not val.a[0]+con.a[0] for " .. name, 1)
	end
	-- the first hopping is what the impurity sees of the two chains together
	local Wv = (#(td.val[2]) > 0) and td.val[2][1]^2 or 0.0
	local Wc = (#(td.con[2]) > 0) and td.con[2][1]^2 or 0.0
	-- with both chains empty the matrix is the impurity alone and has no hopping
	if (nv + nc > 0) and
	   (math.abs(tt[2][2] - math.sqrt(Wv + Wc)) > 1E-11 * (1 + math.sqrt(Wv + Wc))) then
		error("ChangeType DoubleTri to Tri: the first hopping is not sqrt(val.b[0]^2+con.b[0]^2) for " .. name, 1)
	end
	-- the sign of a hopping is a gauge and they are all made positive
	for i = 2, #tt[2] do
		if tt[2][i] < 0 then
			error("ChangeType DoubleTri to Tri: hopping " .. i .. " is negative for " .. name, 1)
		end
	end
	local e = math.max(MaxRelDiff(GD, GT, 0.3), MaxRelDiff(GD, GT, 0.02))
	print(string.format("  %-32s val.N=%4d con.N=%4d  dim %5d   max relative error %9.2e",
	      name, nv, nc, #(tt[1]) - 1, e))
	if e > 1E-11 then
		error("ChangeType DoubleTri to Tri does not reproduce the original function for " .. name, 1)
	end
end

print("to a tri-diagonal matrix, by band reduction")
CheckTri("kBT finite, eimp nonzero",
         ResponseFunction.ChangeType(MakeAnderson(999, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckTri("valence chain empty",
         ResponseFunction.ChangeType(MakeAnderson(999, 1.7, -6.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckTri("conduction chain empty",
         ResponseFunction.ChangeType(MakeAnderson(999, 1.7, 6.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckTri("single bath level",
         ResponseFunction.ChangeType(MakeAnderson(1, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.3}}))
for i, s in ipairs({{5, 5}, {40, 25}, {1, 1}, {1, 7}, {7, 1}, {0, 7}, {7, 0}, {0, 0}}) do
	CheckTri("val.N " .. s[1] .. " con.N " .. s[2], MakeD(s[1], s[2]))
end

-- The band reduction and the route through the Anderson form are different
-- algorithms for the same chain, so they have to agree on it -- but only as far
-- as the chain is determined. The map from a measure to its recurrence
-- coefficients is exponentially ill conditioned in the chain index: deep in the
-- tail two very different chains give the same G to the last digit, and the two
-- algorithms, both backward stable, part company there. At 2m=40 they agree to
-- 3e-14, at 2m=60 they part at site 31, at 2m=120 at site 27. So this compares a
-- chain short enough to be determined; what has to hold for the long ones is
-- that G is reproduced, which is checked above.
GDx = MakeD(20, 15)
TA = ResponseFunction.ToTable(ResponseFunction.ChangeType(ResponseFunction.ChangeType(GDx, "And"), "Tri"))
TB = ResponseFunction.ToTable(ResponseFunction.ChangeType(GDx, "Tri"))
eboth, scale = 0.0, 0.0
for i = 1, #TA[1] do
	if math.abs(TA[1][i]) > scale then scale = math.abs(TA[1][i]) end
	if math.abs(TA[1][i] - TB[1][i]) > eboth then eboth = math.abs(TA[1][i] - TB[1][i]) end
end
for i = 1, #TA[2] do
	if math.abs(TA[2][i] - TB[2][i]) > eboth then eboth = math.abs(TA[2][i] - TB[2][i]) end
end
print(string.format("  %-32s max difference %9.2e on a scale of %6.3f",
      "band reduction vs via And", eboth, scale))
if eboth > 1E-11 * (1 + scale) then
	error("the band reduction and the route through And do not give the same chain", 1)
end

-- The poles of G are the eigenvalues of the whole matrix, not the two chain
-- spectra: read it as val_N ... val_1, impurity, con_1 ... con_N and it is an
-- ordinary tri-diagonal matrix, so one eigenvalue problem gives them, with the
-- weights read from the middle row of the eigenvectors rather than the first.
-- The natural orbital form then follows through the poles, which is the only
-- thing the two forms agree on: one adds its chains where the other nests them.
function CheckPoles(name, GD)
	local GL = ResponseFunction.ChangeType(GD, "LP")
	local td, tl = ResponseFunction.ToTable(GD), ResponseFunction.ToTable(GL)
	local nv, nc = #(td.val[1]) - 1, #(td.con[1]) - 1
	if (#(tl[1]) - 1) ~= (1 + nv + nc) then
		error("ChangeType DoubleTri to LP: not 1+val.N+con.N poles for " .. name, 1)
	end
	-- the poles carry b0^2 of weight in total
	local W, b0 = 0.0, td[1][2]
	for i = 1, #tl[2] do W = W + tl[2][i] end
	if math.abs(W - b0 * b0) > 1E-11 * (1 + b0 * b0) then
		error("ChangeType DoubleTri to LP: the poles do not carry b0^2 for " .. name, 1)
	end
	-- tl[1][1] is the offset a0, the pole energies start at 2 and come out ordered
	for i = 3, #(tl[1]) do
		if tl[1][i] < tl[1][i - 1] then
			error("ChangeType DoubleTri to LP: the poles are not ordered for " .. name, 1)
		end
	end
	local el = math.max(MaxRelDiff(GD, GL, 0.3), MaxRelDiff(GD, GL, 0.02))
	local GN = ResponseFunction.ChangeType(GD, "Nat")
	local en = math.max(MaxRelDiff(GD, GN, 0.3), MaxRelDiff(GD, GN, 0.02))
	print(string.format("  %-32s val.N=%4d con.N=%4d  poles %5d   to LP %9.2e   to Nat %9.2e",
	      name, nv, nc, #(tl[1]) - 1, el, en))
	if el > 1E-11 then
		error("ChangeType DoubleTri to LP does not reproduce the original function for " .. name, 1)
	end
	if en > 1E-11 then
		error("ChangeType DoubleTri to Nat does not reproduce the original function for " .. name, 1)
	end
end

print("to a list of poles, and on to the natural orbital form")
CheckPoles("kBT finite, eimp nonzero",
           ResponseFunction.ChangeType(MakeAnderson(999, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckPoles("mu off centre",
           ResponseFunction.ChangeType(MakeAnderson(999, 0.0, -1.3), "DoubleTri", {{"EffectivekBT", 0.1}}))
CheckPoles("valence chain empty",
           ResponseFunction.ChangeType(MakeAnderson(999, 1.7, -6.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckPoles("conduction chain empty",
           ResponseFunction.ChangeType(MakeAnderson(999, 1.7, 6.0), "DoubleTri", {{"EffectivekBT", 0.025}}))
CheckPoles("single bath level",
           ResponseFunction.ChangeType(MakeAnderson(1, 1.7, 0.0), "DoubleTri", {{"EffectivekBT", 0.3}}))
for i, s in ipairs({{5, 5}, {40, 25}, {1, 1}, {1, 7}, {7, 1}, {0, 7}, {7, 0}, {0, 0}}) do
	CheckPoles("val.N " .. s[1] .. " con.N " .. s[2], MakeD(s[1], s[2]))
end

-- the whole row at once, and back again, for full chains and for empty ones
for j, s in ipairs({{30, 22}, {0, 9}, {9, 0}, {0, 0}}) do
	local GDrow = MakeD(s[1], s[2])
	local shape = "val.N " .. s[1] .. " con.N " .. s[2]
	for i, ty in ipairs({"LP", "Tri", "And", "Nat", "DoubleTri"}) do
		local e = MaxRelDiff(GDrow, ResponseFunction.ChangeType(GDrow, ty), 0.02)
		print(string.format("  %-32s max relative error %9.2e", "to " .. ty .. ", " .. shape, e))
		if e > 1E-11 then
			error("ChangeType DoubleTri to " .. ty .. " does not reproduce " .. shape, 1)
		end
		local eback = MaxRelDiff(GDrow,
		              ResponseFunction.ChangeType(ResponseFunction.ChangeType(GDrow, ty), "DoubleTri",
		                                          {{"EffectivekBT", 0.05}}), 0.02)
		if eback > 1E-11 then
			error("DoubleTri to " .. ty .. " and back does not reproduce " .. shape, 1)
		end
	end
end

-- and the whole way round
GA0 = MakeAnderson(300, 1.7, 0.0)
GA1 = ResponseFunction.ChangeType(ResponseFunction.ChangeType(GA0, "DoubleTri", {{"EffectivekBT", 0.05}}), "And")
eround = math.max(MaxRelDiff(GA0, GA1, 0.3), MaxRelDiff(GA0, GA1, 0.02))
print(string.format("  %-32s max relative error %9.2e", "round trip And to DoubleTri to And", eround))
if eround > 1E-11 then
	error("And to DoubleTri to And does not reproduce the original function", 1)
end

print("--------------------------------------------------------")
