A0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})/3
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})/3
