B2s = Matrix.New({{2,0,3},{0,0,2},{3,2,0}})
B2 = B2s * B2s/100
B3s = Matrix.New({{3,0,3},{0,5,1},{3,1,0}})
B3 = B3s * B3s/100

G8 = ResponseFunction.New( { {A0,-5,7,10}, {B0,B1,B2}, mu=0, type="ListOfPoles", name="G Mat LP"} )



print(G1.name)
G1p = ResponseFunction.ReducePoles(G1, 2)
if( (Chop(G1-G1p)==Chop(G1-G1)) ~= true) then
	print(G1)
	print(G1p)
	error("ResponseFunction.ReducePoles failed",1)
end
if( (Chop(G1(0,1E8)-G1p(0,1E8))==Chop(G1(0,0)-G1(0,0))) ~= true) then
	print(G1)
	print(G1p)
	error("ResponseFunction.ReducePoles failed",1)
end

