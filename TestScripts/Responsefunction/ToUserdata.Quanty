aval = {0, -15,  -16,  -17}
bval = {    12,   13,   14}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
a0=0
b0=1
G = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=0,type="Nat", name="D"})

G2=ResponseFunction.ToUserdata(G)
G3={{a0,b0},val=Gval,con=Gcon,mu=0,type="Nat", name="D"}
setmetatable(G3, ResponseFunctionMeta)
G3=ResponseFunction.ToUserdata(G3)
if((G2==G3)~=true) then error("Response function ToUserdata failed\n",1) end

print("-- LP                                                 --")

a = {0, -sqrt(2), 0,   sqrt(2)}
