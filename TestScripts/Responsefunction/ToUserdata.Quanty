A0 = Matrix.New({{0,I,0},{-I,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s

B0v = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})
B0c = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})

Gv = ResponseFunction.New( { {0*A0,-A1,-A2,-A3}, {B0v,B1,B2}, mu=0, type="Tri", name="A"} )
Gc = ResponseFunction.New( { {0*A0, A1, A2, A3}, {B0c,B1,B2}, mu=0, type="Tri", name="A"} )

G = ResponseFunction.New( { {A0,B0}, val=Gv, con=Gc, mu=0, type="Nat", name="A"} )

G2=ResponseFunction.ToUserdata(G)
G3={ {A0,B0}, val=ResponseFunction.ToTable(Gv), con=ResponseFunction.ToTable(Gc), mu=0, type="Nat", name="A"}
setmetatable(G3, ResponseFunctionMeta)
G3=ResponseFunction.ToUserdata(G3)
if((G2==G3)~=true) then error("Response function ToUserdata failed\n",1) end


