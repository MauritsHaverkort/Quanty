print("-- Single valued                                      --")

print("-- Tri                                                --")

Mexp = Matrix.New({ {  11     ,  2      ,  0      ,  0      ,  0      ,  0      } ,
										{  2      ,  12     ,  3      ,  0      ,  0      ,  0      } ,
										{  0      ,  3      ,  13     ,  4      ,  0      ,  0      } ,
										{  0      ,  0      ,  4      ,  14     ,  5      ,  0      } ,
										{  0      ,  0      ,  0      ,  5      ,  15     ,  6      } ,
										{  0      ,  0      ,  0      ,  0      ,  6      ,  16     } })
Oexp = NewOperator(6,0,{{0,-0,11},{1,-1,12},{2,-2,13},{3,-3,14},{4,-4,15},{5,-5,16},
									      {0,-1,2},{1,-0,2}, {1,-2,3},{2,-1,3}, {2,-3,4},{3,-2,4}, {3,-4,5},{4,-3,5}, {4,-5,6},{5,-4,6} })
a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  3,  4,  5,  6}
G = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})

O = ResponseFunction.ToOperator(G)
O2= Matrix.ToOperator(Mexp)

OS = ResponseFunction.ToOperator(G,{{"AddSpin",true}})
O2S= Matrix.ToOperator(Matrix.AddSpin(Mexp))

if((O==Oexp)~=true) then
	print("Error")
	print("O\n",O)
	print("Oexp\n",Oexp)
	print("Oexp-O\n",Oexp-O)
	print("G\n",ResponseFunction.ToTable(G))
	error("Response operator comparison failed\n",1)
end

if((O==O2)~=true) then
	print("Error")
	print("O\n",O)
	print("Oexp\n",Oexp)
	print("Oexp-O\n",Oexp-O)
	print("G\n",ResponseFunction.ToTable(G))
	error("Response operator comparison failed\n",1)
end

if((OS==O2S)~=true) then
	print("Error")
	print("O\n",O)
	print("Oexp\n",Oexp)
	print("Oexp-O\n",Oexp-O)
	print("G\n",ResponseFunction.ToTable(G))
	error("Response operator comparison failed\n",1)
end

