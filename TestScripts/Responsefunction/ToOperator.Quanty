print("-- Nat                                                --")

acon = {0,  5, 6, 7}
bcon = {    2, 3, 4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16,  -17}
bval = {    12,   13,   14}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
a0=0
b0=1
G = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=0,type="Nat", name="D"})
Mexp = Matrix.New({ { -2140   , -480    ,  156    ,  0      ,  6      ,  0      } ,
										{ -480    ,  660    ,  26     ,  0      , -36     ,  0      } ,
										{  156    ,  26     , -16     ,  14     ,  0      ,  0      } ,
										{  0      ,  0      ,  14     , -17     ,  0      ,  0      } ,
										{  6      , -36     ,  0      ,  0      ,  6      ,  4      } ,
										{  0      ,  0      ,  0      ,  0      ,  4      ,  7      } })
Oexp = NewOperator(6,0,{{0,-0,-2140},{1,-1,660},{2,-2,-16},{3,-3,-17},{4,-4,6},{5,-5,7},
												{0,-1,-480},{1,-0,-480}, {0,-2,156},{2,-0,156}, {0,-4,  6},{4,-0,  6},
									                               {1,-2, 26},{2,-1, 26}, {1,-4,-36},{4,-1,-36},
									      {2,-3,14},{3,-2,14},
									      {4,-5,4},{5,-4,4}})
O = ResponseFunction.ToOperator(G)
O2= Matrix.ToOperator(Mexp)
OS = ResponseFunction.ToOperator(G,{{"AddSpin",true}})
O2S= Matrix.ToOperator(Matrix.AddSpin(Mexp))

if((O==Oexp)~=true) then
	print("Error")
	print("O\n",O)
	print("Oexp\n",Oexp)
	print("Oexp-O\n",Oexp-O)
	print("G\n",ResponseFunction.ToTable(G))
	error("Response operator comparison failed\n",1)
end

if((O==O2)~=true) then
	print("Error")
	print("O\n",O)
	print("Oexp\n",Oexp)
	print("Oexp-O\n",Oexp-O)
	print("G\n",ResponseFunction.ToTable(G))
