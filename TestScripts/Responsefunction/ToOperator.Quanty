print("--------------------------------------------------------")
print("-- DoubleTri                                          --")
print("--------------------------------------------------------")
-- The orbitals of a double tri-diagonal matrix are
--
--     [ core | impurity | val_1 ... val_Nv | con_1 ... con_Nc ]
--
-- a[0] of a chain is the impurity energy -- the two chains share the site, so it is
-- val.a[0] + con.a[0] -- and b[0] is the hopping from the impurity into the first site of
-- that chain, with a[1..N] and b[1..N-1] the chain itself. A chain therefore contributes N
-- sites, one more per chain than the natural orbital form above, where a[1] is the natural
-- orbital itself and belongs with the impurity.
--
-- a0 and b0 of the matrix are the offset and the scaling of the Green's function and are
-- not part of the Hamiltonian, as everywhere in this file.
--
-- Every number below is a dyadic fraction so that the comparisons are exact: 1 + 0.5 is
-- 1.5 to the last bit where 0.9 + 0.8 is not 1.7.

aval = {1, -3, -4};   bval = {0.5, 0.25}
acon = {0.5, 5, 6};   bcon = {0.75, 0.125}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
G = ResponseFunction.New({{0.25,1.5},val=Gval,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})

Mexp = Matrix.New({ {  1.5    ,  0.5    ,  0      ,  0.75   ,  0      } ,
                    {  0.5    , -3      ,  0.25   ,  0      ,  0      } ,
                    {  0      ,  0.25   , -4      ,  0      ,  0      } ,
                    {  0.75   ,  0      ,  0      ,  5      ,  0.125  } ,
                    {  0      ,  0      ,  0      ,  0.125  ,  6      } })
Oexp = NewOperator(5,0,{{0,-0,1.5},{1,-1,-3},{2,-2,-4},{3,-3,5},{4,-4,6},
                        {0,-1,0.5},{1,-0,0.5},   {1,-2,0.25},{2,-1,0.25},
                        {0,-3,0.75},{3,-0,0.75}, {3,-4,0.125},{4,-3,0.125}})
O  = ResponseFunction.ToOperator(G)
O2 = Matrix.ToOperator(Mexp)
O3 = Matrix.ToOperator(ResponseFunction.ToMatrix(G))
OS = ResponseFunction.ToOperator(G,{{"AddSpin",true}})
O2S= Matrix.ToOperator(Matrix.AddSpin(Mexp))
if((O==Oexp)~=true) then
	print("O\n",O) print("Oexp\n",Oexp) print("Oexp-O\n",Oexp-O)
	error("Response operator comparison failed for DoubleTri\n",1)
end
if((O==O2)~=true) then
	print("O\n",O) print("O2\n",O2)
	error("Response operator comparison failed for DoubleTri against the matrix\n",1)
end
-- and against ResponseFunction.ToMatrix, which builds the same matrix by its own route
if((O==O3)~=true) then
	print("O\n",O) print("O3\n",O3)
	error("ToOperator and ToMatrix disagree for DoubleTri\n",1)
end
if((OS==O2S)~=true) then
	print("OS\n",OS) print("O2S\n",O2S)
	error("Response operator comparison failed for DoubleTri with spin\n",1)
end

print("-- DoubleTri, an empty chain                           --")
-- a chemical potential outside the bath leaves one chain empty, which is an ordinary case
-- for this type. The impurity keeps both a[0] shares either way.
GvalEmpty = ResponseFunction.New({{1},{},mu=0,type="Tri"})
GconEmpty = ResponseFunction.New({{0.5},{},mu=0,type="Tri"})
for i, p in ipairs({{Gval, GconEmpty, Matrix.New({ {  1.5, 0.5 ,  0    } ,
                                                   {  0.5, -3  ,  0.25 } ,
                                                   {  0  , 0.25, -4    } })},
                    {GvalEmpty, Gcon, Matrix.New({ {  1.5, 0.75,  0     } ,
                                                   {  0.75, 5  ,  0.125 } ,
                                                   {  0  , 0.125, 6     } })},
                    {GvalEmpty, GconEmpty, Matrix.New({ { 1.5 } })}}) do
	local Gp = ResponseFunction.New({{0.25,1.5},val=p[1],con=p[2],mu=0,kBT=0.05,type="DoubleTri", name="D"})
	local Op = ResponseFunction.ToOperator(Gp)
	if((Op==Matrix.ToOperator(p[3]))~=true) then
		print("Op\n",Op) print("expected\n",Matrix.ToOperator(p[3]))
		error("Response operator comparison failed for a DoubleTri with an empty chain\n",1)
	end
	if((Op==Matrix.ToOperator(ResponseFunction.ToMatrix(Gp)))~=true) then
		error("ToOperator and ToMatrix disagree for a DoubleTri with an empty chain\n",1)
	end
end

print("-- DoubleTri with Nv and Nc                            --")
-- Nv keeps Nv sites of the valence chain and returns the rest as a Green's function whose
-- a0 and b0 are the on site energy of the last kept site and the hopping into the tail,
-- exactly as for the natural orbital form above.
aval3 = {1, -3, -4, -5}; bval3 = {0.5, 0.25, 0.125}
Gval3 = ResponseFunction.New({aval3,bval3,mu=0,type="Tri"})
G3 = ResponseFunction.New({{0.25,1.5},val=Gval3,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})
MexpNv1 = Matrix.New({ {  1.5    ,  0.5    ,  0.75   ,  0      } ,
                       {  0.5    , -3      ,  0      ,  0      } ,
                       {  0.75   ,  0      ,  5      ,  0.125  } ,
                       {  0      ,  0      ,  0.125  ,  6      } })
ONv1, bmNv1, tailsNv1 = ResponseFunction.ToOperator(G3,{{"Nv",1}})
if((ONv1==Matrix.ToOperator(MexpNv1))~=true) then
	print("ONv1\n",ONv1) print("expected\n",Matrix.ToOperator(MexpNv1))
	error("Response operator comparison failed for a DoubleTri with Nv set\n",1)
end
tv = ResponseFunction.ToTable(tailsNv1.GvalBath)
if (#(tv[1]) ~= 3) or (tv[1][1] ~= 0) or (tv[1][2] ~= -4) or (tv[1][3] ~= -5) or
   (#(tv[2]) ~= 2) or (tv[2][1] ~= 0.25) or (tv[2][2] ~= 0.125) then
	print(tv)
	error("the valence tail of a DoubleTri with Nv set is wrong\n",1)
end
if tailsNv1.GconBath ~= nil then
	error("no conduction tail should be returned when Nc is not set\n",1)
end

print("-- DoubleTri, block                                    --")
-- The same layout with blocks. The hand written matrix is there to pin that layout down
-- independently; ToMatrix is then a second, independent route to it.
AI = {{1,0},{0,0.5}}
CI = {{0.5,0},{0,0.25}}
AV1 = {{-3,0.25},{0.25,-4}}
AC1 = {{5,0.5},{0.5,6}}
BV0 = {{0.5,0.125},{-0.0625,0.75}}
BC0 = {{0.75,0.25},{0.125,0.5}}
GvB = ResponseFunction.New({{AI,AV1},{BV0},mu=0,type="Tri"})
GcB = ResponseFunction.New({{CI,AC1},{BC0},mu=0,type="Tri"})
GB = ResponseFunction.New({{{{0.25,0},{0,0.25}},{{1.5,0},{0,1.5}}},val=GvB,con=GcB,mu=0,kBT=0.05,type="DoubleTri", name="DB"})
-- impurity is AI+CI, the impurity to val_1 block is BV0 and the block back is its
-- transpose, likewise for con
MexpB = Matrix.New({ {  1.5    ,  0       ,  0.5    ,  0.125  ,  0.75   ,  0.25   } ,
                     {  0      ,  0.75    , -0.0625 ,  0.75   ,  0.125  ,  0.5    } ,
                     {  0.5    , -0.0625  , -3      ,  0.25   ,  0      ,  0      } ,
                     {  0.125  ,  0.75    ,  0.25   , -4      ,  0      ,  0      } ,
                     {  0.75   ,  0.125   ,  0      ,  0      ,  5      ,  0.5    } ,
                     {  0.25   ,  0.5     ,  0      ,  0      ,  0.5    ,  6      } })
OB = ResponseFunction.ToOperator(GB)
if((OB==Matrix.ToOperator(MexpB))~=true) then
	print("OB\n",OB) print("expected\n",Matrix.ToOperator(MexpB))
	print("ToMatrix\n",ResponseFunction.ToMatrix(GB))
	error("Response operator comparison failed for a block DoubleTri\n",1)
end
if((OB==Matrix.ToOperator(ResponseFunction.ToMatrix(GB)))~=true) then
	error("ToOperator and ToMatrix disagree for a block DoubleTri\n",1)
end
if((ResponseFunction.ToOperator(GB,{{"AddSpin",true}})==Matrix.ToOperator(Matrix.AddSpin(MexpB)))~=true) then
	error("Response operator comparison failed for a block DoubleTri with spin\n",1)
end

print("-- DoubleTri, block, complex and with a shift          --")
-- b[0] of a chain enters the Green's function as b0^* . G . b0^T where the couplings inside
-- a chain enter as b . G . b^+, so the impurity to first block hopping is conj(b0) and the
-- ones inside the chains are b as stored. Only a complex matrix can tell the two apart, and
-- ToMatrix is the independent statement of the same thing.
CJ = Complex.New
AV1c = {{-3,CJ(0.25,0.5)},{CJ(0.25,-0.5),-4}}
AC1c = {{5,CJ(0.5,-0.25)},{CJ(0.5,0.25),6}}
BV0c = {{CJ(0.5,0.25),CJ(0.125,-0.5)},{CJ(-0.0625,0.125),CJ(0.75,0.5)}}
BC0c = {{CJ(0.75,-0.5),CJ(0.25,0.125)},{CJ(0.125,0.25),CJ(0.5,-0.125)}}
GvBc = ResponseFunction.New({{AI,AV1c},{BV0c},mu=0,type="Tri"})
GcBc = ResponseFunction.New({{CI,AC1c},{BC0c},mu=0,type="Tri"})
GBc = ResponseFunction.New({{{{0.25,0},{0,0.25}},{{1.5,0},{0,1.5}}},val=GvBc,con=GcBc,mu=0,kBT=0.05,type="DoubleTri", name="DBc"})
if((ResponseFunction.ToOperator(GBc)==Matrix.ToOperator(ResponseFunction.ToMatrix(GBc)))~=true) then
	print("ToOperator\n",OperatorToMatrix(ResponseFunction.ToOperator(GBc)))
	print("ToMatrix\n",ResponseFunction.ToMatrix(GBc))
	error("ToOperator and ToMatrix disagree for a complex block DoubleTri\n",1)
end
if((ResponseFunction.ToOperator(GBc,{{"AddSpin",true}})==Matrix.ToOperator(Matrix.AddSpin(ResponseFunction.ToMatrix(GBc))))~=true) then
	error("ToOperator and ToMatrix disagree for a complex block DoubleTri with spin\n",1)
end
-- FermionShift puts core orbitals in front, and those are not doubled by AddSpin: orbital n
-- spin s is fermion FermionShift + 2*n + s, which is where CreateBitMasks says they are.
for i, sp in ipairs({false, true}) do
	for j, fs in ipairs({0, 3}) do
		local Osh = ResponseFunction.ToOperator(GBc,{{"AddSpin",sp},{"FermionShift",fs}})
		local msk = ResponseFunction.CreateBitMasks(GBc,{{"AddSpin",sp},{"NCore",fs}})
		if Osh.NF ~= msk.NF then
			error("ToOperator and CreateBitMasks disagree on the number of fermions for a block DoubleTri\n",1)
		end
		local Msh = OperatorToMatrix(Osh)
		for p = 1, fs do
			for q = 1, #Msh do
				if (Complex.Re(Msh[p][q]) ~= 0) or (Complex.Im(Msh[p][q]) ~= 0) then
					error("ToOperator wrote into a core orbital of a block DoubleTri\n",1)
				end
			end
		end
		-- and nothing is lost off the end: the shifted operator is the unshifted one moved up
		local Mref = OperatorToMatrix(ResponseFunction.ToOperator(GBc,{{"AddSpin",sp}}))
		if (#Msh - fs) ~= #Mref then
			error("the shifted operator of a block DoubleTri has the wrong dimension\n",1)
		end
		for p = 1, #Mref do
			for q = 1, #Mref do
				if (Complex.Re(Msh[p+fs][q+fs]) ~= Complex.Re(Mref[p][q])) or
				   (Complex.Im(Msh[p+fs][q+fs]) ~= Complex.Im(Mref[p][q])) then
					error("FermionShift does not simply shift the operator of a block DoubleTri\n",1)
				end
			end
		end
	end
end

print("--------------------------------------------------------")
print("-- FermionShift together with AddSpin, block types    --")
print("--------------------------------------------------------")
-- Orbital n spin s is fermion FermionShift + 2*n + s. The shift is not doubled: the core
-- orbitals in front of it are not part of the impurity problem, so a shifted operator is
-- the unshifted one moved up by FermionShift and nothing else. That is what
-- CreateBitMasks reports and what the single valued family has always done.
--
-- The block tri-diagonal and block Anderson builders used to write 2*ifer with the shift
-- already inside ifer, so the shift came out doubled: with FermionShift 2 and a bath of
-- two blocks of size two the orbitals landed at 4..9 instead of 2..9, leaving two empty
-- and pushing the top two past NFermion, where they were lost.
do
	local CJ = Complex.New
	local a = {{{0,0},{0,0}}, {{1,CJ(0.25,0.5)},{CJ(0.25,-0.5),2}}, {{3,CJ(0.5,-0.25)},{CJ(0.5,0.25),4}}}
	local b = {{{1,0},{0,1}}, {{CJ(0.5,0.25),CJ(0.25,-0.5)},{CJ(-0.125,0.25),CJ(0.5,0.0625)}}}
	local Gv = ResponseFunction.New({{{{0,0},{0,0}},{{-1,0},{0,-2}},{{-3,0},{0,-4}}},
	                                 {{{0.5,0},{0,0.5}},{{0.25,0},{0,0.25}}},mu=0,type="Tri"})
	local Gc = ResponseFunction.New({{{{0,0},{0,0}},{{1,0},{0,2}},{{3,0},{0,4}}},
	                                 {{{0.5,0},{0,0.5}},{{0.25,0},{0,0.25}}},mu=0,type="Tri"})
	local cases = {
		{"Tri", ResponseFunction.New({a,b,mu=0,type="Tri",name="T"})},
		{"And", ResponseFunction.New({a,b,mu=0,type="And",name="A"})},
		{"Nat", ResponseFunction.New({{{{0,0},{0,0}},{{1,0},{0,1}}},val=Gv,con=Gc,mu=0,type="Nat",name="N"})},
		{"DoubleTri", ResponseFunction.New({{{{0,0},{0,0}},{{1,0},{0,1}}},val=Gv,con=Gc,mu=0,kBT=0.05,type="DoubleTri",name="D"})},
	}
	for i, c in ipairs(cases) do
		for j, fs in ipairs({1, 3, 6}) do
			local Mref = OperatorToMatrix(ResponseFunction.ToOperator(c[2], {{"AddSpin",true}}))
			local Osh  = ResponseFunction.ToOperator(c[2], {{"AddSpin",true},{"FermionShift",fs}})
			local Msh  = OperatorToMatrix(Osh)
			local msk  = ResponseFunction.CreateBitMasks(c[2], {{"AddSpin",true},{"NCore",fs}})
			if Osh.NF ~= msk.NF then
				error("ToOperator and CreateBitMasks disagree on NFermion for a block " .. c[1], 1)
			end
			if (#Msh - fs) ~= #Mref then
				error("FermionShift changes the size of the impurity problem for a block " .. c[1], 1)
			end
			for p = 1, fs do
				for q = 1, #Msh do
					if (Complex.Re(Msh[p][q]) ~= 0) or (Complex.Im(Msh[p][q]) ~= 0) then
						error("ToOperator wrote into a core orbital for a block " .. c[1], 1)
					end
				end
			end
			for p = 1, #Mref do
				for q = 1, #Mref do
					if (Complex.Re(Msh[p+fs][q+fs]) ~= Complex.Re(Mref[p][q])) or
					   (Complex.Im(Msh[p+fs][q+fs]) ~= Complex.Im(Mref[p][q])) then
						error("FermionShift does not simply shift the operator for a block " .. c[1], 1)
					end
				end
			end
		end
		print(string.format("  block %-10s shifts by 1, 3 and 6 without losing an orbital", c[1]))
	end
end


