Verbosity(0)

GTval = ResponseFunction.New({{0, -3, -4, -5},{sqrt(0.5), 0.25, 0.125},mu=0,type="Tri"})
GTcon = ResponseFunction.New({{0,  3,  4,  5},{sqrt(0.5), 0.25, 0.125},mu=0,type="Tri"})
GDS = ResponseFunction.New({{0,1},val=GTval,con=GTcon,mu=0,kBT=0.05,type="DoubleTri", name="DS"})
GNS = ResponseFunction.New({{0,1},val=GTval,con=GTcon,mu=0,kBT=0.05,type="Nat", name="DS"})
M0 = Matrix.Zero(2)
M1 = Matrix.Identity(2)
M2 = {{ 2,1},{1, 4}}
M3 = {{-2,1},{1,-3}}
M4 = {{sqrt(0.5),0},{0,sqrt(0.5)}}
M5 = {{0.3,0},{0,0.4}}
M6 = {{0.5,0},{0,0.6}}
GTval = ResponseFunction.New({{M0, M3, M3, M3},{M4,M5,M6},mu=0,type="Tri"})
GTcon = ResponseFunction.New({{M0, M2, M2, M2},{M4,M5,M6},mu=0,type="Tri"})
GDMR = ResponseFunction.New({{M0,M1},val=GTval,con=GTcon,mu=0,kBT=0.05,type="DoubleTri", name="DMR"})
GNMR = ResponseFunction.New({{M0,M1},val=GTval,con=GTcon,mu=0,kBT=0.05,type="Nat", name="NMR"})


M2 = {{ 2,I},{-I, 4}}
M3 = {{-2,I},{-I,-3}}
M4 = {{sqrt(0.5),0},{0,sqrt(0.5)}}
M5 = {{0.3,0},{0,0.4}}
M6 = {{0.5,0},{0,0.6}}
GTval = ResponseFunction.New({{M0, M3, M3, M3},{M4,M5,M6},mu=0,type="Tri"})
GTcon = ResponseFunction.New({{M0, M2, M2, M2},{M4,M5,M6},mu=0,type="Tri"})
GDMC = ResponseFunction.New({{M0,M1},val=GTval,con=GTcon,mu=0,kBT=0.05,type="DoubleTri", name="DMC"})
GNMC = ResponseFunction.New({{M0,M1},val=GTval,con=GTcon,mu=0,kBT=0.05,type="Nat", name="NMC"})


GList = {{GNS,GNMR,GNMC},{GDS,GDMR,GDMC}}
NVList = {{1,2},{0,1,2}}
NCList = {{1,2},{0,1,2}}
AddSpin = {false,true}


a = "01" and "00"

print(a)
os.exit()


for i=1,2 do
	for iG=1, #GList[i] do
	  for iNv=1, #NVList[i] do
		  for iNc=1, #NCList[i] do
				for iS=1,2 do
				  print("Start ",i, iG, iNv, iNc, iS)
			    Opp, Bitmask, Tail = ResponseFunction.ToOperator(GList[i][iG],{{"Nv",NVList[i][iNv]},{"Nc",NCList[i][iNc]},{"AddSpin",AddSpin[iS]}})
				
				  -- create the vacuum state
				  psi0 = NewWavefunction(Opp.NF,0,{{Bitmask.Core,1}})
				  -- create the creation operators on the impurity
          OppCr = {}
				  NF, impIndex = BitMaskToIndex(Bitmask.Impurity)
				  for iCr=1, #impIndex do
					  OppCr[iCr] = NewOperator(NF,0,{{impIndex[iCr],1}})
			  	end
				  -- rotate the impurity if geometry equal NAT
			  	if i==1 then
          U = Matrix.Flatten({{Bitmask.T,0},{0,Matrix.Identity(Opp.NF-Bitmask.T.Ni)}})
			    Opp = Chop(Rotate(Opp,U))
					for iCr=1, #impIndex do
						OppCr[iCr] = Chop(Rotate(OppCr[iCr],U))
					end
        end
				  if(Tail.GvalBathIndex==nil) then
					  print("Val nil",i,iG,iNv,iNc,iS)
					  error("Test failed")
				  elseif (Tail.GconBathIndex==nil) then
					  print("Con nil",i,iG,iNv,iNc,iS)
					  error("Test failed")
				  else
				    Vval={}
				    for iVval=1,#Tail.GvalBathIndex do
					    Vval[iVval] = NewOperator(NF,0,{{-Tail.GvalBathIndex[iVval],1}})
				    end
				    Vcon={}
				    for iVcon=1,#Tail.GconBathIndex do
					    Vcon[iVcon] = NewOperator(NF,0,{{-Tail.GconBathIndex[iVcon],1}})
				    end
				    Spec, G = CreateSpectra(Opp,OppCr,psi0,{{Tail.GvalBath,Vval},{Tail.GconBath,Vcon}}, {{"Tensor", true}, {"NTri", 200}, {"DenseBorder", 0}, {"Emin", -5}, {"Emax", 5}, {"NE", 1000}, {"Gamma", 0.1}})
            local failed=false
			  	  if iG==1 then
					    for omega=-3,3,0.1 do
						    if Chop( G(omega,0.1)[1][1] - GList[i][iG](omega,0.1),1E-10 ) ~= 0 then
							    failed = true
							    print( omega, G(omega,0.1)[1][1] - GList[i][iG](omega,0.1) )
						    end
					    end
				    else
				      for omega=-3,3,0.1 do
						    for ii=1,2 do
							    for jj=1,2 do
					          if Chop( G(omega,0.1)[1+(ii-1)*iS][1+(jj-1)*iS] - GList[i][iG](omega,0.1)[ii][jj],1E-10 ) ~= 0 then
						         failed = true
										 print( omega, Chop(G(omega,0.1)) )
										 print( omega, GList[i][iG](omega,0.1) )
					          end
							    end
						    end
				      end
				    end
				
				    if failed then
					    print("FAILED")
				      print(G(0.0,0.1))
				      print(GList[i][iG](0.0,0.1))
				
				      print(GList[i][iG])
				      print(G)
				      print(ResponseFunction.ChangeType(GList[i][iG],"Tri"))
				
				      print(OppCr)
				      print(Opp)
				      print(psi0)
				      print(Vval)
				      print(Vcon)
						
						  error("Test failed")
					  end
					end
				end
      end
	  end
	end
end
collectgarbage()


print("--------------------------------------------------------")
print("-- Nv, Nc, and addSpin, for (Block) Nat               --")
print("-- Starting from many-body state                      --")
print("--------------------------------------------------------")


for i=1,1 do
	for iG=1, #GList[i] do
		for iNv=1, #NVList[i] do
			for iNc=1, #NCList[i] do
				for iS=1,2 do
					print("Start ",i, iG, iNv, iNc, iS)
					Opp, Bitmask, Tail = ResponseFunction.ToOperator(GList[i][iG],{{"Nv",NVList[i][iNv]},{"Nc",NCList[i][iNc]},{"AddSpin",AddSpin[iS]}})
				  
					print(Bitmask)
					os.exit()
					
					-- create the vacuum state
					psi0 = NewWavefunction(Opp.NF,0,{{Bitmask.Core,1}})
					-- create the creation operators on the impurity
					OppCr = {}
					NF, impIndex = BitMaskToIndex(Bitmask.Impurity)
					for iCr=1, #impIndex do
						OppCr[iCr] = NewOperator(NF,0,{{impIndex[iCr],1}})
					end
					-- rotate the impurity if geometry equal NAT
					if i==1 then
					U = Matrix.Flatten({{Bitmask.T,0},{0,Matrix.Identity(Opp.NF-Bitmask.T.Ni)}})
					Opp = Chop(Rotate(Opp,U))
					for iCr=1, #impIndex do
						OppCr[iCr] = Chop(Rotate(OppCr[iCr],U))
					end
				end
					if(Tail.GvalBathIndex==nil) then
						print("Val nil",i,iG,iNv,iNc,iS)
						error("Test failed")
					elseif (Tail.GconBathIndex==nil) then
						print("Con nil",i,iG,iNv,iNc,iS)
						error("Test failed")
					else
						Vval={}
						for iVval=1,#Tail.GvalBathIndex do
							Vval[iVval] = NewOperator(NF,0,{{-Tail.GvalBathIndex[iVval],1}})
						end
						Vcon={}
						for iVcon=1,#Tail.GconBathIndex do
							Vcon[iVcon] = NewOperator(NF,0,{{-Tail.GconBathIndex[iVcon],1}})
						end
						Spec, G = CreateSpectra(Opp,OppCr,psi0,{{Tail.GvalBath,Vval},{Tail.GconBath,Vcon}}, {{"Tensor", true}, {"NTri", 200}, {"DenseBorder", 0}, {"Emin", -5}, {"Emax", 5}, {"NE", 1000}, {"Gamma", 0.1}})
						local failed=false
						if iG==1 then
							for omega=-3,3,0.1 do
								if Chop( G(omega,0.1)[1][1] - GList[i][iG](omega,0.1),1E-10 ) ~= 0 then
									failed = true
									print( omega, G(omega,0.1)[1][1] - GList[i][iG](omega,0.1) )
								end
							end
						else
							for omega=-3,3,0.1 do
								for ii=1,2 do
									for jj=1,2 do
										if Chop( G(omega,0.1)[1+(ii-1)*iS][1+(jj-1)*iS] - GList[i][iG](omega,0.1)[ii][jj],1E-10 ) ~= 0 then
										 failed = true
										 print( omega, Chop(G(omega,0.1)) )
										 print( omega, GList[i][iG](omega,0.1) )
										end
									end
								end
							end
						end
				
						if failed then
							print("FAILED")
							print(G(0.0,0.1))
							print(GList[i][iG](0.0,0.1))
				
							print(GList[i][iG])
							print(G)
							print(ResponseFunction.ChangeType(GList[i][iG],"Tri"))
				
							print(OppCr)
							print(Opp)
							print(psi0)
							print(Vval)
							print(Vcon)
						
							error("Test failed")
						end
					end
				end
			end
		end
	end
end



collectgarbage()
print("--------------------------------------------------------")
print("-- End                                                --")
print("--------------------------------------------------------")


