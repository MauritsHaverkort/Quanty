										{  2      ,  12     ,  0      ,  0      ,  0      ,  0      } ,
										{  3      ,  0      ,  13     ,  0      ,  0      ,  0      } ,
										{  4      ,  0      ,  0      ,  14     ,  0      ,  0      } ,
										{  5      ,  0      ,  0      ,  0      ,  15     ,  0      } ,
										{  6      ,  0      ,  0      ,  0      ,  0      ,  16     } })
