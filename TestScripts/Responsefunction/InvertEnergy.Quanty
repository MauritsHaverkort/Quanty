print("--------------------------------------------------------")
print("-- Responsefunction InvertEnergy                      --")
print("--------------------------------------------------------")




print("-- Single valued                                      --")

print("-- Tri                                                --")

a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  3,  4,  5,  6}
G = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
a = {10,-11,-12,-13,-14,-15,-16}
b = {     1,  2,  3,  4,  5,  6}
Gmin = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)

if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end


print("-- And                                                --")

a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  3,  4,  5,  6}
G = ResponseFunction.New({a,b,mu=0,type="And", name="G"})
a = {10,-11,-12,-13,-14,-15,-16}
b = {     1,  2,  3,  4,  5,  6}
Gmin = ResponseFunction.New({a,b,mu=0,type="And", name="G"})
Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)

if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end



print("-- Nat                                                --")

acon = {0,  5, 6, 7}
bcon = {    2, 3, 4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16,  -17}
bval = {    12,   13,   14}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
a0=3
b0=1
G = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=0,type="Nat", name="D"})
acon = {0, 15,  16,  17}
bcon = {   12,  13,  14}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0,-5, -6, -7}
bval = {   2,  3,  4}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
a0=3
b0=1
Gmin = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=0,type="Nat", name="D"})

Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)

if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end



print("-- DoubleTri                                          --")

-- The two chains of a DoubleTri sit in the denominator of
-- G = a0 + b0^2 / ( w - Gval(w) - Gcon(w) ), so unlike the chains of a Nat -- which are
-- added and whose head is a constant of G -- their head follows the inversion. a[0] of
-- the two chains together hold the onsite energy of the observed site, half of it in
-- each, so each of the two maps to mu - a[0] and the two together to 2 mu - a[0]val
-- - a[0]con. Below the head a[i] -> 2 mu - a[i], and the two chains change place as what
-- was below mu is above it now. a0 and b0 do not follow: a0 is the constant of G, which
-- this map leaves where it is, and b0 enters squared.

acon = { 0.5,  5, 6, 7}
bcon = {      2, 3, 4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = { 0.5,-15,-16,-17}
bval = {      12, 13, 14}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
a0=3
b0=1
G = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=0,type="DoubleTri", name="E"})

acon = { 0-0.5, 2*0+15, 2*0+16, 2*0+17}
bcon = {           12,       13,       14}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = { 0-0.5, 2*0-5, 2*0-6, 2*0-7}
bval = {           2,       3,       4}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
a0=3
b0=1
Gmin = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=0,type="DoubleTri", name="E"})

Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)

if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function InvertEnergy failed\n",1) end


print("-- LP                                                 --")

a = {0,  1,   2,   3}
b = {  1/4, 1/2, 1/4}
G = ResponseFunction.New({a,b,mu=0,type="ListOfPoles", name="A"})
a = {0, -1,  -2,  -3}
b = {  1/4, 1/2, 1/4}
Gmin = ResponseFunction.New({a,b,mu=0,type="ListOfPoles", name="A"})

Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)

if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end





