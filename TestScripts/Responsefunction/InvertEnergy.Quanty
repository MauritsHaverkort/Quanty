print("--------------------------------------------------------")
print("-- Responsefunction InvertEnergy                      --")
print("--------------------------------------------------------")




print("-- Single valued                                      --")

print("-- Tri                                                --")

a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  3,  4,  5,  6}
G = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
a = {10,-11,-12,-13,-14,-15,-16}
b = {     1,  2,  3,  4,  5,  6}
Gmin = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)

if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end


print("-- And                                                --")

