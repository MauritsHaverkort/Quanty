a0=3
b0=1
G = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=2,type="DoubleTri", name="E"})

acon = { 2-0.5, 2*2+15, 2*2+16, 2*2+17}
bcon = {           12,       13,       14}
Gcon = ResponseFunction.New({acon,bcon,mu=2,type="Tri"})
aval = { 2-0.5, 2*2-5, 2*2-6, 2*2-7}
bval = {           2,       3,       4}
Gval = ResponseFunction.New({aval,bval,mu=2,type="Tri"})
a0=3
b0=1
Gmin = ResponseFunction.New({{a0,b0},val=Gval,con=Gcon,mu=2,type="DoubleTri", name="E"})

