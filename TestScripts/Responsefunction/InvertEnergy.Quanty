G = ResponseFunction.New( { {A0,A1,A2,A3}, {B0,B1,B2}, mu=1, type="And", name="A"} )

A0 = Matrix.New({{2,0,0},{3,3,0},{4,4,4}})
A1 =2*MI-Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 =2*MI-Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 =2*MI-Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s

Gmin = ResponseFunction.New( { {A0,A1,A2,A3}, {B0,B1,B2}, mu=1, type="And", name="A"} )

Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)



if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end



print("-- Nat                                                --")


A0 = Matrix.New({{0,0,0},{0,1,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s

B0v = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})
B0c = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})

Gv = ResponseFunction.New( { {A0,-A1/2,-A2/2,-A3/2}, {B0v,B1,B2}, mu=0.1, type="Tri", name="A"} )
Gc = ResponseFunction.New( { {A0, A1/1, A2/1, A3/1}, {B0c,B2,B3}, mu=0.1, type="Tri", name="A"} )
G = ResponseFunction.New( { {A0,B0}, val=Gv, con=Gc, mu=0.1, type="Nat", name="A"} )


Gc = ResponseFunction.New( { {A0, 0.2*MI+A1/2, 0.2*MI+A2/2, 0.2*MI+A3/2}, {B0v,B1,B2}, mu=0.1, type="Tri", name="A"} )
Gv = ResponseFunction.New( { {A0, 0.2*MI-A1/1, 0.2*MI-A2/1, 0.2*MI-A3/1}, {B0c,B2,B3}, mu=0.1, type="Tri", name="A"} )
Gmin = ResponseFunction.New( { {A0,B0}, val=Gv, con=Gc, mu=0.1, type="Nat", name="A"} )

Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)


if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end





print("-- DoubleTri                                          --")

-- as for the single valued case above: the head of the two chains holds half of the
-- onsite energy of the observed block each and follows the inversion, the chains below
-- it map to 2 mu - A[i], the two chains change place, and A0 and B0 stay as they are.

DI  = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
DH  = Matrix.New({{1,0.2,0},{0.2,2,0.1},{0,0.1,3}})
DV1 = Matrix.New({{-2,0.1,0},{0.1,-3,0},{0,0,-4}})
DV2 = Matrix.New({{-5,0,0},{0,-6,0.2},{0,0.2,-7}})
DC1 = Matrix.New({{2,0.1,0},{0.1,3,0},{0,0,4}})
DC2 = Matrix.New({{5,0,0},{0,6,0.1},{0,0.1,7}})
DBv = Matrix.New({{0.7,0,0},{0,0.6,0},{0,0,0.5}})
DBc = Matrix.New({{0.4,0,0},{0,0.3,0},{0,0,0.2}})
DB1 = Matrix.New({{1,0,0},{0,2,0},{0,0,3}})
DA0 = Matrix.New({{0.5,0,0},{0,0.4,0},{0,0,0.3}})

Gv = ResponseFunction.New({ {DH,DV1,DV2}, {DBv,DB1}, mu=1, type="Tri"})
Gc = ResponseFunction.New({ {DH,DC1,DC2}, {DBc,DB1}, mu=1, type="Tri"})
G  = ResponseFunction.New({ {DA0,DI}, val=Gv, con=Gc, mu=1, type="DoubleTri", name="E"})

Gv = ResponseFunction.New({ {1*DI-DH,2*1*DI-DC1,2*1*DI-DC2}, {DBc,DB1}, mu=1, type="Tri"})
Gc = ResponseFunction.New({ {1*DI-DH,2*1*DI-DV1,2*1*DI-DV2}, {DBv,DB1}, mu=1, type="Tri"})
Gmin = ResponseFunction.New({ {DA0,DI}, val=Gv, con=Gc, mu=1, type="DoubleTri", name="E"})

Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)

if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function InvertEnergy failed\n",1) end


print("-- LP                                                 --")


A0 = Matrix.New({{0,1,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s

G = ResponseFunction.New( { {A0, 1, 2, 3}, {B0,B1,B2}, mu=0.5, type="ListOfPoles", name="A"} )
Gmin = ResponseFunction.New( { {A0, 1-1, 1-2, 1-3}, {B0,B1,B2}, mu=0.5, type="ListOfPoles", name="A"} )


Gminp = ResponseFunction.InvertEnergy(G)
Gp = ResponseFunction.InvertEnergy(Gmin)


if((G==Gp)~=true) then error("Response function InvertEnergy failed\n",1) end
if((Gmin==Gminp)~=true) then error("Response function ToTable failed\n",1) end








