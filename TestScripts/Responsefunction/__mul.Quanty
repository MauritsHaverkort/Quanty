--------------------------------------------------------
-- response functions in Quanty are functions that, given
-- a complex number as input w + I gamma/2 return a complex
-- number (single valued functions) or a matrix (matrix functions)
--
-- response functions fullfil the Kramers Kronig relations and
-- "causality". Response functions are defined by matrices such that
-- the function is given by
-- A0 + B0^* ( 1 / (w - H + I gamma / 2) ) B0^T
-- H can have different forms whereby only a few blocks are non-zero


print("--------------------------------------------------------")
print("-------- Single valued functions -----------------------")
print("--------------------------------------------------------")

-- List of poles
a = {10, -1,-0.5, 0,   0.5,  1,  1.5}
b = {  0.1, 0.1, 0.1, 0.1, 0.2, 0.3}
GA_L = {a,b,mu=0,type="ListOfPoles", name="A"}
setmetatable(GA_L, ResponseFunctionMeta)

a = {20, -1,-0.5, 0,   0.5,  1,  1.5}
b = {   0.2, 0.2, 0.2, 0.2, 0.4, 0.6}
GA_L2 = {a,b,mu=0,type="ListOfPoles", name="A"}
setmetatable(GA_L2, ResponseFunctionMeta)

GA_L2m = 2 * GA_L
if((GA_L2==GA_L2m)~=true) then error("Response function comparison failed\n",1) end
GA_L2m = GA_L*2
if((GA_L2==GA_L2m)~=true) then error("Response function comparison failed\n",1) end



-- Tridiagonal
a = {10, 1,   1,   1,   1,   1,  1}
b = {   1, 0.5, 0.5, 0.5, 0.5, 0.5}
GB_T = {a,b,mu=0,type="Tri", name="B"}
setmetatable(GB_T, ResponseFunctionMeta)

a = {20, 1,   1,   1,   1,   1,  1}
b = {   sqrt(2), 0.5, 0.5, 0.5, 0.5, 0.5}
GB_T2 = {a,b,mu=0,type="Tri", name="B"}
setmetatable(GB_T2, ResponseFunctionMeta)

GB_T2m = 2 * GB_T
if((GB_T2==GB_T2m)~=true) then error("Response function comparison failed\n",1) end
GB_T2m = GB_T*2
if((GB_T2==GB_T2m)~=true) then error("Response function comparison failed\n",1) end

