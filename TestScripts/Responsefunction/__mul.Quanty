setmetatable(GC_A, ResponseFunctionMeta)

a = {20, 1, 1.5,   2, 2.5,   3, 3.5}
b = {   sqrt(2), 0.5, 0.5, 0.5, 0.5, 0.5}
GC_A2 = {a,b,mu=0,type="And", name="C"}
