----- test equality

GList = {GA_T,GA_A,GA_N,GA_U,GA_B,GA_TL,GA_AL,GA_NL,GA_UL,GA_BL, GA_t,GA_a,GA_n,GA_u,GA_b,GA_tl,GA_al,GA_nl,GA_ul,GA_bl}

for i=1,#GList do
	for j=1,#GList do
		print("GA",i,j)
		A = ResponseFunction.ToUserdata(GList[i])
		B = ResponseFunction.ToUserdata(GList[i])
		if((A==B)~=true) then
			print("Error at i=",i,"j=",j)
			print("G[i]\n",ResponseFunction.ToTable(GList[i]))
			print("G[j]\n",ResponseFunction.ToTable(GList[j]))
			print("G[i]-G[j]\n",ResponseFunction.ToTable(GList[i]-GList[j]))
			print("G[j]-G[i]\n",ResponseFunction.ToTable(GList[i]-GList[j]))
			error("Response function comparison failed\n",1)
		end
		A=nil
		B=nil
		collectgarbage()
		A = ResponseFunction.ToTable(GList[i])
		B = ResponseFunction.ToTable(GList[i])
		if((A==B)~=true) then
			print("Error at i=",i,"j=",j)
			print("G[i]\n",ResponseFunction.ToTable(GList[i]))
			print("G[j]\n",ResponseFunction.ToTable(GList[j]))
			print("G[i]-G[j]\n",ResponseFunction.ToTable(GList[i]-GList[j]))
			print("G[j]-G[i]\n",ResponseFunction.ToTable(GList[i]-GList[j]))
			error("Response function comparison failed\n",1)
		end
		A=nil
		B=nil
		collectgarbage()
	end
end

