print("--------------------------------------------------------")
print("-- Responsefunction ChangeType to DoubleTri            --")
print("--------------------------------------------------------")

-- The double tri-diagonal representation holds one impurity site with a valence
-- chain and a conduction chain hanging off it:
--
--   G(w) = a0 + b0^2 / ( w - Gval(w) - Gcon(w) )
--
-- with Gval and Gcon ordinary tri-diagonal response functions. The impurity
-- energy is val.a[0] + con.a[0], the plain sum, and each chain is given half of
-- it by convention.
--
-- Converting an Anderson matrix to this form splits the bath at the chemical
-- potential with a Fermi function, so a bath level within 40 kBT of mu ends up
-- in both chains, with weight f and 1-f. Nothing is truncated, so the result
-- has to reproduce the original response function exactly.

function MakeAnderson(nb, eimp, mu)
	local a = {0.0, eimp}		-- a[1] is the offset a0, a[2] the impurity energy
	local b = {1.4}			-- b[1] is the overall scale b0
	for i = 1, nb do
		local E = -5.0 + 10.0 * (i - 0.5) / nb
		a[#a + 1] = E
		b[#b + 1] = 0.5 * math.sqrt(math.max(0.0, 25.0 - E * E)) / math.sqrt(nb)
	end
	return ResponseFunction.New({a, b, mu = mu, type = "And", name = "bath"})
end

-- largest relative difference between two response functions on a grid
function MaxRelDiff(G1, G2, gamma)
	local worst = 0.0
	for i = 0, 400 do
		local w = -7.0 + 14.0 * i / 400
		local v1, v2 = G1(w, gamma), G2(w, gamma)
		-- Complex.Re and Complex.Im are functions and return a value; they work whether
		-- the argument is a complex userdata or a plain lua number. a.Re reads like a
		-- method, which in Quanty would mean it modifies a, so it is the wrong spelling.
		local d = math.sqrt((Complex.Re(v1) - Complex.Re(v2))^2 + (Complex.Im(v1) - Complex.Im(v2))^2)
		local n = math.sqrt(Complex.Re(v1)^2 + Complex.Im(v1)^2)
		if (n > 0) and ((d / n) > worst) then worst = d / n end
	end
	return worst
end

function Check(name, nb, eimp, mu, kBT)
	local GA = MakeAnderson(nb, eimp, mu)
	local GD = ResponseFunction.ChangeType(GA, "DoubleTri", {{"EffectivekBT", kBT}})
	local e = math.max(MaxRelDiff(GA, GD, 0.3), MaxRelDiff(GA, GD, 0.02))
	local t = ResponseFunction.ToTable(GD)
	local ta, tb = ResponseFunction.ToTable(GA)[1], ResponseFunction.ToTable(GA)[2]
	-- the impurity energy is shared between the two chains and must add up
	if math.abs(t.val[1][1] + t.con[1][1] - ta[2]) > 1E-12 * (1 + math.abs(ta[2])) then
		error("ChangeType DoubleTri: val.a[0] + con.a[0] is not the impurity energy for " .. name, 1)
	end
	-- the two chains together carry the whole hybridization weight. An empty
	-- chain has no b at all, its b[0] would be the zeroth element of a list of
	-- length zero, so it contributes nothing
	local W = 0.0
	for i = 2, #tb do W = W + tb[i] * tb[i] end
	local Wval = (#(t.val[2]) > 0) and t.val[2][1]^2 or 0.0
	local Wcon = (#(t.con[2]) > 0) and t.con[2][1]^2 or 0.0
	if math.abs(Wval + Wcon - W) > 1E-12 * (1 + W) then
		error("ChangeType DoubleTri: the two chains do not carry the whole weight for " .. name, 1)
	end
	-- the result has to survive a round trip through a lua table
	local e2 = MaxRelDiff(GD, ResponseFunction.ToUserdata(ResponseFunction.ToTable(GD)), 0.02)
	if e2 > 1E-11 then
		error("ChangeType DoubleTri does not survive a table round trip for " .. name, 1)
	end
	print(string.format("  %-30s Nval=%4d Ncon=%4d   max relative error %9.2e",
	      name, #(t.val[1]) - 1, #(t.con[1]) - 1, e))
	if e > 1E-11 then
		error("ChangeType DoubleTri does not reproduce the original function for " .. name, 1)
	end
end

print("Anderson to DoubleTri, agreement with the original function")
Check("kBT finite, eimp nonzero", 999, 1.7,  0.0, 0.025)
Check("kBT zero",                 999, 1.7,  0.0, 0.0)
Check("mu off centre",            999, 0.0, -1.3, 0.1)
Check("valence chain empty",      999, 1.7, -6.0, 0.025)
Check("conduction chain empty",   999, 1.7,  6.0, 0.025)
Check("small bath",                 6, 1.7,  0.0, 0.3)
Check("single bath level",          1, 1.7,  0.0, 0.3)
Check("no bath at all",             0, 1.7,  0.0, 0.025)

-- A chain of length zero is a legal double tri-diagonal matrix: that branch is
-- absent and contributes only its site energy to the denominator. It happens
-- whenever the chemical potential lies outside the bath, and with no bath at all
-- both chains are empty. Copying such a matrix has to work, which is what
-- converting a double tri-diagonal one to its own type does.
for i, s in ipairs({{"both empty", 0.0}, {"valence empty", -6.0}, {"conduction empty", 6.0}}) do
	local GD = ResponseFunction.ChangeType(MakeAnderson((s[2] == 0.0) and 0 or 40, 1.7, s[2]),
	                                       "DoubleTri", {{"EffectivekBT", 0.01}})
	local t = ResponseFunction.ToTable(GD)
	local nv, nc = #(t.val[1]) - 1, #(t.con[1]) - 1
	if (s[2] <= 0.0) and (nv ~= 0) then
		error("ChangeType DoubleTri: expected an empty valence chain, got " .. nv, 1)
	end
	if (s[2] >= 0.0) and (nc ~= 0) then
		error("ChangeType DoubleTri: expected an empty conduction chain, got " .. nc, 1)
	end
	local e = MaxRelDiff(GD, ResponseFunction.ChangeType(GD, "DoubleTri"), 0.02)
	print(string.format("  %-30s Nval=%4d Ncon=%4d   max relative error %9.2e",
	      "copy, " .. s[1], nv, nc, e))
	if e > 1E-11 then
		error("copying a DoubleTri, " .. s[1] .. ", does not reproduce it", 1)
	end
end

-- A response function of dimension zero: no bath and no impurity site either, so
-- G(w) = a0, a constant, with no matrix behind it. Every type writes that as a
-- list of length zero, {{a0}, {}}. In the double tri-diagonal form it is b0 = 0
-- with two empty chains: b0 is the hopping onto the observed site, and with no
-- site to hop onto b0 = 0 is what says there is nothing here. Note this is a
-- different object from an Anderson matrix with an impurity and no bath, which is
-- the 1x1 matrix tested as "no bath at all" above and keeps b0 nonzero.
--
-- Nothing is computed on this path, so a0 has to come back bit for bit.
function CheckZeroDim(name, G, a0)
	local D = ResponseFunction.ChangeType(G, "DoubleTri", {{"EffectivekBT", 0.05}})
	local t = ResponseFunction.ToTable(D)
	if t[1][2] ~= 0.0 then
		error("ChangeType DoubleTri: dimension zero must give b0 = 0 for " .. name, 1)
	end
	if (#(t.val[1]) - 1 ~= 0) or (#(t.con[1]) - 1 ~= 0) then
		error("ChangeType DoubleTri: dimension zero must give two empty chains for " .. name, 1)
	end
	if (t.val[1][1] ~= 0.0) or (t.con[1][1] ~= 0.0) then
		error("ChangeType DoubleTri: dimension zero must give val.a[0] = con.a[0] = 0 for " .. name, 1)
	end
	if t[1][1] ~= a0 then
		error("ChangeType DoubleTri: dimension zero did not keep a0 for " .. name, 1)
	end
	-- G is a0 at every energy and every broadening, exactly
	local worst = 0.0
	for i = 0, 40 do
		local w = -6.0 + 12.0 * i / 40
		for j, gamma in ipairs({0.3, 0.02, 1E-6}) do
			local v = D(w, gamma)
			local d = math.sqrt((Complex.Re(v) - a0)^2 + Complex.Im(v)^2)
			if d > worst then worst = d end
		end
	end
	-- and it survives a table round trip
	local v = ResponseFunction.ToUserdata(ResponseFunction.ToTable(D))(0.5, 0.1)
	if (Complex.Re(v) ~= a0) or (Complex.Im(v) ~= 0.0) then
		error("ChangeType DoubleTri: dimension zero does not survive a table round trip for " .. name, 1)
	end
	print(string.format("  %-30s a0=%8.3f b0=%3.1f  deviation from a0 %9.2e",
	      name, t[1][1], t[1][2], worst))
	if worst ~= 0.0 then
		error("ChangeType DoubleTri: dimension zero is not exactly a0 for " .. name, 1)
	end
end

print("a response function of dimension zero")
CheckZeroDim("from And",         ResponseFunction.New({{1.234}, {}, mu=0, type="And",         name="z"}), 1.234)
CheckZeroDim("from Tri",         ResponseFunction.New({{1.234}, {}, mu=0, type="Tri",         name="z"}), 1.234)
CheckZeroDim("from ListOfPoles", ResponseFunction.New({{1.234}, {}, mu=0, type="ListOfPoles", name="z"}), 1.234)
CheckZeroDim("a0 zero",          ResponseFunction.New({{0.0},   {}, mu=0, type="And",         name="z"}), 0.0)
CheckZeroDim("a0 negative",      ResponseFunction.New({{-2.5},  {}, mu=0, type="And",         name="z"}), -2.5)

-- Degenerate bath levels have to be merged before the chain is built, or the
-- measure has a smaller support than the number of poles and the recursion
-- breaks down. Every level here appears three times.
a = {0.0, 1.7}
b = {1.4}
for i = 1, 12 do
	a[#a + 1] = -3.0 + 6.0 * (math.floor((i - 1) / 3) + 0.5) / 4
	b[#b + 1] = 0.2 + 0.01 * i
end
GAdeg = ResponseFunction.New({a, b, mu = 0.0, type = "And", name = "degenerate"})
GDdeg = ResponseFunction.ChangeType(GAdeg, "DoubleTri", {{"EffectivekBT", 0.1}})
edeg = math.max(MaxRelDiff(GAdeg, GDdeg, 0.3), MaxRelDiff(GAdeg, GDdeg, 0.02))
tdeg = ResponseFunction.ToTable(GDdeg)
print(string.format("  %-30s Nval=%4d Ncon=%4d   max relative error %9.2e",
      "degenerate bath levels", #(tdeg.val[1]) - 1, #(tdeg.con[1]) - 1, edeg))
if edeg > 1E-11 then
	error("ChangeType DoubleTri does not reproduce a bath with degenerate levels", 1)
end
-- 12 levels on 4 distinct energies, so neither chain can be longer than 4
if (#(tdeg.val[1]) - 1 > 4) or (#(tdeg.con[1]) - 1 > 4) then
	error("ChangeType DoubleTri did not merge degenerate bath levels", 1)
end

-- The natural orbital form reaches the double tri-diagonal form through the
-- Anderson form, and its bath is one tri-diagonal eigenvalue problem away: drop
-- the observed orbital and the extra natural orbital is left with exactly two
-- neighbours, the head of each chain, so the whole minor is a single chain. That
-- step has to reproduce the original function on its own.
av = {0.0}
bv = {math.sqrt(0.5)}
ac = {0.0}
bc = {math.sqrt(0.5)}
for i = 1, 40 do
	av[#av + 1] = -5.0 + 4.9 * (i - 0.5) / 40
	ac[#ac + 1] =  0.1 + 4.9 * (i - 0.5) / 40
	if i < 40 then
		bv[#bv + 1] = 0.30 * (1.0 + 0.3 * math.sin(3.0 * i))
		bc[#bc + 1] = 0.28 * (1.0 + 0.3 * math.sin(3.0 * i))
	end
end
Gval = {av, bv, mu = 0, type = "Tri"}
setmetatable(Gval, ResponseFunctionMeta)
Gcon = {ac, bc, mu = 0, type = "Tri"}
setmetatable(Gcon, ResponseFunctionMeta)
GNat = ResponseFunction.New({{0.3, 1.2}, val = Gval, con = Gcon, mu = 0, type = "Nat", name = "N"})
GNatA = ResponseFunction.ChangeType(GNat, "And")
eNatA = math.max(MaxRelDiff(GNat, GNatA, 0.3), MaxRelDiff(GNat, GNatA, 0.02))
print(string.format("  %-30s max relative error %9.2e", "Nat to And", eNatA))
if eNatA > 1E-11 then
	error("ChangeType from Nat to And does not reproduce the original function", 1)
end

-- A tri-diagonal and a list of poles reach the double tri-diagonal form through
-- the Anderson form, so they have to agree with it as well.
GA = MakeAnderson(200, 1.7, 0.0)
for i, ty in ipairs({"Tri", "LP", "Nat"}) do
	G = ResponseFunction.ChangeType(GA, ty)
	GD = ResponseFunction.ChangeType(G, "DoubleTri", {{"EffectivekBT", 0.05}})
	e = math.max(MaxRelDiff(G, GD, 0.3), MaxRelDiff(G, GD, 0.02))
	print(string.format("  %-30s max relative error %9.2e", ty .. " to DoubleTri", e))
	if e > 1E-11 then
		error("ChangeType DoubleTri does not reproduce the original function from " .. ty, 1)
	end
end

print("--------------------------------------------------------")
