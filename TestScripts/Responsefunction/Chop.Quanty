B0v = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})
B0c = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})

Gv = ResponseFunction.New( { {A0}, {}, mu=0, type="Tri", name="A"} )
Gc = ResponseFunction.New( { {A0, A1/1, A2/1},       {B0c,B2}, mu=0, type="Tri", name="A"} )
G1t = ResponseFunction.New( { {A0,B0}, val=Gv, con=Gc, mu=0, type="Nat", name="A"} )

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
