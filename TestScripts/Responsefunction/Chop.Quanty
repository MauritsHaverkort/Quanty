B0v = Matrix.New({{1E-18,1E-18,1E-18},{1E-18,1E-18,1E-18},{1E-18,1E-18,1E-18}})
B0c = Matrix.New({{sqrt(1/2),0,0},{0,sqrt(1/2),0},{0,0,sqrt(1/2)}})

Gv = ResponseFunction.New( { {A0,-A1/2,-A2/2,-A3/2}, {B0v,B1,B2}, mu=0, type="Tri", name="A"} )
Gc = ResponseFunction.New( { {A0, A1/1, A2/1, A3/1}, {B0c,B2,B3}, mu=0, type="Tri", name="A"} )
G = ResponseFunction.New( { {A0,B0}, val=Gv, con=Gc, mu=0, type="Nat", name="A"} )

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{0,0,0},{3,6,9}})
