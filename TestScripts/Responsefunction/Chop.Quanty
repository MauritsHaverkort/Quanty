print("-- DoubleTri                                          --")

-- The two chains are ordinary tri-diagonal matrices, so a chopped hopping cuts the
-- chain there, exactly as for Tri and Nat above. What is extra is the pair a0, b0 of
-- the matrix itself, and b0 is the interesting one -- see "DoubleTri to zero" below.

acon = {0,  5, 6, 7}
bcon = {    2, 1E-17, 4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16,  -17}
bval = {    12,   13,   1E-17}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
G = ResponseFunction.New({{3,1},val=Gval,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})

acon = {0,  5}
bcon = {    2}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16}
bval = {    12,   13}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
G1t = ResponseFunction.New({{3,1},val=Gval,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})

acon = {0,  5, 6, 7}
bcon = {    2, 0, 4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16,  -17}
bval = {    12,   13,   0}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
G2t = ResponseFunction.New({{3,1},val=Gval,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})

G1 = Chop(G)
G2 = Chop(G,{{"Deflate",false}})

if((G1==G1t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G1)); print(ResponseFunction.ToTable(G1t)); error("Response function comparison failed\n",1) end
if((G2==G2t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G2)); print(ResponseFunction.ToTable(G2t)); error("Response function comparison failed\n",1) end


print("-- DoubleTri to zero                                  --")

-- b0 is the hopping onto the observed site itself, so once it is chopped away nothing
-- couples to the matrix: G(w) = a0, and with Deflate there is no matrix left to keep.
-- Both chains go to length zero, which is a legal DoubleTri. The head energies a[0] of
-- the two branches are left where they were; with b0 = 0 nothing can observe them.

acon = {0,  5, 6, 7}
bcon = {    2, 1E-17, 4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16,  -17}
bval = {    12,   13,   1E-17}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
G = ResponseFunction.New({{3,1E-17},val=Gval,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})

Gcon = ResponseFunction.New({{0},{},mu=0,type="Tri"})
Gval = ResponseFunction.New({{0},{},mu=0,type="Tri"})
G1t = ResponseFunction.New({{3,0},val=Gval,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})

acon = {0,  5, 6, 7}
bcon = {    2, 0, 4}
Gcon = ResponseFunction.New({acon,bcon,mu=0,type="Tri"})
aval = {0, -15,  -16,  -17}
bval = {    12,   13,   0}
Gval = ResponseFunction.New({aval,bval,mu=0,type="Tri"})
G2t = ResponseFunction.New({{3,0},val=Gval,con=Gcon,mu=0,kBT=0.05,type="DoubleTri", name="D"})

G1 = Chop(G)
G2 = Chop(G,{{"Deflate",false}})

if((G1==G1t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G1)); print(ResponseFunction.ToTable(G1t)); error("Response function comparison failed\n",1) end
if((G2==G2t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G2)); print(ResponseFunction.ToTable(G2t)); error("Response function comparison failed\n",1) end
-- and G really is the constant a0 now, at any energy and any broadening
for i = 0, 8 do
	local w = -4.0 + 8.0 * i / 8
	if((G1(w,0.3).Re~=3) or (G1(w,0.3).Im~=0)) then error("a chopped DoubleTri is not exactly a0\n",1) end
	if((G2(w,0.3).Re~=3) or (G2(w,0.3).Im~=0)) then error("a chopped DoubleTri is not exactly a0\n",1) end
end


print("-- Matrix                                             --")


M0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})

print("-- Tri                                                --")


A0 = Matrix.New({{2,0,0},{3,3,0},{4,4,4}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1E-18,1E-18,1E-18},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{1E-17,0,1E-17},{0,1E-17,1E-17},{1E-17,1E-17,1E-17}})
B2 = B2s * B2s
B3s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s
G = ResponseFunction.New( { {A0,A1,A2,A3,A3}, {B0,B1,B2,B3}, mu=0, type="Tri", name="A"} )

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{0,0,0},{3,6,9}})
B1 = B1s * B1s
G1t = ResponseFunction.New( { {A0,A1,A2}, {B0,B1}, mu=0, type="Tri", name="A"} )

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{0,0,0},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
B2 = B2s * B2s
B3s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s
G2t = ResponseFunction.New( { {A0,A1,A2,A3,A3}, {B0,B1,B2,B3}, mu=0, type="Tri", name="A"} )


G1 = Chop(G)
G2 = Chop(G,{{"Deflate",false}})



if((G1==G1t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G1)); print(ResponseFunction.ToTable(G1t)); error("Response function comparison failed\n",1) end
if((G2==G2t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G2)); print(ResponseFunction.ToTable(G2t)); error("Response function comparison failed\n",1) end


