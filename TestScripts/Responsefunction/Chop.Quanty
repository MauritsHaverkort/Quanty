print("-- Matrix                                             --")


M0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})

print("-- Tri                                                --")


A0 = Matrix.New({{2,0,0},{3,3,0},{4,4,4}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1E-18,1E-18,1E-18},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{1E-17,0,1E-17},{0,1E-17,1E-17},{1E-17,1E-17,1E-17}})
B2 = B2s * B2s
B3s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s
G = ResponseFunction.New( { {A0,A1,A2,A3,A3}, {B0,B1,B2,B3}, mu=0, type="Tri", name="A"} )

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{0,0,0},{3,6,9}})
B1 = B1s * B1s
G1t = ResponseFunction.New( { {A0,A1,A2}, {B0,B1}, mu=0, type="Tri", name="A"} )

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{0,0,0},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
B2 = B2s * B2s
B3s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s
G2t = ResponseFunction.New( { {A0,A1,A2,A3,A3}, {B0,B1,B2,B3}, mu=0, type="Tri", name="A"} )


G1 = Chop(G)
G2 = Chop(G,{{"Deflate",false}})



if((G1==G1t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G1)); print(ResponseFunction.ToTable(G1t)); error("Response function comparison failed\n",1) end
if((G2==G2t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G2)); print(ResponseFunction.ToTable(G2t)); error("Response function comparison failed\n",1) end


