print("-- LP                                                 --")


A0 = Matrix.New({{0,1E-18,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = (1E-20) * Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s

G   = ResponseFunction.New( { {A0, 1, 2, 3}, {B0,B1,B2}, mu=0, type="ListOfPoles", name="A"} )
G1t = ResponseFunction.New( { {M0, 1,    3}, {B0,   B2}, mu=0, type="ListOfPoles", name="A"} )
G2t = ResponseFunction.New( { {M0, 1, 2, 3}, {B0,M0,B2}, mu=0, type="ListOfPoles", name="A"} )

G1 = Chop(G)
G2 = Chop(G,{{"Deflate",false}})

if((G1==G1t)~=true)    then error("Response function comparison failed\n",1) end
if((G2==G2t)~=true)    then error("Response function comparison failed\n",1) end



print("-- LP to zero                                         --")


A0 = Matrix.New({{0,1E-18,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})

B0s = (1E-20) * Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = (1E-20) * Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s
B2s = (1E-20) * Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s

G   = ResponseFunction.New( { {A0, 1, 2, 3}, {B0,B1,B2}, mu=0, type="ListOfPoles", name="A"} )
G1t = ResponseFunction.New( { {M0}, {}, mu=0, type="ListOfPoles", name="A"} )
G2t = ResponseFunction.New( { {M0, 1, 2, 3}, {M0,M0,M0}, mu=0, type="ListOfPoles", name="A"} )

G1 = Chop(G)
G2 = Chop(G,{{"Deflate",false}})

if((G1==G1t)~=true)    then error("Response function comparison failed\n",1) end
if((G2==G2t)~=true)    then error("Response function comparison failed\n",1) end



collectgarbage()
print("-- DoubleTri                                          --")

-- Evaluating a block response function always gives a complex matrix; Gw.QComplex is
-- 1 whatever the numbers in it. But LuaPushTable_CompactMatrixType pushes element by
-- element, and an element whose imaginary part is exactly zero is pushed as a plain lua
-- number rather than as a Complex. So the table can be mixed, and routinely is: any G
-- that is block diagonal has plain zeros off the diagonal, and once b0 has been chopped
-- away G is the real matrix A0 and every element is a plain number. Read through ReIm
-- rather than assuming .Re and .Im exist.
function ReIm(x)
	if(type(x)=="number") then return x, 0 end
	return x.Re, x.Im
end

-- Built by conversion, since that is how a block DoubleTri comes about; the expected
-- chains are not written out by hand here, so this asserts shapes and values rather
-- than comparing against a hand built matrix.

MDa = { {{0,0},{0,0}}, {{1.7,0.2},{0.2,1.3}}, {{-2,0},{0,-2}}, {{-1,0},{0,-1}}, {{1,0},{0,1}}, {{2,0},{0,2}} }
MDb = { {{1,0},{0,1}}, {{0.4,0},{0,0.4}}, {{0.35,0},{0,0.35}}, {{0.3,0},{0,0.3}}, {{0.25,0},{0,0.25}} }
MD  = ResponseFunction.ChangeType(ResponseFunction.New({MDa,MDb,mu=0,type="And",name="MD"}),
                                  "DoubleTri", {{"EffectivekBT",0.05}})
MDt = ResponseFunction.ToTable(MD)
MDnv, MDnc = #(MDt.val[1])-1, #(MDt.con[1])-1

-- a chop far below every element must leave it alone, deflating or not
for i, d in ipairs({false,true}) do
	local t = ResponseFunction.ToTable(Chop(MD,1E-30,{{"Deflate",d}}))
	if((#(t.val[1])-1~=MDnv) or (#(t.con[1])-1~=MDnc)) then
		error("Chop of a block DoubleTri below every element changed its dimensions\n",1)
	end
	for k = 0, 8 do
		local w = -6.0 + 12.0*k/8
		local u, v = MD(w,0.3), Chop(MD,1E-30,{{"Deflate",d}})(w,0.3)
		for x = 1, 2 do for y = 1, 2 do
			local ur, ui = ReIm(u[x][y])
			local vr, vi = ReIm(v[x][y])
			if(math.abs(ur-vr)+math.abs(ui-vi) > 1E-13) then
				error("Chop of a block DoubleTri below every element changed G\n",1)
			end
		end end
	end
end

print("-- DoubleTri to zero                                  --")

-- b0 of this one is the identity, so a chop above 1 takes it away. Nothing then couples
-- to the matrix: G(w) = A0, and with Deflate both chains go to length zero.
MD1 = Chop(MD,10.0,{{"Deflate",true}})
MD2 = Chop(MD,10.0,{{"Deflate",false}})
MDt1, MDt2 = ResponseFunction.ToTable(MD1), ResponseFunction.ToTable(MD2)
if((#(MDt1.val[1])-1~=0) or (#(MDt1.con[1])-1~=0)) then
	error("a block DoubleTri whose b0 is chopped away must have no chains left\n",1)
end
if((#(MDt2.val[1])-1~=MDnv) or (#(MDt2.con[1])-1~=MDnc)) then
	error("Chop without Deflate must not change the dimensions of a block DoubleTri\n",1)
end
for i, G in ipairs({MD1, MD2}) do
	for x = 1, 2 do for y = 1, 2 do
		if(ResponseFunction.ToTable(G)[1][2][x][y]~=0) then
			error("b0 of a chopped block DoubleTri is not zero\n",1)
		end
	end end
	-- and G is the constant A0, exactly, at any energy
	for k = 0, 8 do
		local w = -6.0 + 12.0*k/8
		local v = G(w,0.3)
		for x = 1, 2 do for y = 1, 2 do
			local vr, vi = ReIm(v[x][y])
			if((vr~=MDt[1][1][x][y]) or (vi~=0)) then
				error("a chopped block DoubleTri is not exactly A0\n",1)
			end
		end end
	end
end

print("-- DoubleTri mixed real and complex                   --")

-- QComplex of a block DoubleTri is 0 if all four of val, con, a0 and b0 are real, 1 if
-- all four are complex, and 2 for a mixture. A chop demotes each part on its own -- the
-- imaginary part of a0 goes here while val keeps a real one -- so a mixture is exactly
-- what comes out, and every consumer has to read the QComplex of the part it touches
-- rather than the container's. That is what this checks: if anything downstream used the
-- container flag, G would come back wrong.
MXv = ResponseFunction.New({ {{{0,0},{0,0}}, {{Complex.New(-1,0.4),0},{0,-1.2}}},
                             {{{0.6,0},{0,0.5}}}, mu=0, type="Tri"})
MXc = ResponseFunction.New({ {{{0,0},{0,0}}, {{1.1,0},{0,1.3}}},
                             {{{0.5,0},{0,0.45}}}, mu=0, type="Tri"})
MX  = ResponseFunction.New({ {{{0.3,Complex.New(0,1E-17)},{0,0.2}}, {{1,0},{0,1}}},
                             val=MXv, con=MXc, mu=0, kBT=0.05, type="DoubleTri", name="MX"})
for i, d in ipairs({false,true}) do
	local GC = Chop(MX,1E-15,{{"Deflate",d}})
	for k = 0, 12 do
		local w = -5.0 + 10.0*k/12
		local u, v = MX(w,0.3), GC(w,0.3)
		for x = 1, 2 do for y = 1, 2 do
			local ur, ui = ReIm(u[x][y])
			local vr, vi = ReIm(v[x][y])
			if(math.abs(ur-vr)+math.abs(ui-vi) > 1E-14) then
				error("chopping a block DoubleTri of mixed real and complex parts changed G\n",1)
			end
		end end
	end
end


print("--------------------------------------------------------")
print("-- End                                                --")
print("--------------------------------------------------------")



