print("--------------------------------------------------------")
print("-- Responsefunction Chop                              --")
print("--------------------------------------------------------")




print("-- Single valued                                      --")

print("-- Tri                                                --")

a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  1E-17,  4,  5,  6}
G = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
a = {10, 11, 12}
b = {     1,  2}
G1t = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
a = {10, 11, 12, 13, 14, 15, 16}
b = {     1,  2,  0,  4,  5,  6}
G2t = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})

G1 = Chop(G)
G2 = Chop(G,{{"Deflate",false}})

if((G1==G1t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G1)); print(ResponseFunction.ToTable(G1t)); error("Response function comparison failed\n",1) end
if((G2==G2t)~=true)    then print(ResponseFunction.ToTable(G)); print(ResponseFunction.ToTable(G2)); print(ResponseFunction.ToTable(G2t)); error("Response function comparison failed\n",1) end


print("-- Tri to zero                                        --")

