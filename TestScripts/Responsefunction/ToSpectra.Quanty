print("-- Tri                                                --")


A0 = Matrix.New({{0,0,0},{0,0,0},{0,0,0}})
A1 = Matrix.New({{1,2,3},{2,5,6},{3,6,9}})/3
A2 = Matrix.New({{2,2,3},{2,5,6},{3,6,9}})/3
A3 = Matrix.New({{3,2,3},{2,5,6},{3,6,9}})/3

B0s = Matrix.New({{1,0,0},{0,1,0},{0,0,1}})
B0 = B0s * B0s
B1s = Matrix.New({{1,1,3},{1,5,6},{3,6,9}})
B1 = B1s * B1s / 100
B2s = Matrix.New({{2,0,3},{0,5,6},{3,6,9}})
B2 = B2s * B2s / 100
B3s = Matrix.New({{3,0,3},{0,5,6},{3,6,9}})
B3 = B3s * B3s / 100

G = ResponseFunction.New( { {A0,A1,A2,A3}, {B0,B1,B2}, mu=0, type="Tri", name="A"} )

S = ResponseFunction.ToSpectra(G)
--print("S1",S)
if DoPlot then
	Pl  = Graphics.Plot(S, {{"Nrow",3},{"NColumn",3},{"Frame",{{"Ymin",-1.1},{"Ymax",1.1},{"dYTick",0.5},{"XLabel","X scale [unit]"},{"YLabel","Y scale [unit]"}}}})
	SVG = Graphics.ToSVG(Pl)
	file = io.open(directory.."../../../TestPlotOutput/MTriDiagonalMatrixToSpectra_1.svg",'w')
	file:write(SVG)
	file:close()
end
St=Spectra.ToTable(S)
for i=1, 9 do
  dE = St[i][1][1] - St[i][2][1]
  Integral = 0
  for j=1,#St[i] do
	  Integral = Integral + dE * St[i][j][2]
  end
	print(i, St[i].Integral, Integral/Pi)
end


