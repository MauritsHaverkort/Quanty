print("-- Tri                                                --")

Mexp = Matrix.New({ {  1      ,  2      ,  0      ,  0      ,  0      ,  0      } ,
										{  2      ,  2      ,  3      ,  0      ,  0      ,  0      } ,
										{  0      ,  3      ,  3      ,  4      ,  0      ,  0      } ,
										{  0      ,  0      ,  4      ,  4      ,  5      ,  0      } ,
										{  0      ,  0      ,  0      ,  5      ,  5      ,  6      } ,
										{  0      ,  0      ,  0      ,  0      ,  6      ,  6      } })
a = {0.5, 1, 2 ,  3 , 4, 5,  6}
b = {     1,  2,  3,  4,  5,  6}
G = ResponseFunction.New({a,b,mu=0,type="Tri", name="G"})
S = ResponseFunction.ToSpectra(G)
--print("S1",S)
St=Spectra.ToTable(S)
print(St[1].Integral)
dE = St[1][1][1] - St[1][2][1]
Integral = 0
for i=1,#St[1] do
	Integral = Integral + dE * St[1][i][2]
end
print(Integral / Pi)

if DoPlot then
	Pl  = Graphics.Plot(S, {{"Frame",{{"Ymin",-1},{"Ymax",1},{"dYTick",10},{"XLabel","X scale [unit]"},{"YLabel","Y scale [unit]"}}}})
	SVG = Graphics.ToSVG(Pl)
	file = io.open(directory.."../../../TestPlotOutput/TriDiagonalMatrixToSpectra_1.svg",'w')
	file:write(SVG)
	file:close()
end
S = ResponseFunction.ToSpectra(G,{{"Emin",-10},{"Emax",10}})
--print("S2",S)
