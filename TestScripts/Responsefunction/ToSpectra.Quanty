Gc = ResponseFunction.New( { {A0, A1, A2, A3}, {B0c,B1,B2}, mu=0, type="Tri", name="A"} )

G = ResponseFunction.New( { {A0,B0}, val=Gv, con=Gc, mu=0, type="Nat", name="A"} )
A1v=-A1
A1c= A1
B1v= B1
B1c= B1
Mexp = Matrix.Flatten({{ B0c*A1c*B0c+B0v*A1v*B0v,-B0c*A1c*B0v+B0v*A1v*B0c, B1v*B0v, 0 , B1c*B0c, 0  },
											 { B0c*A1v*B0v-B0v*A1c*B0c, B0v*A1c*B0v+B0c*A1v*B0c, B1v*B0c, 0 ,-B1c*B0v, 0  },
											 { B1v*B0v                , B1v*B0c                ,-A2     , B2, 0      , 0  },
											 { 0                      , 0                      , B2     ,-A3, 0      , 0  },
											 { B1c*B0c                , -B1c*B0v               , 0      , 0 , A2     , B2 },
											 { 0                      , 0                      , 0      , 0 , B2     , A3 }})

S = ResponseFunction.ToSpectra(G)
print("S1",S)
S = ResponseFunction.ToSpectra(G,{{"Emin",-1},{"Emax",1}})
print("S2",S)
S = ResponseFunction.ToSpectra(G,{{"Emin",-1},{"Emax",1},{"NE",100}})
print("S3",S)
S = ResponseFunction.ToSpectra(G,{{"Emin",-1},{"Emax",1},{"NE",100},{"GammaG",0.1}})
print("S4",S)
S = ResponseFunction.ToSpectra(G,{{"Emin",-1},{"Emax",1},{"NE",100},{"GammaL",0.1}})
print("S5",S)




