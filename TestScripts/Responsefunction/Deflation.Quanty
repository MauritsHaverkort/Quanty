
function ImpurityVSBath(impstr,bathstr)
	if #impstr ~= #bathstr then return false end
	for i=1, #impstr  do
		if impstr:sub(i, i) == bathstr:sub(i, i) then
			return false
		end
	end
	return true
end

print("--------------------------------------------------------")
print("-- Responsefunction Deflation                         --")
print("--------------------------------------------------------")

A0 = Matrix.New({{0,0},{0,0}})
A1 = Matrix.New({{1,0},{0,1}})
A2 = Matrix.New({{2,0},{0,2}})
A3 = Matrix.New({{3,3},{3,3}})
A4 = Matrix.New({{4,0},{0,4}})
A5 = Matrix.New({{5,0},{0,5}})

B0 = Matrix.New({{1,0},{0,1}})
B1 = Matrix.New({{1,0},{0,1}})
B2 = Matrix.New({{1,0},{0,1}})
B3 = Matrix.New({{1,0},{0,0}})
B4 = Matrix.New({{1,0},{0,0}})

G0And = ResponseFunction.New({ {A0,A1,A2,A3,A4,A5}, {B0,B1,B2,B3,B4}, mu=0, type="And", name="G0ANd"})
G0Tri = ResponseFunction.New({ {A0,A1,A2,A3,A4,A5}, {B0,B1,B2,B3,B4}, mu=0, type="Tri", name="G0Tri"})
for i=1,6 do
	if ResponseFunction.ToTable(G0Tri).BlockSize[i] ~= 2 then error("BlockSize changed at initialization\n",1) end
end

H0, bit0 = ResponseFunction.ToOperator(G0Tri)
if H0.NF ~= 10 then error("BlockSize changed at initialization\n",1) end
if bit0.NF ~= 10 then error("BlockSize changed at initialization\n",1) end
if ImpurityVSBath(bit0.Impurity,bit0.Bath)~=true then error("Something wrong with the bitfield\n",1) end


M0 = ResponseFunction.ChangeType(G0Tri,"Dense")
if #M0 ~= 10 then error("Matrix has wrong size\n",1) end
print(M0)


blocksizenow = {2,2,2,2,1,1}
G1Tri = BlockBandDiagonalize(M0,2,{{"NTri",5}})

for i=1,6 do
	if G1Tri.BlockSize[i] ~= blocksizenow[i] then error("BlockSize changed at initialization\n",1) end
end

print("-------- comparison for G1Tri")

H1, bit1 = ResponseFunction.ToOperator(G1Tri)
M1 = ResponseFunction.ChangeType(G1Tri,"Dense")

if H1.NF ~= 10 then error("BlockSize changed at initialization\n",1) end
if bit1.NF ~= 10 then error("BlockSize changed at initialization\n",1) end
if ImpurityVSBath(bit1.Impurity,bit1.Bath)~=true then error("Something wrong with the bitfield\n",1) end
if #M1 ~= 10 then error("Matrix has wrong size\n",1) end


print("-------- comparison for G1Tri with deflation")

--H1, bit1 = ResponseFunction.ToOperator(G1Tri,{{"Deflate",true}})
bit2 = ResponseFunction.CreateBitMasks(G1Tri,{{"Deflate",true}})
M1 = ResponseFunction.ChangeType(G1Tri,"Dense",{{"Deflate",true}})

print(G1Tri)
--print(H1)
--print(bit1)
print(bit2)
print(M1)


--if H1.NF ~= 8 then error("BlockSize changed at initialization\n",1) end
--if bit1.NF ~= 8 then error("BlockSize changed at initialization\n",1) end
if bit2.NF ~= 8 then error("BlockSize changed at initialization\n",1) end
--if ImpurityVSBath(bit1.Impurity,bit1.Bath)~=true then error("Something wrong with the bitfield\n",1) end
if ImpurityVSBath(bit2.Impurity,bit2.Bath)~=true then error("Something wrong with the bitfield\n",1) end
if #M1 ~= 8 then error("Matrix has wrong size\n",1) end


print("-------- comparison for G1Nat")

G1Nat = {{A0,B0},val=G1Tri,con=G1Tri,mu=0,type="Nat", name="G1Nat"}
setmetatable(G1Nat, ResponseFunctionMeta)

H1, bit1 = ResponseFunction.ToOperator(G1Nat)
print(G1Nat)
print(H1)
print(bit1)
bit2 = ResponseFunction.CreateBitMasks(G1Nat)
print(bit2)
M1 = ResponseFunction.ChangeType(G1Nat,"Dense")
print(M1)

if H1.NF ~= 20 then error("BlockSize changed at initialization\n",1) end
if bit1.NF ~= 20 then error("BlockSize changed at initialization\n",1) end
if bit2.NF ~= 20 then error("BlockSize changed at initialization\n",1) end
if ImpurityVSBath(bit1.Impurity,bit1.Bath)~=true then error("Something wrong with the bitfield\n",1) end
if ImpurityVSBath(bit2.Impurity,bit2.Bath)~=true then error("Something wrong with the bitfield\n",1) end
if #M1 ~= 20 then error("Matrix has wrong size\n",1) end


collectgarbage()
collectgarbage()
collectgarbage()
