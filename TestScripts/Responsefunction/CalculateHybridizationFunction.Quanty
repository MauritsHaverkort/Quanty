A0 = {{1,0,0},{0,1,0},{0,0,1}}
setmetatable(A0, MatrixMeta)
a1 = -1
a2 = 0
a3 = 0
a4 = 2
a5 = 3


Azero = {{0,0,0},{0,0,0},{0,0,0}}
setmetatable(Azero, MatrixMeta)

B1s = {{1,1,3},{1,5,6},{3,6,9}}
setmetatable(B1s, MatrixMeta)
B1 = B1s * B1s
B2s = {{2,0,3},{0,5,6},{3,6,9}}
setmetatable(B2s, MatrixMeta)
B2 = B2s * B2s
B3s = {{3,0,3},{0,5,6},{3,6,9}}
setmetatable(B3s, MatrixMeta)
B3 = B3s * B3s
B4s = {{3,0,3},{0,5,2},{3,2,1}}
setmetatable(B4s, MatrixMeta)
B4 = B4s * B4s
B5s = {{3,0,3},{0,1,2},{3,2,1}}
setmetatable(B5s, MatrixMeta)
B5 = B5s * B5s

G0 = ResponseFunction.New({ {Azero,-2,2}, {B1,B2}, mu=0, type="ListOfPoles", name="A"})

Sigma = ResponseFunction.New({ {A0,10}, {B3}, mu=0, type="ListOfPoles", name="A"})

Gbath = ResponseFunction.CalculateHybridizationFunction(G0,Sigma)

print(ResponseFunction.ToTable(G0))
print(ResponseFunction.ToTable(Sigma))
print(ResponseFunction.ToTable(Gbath))



collectgarbage()
