	print("Error GLP not equal to GTri")
	print("GLP-GNat\n",ResponseFunction.ToTable(GLP-GNat))
	print("GNat-GLP\n",ResponseFunction.ToTable(GNat-GLP))
	error("Response function comparison failed\n",1)
end

GLP  = ResponseFunction.Transpose(GLP)
GTri = ResponseFunction.Transpose(GTri)
GAnd = ResponseFunction.Transpose(GAnd)
GNat = ResponseFunction.Transpose(GNat)

TimeStart("Plot")
PlotPoints = 800
Emin=-10
Emax= 15
dETick=5
dYtick=10
Ymin =-20
Ymax = 15


PlG1 = Graphics.Plot(GLP,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.016},{"LineColor",0xFF000080}},
																					 {{"LineWidth",0.016},{"LineColor",0xFF800000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

