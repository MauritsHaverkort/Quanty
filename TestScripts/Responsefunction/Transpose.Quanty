-- Determine working directory (same as the directory of the input script)
directory = debug.getinfo(1, "S").source:sub(2):match("(.*/)")


--------------
---- Real ----
--------------

-- Matrix valued
-- For physical systems A0 should be Hermitian (It can represent an Hamiltonian)
-- We here do not follow this for testing perpousous. The matrices B can be written as Bp Bp^{dag} such that G is symmetric.
-- Transpose sould leave a real G invariant
A0 = Matrix.New({{1,0,-5},{0,1,1},{5,1,1}})

B1 = Matrix.New({{1,-1/2,1/5},{-1/2,1,0},{1/5,0,2}})
B2 = Matrix.New({{1,0,0},{0,1,1},{0,1,1}})
B3 = Matrix.New({{1,0,0},{0,2,0},{0,0,3}})
B4 = Matrix.New({{1,1,0},{1,2,0},{0,0,3}})

GLP  = ResponseFunction.New( { {A0,-5,-2, 7,10}, {B1,B2,B3,B4}, mu=0, type="ListOfPoles", name="G Mat LP"} )
GTri = ResponseFunction.ChangeType(GLP,"Tri")
GAnd = ResponseFunction.ChangeType(GLP,"And")
GNat = ResponseFunction.ChangeType(GLP,"Nat")

TimeStart("Plot")
PlotPoints = 800
Emin=-10
Emax= 15
dETick=5
dYtick=10
Ymin =-20
Ymax = 15


PlG1 = Graphics.Plot(GLP,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.016},{"LineColor",0xFF000080}},
																					 {{"LineWidth",0.016},{"LineColor",0xFF800000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG2 = Graphics.Plot(GTri,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.008},{"LineColor",0xFF0000FF}},
																					 {{"LineWidth",0.008},{"LineColor",0xFFFF0000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG3 = Graphics.Plot(GAnd,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.004},{"LineColor",0xFF008080}},
																					 {{"LineWidth",0.004},{"LineColor",0xFF808000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG4 = Graphics.Plot(GNat,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.002},{"LineColor",0xFF00FFFF}},
																					 {{"LineWidth",0.002},{"LineColor",0xFFFFFF00}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})




PlG = Graphics.Add(PlG1,PlG2,PlG3,PlG4)

SVGPlG = Graphics.ToSVG(PlG,{{"RelativeSize",true}})
file = io.open(directory.."OutputPlots/Transpose.svg",'w')
file:write(SVGPlG)
file:close()
TimeEnd("Plot")

print("Green's function as list of poles")
print(GLP)

print("Green's function tridiagonal")
print(GTri)
if((GLP==GTri)~=true) then
	print("Error GLP not equal to GTri")
	print("GLP-GTri\n",ResponseFunction.ToTable(GLP-GTri))
	print("GTri-GLP\n",ResponseFunction.ToTable(GTri-GLP))
	error("Response function comparison failed\n",1)
end

print("Green's function anderson format")
print(GAnd)
if((GLP==GAnd)~=true) then
	print("Error GLP not equal to GAnd")
	print("GLP-GAnd\n",ResponseFunction.ToTable(GLP-GAnd))
	print("GAnd-GLP\n",ResponseFunction.ToTable(GAnd-GLP))
	error("Response function comparison failed\n",1)
end

print(GNat)
if((GLP==GNat)~=true) then
	print("Error GLP not equal to GTri")
	print("GLP-GNat\n",ResponseFunction.ToTable(GLP-GNat))
	print("GNat-GLP\n",ResponseFunction.ToTable(GNat-GLP))
	error("Response function comparison failed\n",1)
end

GLP  = ResponseFunction.Transpose(GLP)
GTri = ResponseFunction.Transpose(GTri)
GAnd = ResponseFunction.Transpose(GAnd)
GNat = ResponseFunction.Transpose(GNat)

TimeStart("Plot")
PlotPoints = 800
Emin=-10
Emax= 15
dETick=5
dYtick=10
Ymin =-20
Ymax = 15


PlG1 = Graphics.Plot(GLP,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.016},{"LineColor",0xFF000080}},
																					 {{"LineWidth",0.016},{"LineColor",0xFF800000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG2 = Graphics.Plot(GTri,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.008},{"LineColor",0xFF0000FF}},
																					 {{"LineWidth",0.008},{"LineColor",0xFFFF0000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG3 = Graphics.Plot(GAnd,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.004},{"LineColor",0xFF008080}},
																					 {{"LineWidth",0.004},{"LineColor",0xFF808000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG4 = Graphics.Plot(GNat,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.002},{"LineColor",0xFF00FFFF}},
																					 {{"LineWidth",0.002},{"LineColor",0xFFFFFF00}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})




PlG = Graphics.Add(PlG1,PlG2,PlG3,PlG4)

SVGPlG = Graphics.ToSVG(PlG,{{"RelativeSize",true}})
file = io.open(directory.."OutputPlots/TransposeT.svg",'w')
file:write(SVGPlG)
file:close()
TimeEnd("Plot")

print("Green's function as list of poles")
print(GLP)

print("Green's function tridiagonal")
print(GTri)
if((GLP==GTri)~=true) then
	print("Error GLP not equal to GTri")
	print("GLP-GTri\n",ResponseFunction.ToTable(GLP-GTri))
	print("GTri-GLP\n",ResponseFunction.ToTable(GTri-GLP))
	error("Response function comparison failed\n",1)
end

print("Green's function anderson format")
print(GAnd)
if((GLP==GAnd)~=true) then
	print("Error GLP not equal to GAnd")
	print("GLP-GAnd\n",ResponseFunction.ToTable(GLP-GAnd))
	print("GAnd-GLP\n",ResponseFunction.ToTable(GAnd-GLP))
	error("Response function comparison failed\n",1)
end

print(GNat)
if((GLP==GNat)~=true) then
	print("Error GLP not equal to GTri")
	print("GLP-GNat\n",ResponseFunction.ToTable(GLP-GNat))
	print("GNat-GLP\n",ResponseFunction.ToTable(GNat-GLP))
	error("Response function comparison failed\n",1)
end





-----------------
---- Complex ----
-----------------

-- Matrix valued
-- For physical systems A0 should be Hermitian (It can represent an Hamiltonian)
-- We here do not follow this for testing perpousous. The matrices B can be written as Bp Bp^{dag} such that G is symmetric.
-- Transpose sould leave a real G invariant
A0 = Matrix.New({{1,0,-5*I+1},{0,1,1},{5*I+1,1,1}})

B1 = Matrix.New({{1,-1/2*I,1/5+1/5*I},{1/2*I,1,0},{1/5-1/5*I,0,2}})
B2 = Matrix.New({{1,0,0},{0,1,I},{0,-I,1}})
B3 = Matrix.New({{1,0,0},{0,2,0},{0,0,3}})
B4 = Matrix.New({{1,1,0},{1,2,0},{0,0,3}})

GLP  = ResponseFunction.New( { {A0,-5,-2, 7,10}, {B1,B2,B3,B4}, mu=0, type="ListOfPoles", name="G Mat LP"} )
GTri = ResponseFunction.ChangeType(GLP,"Tri")
GAnd = ResponseFunction.ChangeType(GLP,"And")
GNat = ResponseFunction.ChangeType(GLP,"Nat")




TimeStart("Plot")
PlotPoints = 800
Emin=-10
Emax= 15
dETick=5
dYtick=10
Ymin =-20
Ymax = 15


PlG1 = Graphics.Plot(GLP,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.016},{"LineColor",0xFF000080}},
																					 {{"LineWidth",0.016},{"LineColor",0xFF800000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG2 = Graphics.Plot(GTri,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.008},{"LineColor",0xFF0000FF}},
																					 {{"LineWidth",0.008},{"LineColor",0xFFFF0000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG3 = Graphics.Plot(GAnd,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.004},{"LineColor",0xFF008080}},
																					 {{"LineWidth",0.004},{"LineColor",0xFF808000}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})

PlG4 = Graphics.Plot(GNat,0.0,0.5, {{"PlotPoints",PlotPoints},
														 {"LineStyle",{{},
																					 {{"LineWidth",0.002},{"LineColor",0xFF00FFFF}},
																					 {{"LineWidth",0.002},{"LineColor",0xFFFFFF00}}}},
														 {"Frame",{{"Ymin",Ymin},{"Ymax",Ymax},{"dYTick",dYtick},{"Xmin",Emin},{"Xmax",Emax},{"dXTick",dETick},{"XLabel","Energy [t]"},{"YLabel","Intensity"}}}})




PlG = Graphics.Add(PlG1,PlG2,PlG3,PlG4)

SVGPlG = Graphics.ToSVG(PlG,{{"RelativeSize",true}})
file = io.open(directory.."OutputPlots/TransposeComplex.svg",'w')
file:write(SVGPlG)
file:close()
TimeEnd("Plot")

print("Green's function as list of poles")
print(GLP)

print("Green's function tridiagonal")
print(GTri)
if((GLP==GTri)~=true) then
	print("Error GLP not equal to GTri")
	print("GLP-GTri\n",ResponseFunction.ToTable(GLP-GTri))
	print("GTri-GLP\n",ResponseFunction.ToTable(GTri-GLP))
	error("Response function comparison failed\n",1)
end

print("Green's function anderson format")
print(GAnd)
if((GLP==GAnd)~=true) then
	print("Error GLP not equal to GAnd")
	print("GLP-GAnd\n",ResponseFunction.ToTable(GLP-GAnd))
	print("GAnd-GLP\n",ResponseFunction.ToTable(GAnd-GLP))
