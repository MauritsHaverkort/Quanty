--print(GN)

Gvn = ResponseFunction.New({ {0,0}, val=ResponseFunction.New({ {0,-1,-1}, {1,1}, mu=0, type="Tri", name="Gv"}), con=Gt, mu=0, type="Nat", name="Gvn"})
