print("size 3+3 natural")
G = ResponseFunction.New({ {0,1}, val=ResponseFunction.New({ {0,-4,-5,-6}, {sqrt(1/2),2,2}, mu=0, type="Tri", name="Gv"}), con=ResponseFunction.New({ {0,3,6,7}, {sqrt(1/2),3,3}, mu=0, type="Tri", name="Gc"}), mu=0, type="Nat", name="Gcn"})
M = ResponseFunction.ToMatrix(G)
G = ResponseFunction.New({ {{{0}},{{1}}}, val=ResponseFunction.New({ {{{0}},{{-4}},{{-5}},{{-6}}}, {{{sqrt(1/2)}},{{2}},{{2}}}, mu=0, type="Tri", name="Gv"}), con=ResponseFunction.New({ {{{0}},{{3}},{{6}},{{7}}}, {{{sqrt(1/2)}},{{3}},{{3}}}, mu=0, type="Tri", name="Gc"}), mu=0, type="Nat", name="Gcn"})
M = Chop(M - ResponseFunction.ToMatrix(G),1E-15)
if not(M==Matrix.Zero(6)) then error("Response matrix comparison failed\n",1) end
O, bitmask = ResponseFunction.ToOperator(G)
if not(O.NF==bitmask.NF) then error("Responsefunction to Operator failed\n",1) end
M = Chop(OperatorToMatrix(O) - ResponseFunction.ToMatrix(G),1E-15)
if not(M==Matrix.Zero(6)) then error("Response matrix comparison failed\n",1) end

