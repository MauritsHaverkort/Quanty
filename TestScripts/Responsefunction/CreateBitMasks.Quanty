         GD_T,GD_A,GD_N,GD_U,GD_B, GD_t,GD_a,GD_n,GD_u,GD_b}

for i=1,#GList do
	GBitmask = ResponseFunction.CreateBitMasks(GList[i])
	if ( (GBitmask.NF ~= #ResponseFunction.ToMatrix(GList[i])) or (ImpurityVSBath(GBitmask.Impurity,GBitmask.Bath)==false) ) then
		print(GList[i])
		print("**"..GBitmask.Impurity.."**")
		print("**"..GBitmask.Bath.."**")
		print(ResponseFunction.CreateBitMasks(GList[i]).NF)
		print(ResponseFunction.ToMatrix(GList[i]))
	  error("Response create bitmasks failed\n",1)
	end
end



