Htb = NewTightBinding()
Htb.Cell={{1,0,0},
          {0,1,0},
          {0,0,1}}
Htb.Atoms={{"O",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"O.s","O.s",{0,0, 1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0,-1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0, 2},{{0.1,0},{0,0.1}}},
             {"O.s","O.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,4}}},U*HlocU)

StartRestrictions = {8,0,{"10101010",2,2}, {"01010101",2,2}}

TimeStart("Hubbard Eigensystem 1 states")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Hubbard Eigensystem 1 states")
TimePrint()

print("\npsiExpanded = ExpandToBasis(fun1s):")
psiExpanded = ExpandToBasis(fun1s)
print(psiExpanded)

if not compareUnorderedLists(psiExpanded, RefPsi) then error("Result not equal to the expected one\n",1) end

print("============================================")
print("        Hubbartd model 4 sites 1D           ")
print("============================================")
print("                  complex                   ")
print("============================================\n\n")

Htb = NewTightBinding()
Htb.Cell={{1,0,0},
          {0,1,0},
          {0,0,1}}
Htb.Atoms={{"O",{0,0,0},{{"s",{"^{dn}","^{up}"}}}}}
Htb.Hopping={{"O.s","O.s",{0,0, 1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0,-1},{{1  ,0},{0,1  }}},
             {"O.s","O.s",{0,0, 2},{{0.1,0},{0,0.1}}},
             {"O.s","O.s",{0,0,-2},{{0.1,0},{0,0.1}}}}

HlocU = NewOperator("Number",2,0,0)*NewOperator("Number",2,1,1)

U=3.5
Hamiltonian1 = CreateClusterHamiltonian(Htb,{"periodic",{{1,0,0},{0,1,0},{0,0,4}}},U*HlocU,{{"k",{0,0,Pi/2}}})

StartRestrictions = {8,0,{"10101010",2,2}, {"01010101",2,2}}

TimeStart("Hubbard Eigensystem 1 states")
fun1s = Eigensystem(Hamiltonian1,StartRestrictions,1)
TimeEnd("Hubbard Eigensystem 1 states")
TimePrint()

print(fun1s)

print("\npsiExpanded = ExpandToBasis(fun1s):")
psiExpanded = ExpandToBasis(fun1s)
print(psiExpanded)

if not compareUnorderedLists(psiExpanded, RefPsi) then error("Result not equal to the expected one\n",1) end


