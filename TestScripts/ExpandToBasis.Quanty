print("--                  ExpandToBasis                  --")
print("-----------------------------------------------------")

-- compare two list of wavefunctions, which are not ordered in the same way
local function compareUnorderedLists(list1, list2, threshold)
    if threshold == nil then threshold = 1E-14 end

    -- Check if the lengths are the same
    if #list1 ~= #list2 then
        return false
    end

    local n = #list2

    local idx = 0
    for i = 1, n do
        local fun = list2[i]
        for j = 1, n do
            if Chop(fun - list1[j], threshold) == 0*fun then
                idx = idx + 1
            end
        end
    end

    if idx == n then return true end
    return false
end


RefPsi = { NewWavefunction( 22, 0,{
{"0000000000001111111111", 1.000000000000000E+00}},
{{"Name","Wave Function 0000000000001111111111"},{"NBitsKey",2}}) , NewWavefunction( 22, 0,{
{"1111000000000000000000", 1.000000000000000E+00}},
{{"Name","Wave Function 1111000000000000000000"},{"NBitsKey",2}}) , NewWavefunction( 22, 0,{
{"0000111111000000000000", 1.000000000000000E+00}},
{{"Name","Wave Function 0000111111000000000000"},{"NBitsKey",2}}) }

orbitals = {"H_1s","Fe_2s","Fe_2p","Fe_3s","Fe_3d"}
groupings = { {"H_states", {"H_1s"} }, {"Fe_states", {"Fe_2s","Fe_2p","Fe_3s","Fe_3d"}} }
Ind, NF = CreateAtomicIndicesDict(orbitals,groupings)

psi = NewWavefunction(NF,0,{{DeterminantString(NF, Ind["Fe_3d"]) , 1}, {DeterminantString(NF, {0,1,2,3}), I}, {DeterminantString(NF, Ind["Fe_2p"]), 1+0.5*I}})
psi.Normalize()
print(psi)

print("\npsiExpanded = ExpandToBasis(psi):")
psiExpanded = ExpandToBasis(psi)
print(psiExpanded)

if #psiExpanded ~= #RefPsi then error("Result not equal to the expected one\n",1) end
for i = 1, #psiExpanded do
    if psiExpanded[i] ~= RefPsi[i] then error(i.."-th Result not equal to the expected one\n",1) end
end

