function MeanFieldMatrix(OppMat,rho)
    local MatMF = Matrix.ToTable(Matrix.Zero(NF))
    local shift = 0
    local c = 0
    for i=1,NF do
        for j=1,NF do
            for k=1,NF do
                for l=1,NF do
                    c = OppMat[i][j][k][l];
                    MatMF[i][k] = MatMF[i][k] - c*rho[j][l];
                    MatMF[i][l] = MatMF[i][l] + c*rho[j][k];
                    MatMF[j][k] = MatMF[j][k] + c*rho[i][l];
                    MatMF[j][l] = MatMF[j][l] - c*rho[i][k];
                    shift = shift + c*(rho[i][k]*rho[j][l] - rho[i][l]*rho[j][k]);
                end
            end
        end
    end
    return MatMF,shift
end

function AddDFTSelfInteraction(Op,Opijkl,rho)
    local Op = Clone(Op)

    local U = 0
    for i=1,NF do
        for j=1,NF do
            U = U + Opijkl[i][j][j][i]-Opijkl[i][j][i][j]
        end
    end
    U = U * 2/(NF*(NF-1))
    for i=0,NF-1 do
        for j=0,NF-1 do
            Op = Op + U*rho[i+1][j+1]*NewOperator(NF,0,{{i,-j,1}})
        end
    end
    return Op
end



for irho=1,#rho_list do

    local rho = rho_list[irho]
    setmetatable(rho,MatrixMeta)

    local label = labels[irho]
    print("\n=======================================")
    print("Density Matrix Type: "..label.."\n")


    MatOpMFTest,OpMFShift = MeanFieldMatrix(Opijkl,rho)

    OpOne = Chop(0*NewOperator(NF,0,{{0,-0,1}}))

    rhoTrace = 0
    coeffList = {}
    coeffListMF = {}
    for i=0,NF-1 do
        OpOne = OpOne + NewOperator(NF,0,{{i,-i,1}})
        rhoTrace = rhoTrace + rho[i+1][i+1]
        for j=0,NF-1 do
            coeffListMF[#coeffListMF+1] = {i,-j,MatOpMFTest[i+1][j+1]}
            for k=0,NF-1 do
                for l=0,NF-1 do
                    coeffList[#coeffList+1] = {i,j,-k,-l,Opijkl[i+1][j+1][k+1][l+1]}
                end
            end
        end
    end
    Op = NewOperator(NF,0,coeffList)
    OpMFTest = NewOperator(NF,0,coeffListMF)+OpMFShift
    ZeroOp = Chop(0*Clone(OpMFTest))


    --OpMF = MeanFieldOperator(Op,rho,{{"Offset",true}})


    print("Options: {}")

    OpMF = MeanFieldOperator(Op,rho)

    if (Chop(OpMF-OpMFTest,tol)~=ZeroOp) then
        print(Chop(OpMF-OpMFTest,tol))
        error("MeanFieldOperator does not reproduce the HF MF operator (with all options default) for "..label,1)
    end



    print("Options: {{Offset:False}}")

    OpMFTest = NewOperator(NF,0,coeffListMF)
    OpMF = MeanFieldOperator(Op,rho,{{"Offset",false}})


    if (Chop(OpMF-OpMFTest,tol)~=ZeroOp) then
			print(Op)
			print(rho)
			print(OpMF)
			print(OpMFTest)
        print(Chop(OpMF-OpMFTest,tol))
        error("MeanFieldOperator does not reproduce the HF MF operator (with OffsetAsTrace:false) for "..label,1)
    end



    print("Options: {{OffsetAsTrace:True}}")

    OpMFTest = NewOperator(NF,0,coeffListMF)
    OpMFTest = OpMFTest + OpMFShift / rhoTrace * OpOne

    OpMF = MeanFieldOperator(Op,rho,{{"OffsetAsTrace",true}})


    if (Chop(OpMF-OpMFTest,tol)~=ZeroOp) then
        print(Chop(OpMF-OpMFTest,tol))
        error("MeanFieldOperator does not reproduce the HF MF operator (with OffsetAsTrace:false) for "..label,1)
    end




    print("Options {{AddDFTSelfInteraction:True}}")

    OpMF = MeanFieldOperator(Op,rho,{{"AddDFTSelfInteraction",true}})

    OpMFTest = NewOperator(NF,0,coeffListMF)
    OpMFTest = OpMFTest + OpMFShift
    OpMFTest = AddDFTSelfInteraction(OpMFTest,Opijkl,rho)


    if (Chop(OpMF-OpMFTest,tol)~=ZeroOp) then
			print(Op)
			print(rho)
			print(OpMF)
			print(OpMFTest)
        print(Chop(OpMF-OpMFTest,tol))
        error("MeanFieldOperator does not reproduce the HF-MF operator (with AddDFTSelfInteraction:True) for "..label,1)
    end

    print("Options {{AddDFTSelfInteraction:True},{Offst:False}}")

    OpMF = MeanFieldOperator(Op,rho,{{"AddDFTSelfInteraction",true},{"Offset",false}})

    OpMFTest = NewOperator(NF,0,coeffListMF)
    OpMFTest = OpMFTest 
    OpMFTest = AddDFTSelfInteraction(OpMFTest,Opijkl,rho)

    if (Chop(OpMF-OpMFTest,tol)~=ZeroOp) then
        print(Chop(OpMF-OpMFTest,tol))
        error("MeanFieldOperator does not reproduce the HF-MF operator (with AddDFTSelfInteraction:True) for "..label,1)
    end


    print("Options {{AddDFTSelfInteraction:True},{OffstAsTrace:True}}")

    OpMF = MeanFieldOperator(Op,rho,{{"AddDFTSelfInteraction",true},{"OffsetAsTrace",true}})

    OpMFTest = NewOperator(NF,0,coeffListMF)
    OpMFTest = OpMFTest + OpMFShift / rhoTrace * OpOne
    OpMFTest = AddDFTSelfInteraction(OpMFTest,Opijkl,rho)

    if (Chop(OpMF-OpMFTest,tol)~=ZeroOp) then
        print(Chop(OpMF-OpMFTest,tol))
        error("MeanFieldOperator does not reproduce the HF-MF operator (with AddDFTSelfInteraction:True) for "..label,1)
    end
end

