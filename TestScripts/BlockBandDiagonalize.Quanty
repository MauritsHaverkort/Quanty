----------------------------------
----------------------------------
--- Case 2: Operators
----------------------------------
----------------------------------

-- Defining some operator (impurity coupled to a 1D chain)
NBath = 5
NF = 2 + 2*NBath
t = 1
U = 3
H0 = NewOperator(NF, 0, {{0, -0, 1, -1, 1}})
for i = 1, NBath do
		H0 = H0 + NewOperator(NF, 0, {{2*i,       -2*(i-1),     t}})
						+ NewOperator(NF, 0, {{2*i+1,     -(2*(i-1)+1), t}})
						+ NewOperator(NF, 0, {{2*(i-1),   -2*i,         t}})
						+ NewOperator(NF, 0, {{2*(i-1)+1, -(2*i+1),     t}})
end
-- Defining some wave functions
str1 = "11"
for i = 1, NBath do
    str1 = str1.."00"
end
str2 = "01"
for i = 1, NBath do
    if i == 3 then
		str2 = str2.."10"
    else
        str2 = str2.."00"
    end
end
psi1 = NewWavefunction(NF, 0, {{str1, 1}})
psi2 = NewWavefunction(NF, 0, {{str2, 1}})
psiList = {psi1, psi2}

