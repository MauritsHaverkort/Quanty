----------------------------------
--- Case 3: Tight-binding object
----------------------------------
----------------------------------

-- set parameters
dAB = 0.2
tnn = 1.1
-- create the tight binding Hamiltonian
HTB = NewTightBinding()
HTB.Name = "dichalcogenide tight binding"
HTB.Cell = {{sqrt(3),0,0},
            {sqrt(3/4),3/2,0},
            {0,0,1}}
HTB.Atoms = { {"A", {0,0,0},       {{"p", {"0"}}}},
              {"B", {sqrt(3),1,0}, {{"p", {"0"}}}}}
HTB.Hopping = {{"A.p","A.p",{         0,   0,0},{{-dAB/2}}},
               {"B.p","B.p",{         0,   0,0},{{ dAB/2}}},
               {"A.p","B.p",{         0,   1,0},{{ tnn  }}},
               {"B.p","A.p",{         0,  -1,0},{{ tnn  }}},
               {"A.p","B.p",{ sqrt(3/4),-1/2,0},{{ tnn  }}},
               {"B.p","A.p",{-sqrt(3/4), 1/2,0},{{ tnn  }}},
               {"A.p","B.p",{-sqrt(3/4),-1/2,0},{{ tnn  }}},
               {"B.p","A.p",{ sqrt(3/4), 1/2,0},{{ tnn  }}}
              }
-- create a cluster Hamiltonian
HCl, HClTB = CreateClusterHamiltonian(HTB, {"open", {{"A", {0,0,0}}, {"B", {sqrt(3),1,0}},
                                                     {"B", {0,1,0}},
                                                     {"B", { sqrt(3/4),-1/2,0}}, 
                                                     {"B", {-sqrt(3/4),-1/2,0}}, 
                                                     {"A", {sqrt(3),0,0}},
                                                     {"A", {sqrt(3/4), 3/2,0}},
                                                     {"A", {3*sqrt(3/4), 3/2,0}}}})
-- Defining some list of atoms for using in BlockBandDiagonalize functions
AtomsPos = {{ "A" , 
            { 0 , 0 , 0 } , 
            { { "p" , 
            { 0 } } } } , 
            { "B" , 
            { sqrt(3) , 1 , 0 } , 
            { { "p" , 
            { 0 } } } }}


-- Defining results for comparison
ResTB = NewOperator( 6, 0,{
    {    0,-   0,-1.000000000000000E-01 },
    {    0,-   2, 1.905255888325765E+00 },
    {    1,-   1, 1.000000000000000E-01 },
    {    1,-   3, 1.905255888325765E+00 },
    {    2,-   0, 1.905255888325765E+00 },
    {    2,-   2, 1.000000000000000E-01 },
    {    2,-   3, 7.333333333333335E-01 },
    {    2,-   4, 5.185449728701350E-01 },
    {    3,-   1, 1.905255888325765E+00 },
    {    3,-   2, 7.333333333333335E-01 },
    {    3,-   3,-1.000000000000000E-01 },
    {    3,-   5, 5.185449728701350E-01 },
    {    4,-   2, 5.185449728701350E-01 },
    {    4,-   4,-1.000000000000000E-01 },
    {    4,-   5, 3.666666666666668E-01 },
    {    5,-   3, 5.185449728701350E-01 },
    {    5,-   4, 3.666666666666668E-01 },
    {    5,-   5, 1.000000000000000E-01 }},
   {{"Name","Operator"},{"NBitsKey",{0,10}}})

-- Threshold for comparing the response functions
threshold = 1E-13
-- some reference frequencies
omegaList = {-1.1, -0.5463, 0.0, 4.75, 100.1}

print("-------------------------------------------------------")
print("--                     Matrix                        --")
print("-------------------------------------------------------")


blockTriMat, rotateMat = BlockBandDiagonalize(MatR, 3, {{"SingularValue", 1E-6}, {"NTri", 1000}, {"NOrtho", 1000}, {"ReOrthogonalize", true}})
resRotated = Rotate(MatR, rotateMat)
comp = resRotated - ResMatR
for i = 1, #comp do
    for j = 1, #comp[1] do
        if Chop(comp[i][j]) ~= 0 then
            error("Real matrix not equal to the expected value\n", 1)
        end
    end
end

blockTriMat, rotateMat = BlockBandDiagonalize(MatC, 3, {{"SingularValue", 1E-6}, {"NTri", 1000}, {"NOrtho", 1000}, {"ReOrthogonalize", true}})
