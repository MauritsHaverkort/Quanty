for i, omega in pairs(omegaList) do
    if Chop(blockTriMat(omega, 0.1)[1][1] - ResOpp2(omega, 0.1)[1][1], 1E-9) ~= 0 then
        error("Result for operator not equal to the expected value\n", 1)
    end
end

blockTriMat = BlockBandDiagonalize(H0, psiList, {{"SingularValue", 1E-6}, {"NTri", 1000}, {"NOrtho", 1000}, {"ReOrthogonalize", false}})
setmetatable(blockTriMat, ResponseFunctionMeta)

for i, omega in pairs(omegaList) do
    if Chop(blockTriMat(omega, 0.1)[1][1] - ResOpp1(omega, 0.1)[1][1], threshold) ~= 0 then
        error("Result for operator not equal to the expected value\n", 1)
    end
    if Chop(blockTriMat(omega, 0.1)[2][2] - ResOpp2(omega, 0.1)[1][1], 1E-9) ~= 0 then
        error("Result for operator not equal to the expected value\n", 1)
    end
end

print("---------------------------------------------------------")
print("--                     Tight-Binding                   --")
print("---------------------------------------------------------")

TBObj, RotateMat = BlockBandDiagonalize(HClTB, AtomsPos, {{"SingularValue", 1E-6}, {"NTri", 1000}, {"NOrtho", 1000}, {"ReOrthogonalize", true}})
OppObj = CreateClusterHamiltonian(TBObj, {"open", TBObj.Atoms})

if Chop(OppObj-ResTB) ~= 0*OppObj then error("Result for Tight-Binding not equal to the expected value\n", 1) end

print("-------------------------------------------------------------------------")
print("--                     Tight-Binding with SingularValue                --")
print("-------------------------------------------------------------------------")

TBObj, RotateMat = BlockBandDiagonalize(HClTB, AtomsPos, {{"SingularValue", 0.5}, {"NTri", 1000}, {"NOrtho", 1000}, {"ReOrthogonalize", true}})
OppObj = CreateClusterHamiltonian(TBObj, {"open", TBObj.Atoms})

if Chop(OppObj-ResTB) ~= 0*OppObj then error("Result for Tight-Binding not equal to the expected value\n", 1) end

print("-------------------------------------------------------------------------")
print("--                     Tight-Binding with NTri                         --")
print("-------------------------------------------------------------------------")

TBObj, RotateMat = BlockBandDiagonalize(HClTB, AtomsPos, {{"SingularValue", 1E-6}, {"NTri", 3}, {"NOrtho", 1000}, {"ReOrthogonalize", true}})
OppObj = CreateClusterHamiltonian(TBObj, {"open", TBObj.Atoms})

if Chop(OppObj-ResTB) ~= 0*OppObj then error("Result for Tight-Binding not equal to the expected value\n", 1) end

print("-------------------------------------------------------------------------")
print("--                     Tight-Binding with NOrtho                       --")
print("-------------------------------------------------------------------------")

TBObj, RotateMat = BlockBandDiagonalize(HClTB, AtomsPos, {{"SingularValue", 1E-6}, {"NTri", 1000}, {"NOrtho", 2}, {"ReOrthogonalize", true}})
OppObj = CreateClusterHamiltonian(TBObj, {"open", TBObj.Atoms})

if Chop(OppObj-ResTB) ~= 0*OppObj then error("Result for Tight-Binding not equal to the expected value\n", 1) end

print("-------------------------------------------------------------------------")
print("--                     Tight-Binding with ReOrthogonalize              --")
print("-------------------------------------------------------------------------")

TBObj, RotateMat = BlockBandDiagonalize(HClTB, AtomsPos, {{"SingularValue", 1E-6}, {"NTri", 1000}, {"NOrtho", 1000}, {"ReOrthogonalize", false}})
OppObj = CreateClusterHamiltonian(TBObj, {"open", TBObj.Atoms})

if Chop(OppObj-ResTB) ~= 0*OppObj then error("Result for Tight-Binding not equal to the expected value\n", 1) end


collectgarbage()

print("--------------------------------------------------------------")
print("--                  BlockBandDiagonalize                    --")
