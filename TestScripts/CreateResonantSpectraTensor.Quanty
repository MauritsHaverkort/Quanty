print("--------------------------------------------------------")
print("--   Create Resonant Spectra with the option Tensor   --")
print("--------------------------------------------------------")

-- CreateResonantSpectra with {"Tensor",true} returns the full RIXS tensor
--   X(A,B) = < T2_s G1 T1_i psi | G2 | T2_t G1 T1_j psi >   with A = (i,s), B = (j,t)
-- for T1 = {Tx,Ty,Tz} and T2 = {Tx^dag,Ty^dag,Tz^dag}, from which the spectrum for any
-- pair of polarization vectors follows by contraction. Tested on Ni 2p-3d RIXS (NiO like,
-- 3d8 with spin-orbit coupling and a small magnetic field), in spherical symmetry and in
-- D4h, with the dense (denseborder large) and the sparse (denseborder 0) methods:
--
-- 1. The tensor against the 81 ordinary resonant spectra of the nine combinations
--    x, y, z, x+y, y+z, z+x, x+iy, y+iz, z+ix of the in- and outgoing operator, combined
--    with Spectra.Sum into the Cartesian tensor and into the spherical tensor K basis.
-- 2. Rotations of the tensor and the powder average.
-- 3. The spectrum for a pair of polarization vectors, calculated directly, against the
--    contraction of the tensor, for high symmetry and for pseudo random real and complex
--    directions.
-- 4. The tensor of the dense method against the one of the sparse method.

-- Accuracy relative to the largest value of the spectra compared, or of the tensor. The
-- dense method agrees to 1E-14; the sparse one to 1E-13 .. 1E-11, varying with the start
-- vector of Eigensystem. A wrong tensor, as when a block Lanczos lost a direction on
-- deflation, is off by 1E-2 or more.
accuracyDense  = 1E-12
accuracySparse = 1E-9
accuracy = accuracyDense

function MaxAbs(Spec)
  local t = Spectra.ToTable(Spec)
  local m = 0
  for i=1,#t do
    for j=1,#t[i] do
      local v = t[i][j][2]
      m = math.max(m, math.sqrt(Complex.Re(v)^2 + Complex.Im(v)^2))
    end
  end
  return m
end

-- the difference of A and B relative to the largest value of B, or of Scale when given
function Check(text, A, B, Scale)
  local d = MaxAbs(A-B)/(Scale or MaxAbs(B))
  print(string.format("%-78s %.1e", text, d))
  if not (d < accuracy) then
    error("Test failed: "..text, 1)
  end
end

function cj(z) if type(z)=="number" then return z end return Conjugate(z) end
function abs2(z) if type(z)=="number" then return z*z end return Complex.Re(z)^2 + Complex.Im(z)^2 end

----------------------------------------------------------------------------------------
-- Ni 2p-3d model
----------------------------------------------------------------------------------------

n       = 8
F2dd    = 11.142
F4dd    =  6.874
F0dd    = (F2dd+F4dd)*2/63
F2pd    =  6.667
G1pd    =  4.922
G3pd    =  2.796
F0pd    = G1pd*1/15 + G3pd*3/70
tenDq   =  1.100
zeta_3d =  0.081
zeta_2p = 11.498
Bz      =  0.1

Index, NF = CreateAtomicIndicesDict({"3d","2p"})

OpU3d = F0dd * NewOperator("U", NF, Index["3d_Up"], Index["3d_Dn"], {1, 0, 0})
      + F2dd * NewOperator("U", NF, Index["3d_Up"], Index["3d_Dn"], {0, 1, 0})
      + F4dd * NewOperator("U", NF, Index["3d_Up"], Index["3d_Dn"], {0, 0, 1})
OpU2p3d = F0pd * NewOperator("U", NF, Index["2p_Up"], Index["2p_Dn"], Index["3d_Up"], Index["3d_Dn"], {1, 0}, {0, 0})
        + F2pd * NewOperator("U", NF, Index["2p_Up"], Index["2p_Dn"], Index["3d_Up"], Index["3d_Dn"], {0, 1}, {0, 0})
        + G1pd * NewOperator("U", NF, Index["2p_Up"], Index["2p_Dn"], Index["3d_Up"], Index["3d_Dn"], {0, 0}, {1, 0})
        + G3pd * NewOperator("U", NF, Index["2p_Up"], Index["2p_Dn"], Index["3d_Up"], Index["3d_Dn"], {0, 0}, {0, 1})
Oppldots_2p = NewOperator("ldots", NF, Index["2p_Up"], Index["2p_Dn"])
Oppldots_3d = NewOperator("ldots", NF, Index["3d_Up"], Index["3d_Dn"])
Opp3dSz = NewOperator("Sz", NF, Index["3d_Up"], Index["3d_Dn"])
Opp3dLz = NewOperator("Lz", NF, Index["3d_Up"], Index["3d_Dn"])

-- D4h crystal field
deltaEeg  = 0.72
deltaEt2g = -1.23
Eb1g = 3/5*tenDq-deltaEeg
Ea1g = 3/5*tenDq+deltaEeg
Eeg  = -2/5*tenDq-1/3*deltaEt2g
Eb2g = -2/5*tenDq+2/3*deltaEt2g
AkmD4h = {{0, 0, (1/5)*(Ea1g + Eb1g + Eb2g + 2*Eeg)},
          {2, 0, Ea1g - Eb1g - Eb2g + Eeg},
          {4, 0, (3/10)*(6*Ea1g + Eb1g + Eb2g - 8*Eeg)},
          {4,-4, (3/2)*sqrt(7/10)*(Eb1g - Eb2g)},
          {4, 4, (3/2)*sqrt(7/10)*(Eb1g - Eb2g)}}
HCFD4h = NewOperator("CF", NF, Index["3d_Up"], Index["3d_Dn"], AkmD4h)
HCFD4h = 1/2*(HCFD4h+ConjugateTranspose(HCFD4h))

HSO3   = zeta_3d * Oppldots_3d + OpU3d + Bz * (2 * Opp3dSz + Opp3dLz)
XASSO3 = zeta_3d * Oppldots_3d + zeta_2p * Oppldots_2p + OpU3d + OpU2p3d
Symmetries = {
  {"SO3", HSO3,          XASSO3,          HSO3},
  {"D4h", HSO3 + HCFD4h, XASSO3 + HCFD4h, HSO3 + HCFD4h},
}

-- dipole operators and the nine combinations used by the ordinary spectra
t = 1/math.sqrt(2)
Tx = NewOperator("CF", NF, Index["3d_Up"], Index["3d_Dn"], Index["2p_Up"], Index["2p_Dn"], {{1,-1,t},{1, 1,-t}})
Ty = NewOperator("CF", NF, Index["3d_Up"], Index["3d_Dn"], Index["2p_Up"], Index["2p_Dn"], {{1,-1,t*I},{1, 1,t*I}})
Tz = NewOperator("CF", NF, Index["3d_Up"], Index["3d_Dn"], Index["2p_Up"], Index["2p_Dn"], {{1,0,1}})
Tcart = {Tx, Ty, Tz}

alpha = {{1,0,0},{0,1,0},{0,0,1},{t,t,0},{0,t,t},{t,0,t},{t,t*I,0},{0,t,t*I},{t*I,0,t}}
T1Combinations = {}
T2Combinations = {}
for a=1,9 do
  T1Combinations[a] = alpha[a][1]*Tx + alpha[a][2]*Ty + alpha[a][3]*Tz
  T2Combinations[a] = ConjugateTranspose(T1Combinations[a])
end

-- energies of the spectra
Gamma1, Gamma2 = 1, 0.2
dE1, dE2 = 1, 4
E01 = -0.2 - 1/2*zeta_2p
E02 = -2
NE1 = 10
NE2 = 200
NTri = 200
function Opts(denseborder, tensor)
  local o = {{"Emin1",E01}, {"Emax1",E01+dE1}, {"NE1",NE1}, {"Gamma1",Gamma1}, {"NTri1",NTri},
             {"Emin2",E02}, {"Emax2",E02+dE2}, {"NE2",NE2}, {"Gamma2",Gamma2}, {"NTri2",NTri},
             {"denseborder",denseborder}}
  if tensor then
    o[#o+1] = {"Tensor", true}
    o[#o+1] = {"TensorBasis", "cartesian"}
  end
  return o
end

----------------------------------------------------------------------------------------
-- coefficients that combine the 81 ordinary spectra into the tensor
----------------------------------------------------------------------------------------
-- The ordinary spectrum of combination a (in) and b (out) is
--   R(a,b) = sum X(A,B) conj(alpha_ai) alpha_aj alpha_bs conj(alpha_bt)
-- so R = (M kron conj(M)) X with M[a][(i,j)] = conj(alpha_ai) alpha_aj, and X follows from
-- the inverse of the 9 by 9 matrix M. These are the tables SumTensorE1E1Cart and
-- SumTensorE1E1KHarmonics of Michelangelo Tagliavini (calculated with Mathematica),
-- which they reproduce to rounding (as used, i.e. after the conjugation his script applied).
-- Component index of the tensor: 9*(A-1)+B with A = 3*(i-1)+s, spectrum index of the
-- ordinary spectra: 9*(a-1)+b.

M = {}
for a=1,9 do
  M[a] = {}
  for i=1,3 do for j=1,3 do M[a][3*(i-1)+j] = cj(alpha[a][i])*alpha[a][j] end end
end
setmetatable(M, MatrixMeta)
Mi = Inverse(M)

SumCart = {}
for i=1,3 do for s=1,3 do for j=1,3 do for tt=1,3 do
  local c = 9*(3*(i-1)+s-1) + 3*(j-1)+tt
  SumCart[c] = {}
  for a=1,9 do for b=1,9 do
    SumCart[c][9*(a-1)+b] = Mi[3*(i-1)+j][a] * cj(Mi[3*(s-1)+tt][b])
  end end
end end end end

-- the spherical tensor K basis: X'(A',B') = sum U(A',A) X(A,B) conj(U(B',B))
UCartToSphK = CoupledCartesianToSphericalTensorKMatrix(1,1)
SumSphK = {}
for Ap=1,9 do for Bp=1,9 do
  local c = 9*(Ap-1)+Bp
  SumSphK[c] = {}
  for r=1,81 do SumSphK[c][r] = 0 end
  for A=1,9 do for B=1,9 do
    local w = UCartToSphK[Ap][A]*cj(UCartToSphK[Bp][B])
    if abs2(w) > 0 then
      for r=1,81 do SumSphK[c][r] = SumSphK[c][r] + w*SumCart[9*(A-1)+B][r] end
    end
  end end
end end

-- the same coefficients for every incident energy, in the form Spectra.Sum takes them
function PerIncidentEnergy(Sum)
  local S = {}
  for c=1,#Sum do
    for k=1,NE1+1 do
      local row = {}
      for r=1,#Sum[c] do
        for l=1,NE1+1 do
          row[(r-1)*(NE1+1)+l] = (l==k) and Sum[c][r] or 0
        end
      end
      S[(c-1)*(NE1+1)+k] = row
    end
  end
  return S
end
SumCartNE1 = PerIncidentEnergy(SumCart)
SumSphKNE1 = PerIncidentEnergy(SumSphK)

-- powder average in the spherical tensor K basis: the diagonal of each rank K = 0, 1, 2
-- averaged over its 2K+1 components, all other components zero
Rank = {0, 1, 1, 1, 2, 2, 2, 2, 2}
SumPowder = {}
for A=1,9 do for B=1,9 do
  local c = 9*(A-1)+B
  SumPowder[c] = {}
  for r=1,81 do SumPowder[c][r] = 0 end
  if A==B then
    for Ap=1,9 do
      if Rank[Ap]==Rank[A] then SumPowder[c][9*(Ap-1)+Ap] = 1/(2*Rank[A]+1) end
    end
  end
end end
SumPowderNE1 = PerIncidentEnergy(SumPowder)

----------------------------------------------------------------------------------------
-- polarization vectors, high symmetry and pseudo random, test k uses in = k and out = k+1
----------------------------------------------------------------------------------------
function Normalized(v)
  local norm = 0
  for i=1,3 do norm = norm + abs2(v[i]) end
  norm = math.sqrt(norm)
  -- real entries stay Lua numbers, so the contraction is tested with numbers, Complex and a mix
  return {v[1]/norm, v[2]/norm, v[3]/norm}
end
Polarizations = {
  {"(1,0,0)",      Normalized({1, 0, 0})},
  {"(0,0,1)",      Normalized({0, 0, 1})},
  {"(1,1,0)",      Normalized({1, 1, 0})},
  {"(1,1,1)",      Normalized({1, 1, 1})},
  {"(1,i,0)",      Normalized({1, I, 0})},
  {"(1,2,3)",      Normalized({1, 2, 3})},
  {"(0.3+0.7i,-1.1+0.2i,0.5-0.9i)", Normalized({0.3+0.7*I, -1.1+0.2*I, 0.5-0.9*I})},
}

----------------------------------------------------------------------------------------
-- the tests
----------------------------------------------------------------------------------------
for _, Sym in ipairs(Symmetries) do
  local name, H, XAS, fin = Sym[1], Sym[2], Sym[3], Sym[4]
  local psi = Eigensystem(H, {NF, 0, {"1111111111 111111",6+n,6+n}, {"1111111111 000000",n,n}}, 1, {{"Epsilon",1E-12},{"Zero",1E-12}})
  local Tensor = {}
  for _, Method in ipairs({{"dense", 1000000, accuracyDense}, {"sparse", 0, accuracySparse}}) do
    local label = name.." "..Method[1]..": "
    accuracy = Method[3]
    local X = CreateResonantSpectra(XAS, fin, Tcart, {ConjugateTranspose(Tx), ConjugateTranspose(Ty), ConjugateTranspose(Tz)}, psi, Opts(Method[2], true))
    local XK = Rotate(X, Conjugate(UCartToSphK), {{"TensorBasis","SphericalTensorK"}})
    Tensor[Method[1]] = X
    MaxX = MaxAbs(X)

    -- 1. the tensor from the ordinary spectra of the nine combinations
    local Raw = CreateResonantSpectra(XAS, fin, T1Combinations, T2Combinations, psi, Opts(Method[2], false))
    Check(label.."tensor = combination of the 81 ordinary spectra, Cartesian",    X,  Spectra.Sum(Raw, table.unpack(SumCartNE1)))
    Check(label.."tensor = combination of the 81 ordinary spectra, spherical K",  XK, Spectra.Sum(Raw, table.unpack(SumSphKNE1)))

    -- 2. rotations and powder average
    Check(label.."rotation to spherical K and back",              X, Rotate(Rotate(X, UCartToSphK), ConjugateTranspose(UCartToSphK)))
    Check(label.."rotation by the identity",                      X, Rotate(X, Matrix.Identity(9)))
    local PowderK = XK.GetPowderTensor()
    Check(label.."powder average in spherical K = sum over each rank K",  PowderK, Spectra.Sum(XK, table.unpack(SumPowderNE1)))
    Check(label.."powder average in Cartesian = in spherical K rotated back", X.GetPowderTensor(), Rotate(PowderK, ConjugateTranspose(UCartToSphK), {{"TensorBasis","cartesian"}}))

    -- 3. direct spectra for pairs of polarization vectors against the contracted tensor
    for k=1,#Polarizations do
      local In, Out = Polarizations[k], Polarizations[k % #Polarizations + 1]
      local Ein, Eout = In[2], Out[2]
      local TIn  = Ein[1]*Tx + Ein[2]*Ty + Ein[3]*Tz
      local TOut = cj(Eout[1])*ConjugateTranspose(Tx) + cj(Eout[2])*ConjugateTranspose(Ty) + cj(Eout[3])*ConjugateTranspose(Tz)
      -- relative to the size of the tensor, as a polarization can be close to a selection rule
      local Direct = CreateResonantSpectra(XAS, fin, TIn, TOut, psi, Opts(Method[2], false))
      Check(label.."in "..In[1].." out "..Out[1]..", Cartesian tensor",   X.ContractSpectraTensorWithPolarization(Ein, Eout),  Direct, MaxX)
      Check(label.."in "..In[1].." out "..Out[1]..", spherical K tensor", XK.ContractSpectraTensorWithPolarization(Ein, Eout), Direct, MaxX)
    end
  end
  -- 4. dense against sparse
  accuracy = accuracySparse
  Check(name..": tensor of the sparse method = tensor of the dense method", Tensor["sparse"], Tensor["dense"])
end
