FPLOOut = FileReadDresdenFPLO(script_path().."DFT/NiO/out.wan")
TB = TightBindingDefFromDresdenFPLO(FPLOOut)
NewCluster = FindAllAtomsInsideSphere(TB.Atoms,TB.Cell,{0,0,0},4.1)
print("Generated cluster:")
print(NewCluster)

if not compareClusters(NewCluster, RefCluster) then error("Clusters not equal to the expected one\n",1) end

