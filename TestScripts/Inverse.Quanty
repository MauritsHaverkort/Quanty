M0_inv = Inverse(M0)

for i=1,#M0 do
    for j=1,#M0[i] do
       if not (math.abs(M0_inv[i][j]-M0_inv_test[i][j])<tol) then 
            print(i,j,M0_inv[i][j],M0_inv_test[i][j])
            error("Inverse does not agree with Mathematica",1) 
        end
    end
end