-- Set the dimension of the one-particle Hilbert space and add meaning to the one particle basis
 
NF=14
NB=0
IndexDn_4f={0,2,4,6,8,10,12}
IndexUp_4f={1,3,5,7,9,11,13}

-- define the operator G(k,q)
function OppG (k, q, IndexDn, IndexUp)
	local G=0
	for m1=-3,3 do
		for m2=-3,3 do
			G = G + NewOperator(NF,NB,{{IndexDn[m1+4],-IndexDn[m2+4],(-1)^(3-m1)*ThreeJSymbol({3,-m1},{k,q},{3,m2})}
																,{IndexUp[m1+4],-IndexUp[m2+4],(-1)^(3-m1)*ThreeJSymbol({3,-m1},{k,q},{3,m2})}})
		end
	end
	return Chop(G)
end

-- Defene the dot product between operator G(k,q) and G(k,q)
function OppGG(k, IndexDn, IndexUp)
	local G=0
	for q=-k,k do
		G = G + ((-1)^q) * OppG(k, q, IndexDn, IndexUp) * OppG(k,-q, IndexDn, IndexUp)
  end
	return Chop(G)
end

-- Define the 3 Casimir operators
OppCSO7 = OppGG(1,IndexDn_4f,IndexUp_4f) + OppGG(3,IndexDn_4f,IndexUp_4f) + OppGG(5,IndexDn_4f,IndexUp_4f)
OppCG2  = OppGG(1,IndexDn_4f,IndexUp_4f) + OppGG(5,IndexDn_4f,IndexUp_4f)
OppCSO3 = OppGG(1,IndexDn_4f,IndexUp_4f)
-- Give them a name for printing
OppCSO3.Name = "C SO3"
OppCG2.Name = "C G2 "
OppCSO7.Name = "C SO7"

-- The operator to add to the multiplet splitting is
-- alpha' * OppCSO3 + beta' * OppCG2 + gamma' * OppCSO7

-- Warning!!! any scaling of these operators are valid in the fit.
-- For the k=1 Casimir operator, i.e. G^{(1)} . G^{(1)} we do not fit agains
-- alpha' OppCSO3 but to alpha * OppLsqr
-- and L^2 = 12 * 7 * OppCSO3, so alpha = alpha' / (12*7)
-- The relation between beta' and beta and gamma' and gamma is probalby author dependent.
-- given the wide variety of definitions for the crystal field parameters and scalings there.


-- Some tests

-- for k=1 the operators G(k,q) span the same space as the angular momentum operators
print("====================")

OppLx   = NewOperator("Lx"   ,NF, IndexUp_4f, IndexDn_4f)
OppLy   = NewOperator("Ly"   ,NF, IndexUp_4f, IndexDn_4f)
OppLz   = NewOperator("Lz"   ,NF, IndexUp_4f, IndexDn_4f)
OppLsqr = NewOperator("Lsqr" ,NF, IndexUp_4f, IndexDn_4f)

OppSx   =NewOperator("Sx"   ,NF, IndexUp_4f, IndexDn_4f)
OppSy   =NewOperator("Sy"   ,NF, IndexUp_4f, IndexDn_4f)
OppSz   =NewOperator("Sz"   ,NF, IndexUp_4f, IndexDn_4f)
OppSsqr =NewOperator("Ssqr" ,NF, IndexUp_4f, IndexDn_4f)

HLSLzSz = 10 * OppSsqr + 0.1 * OppLsqr + 0.001 * OppSz + 0.00001 * OppLz
HLSLzSz.Name = "H    "
H = 10 * OppSsqr + 0.1 * OppLsqr + 0.001 * OppSz + 0.00001 * OppLz + 0.0000001 * OppCG2 + 0.000000001 * OppCSO7
H.Name = "H    "

print("Test that G(k=1, q=0)* sqrt(3 * (3+1) * (2*3+1) is equal to Lz")
if(Chop(OppG(1, 0,IndexDn_4f,IndexUp_4f) * sqrt(3 * (3+1) * (2*3+1) )-OppLz) == Chop(0*OppLz)) then
	print("OK")
else
	error("Test not passed")
end

print("Test that G(k=1, q=-1)* sqrt(3 * (3+1) * (2*3+1) is equal to sqrt(1/2)*Lmin")
if(Chop(OppG(1, -1,IndexDn_4f,IndexUp_4f) * sqrt(3 * (3+1) * (2*3+1) )-sqrt(1/2)*(OppLx - I * OppLy),1E-14) == Chop(0*OppLz)) then
	print("OK")
else
	error("Test not passed")
end

print("Test that G(k=1, q=1)* sqrt(3 * (3+1) * (2*3+1) is equal to sqrt(1/2)*Lplus")
if(Chop(OppG(1, 1,IndexDn_4f,IndexUp_4f) * sqrt(3 * (3+1) * (2*3+1) )-sqrt(1/2)*(-OppLx - I * OppLy),1E-14) == Chop(0*OppLz)) then
	print("OK")
else
	error("Test not passed")
end

print("Test that 12*7* G(k=1) . G(k=1) is equal to L^2")
if(Chop(12*7*OppGG(1,IndexDn_4f,IndexUp_4f)-OppLsqr,1E-14) == Chop(0*OppLz)) then
	print("OK")
else
	error("Test not passed")
end

print("Commutator tests Note that F[k] does not commute with F[k' != k] for k>0 and that C(G2) and C(SO7) do not commute with F[k>0]")
OppF0 =NewOperator("U", NF, IndexUp_4f, IndexDn_4f, {1,0,0,0})
OppF2 =NewOperator("U", NF, IndexUp_4f, IndexDn_4f, {0,1,0,0})
OppF4 =NewOperator("U", NF, IndexUp_4f, IndexDn_4f, {0,0,1,0})
OppF6 =NewOperator("U", NF, IndexUp_4f, IndexDn_4f, {0,0,0,1})
OppF0.Name = "F 0  "
OppF2.Name = "F 2  "
OppF4.Name = "F 4  "
OppF6.Name = "F 6  "
OppList  = {OppCSO3, OppCG2,  OppCSO7, OppF0,   OppF2,   OppF4,   OppF6, HLSLzSz}
function QCommutes(Opp1,Opp2)
	return (Chop(Opp1*Opp2 - Opp2*Opp1,1E-13)==Chop(0*Opp1))
end
for i=1,#OppList do
	for j=i,#OppList do
		if not(QCommutes(OppList[i],OppList[j])) then
			print("Operator "..OppList[i].Name.." and "..OppList[j].Name.." do not commute")
		end
	end
end

print("test within a f^n configuration")

-- For n=2 you find that you can uniquely label each state by L S Lz Sz
-- For n=3 there are configurations with different coulomb energy but the same values for L S Lz Sz.
--  These configurations can be labeled by different expectation values of C(G2) and C(SO7)

n=3
DimH = Binomial(14,n)
StartRestrictions = {NF, NB, {"11111111111111",n,n}}
psiList = Eigensystem(H, StartRestrictions, DimH,{{"DenseBorder",DimH+1}})
OppList = {OppSsqr,OppLsqr,OppSz,OppLz,OppF0,OppF2,OppF4,OppF6,OppCSO3,OppCG2,OppCSO7}
PrintExpectationValues(psiList,OppList)
