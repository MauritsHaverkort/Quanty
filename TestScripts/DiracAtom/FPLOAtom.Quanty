local failed = false
local function check(ok, text)
  print((ok and "ok    " or "FAILED") .. "  " .. text)
  if not ok then failed = true end
end
local a0fm = PhysicalConstants.a0.value*1e15
local G, F, A = CalculateAtomicBasisFunctions(75, {{"Configuration", "[Xe] 4f14 5d3/2(4) 5d5/2(1) 6s2"}, {"Method", "LDA"},
    {"Nucleus", "Uniform"}, {"Rrms", math.sqrt(3/5)*6.90765721/a0fm}})
check(A.Converged and #A.Orbitals == 22, string.format("Re LDA (PW92) Dirac atom, Etot %.8f, %d orbitals", A.Etot, #A.Orbitals))
for i, o in ipairs(A.Orbitals) do
  local r = fplo[o.Label]
  local wG = 0
  for _, p in ipairs(r.GF) do wG = math.max(wG, math.abs(G[i](p[1]) - p[2]), math.abs(F[i](p[1]) - p[3])) end
  check(math.abs(o.Energy - r.E) < 1e-6 and wG < 2e-5, string.format("%-6s eps %16.8f, FPLO %16.8f, %+.1e; max |G, F - FPLO| %.1e", o.Label, o.Energy, r.E, o.Energy - r.E, wG))
end
if failed then error("Re against FPLO: checks failed", 1) end
print("passed")
