--[[
 *  DFT stage A5, check 12 (Doc/Claude/QuantyDFT_StageA, design section 12) and the AU path:
 *  NewOperator("Dirac", ...) and NewOperator("AU", ...) for radial functions of type
 *  DKBSpline (DFT/LuaAtomicOperators.cpp), exact on the shared knot set.
 *  - Check 12: for the bare-nucleus eigen-orbitals (CalculateAtomicBasisFunctions without
 *    electrons; s, p, d, three each;
 *    Fe point nucleus, U Gaussian nucleus with the same Nucleus option) the Dirac operator is
 *    diagonal with the eigenvalues: measured |H_aa - eps_a| <= 3.7e-15 |eps_a| (checked
 *    1e-13) and |H_ab| <= 2.2e-12 max |eps| (the eigenvector noise of the dense solver;
 *    checked 1e-10).
 *  - Closed shells: <det|H0 + U|det> of the Dirac-Fock determinant equals the Hartree-Fock
 *    Etot (Ne, Ar).
 *  - Open shells: the mean of <det|H0 + U|det> over all determinants of the nonrelativistic
 *    configuration is, by definition, the configuration-average energy; Quanty's angular
 *    algebra reproduces the E_av of AtomHF.cpp (Gamma^k, pair counts of design 8.1-8.3) for
 *    Li 2s, O 2p4 (15 determinants), Fe 3d6 4s2 (210) and Pd+ 4d9 (10, 3d and 4d of one
 *    kappa): measured <= 2.4e-15 |E| (checked 1e-13 |E|).
 *  - Errors: functions made with another c, DKBSpline mixed with other types, a Nucleus
 *    option for grid functions. The options of the AU path: NewOperatorAUCore.Quanty.
]]

local failed = false
local function check(ok, text)
  print((ok and "ok    " or "FAILED") .. "  " .. text)
  if not ok then failed = true end
end

-- check 12
local function bare(Z, nucopts, label)
  local o = {{"Configuration", "1s0 2s0 3s0 2p0 3p0 4p0 3d0 4d0 5d0"}}
  for _, v in ipairs(nucopts) do o[#o+1] = v end
  local G, F, A = CalculateAtomicBasisFunctions(Z, o)
  local labels, E = A.Labels, {}
  for o, orb in ipairs(A.Orbitals) do E[o] = orb.Energy end
  local indices, NF = CreateAtomicIndicesList(labels, {{"Kappas", true}})
  local M = OperatorToMatrix(NewOperator("Dirac", NF, Z, indices, G, F, nucopts))
  local diag, off, scale = 0, 0, 0
  for o = 1, #labels do
    local i = indices[o][1] + 1
    diag = math.max(diag, math.abs(M[i][i] - E[o])/math.abs(E[o]))
    scale = math.max(scale, math.abs(E[o]))
  end
  for i = 1, NF do for j = 1, NF do if i ~= j then off = math.max(off, math.abs(M[i][j])) end end end
  check(diag < 1e-13 and off < 1e-10*scale,
        string.format("%s: max |H_aa - eps_a|/|eps_a| %.1e, max |H_ab|/max|eps| %.1e (%d orbitals)", label, diag, off/scale, #labels))
  return G, F, indices, NF
end
local Gb, Fb, indb, NFb = bare(26, {{"Nucleus", "Point"}}, "Fe point nucleus")
bare(92, {{"Nucleus", "Gaussian"}, {"A", 238}}, "U Gaussian nucleus")

-- the energy of determinants
local function atom(Z, conf)
  local G, F, A = CalculateAtomicBasisFunctions(Z, {{"Configuration", conf}, {"Nucleus", "Point"}})
  local labels = {}
  for i, o in ipairs(A.Orbitals) do labels[i] = o.Label end
  local indices, NF = CreateAtomicIndicesList(labels, {{"Kappas", true}})
  return A, NewOperator("Dirac", NF, Z, indices, G, F) + NewOperator("AU", NF, indices, G, F), indices, NF
end
local function determinants(A, indices, NF)
  -- closed nl shells full, every open nl shell all subsets of its q electrons
  local shells, order = {}, {}
  for i, o in ipairs(A.Orbitals) do
    local key = o.n .. "_" .. o.l
    if shells[key] == nil then shells[key] = {q = 0, idx = {}}; order[#order+1] = key end
    shells[key].q = shells[key].q + o.Occupation
    for _, k in ipairs(indices[i]) do table.insert(shells[key].idx, k) end
  end
  local base = {}
  for k = 1, NF do base[k] = "0" end
  local dets = {base}
  for _, key in ipairs(order) do
    local s, new = shells[key], {}
    local q = math.floor(s.q + 0.5)
    for _, d0 in ipairs(dets) do
      local cur = {}
      for k = 1, NF do cur[k] = d0[k] end
      local function rec(start, left)
        if left == 0 then local d = {} for k = 1, NF do d[k] = cur[k] end new[#new+1] = d return end
        for m = start, #s.idx - left + 1 do cur[s.idx[m]+1] = "1"; rec(m + 1, left - 1); cur[s.idx[m]+1] = "0" end
      end
      rec(1, q)
    end
    dets = new
  end
  return dets
end
for _, a in ipairs({{10, "[He] 2s2 2p6"}, {18, "[Ne] 3s2 3p6"}, {3, "1s2 2s1"}, {8, "1s2 2s2 2p4"}, {26, "[Ar] 3d6 4s2"}, {46, "[Kr] 4d9"}}) do
  local A, H, indices, NF = atom(a[1], a[2])
  local dets, sum = determinants(A, indices, NF), 0
  for _, d in ipairs(dets) do
    local psi = NewWavefunction(NF, 0, {{table.concat(d), 1}})
    sum = sum + psi*H*psi
  end
  local d = sum/#dets - A.Etot
  check(math.abs(d) < 1e-13*math.abs(A.Etot),
        string.format("Z = %2d %-14s mean of %3d determinants - Hartree-Fock E_av %+.1e (E_av %.10f)", a[1], a[2], #dets, d, A.Etot))
end

-- errors
local function fails(f, text)
  local ok, message = pcall(f)
  check(not ok, text .. ": " .. string.gsub(tostring(message), "\n", ""))
end
local c0 = PhysicalConstants.cAU.value
PhysicalConstants.cAU.value = 137
fails(function() return NewOperator("Dirac", NFb, 26, indb, Gb, Fb) end, "another c")
PhysicalConstants.cAU.value = c0
local x, y = {}, {}
for i = 0, 40 do x[i+1] = 20*(i/40)^2; y[i+1] = x[i+1]*math.exp(-x[i+1]) end
local bs = InterpolatingFunction.BSpline(x, y, 5)
local Gm, Fm = {}, {}
for i = 1, #Gb do Gm[i] = Gb[i]; Fm[i] = Fb[i] end
Gm[2] = bs
fails(function() return NewOperator("Dirac", NFb, 26, indb, Gm, Fm) end, "DKBSpline mixed with BSpline")
Gm[2] = Gb[2]; Gm[1] = bs
fails(function() return NewOperator("Dirac", NFb, 26, indb, Gm, Fm) end, "BSpline first, then DKBSpline")
fails(function() return NewOperator("AU", NFb, indb, Gm, Fm) end, "AU: BSpline first, then DKBSpline")
local i1, NF1 = CreateAtomicIndicesList({"1s1/2"}, {{"Kappas", true}})
fails(function() return NewOperator("Dirac", NF1, 1, i1, {bs}, {bs}, {{"Nucleus", "Gaussian"}, {"A", 1}}) end, "Nucleus option for grid functions")

if failed then error("NewOperator with DKBSpline functions: checks failed", 1) end
print("passed")
