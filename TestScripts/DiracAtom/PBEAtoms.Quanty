--[[
 *  DFT stage A, check 10 (QuantyDFT_StageA_DiracAtom.md in Doc/Agents, design section 12): the GGA atom.
 *  Reference: fully numerical (finite-element, microhartree) total energies of
 *  S. Lehtola, Phys. Rev. A 101, 012516 (2020), arXiv:1908.02528, Table 1: VWN (= NIST LDA)
 *  and "a PBE functional based on VWN correlation", here Method "PBE-VWN" (PBE exchange,
 *  PBE gradient correction of the correlation on VWN5), nonrelativistic, point nucleus.
 *  Checked, nonrelativistic (Schroedinger), with ResidualTolerance 1e-10 (LDA) and 1e-9 (GGA):
 *  - Etot to 1e-6 Ha (the 6 decimals of the table) for He, Be, Ne, Mg, Ar, Ca, Zn, Kr,
 *    both LDA-VWN and PBE-VWN (all agree to 6.1e-7);
 *  - the two total-energy expressions (direct, and through the eigenvalue sum): their
 *    difference is first order in the potential residual, |dE| <= sqrt(N) |R_v| with
 *    |R_v| = Atom.PotentialResidual (density-weighted, reported in both mixing modes);
 *    checked as |dE| <= 2 sqrt(N) |R_v|. Measured in 30 runs, both modes, LDA and GGA,
 *    Schroedinger and Dirac: |dE|/(sqrt(N) |R_v|) <= 0.92. Measured |dE| <= 2e-9 for the
 *    Lehtola rows (design: 1e-9; the GGA residual has a floor of a few 1e-10).
 *  "LDA" (Slater + PW92) and "PBE" (on PW92) have no independent reference here (the PW92
 *  parameters could not be checked against libxc); for Ne, Dirac and Schroedinger, only
 *  convergence and the same bound are checked. The GGAs use density mixing by default:
 *  mixing the potential does not converge the Dirac GGA (the GGA potential near the
 *  nucleus, with n'/r, reacts too strongly to the input). There the potential residual
 *  stays at 1e-4 (in a tiny region at the nucleus), so the bound is weak; the check for
 *  the Dirac GGA is that it converges. (A fixed 1e-8 on |dE| failed on lin0 with MKL:
 *  1.5e-8 against 2.4e-9 with Accelerate, the same residual.)
]]

local lehtola = {
  {2,  "1s2",               -2.834836,    -2.893287},
  {4,  "1s2 2s2",           -14.447209,   -14.630525},
  {10, "[He] 2s2 2p6",      -128.233481,  -128.869661},
  {12, "[Ne] 3s2",          -199.139406,  -199.958820},
  {18, "[Ne] 3s2 3p6",      -525.946195,  -527.352025},
  {20, "[Ar] 4s2",          -675.742283,  -677.355243},
  {30, "[Ar] 3d10 4s2",     -1776.573850, -1779.194575},
  {36, "[Ar] 3d10 4s2 4p6", -2750.147940, -2753.430126}}

local failed = false
local function check(ok, text)
  print((ok and "ok    " or "FAILED") .. "  " .. text)
  if not ok then failed = true end
end
local common = {{"Nucleus", "Point"}, {"MaxIterations", 400}}
-- the Atom table (and G, F) of CalculateAtomicBasisFunctions
local function CalculateAtom(Z, configuration, options)
  local o = {{"Configuration", configuration}}
  for _, v in ipairs(options or {}) do o[#o+1] = v end
  local G, F, A = CalculateAtomicBasisFunctions(Z, o)
  return A, G, F
end
local function options(extra)
  local o = {}
  for _, v in ipairs(common) do o[#o+1] = v end
  for _, v in ipairs(extra) do o[#o+1] = v end
  return o
end

for _, a in ipairs(lehtola) do
  for k, m in ipairs({"LDA-VWN", "PBE-VWN"}) do
    -- the eigenvalue-sum expression differs from Etot to first order in the residual: an LDA
    -- converges easily to 1e-10, the GGA to 1e-9 (its residual floor is a few 1e-10)
    local A = CalculateAtom(a[1], a[2], options({{"Method", m}, {"Relativistic", false}, {"MixDensity", false},
                                                 {"ResidualTolerance", (k == 1) and 1e-10 or 1e-9}}))
    local d = A.Etot - a[2+k]
    local dE = A.EtotEigenvalueSum - A.Etot
    check(A.Converged and math.abs(d) < 1e-6 and math.abs(dE) < 2*math.sqrt(a[1])*A.PotentialResidual,
          string.format("Z = %2d %-7s Etot = %.6f (Lehtola %.6f) %+.1e, eigenvalue-sum expression %+.1e (bound %.1e), %d iterations",
                        a[1], m, A.Etot, a[2+k], d, dE, math.sqrt(a[1])*A.PotentialResidual, A.Iterations))
  end
end

-- LDA and PBE on PW92, Ne: no reference, convergence and consistency
for _, m in ipairs({"LDA", "PBE"}) do
  for _, rel in ipairs({false, true}) do
    local A = CalculateAtom(10, "[He] 2s2 2p6", options({{"Method", m}, {"Relativistic", rel}, {"ResidualTolerance", (m == "PBE") and 1e-8 or 1e-9}}))
    local dE = A.EtotEigenvalueSum - A.Etot
    check(A.Converged and math.abs(dE) < 2*math.sqrt(10)*A.PotentialResidual,
          string.format("Ne %-3s %-13s Etot = %.6f, eigenvalue-sum expression %+.1e (bound %.1e), %d iterations", m, rel and "Dirac" or "Schroedinger",
                        A.Etot, dE, math.sqrt(10)*A.PotentialResidual, A.Iterations))
  end
end

-- the default mixing: density for the GGAs, potential for the LDAs; an explicit option wins
local defaults = {{"PBE", true}, {"PBE-VWN", true}, {"LDA", false}, {"LDA-VWN", false}, {"RLDA-MV", false}}
local okDefault = true
for _, d in ipairs(defaults) do
  local A = CalculateAtom(2, "1s2", options({{"Method", d[1]}, {"Relativistic", false}}))
  if A.MixDensity ~= d[2] or not A.Converged then okDefault = false end
end
local B = CalculateAtom(2, "1s2", options({{"Method", "PBE"}, {"Relativistic", false}, {"mixdensity", false}}))
check(okDefault and B.MixDensity == false, "default mixing: density for PBE, PBE-VWN, potential for the LDAs; {\"MixDensity\", false} wins")

-- configurations
local A = CalculateAtom(10, "1s2, 2s2, 2p6", options({{"Method", "LDA-VWN"}, {"Relativistic", false}}))
check(math.abs(A.Etot + 128.233481) < 1e-6 and #A.Orbitals == 3, string.format("Ne written out with commas: %.6f", A.Etot))
A = CalculateAtom(10, "[He] 2s2 2p6", options({{"Method", "LDA-VWN"}}))
check(#A.Orbitals == 4 and A.Orbitals[4].Label == "2p3/2" and math.abs(A.Orbitals[4].Occupation - 4) < 1e-15 and math.abs(A.Orbitals[3].Occupation - 2) < 1e-15,
      "Dirac: 2p6 -> 2p3/2 with 4, 2p1/2 with 2 electrons")
local function fails(f, text)
  local ok, message = pcall(f)
  check(not ok, text .. ": " .. string.gsub(tostring(message), "\n", ""))
end
fails(function() return CalculateAtom(10, "1s2 2s2 2p7") end, "2p7")
fails(function() return CalculateAtom(10, "1s2 1s2") end, "1s twice")
fails(function() return CalculateAtom(10, "1p2") end, "1p")
fails(function() return CalculateAtom(10, "[Ne", {{"Nucleus", "Point"}}) end, "[Ne")
fails(function() return CalculateAtom(10, "[He] 2s2 2p6", {{"Nucleus", "Point"}, {"Method", "B3LYP"}}) end, "unknown method")

if failed then error("Kohn-Sham GGA atom checks failed", 1) end
print("passed")
