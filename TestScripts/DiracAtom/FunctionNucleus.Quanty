--[[
 *  DFT stage A, check 13, spherical part (Doc/Claude/QuantyDFT_StageA, design section 12):
 *  Nucleus "Function" given the Gaussian density rho(r) = Z (zeta/pi)^(3/2) exp(-zeta r^2),
 *  zeta = 3/(2 Rrms^2), for U (Z = 92, A = 238). The potential comes from the radial
 *  Poisson equation (Galerkin, B-splines) and must equal the analytic -Z erf(sqrt(zeta) r)/r
 *  of Nucleus "Gaussian", and the orbital energies those of the "Gaussian" run, both to
 *  1e-10 relative, on the same knots (160 intervals, rMin = Rrms/50).
 *  A density normalized to 1.01 Z gives a warning, is rescaled to Z, and gives the same
 *  energies. Unsupported combinations of options give errors.
]]

local Z, A = 92, 238
local a0fm = PhysicalConstants.a0.value*1e15
local Rrms = (0.836*A^(1/3) + 0.570)/a0fm
local zeta = 1.5/Rrms^2
local function rho(r) return Z*(zeta/math.pi)^1.5*math.exp(-zeta*r*r) end
local common = {{"NIntervals", 160}, {"rMin", Rrms/50}, {"rMax", 60/math.sqrt(Z)}}
local function options(extra)
  local o = {}
  for _, v in ipairs(common) do o[#o+1] = v end
  for _, v in ipairs(extra) do o[#o+1] = v end
  return o
end

local failed = false
local function check(ok, text)
  print((ok and "ok    " or "FAILED") .. "  " .. text)
  if not ok then failed = true end
end

for _, kappa in ipairs({-1, 1, -2}) do
  local Eg, _, _, Ig = DiracRadialSolve(Z, kappa, options({{"Nucleus", "Gaussian"}, {"Rrms", Rrms}}))
  local Ef, _, _, If = DiracRadialSolve(Z, kappa, options({{"Nucleus", "Function"}, {"Density", rho}}))
  if kappa == -1 then
    local dV = 0
    for i = 1, #Ig.V do dV = math.max(dV, math.abs(If.V[i]/Ig.V[i] - 1)) end
    check(dV < 1e-10, string.format("max |V_Function/V_Gaussian - 1| = %.1e over %d quadrature points", dV, #Ig.V))
    check(math.abs(If.Nucleus.DensityCharge - Z) < 1e-12*Z, string.format("4 pi int r^2 rho dr - Z = %.1e", If.Nucleus.DensityCharge - Z))
  end
  for i = 1, 3 do
    local d = math.abs(Ef[i]/Eg[i] - 1)
    check(d < 1e-10, string.format("kappa = %+d root %d: Gaussian %.10f Function %.10f relative %.1e", kappa, i, Eg[i], Ef[i], d))
  end
end

-- a density that is 1 % too large: warning, rescaled, same energies
local Eg = DiracRadialSolve(Z, -1, options({{"Nucleus", "Gaussian"}, {"Rrms", Rrms}}))
local Ef, _, _, If = DiracRadialSolve(Z, -1, options({{"Nucleus", "Function"}, {"Density", function(r) return 1.01*rho(r) end}}))
check(math.abs(If.Nucleus.DensityCharge/Z - 1.01) < 1e-12, string.format("unnormalized density: charge %.6f Z", If.Nucleus.DensityCharge/Z))
check(math.abs(Ef[1]/Eg[1] - 1) < 1e-10, string.format("rescaled: 1s1/2 = %.10f relative %.1e", Ef[1], math.abs(Ef[1]/Eg[1] - 1)))

-- errors
local function fails(f, text)
  local ok, message = pcall(f)
  check(not ok, text .. ": " .. tostring(message):gsub("\n", ""))
end
fails(function() return DiracRadialSolve(Z, -1, {{"Nucleus", "Function"}}) end, "Function without Density")
fails(function() return DiracRadialSolve(Z, -1, {{"Nucleus", "Gaussian"}, {"A", A}, {"Density", rho}}) end, "Density with Gaussian")
fails(function() return DiracRadialSolve(Z, -1, {{"Nucleus", "Gaussian"}}) end, "Gaussian without A or Rrms")
fails(function() return DiracRadialSolve(1, -1, {{"Nucleus", "Fermi"}, {"A", 1}}) end, "Fermi nucleus for A = 1")
fails(function() return DiracRadialSolve(Z, -1, {{"A", A}, {"NQuadrature", 128}}) end, "128 quadrature points")
fails(function() return DiracRadialSolve(Z, 0) end, "kappa = 0")

if failed then error("DiracRadialSolve: nucleus Function checks failed", 1) end
print("passed")
