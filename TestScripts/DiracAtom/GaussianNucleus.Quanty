--[[
 *  DFT stage A, check 2 (Doc/Claude/QuantyDFT_StageA, design section 12): U (Z = 92,
 *  A = 238) with a Gaussian nucleus, Rrms = (0.836 A^(1/3) + 0.570) fm = 1.0867e-4 bohr,
 *  degree 8, rMin = Rrms/50, rMax = 60/sqrt(92), for 80, 120 and 160 knot intervals.
 *  Prototype values (Python, c = 137.035999177, 1 bohr = 52917.7210544 fm):
 *      1s1/2 = -4854.15892003,  2p1/2 = -1257.23950876,  2p3/2 = -1089.61141499 Ha.
 *  Every value to 1e-8 Ha, and the three grids agree to 1e-9 Ha. No intruder: the first
 *  electronic root of kappa = +1 is 2p1/2.
 *  Also the Fermi nucleus (t = 2.30 fm): its 1s1/2 lies above the Gaussian one and
 *  agrees between 120 and 160 intervals to 1e-7 Ha.
 *  The bare nucleus: CalculateAtomicBasisFunctions without electrons (until 2026-11-15 the
 *  temporary DiracRadialSolve).
]]

local reference = {[-1] = -4854.15892003, [1] = -1257.23950876, [-2] = -1089.61141499}
local names = {[-1] = "1s1/2", [1] = "2p1/2", [-2] = "2p3/2"}
local Z, A = 92, 238

local failed = false
local function check(ok, text)
  print((ok and "ok    " or "FAILED") .. "  " .. text)
  if not ok then failed = true end
end

local function option(list, name)
  for _, o in ipairs(list) do if o[1] == name then return o[2] end end
end
local first = {}
local fermi = {}
for _, nInterval in ipairs({80, 120, 160}) do
  local G, F, At = CalculateAtomicBasisFunctions(Z, "1s0 2p0", {{"Nucleus", "Gaussian"}, {"A", A}, {"NIntervals", nInterval},
                                                   {"rMax", 60/math.sqrt(Z)}})
  for _, o in ipairs(At.Orbitals) do
    local kappa = o.kappa
    local err = o.Energy - reference[kappa]
    check(math.abs(err) < 1e-8, string.format("%3d intervals %s = %.10f Ha, prototype %+.1e", nInterval, names[kappa], o.Energy, err))
    first[kappa] = first[kappa] or o.Energy
    check(math.abs(o.Energy - first[kappa]) < 1e-9, string.format("              change from 80 intervals %+.1e", o.Energy - first[kappa]))
  end
  if nInterval == 80 then
    local Rrms = option(At.Nucleus, "Rrms")
    check(math.abs(Rrms - 1.0867e-4) < 1e-8, string.format("Rrms = %.6e bohr", Rrms))
    check(math.abs(At.rMin - Rrms/50) < 1e-20, string.format("rMin = Rrms/50 = %.6e bohr", At.rMin))
  end
  if nInterval >= 120 then
    local G, F, Af = CalculateAtomicBasisFunctions(Z, "1s0", {{"Nucleus", "Fermi"}, {"A", A}, {"NIntervals", nInterval}, {"rMax", 60/math.sqrt(Z)}})
    fermi[nInterval] = Af.Orbitals[1].Energy
    print(string.format("        Fermi nucleus %3d intervals 1s1/2 = %.10f Ha", nInterval, fermi[nInterval]))
  end
end
check(fermi[160] > reference[-1] and fermi[160] < reference[-1] + 1, string.format("Fermi 1s1/2 above the Gaussian one by %.4f Ha", fermi[160] - reference[-1]))
check(math.abs(fermi[160] - fermi[120]) < 1e-7, string.format("Fermi 1s1/2 change 120 -> 160 intervals %+.1e", fermi[160] - fermi[120]))

if failed then error("bare Gaussian nucleus checks failed", 1) end
print("passed")
