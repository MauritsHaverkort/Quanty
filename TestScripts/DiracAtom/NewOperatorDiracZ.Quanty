--[[
 *  NewOperator("Dirac", NF, Z, indices, G, F) takes Z as a real number.
 *
 *  The one-electron Dirac operator depends linearly on Z, h(Z) = T - Z v, so
 *      h(Z + 1/2) = ( h(Z) + h(Z+1) ) / 2
 *  for every matrix element. Until 2026 Z was read as an unsigned integer and 1.5 became
 *  1; the test fails for that. Z = 1 and Z = 92 are checked.
]]

local tol = 1e-13

local x = {}
for i = 0, 80 do x[i+1] = 30*(i/80)^2 end
local function spline(f)
  local y = {}
  for i = 1, #x do y[i] = f(x[i]) end
  return InterpolatingFunction.BSpline(x, y, 5)
end

local indices, NF = CreateAtomicIndicesList({"1s1/2", "2p1/2", "2p3/2"}, {{"Kappas", true}})
local G = {spline(function(r) return 2*r*math.exp(-r) end),
           spline(function(r) return r^2*math.exp(-r/2)/(2*math.sqrt(6)) end),
           spline(function(r) return r^2*math.exp(-r/2)/(2*math.sqrt(6)) end)}
local F = {spline(function(r) return -0.004*r*math.exp(-r) end),
           spline(function(r) return 0.002*r*math.exp(-r/2) end),
           spline(function(r) return -0.002*r^2*math.exp(-r/2) end)}

local function h(Z) return OperatorToMatrix(NewOperator("Dirac", NF, Z, indices, G, F)) end

local failed = false
for _, Z in ipairs({1, 92}) do
  local a, b, m = h(Z), h(Z+1), h(Z+0.5)
  local worst, scale, change = 0, 0, 0
  for i = 1, NF do
    for j = 1, NF do
      scale = math.max(scale, math.abs(m[i][j]))
      worst = math.max(worst, math.abs(m[i][j] - (a[i][j] + b[i][j])/2))
      change = math.max(change, math.abs(m[i][j] - a[i][j]))
    end
  end
  print(string.format("Z = %4.1f  max |h(Z+1/2) - (h(Z)+h(Z+1))/2| / max|h| = %.2e   max |h(Z+1/2) - h(Z)| = %.4e",
                      Z, worst/scale, change))
  if not (worst <= tol*scale) or not (change > 1e-3) then failed = true end
end
if failed then error("NewOperator(\"Dirac\") is not linear in a real Z", 1) end
print("passed")
