--[[
 *  DFT stage A, check 4 (Doc/Claude/QuantyDFT_StageA, design section 12): the Galerkin
 *  solution of the radial Poisson equation (BSplinePoissonSetup/Solve),
 *      Y^k(r) = r int rho(r') r<^k / r>^(k+1) dr',
 *  through CalculateAtomicBasisFunctions, against closed forms:
 *  - k = 0: the hydrogen atom in Hartree-Fock (Schroedinger, point nucleus) is exact, so
 *    Atom.Potential.rVH = Y^0 of rho = 4 r^2 e^(-2r) is 1 - e^(-2r) (1 + r); degree 8,
 *    13 points per interval, rMin = 1e-5, rMax = 40: to 1e-8 (80 intervals) and 1e-11
 *    (160 intervals); measured 6.8e-9 and 7.0e-12, as the prototype (6.8e-9 and 8.0e-12).
 *    rVH at the last point is the charge, 1.
 *  - k = 0, 1, 2: the Slater integrals F^k and G^k of the bare hydrogen orbitals 1s, 2s,
 *    2p (no electrons, Schroedinger, default basis) against their rational values,
 *    e.g. F^0(1s,1s) = 5/8, G^1(1s,2p) = 112/2187, F^2(2p,2p) = 45/512; measured
 *    <= 1.8e-11, checked 1e-10.
 *  Until 2026-11-15 through the temporary RadialPoisson(rho, k), which was also checked for
 *  rho = r^6 e^-2r (1 + 0.3 r^3) and k = 0, 1, 2, 4 by incomplete gamma functions.
]]

local failed = false
local function check(ok, text)
  print((ok and "ok    " or "FAILED") .. "  " .. text)
  if not ok then failed = true end
end

-- hydrogen 1s: rVH = Y^0
for _, n in ipairs({80, 160}) do
  local G, F, A = CalculateAtomicBasisFunctions(1, {{"Configuration", "1s1"}, {"Nucleus", "Point"}, {"Relativistic", false}, {"Degree", 8}, {"NIntervals", n},
                                                  {"rMin", 1e-5}, {"rMax", 40}, {"NQuadrature", 13}})
  local Y = A.Potential.rVH
  local last = Y.x[#Y.x]
  local err = 0
  for i = 0, 200 do
    local r = 1e-4*(last/1e-4)^(i/200)
    err = math.max(err, math.abs(Y(r) - (1 - math.exp(-2*r)*(1 + r))))
  end
  check(err < ((n == 80) and 1e-8 or 1e-11), string.format("hydrogen 1s Y^0, %3d intervals: max error %.1e", n, err))
  check(math.abs(Y(last) - 1) < 1e-12, string.format("              Y^0 at the last point (%.3f) - 1 = %.1e", last, Y(last) - 1))
end

-- the Slater integrals of the bare hydrogen orbitals
local G, F, A = CalculateAtomicBasisFunctions(1, {{"Configuration", "1s0 2s0 2p0"}, {"Nucleus", "Point"}, {"Relativistic", false}})
local S = A.SlaterIntegrals
local exact = {{"1s 1s 1s 1s", 0, 5/8},     {"1s 2s 1s 2s", 0, 17/81},     {"1s 2s 2s 1s", 0, 16/729},
               {"1s 2p 1s 2p", 0, 59/243},  {"1s 2p 2p 1s", 1, 112/2187},  {"2s 2s 2s 2s", 0, 77/512},
               {"2p 2p 2p 2p", 0, 93/512},  {"2p 2p 2p 2p", 2, 45/512},    {"2s 2p 2s 2p", 0, 83/512},
               {"2s 2p 2p 2s", 1, 45/512}}
local worst, which = 0, ""
for _, e in ipairs(exact) do
  local d = math.abs(S[e[1]][e[2]] - e[3])
  if d > worst then worst, which = d, e[1] .. " k = " .. e[2] end
end
check(A.NElectron == 0 and worst < 1e-10, string.format("hydrogen Slater integrals, k = 0, 1, 2: %d against their exact values, largest deviation %.1e (%s)", #exact, worst, which))

if failed then error("radial Poisson checks failed", 1) end
print("passed")
