NF = 8

--TODO: nur zu Testzwecken:
print(Simon.MatrixRepresentation(NewOperator("Number",NF,{5},{5},{1+I}) + NewOperator("U",NF,{1},{2},{5}) + 1 + I))

opList = {}
opList[#opList+1] = NewOperator("Number",NF,{0},{0},{1})
opList[#opList+1] = NewOperator("Number",NF,{1},{1},{-1}) + 1
opList[#opList+1] = NewOperator("Number",NF,{2},{2},{1+I})
opList[#opList+1] = NewOperator("Number",NF,{3},{3},{1+I}) + 1
opList[#opList+1] = NewOperator("Number",NF,{4},{4},{1+I}) + I
opList[#opList+1] = NewOperator("Number",NF,{5},{5},{1+I}) + NewOperator("U",NF,{1},{2},{5}) + 1 + I
opList[#opList+1] = NewOperator(NF,0,{{1,2,I},{-1,-2,I},{-3,3,I}})

for key,op in pairs(opList) do
    print("\n\n\nOperator:")
    print(op)
    print("Matrix Representation:")
    print(Simon.MatrixRepresentation(op))
end
