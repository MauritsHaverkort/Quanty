errorCount = 0

print("Reading Orca output for an isolated H atom...")
Orcaout = Simon.FileReadOrca("DFT/H_Orca.out")

fields = {"NBasis", "OverlapMatrix", "MolecularOrbitalMatrix", "EigenEnergies", "EigenOccupations", "BasisOrbitalNames", "Atoms", "RadialFunctions"}
for key,field in pairs(fields) do
    print(field..":")
    print(Orcaout[field])
end

print("\nReading Orca output and diagonalizing degenerate states...")
OrcaoutDiag = Simon.FileReadOrca("DFT/H_Orca.out", {{"diagonalizeDegenerateStates",true}})
print("MolecularOrbitalMatrix:")
print(OrcaoutDiag["MolecularOrbitalMatrix"])

print("Comparing molecular orbitals in rotated systems...")
OrcaCO2x = Simon.FileReadOrca("DFT/CO2x_Orca.out")
OrcaCO2y = Simon.FileReadOrca("DFT/CO2y_Orca.out")
OrcaCO2z = Simon.FileReadOrca("DFT/CO2z_Orca.out")
OrcaCO2xyz = Simon.FileReadOrca("DFT/CO2xyz_Orca.out")

pi =  3.14159265359
function tesseral(orb, vec)
    local x = vec[1]
    local y = vec[2]
    local z = vec[3]
    pos = string.find(orb, '_%d') + 2
    llz = string.sub(orb, pos)
    if llz == "s0" then
        return 1/(2 * sqrt(pi))
    elseif llz == "p-1" then
        return 1/2 * sqrt(3/pi) * y
    elseif llz == "p0" then
        return 1/2 * sqrt(3/pi) * z
    elseif llz == "p1" then
        return 1/2 * sqrt(3/pi) * x
    elseif llz == "d-2" then
        return 1/2 * sqrt(15/pi) * x * y
    elseif llz == "d-1" then
        return 1/2 * sqrt(15/pi) * y * z
    elseif llz == "d0" then
        return -1/4 * sqrt(5/pi) * (x*x + y*y - 2*z*z)
    elseif llz == "d1" then
        return 1/2 * sqrt(15/pi) * x * z
    elseif llz == "d2" then
        return 1/4 * sqrt(15/pi) * (x - y) * (x + y)
    elseif llz == "f-3" then
        return -1/4 * sqrt(35/(2*pi)) * y * (y*y - 3*x*x)
    elseif llz == "f-2" then
        return 1/2 * sqrt(105/pi) * x * y * z
    elseif llz == "f-1" then
        return -1/4 * sqrt(21/(2*pi)) * y * (x*x + y*y - 4*z*z)
    elseif llz == "f0" then
        return 1/4 * sqrt(7/pi) * z * (2*z*z - 3 * (x*x + y*y))
    elseif llz == "f1" then
        return -1/4 * sqrt(21/(2*pi)) * x * (x*x + y*y - 4*z*z)
    elseif llz == "f2" then
        return 1/4 * sqrt(105/pi) * z * (x - y) * (x + y)
    elseif llz == "f3" then
        return 1/4 * sqrt(35/(2*pi)) * x * (x*x - 3*y*y)
    elseif llz == "g-4" then
        return 3/4 * sqrt(35/pi) * x * y * (x - y) * (x + y)
    elseif llz == "g-3" then
        return -3/4 * sqrt(35/(2*pi)) * y * z * (y*y - 3*x*x)
    elseif llz == "g-2" then
        return -3/4 * sqrt(5/pi) * x * y * (x*x + y*y - 6*z*z)
    elseif llz == "g-1" then
        return -3/4 * sqrt(5/(2*pi)) * y * z * (3*(x*x + y*y) - 4*z*z)
    elseif llz == "g0" then
        return (-72*z*z*(x*x + y*y) + 9*(x*x + y*y)*(x*x + y*y) + 24*z*z*z*z)/(16*sqrt(pi))
    elseif llz == "g1" then
        return -3/4 * sqrt(5/(2*pi))*x*z*(3*(x*x + y*y) - 4*z*z)
    elseif llz == "g2" then
        return -3/8 * sqrt(5/pi) * (x - y) * (x + y) * (x*x + y*y - 6*z*z)
    elseif llz == "g3" then
        return 3/4 * sqrt(35/(2*pi)) *x*z*(x*x - 3*y*y)
    elseif llz == "g4" then
        return 3/16 * sqrt(35/pi) * (x*x*x*x - 6*x*x*y*y + y*y*y*y)
    else 
        print("I do not know the tesseral harmonics corresponding to the "..orb.." orbital!!!")
        os.exit()
    end
end

function matMult(mat,vec)
    out = {0,0,0}
    for i=1,#vec do
        for j=1,#vec do
            out[i] = out[i] + mat[i][j]*vec[j]
        end
    end
    return out
end

zToX = {{0,0,1},
        {0,1,0},
        {-1,0,0}}

zToY = {{1,0,0},
        {0,0,1},
        {0,-1,0}}
        
c = 1/sqrt(3)
s = sqrt(2/3)
        
zToXYZ = {{1/2*(1-c) + c, -1/2*(1-c), 1/sqrt(2)*s},
        {-1/2*(1-c), 1/2*(1-c)+c, 1/sqrt(2)*s},
        {-1/sqrt(2)*s, -1/sqrt(2)*s, c}}

pointsZ = {}
for key1,p1 in pairs({-1,0,1}) do
    for key2,p2 in pairs({-1,0,1}) do
        for key3,p3 in pairs({-1,0,1}) do
            pointsZ[#pointsZ+1] = {p1,p2,p3}
        end
    end
end

OrcasAndMatrices = {{OrcaCO2z, Matrix.Identity(3)},{OrcaCO2x,zToX},{OrcaCO2y,zToY},{OrcaCO2xyz,zToXYZ}}

mainAtomMaxInd = 0
for key,orb in pairs(OrcaCO2z["BasisOrbitalNames"]) do
    if string.sub(orb,1,1) ~= "0" then
        break
    else
        mainAtomMaxInd = mainAtomMaxInd + 1
    end
end


valuesZ = {}
for key,val in pairs(OrcasAndMatrices) do
    local orca = val[1]
    local MOs = Matrix.ToTable(orca["MolecularOrbitalMatrix"])
    local R = val[2]
    local orbNames = val[1]["BasisOrbitalNames"]
    for key2, point in pairs(pointsZ) do
        point = matMult(R,point)
        if valuesZ[key2] == nil then
            valuesZ[key2] = {}
        end
        for key3,MO in pairs(MOs) do
            local isDegenerate = false
            if key3 > 1 and abs(orca["EigenEnergies"][key3] - orca["EigenEnergies"][key3-1]) < 1e-5 then
                isDegenerate = true
            end
            if key3 < #(orca["EigenEnergies"]) and abs(orca["EigenEnergies"][key3] - orca["EigenEnergies"][key3+1]) < 1e-5 then
                isDegenerate = true
            end
        
            if not isDegenerate then
                local value = 0
                for key4=1,mainAtomMaxInd do
                    entry = MO[key4]
                    value = value + entry*tesseral(orbNames[key4], point)
                end
                if valuesZ[key2][key3] == nil then
                    valuesZ[key2][key3] = value
                else
                    local diff = Chop( abs(value) - abs(valuesZ[key2][key3]), 5e-4 )
                    if diff ~= 0 then
                        print("Something went wrong!")
                        errorCount = errorCount + 1
                    end
                end
            end
        end
    end
end

os.exit(errorCount)
