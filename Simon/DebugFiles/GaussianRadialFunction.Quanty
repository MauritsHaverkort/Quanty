errorCount = 0

function test(val1, val2, tolerance)
    if tolerance == nil then
       tolerance = 1e-13 
    end
    if Chop(val1 - val2, tolerance) ~= 0 then
        print("Something went wrong!")
        errorCount = errorCount + 1
    end
end


for l=0,4 do
    for amp = 1,3 do
        for width = 1,3 do
            g = GaussianRadialFunction.NewGaussianRadialFunction(l, amp, width)
            
            N = 50
            for i=1,N do
                local x = i*2/N
                test(g(x), amp*pow(x,l)*exp(-width*x*x))
            end
            
            f = GaussianRadialFunction.ToInterpolationTimesR(g)

            N = 200
            for i=1,N do
                local x = i*19/N
                test(g(x)*x, f(x), 1e-5) --Some accuracy loss is expected when converting to Interpolating Functions
            end
        end
    end
end

g = GaussianRadialFunction.NewGaussianRadialFunction(1, {2,3}, {0.4, 0.5})
g.l = 6
g.amplitudes = {7,8}
g.widths = {1/9, 1/10}
test(g.l, 6)
test(g.amplitudes[1], 7)
test(g.amplitudes[2],8)
test(g.widths[1],1/9)
test(g.widths[2],1/10)
test(g.N,2)
g[1] = {11,1/12}
test(g[1][1],11)
test(g[1][2],1/12)
g[3] = {13,1/14}
test(g[3][1],13)
test(g[3][2],1/14)
test(g.N,3)

f = -g
test(f.l,6)
test(f.N,3)
test(f[1][1],-11)
test(f[1][2],1/12)
test(f[2][1],-8)
test(f[2][2],1/10)
test(f[3][1],-13)
test(f[3][2],1/14)

g = GaussianRadialFunction.NewGaussianRadialFunction(1, {2}, {0.3})
f = GaussianRadialFunction.NewGaussianRadialFunction(1, {4}, {0.5})
h = g + f
test(h.l,1)
test(h.N,2)
test(h[1][1],2)
test(h[1][2],0.3)
test(h[2][1],4)
test(h[2][2],0.5)

h = g - f
test(h.l,1)
test(h.N,2)
test(h[1][1],2)
test(h[1][2],0.3)
test(h[2][1],-4)
test(h[2][2],0.5)

h = g*2
test(h.l,1)
test(h.N,1)
test(h[1][1],4)
test(h[1][2],0.3)

h = -2*f
test(h.l,1)
test(h.N,1)
test(h[1][1],-8)
test(h[1][2],0.5)

h = g/2
test(h.l,1)
test(h.N,1)
test(h[1][1],1)
test(h[1][2],0.3)

if errorCount == 0 then
    print("No errors detected.")
end

os.exit(errorCount)
