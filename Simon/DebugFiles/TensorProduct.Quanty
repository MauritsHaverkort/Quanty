errorCount = 0

function errorHappened()
    print("Oh no, something went wrong!")
    errorCount = errorCount + 1
end

function test(i, j)
    psiNew = Simon.TensorProduct(psi[i],psi[j])
    --TODO: I don't know better criteria...
    if psiNew.NF ~= psi[i].NF + psi[j].NF then
        errorHappened()
    elseif psiNew.N ~= psi[i].N * psi[j].N then
        errorHappened()
    elseif ((psi[i].Complex or psi[j].Complex) and not psiNew.Complex) or ((not psi[i].Complex and not psi[j].Complex) and psiNew.Complex) then
        errorHappened()
    elseif Chop( psiNew*psiNew - 1, 1e-10) ~= 0 then
        errorHappened()
    elseif (i ~= j) and ( Chop( psiNew - Simon.TensorProduct(psi[j],psi[i]) ).N == 0 ) then
        errorHappened()
    end
end

psi = {}
psi[#psi+1] = NewWavefunction(1, 0, {{"1",1}})
psi[#psi+1] = NewWavefunction(2, 0, {{"10",I}})
psi[#psi+1] = NewWavefunction(6, 0, {{"100000",math.sqrt(1/2)}, {"000001",math.sqrt(1/2)}})
psi[#psi+1] = NewWavefunction(4, 0, {{"0100",5}, {"0001",1}})
psi[#psi+1] = NewWavefunction(4, 0, {{"0100",5}, {"0001",1 + I}})
psi[#psi+1] = NewWavefunction(8, 0, {{"10011000",I}, {"00100101",-30*I}})
psi[#psi+1] = NewWavefunction(4, 0, {{"0001",1}, {"0010",1}, {"0011",1}, {"0100",1}, {"0101",1}, {"0110",1}, {"0111",1}, {"1000",1}, {"1001",1}, {"1010",1}, {"1011",1}, {"1100",1}, {"1101",1}, {"1110",1}, {"1111",1}})

for i = 1,#psi do
    psi[i].Normalize()
end

for i= 1,#psi do
    for j =1,#psi do
        test(i,j)
    end
end

if errorCount == 0 then
    print("Everything went according to plan.")
else
    print(errorCount.." errors detected.")
end

os.exit(errorCount)
