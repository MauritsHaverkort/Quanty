errorCount = 0

MRe = {{3,14},
       {7,8}}
ORe = Simon.MatrixToOperator(MRe)
print("Real Matrix:")
print(MRe)
print("Real Operator:")
print(ORe)
if Matrix.ToUserdata( Chop( OperatorToMatrix(ORe) - MRe) ) ~= Matrix.ToUserdata( Matrix.Zero(#MRe) ) then errorCount = errorCount + 1 end

MIm = {{2*I, 12.5*I},
       {17*I, 24.4*I}}
OIm = Simon.MatrixToOperator(MIm)
print("Imaginary Matrix:")
print(MIm)
print("Imaginary Operator:")
print(OIm)
if Matrix.ToUserdata( Chop( OperatorToMatrix(OIm) - MIm) ) ~= Matrix.ToUserdata( Matrix.Zero(#MIm) ) then errorCount = errorCount + 1 end

MCom = {{13,12*I,-4},
        {2+7*I,7,91*I},
        {-13,-0.7-5.18*I,0}}
OCom = Simon.MatrixToOperator(MCom)
print("Complex Matrix:")
print(MCom)
print("Complex Operator:")
print(OCom)
if Matrix.ToUserdata( Chop( OperatorToMatrix(OCom) - MCom) ) ~= Matrix.ToUserdata( Matrix.Zero(#MCom) ) then errorCount = errorCount + 1 end

os.exit(errorCount)
