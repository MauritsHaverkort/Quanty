lists = {}
lists[#lists+1] = {}
lists[#lists+1] = {{{{{}}}}}
lists[#lists+1] = {{1, 1}, {1,1}}
lists[#lists+1] = {{{2,2}, 1, 1}, 0}
lists[#lists+1] = {{1,1},{{2},{2}},{1,{{3,{4}}}}}

for key,list in pairs(lists) do
    print("\n\n\n")
    print("Unflattened list:")
    print(list)
    print("Flattened to depth 1:")
    print( Simon.Flatten(list, 1) )
    for r=2,4 do
        print("Flattened to depth "..r..":")
        print( Simon.Flatten(list, r) )
    end
end
