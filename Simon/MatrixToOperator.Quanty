MRe = {{3,14},
       {7,8}}
ORe = Simon.MatrixToOperator(MRe)
print("Real Matrix:")
print(MRe)
print("Real Operator:")
print(ORe)
print("Test:")
print( Chop( OperatorToMatrix(ORe) - MRe) )
print("\n\n\n")

MIm = {{2*I, 12.5*I},
       {17*I, 24.4*I}}
OIm = Simon.MatrixToOperator(MIm)
print("Imaginary Matrix:")
print(MIm)
print("Imaginary Operator:")
print(OIm)
print("Test:")
print( Chop( OperatorToMatrix(OIm) - MIm) )
print("\n\n\n")

MCom = {{13,12*I,-4},
        {2+7*I,7,91*I},
        {-13,-0.7-5.18*I,0}}
OCom = Simon.MatrixToOperator(MCom)
print("Complex Matrix:")
print(MCom)
print("Complex Operator:")
print(OCom)
print("Test:")
print( Chop( OperatorToMatrix(OCom) - MCom) )
print("\n\n\n")
