 RowBox[{
  RowBox[{
   RowBox[{"Z", "[", 
    RowBox[{"k_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
   
   RowBox[{"ExpToTrig", "[", 
    RowBox[{"\[Piecewise]", GridBox[{
       {
        RowBox[{"Y", "[", 
         RowBox[{"k", ",", "0", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
        RowBox[{"m", "\[Equal]", "0"}]},
       {
        RowBox[{
         SqrtBox[
          FractionBox["1", "2"]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Y", "[", 
            RowBox[{"k", ",", 
             RowBox[{"-", "m"}], ",", "\[Theta]", ",", "\[Phi]"}], "]"}], "+",
            
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "m"], 
            RowBox[{"Y", "[", 
             RowBox[{"k", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
             "]"}]}]}], ")"}]}], 
        RowBox[{"m", ">", "0"}]},
       {
        RowBox[{"\[ImaginaryI]", 
         SqrtBox[
          FractionBox["1", "2"]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Y", "[", 
            RowBox[{"k", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
           "-", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "m"], 
            RowBox[{"Y", "[", 
             RowBox[{"k", ",", 
              RowBox[{"-", "m"}], ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}]}],
           ")"}]}], 
        RowBox[{"m", "<", "0"}]}
      }]}], "]"}]}], ";"}]}], "Input",
