dofile("DebugMartin.res")

tuple = {{0, -1, 3, -1, 2, -1, 3, -1}}

w = 1/50

ind, NF = CreateAtomicIndicesList({"1s12","2s12","3s12","4s12"})
groups = {{-1,{0,1,2,3}}}

H0 = Martin.NewDirac(NF,basisfuns,derivfuns,x,groups,67,ind)
U  = Martin.NewCoulomb(NF,basisfuns,x,tuple,ind,1)

--print(#basisfuns,#x,#derivfuns,#DOBase)

hexcited, BaseContinuum = Martin.ContinuumBase(basisfuns,derivfuns,x,groups[1],w,DOBase)

s1 = 0
s2 = 0
for i = 1, #x do
    s1 = s1 + BaseContinuum[1][i]
    s2 = s2 + BaseContinuum[2][i]
end

print("\n")
print("\n")

print("Deviation BaseContinuum:",abs(abs(s1)-5.7522076805844),abs(abs(s2)-1.771797420315)) -- -109.65226056413   3.9804102602695   -5.7522076805845        1.7717974203144
print("Deviation hexcited     :",abs(-0.043998946241088-hexcited[1]),abs(0.090853002599953 -hexcited[2])) --  -0.043998946241088   0.090853002599953

psi0 = NewWavefunction(NF, 0, {{"11110000",1}})
psi1 = (H0+U) * psi0;
psi2 = (H0+U) * psi1;
psi3 = (H0+U) * psi2;
psi4 = (H0+U) * psi3;
psi5 = (H0+U) * psi4;
psi6 = (H0+U) * psi5;
psi7 = (H0+U) * psi6;
psi8 = (H0+U) * psi7;
psi9 = (H0+U) * psi8;

psi = {psi0,psi1,psi2,psi3,psi4,psi5,psi6,psi7,psi8,psi9}

u = Braket(psi,U ,psi)
h = Braket(psi,H0,psi)

du = {}
dh = {}
for i = 1, #u do
    du[i] = {}
    dh[i] = {}
    for j = 1, #u[i] do
        du[i][j] = abs(u[i][j] - uold[i][j])/max(1E-300,abs(uold[i][j]))
        dh[i][j] = abs(h[i][j] - hold[i][j])/max(1E-300,abs(hold[i][j]))
    end
end

print("\n")
print("\n")
print("Deviation Ucoulomb:")
print("\n")
print(du)
print("\n")
print("\n")
print("Deviation HDirac:")
print("\n")
print(dh)
print("\n")
